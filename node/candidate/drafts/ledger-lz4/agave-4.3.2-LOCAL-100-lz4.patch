+
+// Returns whether compression should be enabled for the given column (name).
+//
+// TransactionStatus is the upstream choice. LOCAL-100 adds the columns that
+// hold nearly all of an unpruned ledger: the shred payloads and the per-slot
+// Index and SlotMeta records, together with their alternate-block twins.
+//
+// This only selects which columns follow LedgerColumnOptions::compression_type.
+// That option still defaults to None, so Blockstore::open() and every other
+// default open behave exactly as before. Compression changes how new SST
+// blocks are encoded and nothing else: no key is added, removed or skipped,
+// and files written earlier stay readable as they are.
+fn should_enable_cf_compression(cf_name: &str) -> bool {
+    matches!(
+        cf_name,
+        columns::TransactionStatus::NAME
+            | columns::ShredData::NAME
+            | columns::ShredCode::NAME
+            | columns::Index::NAME
+            | columns::SlotMeta::NAME
+            | columns::AlternateShredData::NAME
+            | columns::AlternateIndex::NAME
+            | columns::AlternateSlotMeta::NAME
+    )
 }
 
