+            columns::AlternateShredData::NAME,
+            columns::AlternateIndex::NAME,
+            columns::AlternateSlotMeta::NAME,
+        ];
+        columns_to_compress.iter().for_each(|cf_name| {
+            assert!(should_enable_cf_compression(cf_name));
+        });
+        let columns_left_alone = [
+            columns::AddressSignatures::NAME,
+            columns::TransactionMemos::NAME,
+            columns::Root::NAME,
+            columns::BankHash::NAME,
+            "something else",
+        ];
+        columns_left_alone.iter().for_each(|cf_name| {
+            assert!(!should_enable_cf_compression(cf_name));
+        });
+        assert!(should_enable_compression::<columns::ShredData>());
+        assert!(should_enable_compression::<columns::ShredCode>());
+        assert!(!should_enable_compression::<columns::Root>());
+    }
