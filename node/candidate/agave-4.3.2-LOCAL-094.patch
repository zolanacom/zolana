+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn request(method: &str, params: Value) -> Value {
+        json!({"jsonrpc":"2.0","id":1,"method":method,"params":params})
+    }
+    #[test]
+    fn fixed_flag_cannot_mix_with_live_or_path_options() {
+        assert!(!selected(&[]).unwrap());
+        assert!(selected(&[FLAG.into()]).unwrap());
+        for extra in ["--service", "--resume-root", "--root", "--build-info", FLAG] {
+            assert!(selected(&[FLAG.into(), extra.into()]).is_err());
+        }
+    }
+    #[test]
+    fn only_four_fixed_finalized_read_shapes() {
+        assert_eq!(
+            parse(&request("getGenesisHash", json!([]))).unwrap(),
+            Call::Genesis
+        );
+        assert_eq!(
+            parse(&request("getSlot", json!([{"commitment":"finalized"}]))).unwrap(),
+            Call::Slot
+        );
+        assert_eq!(
+            parse(&request(
+                "getBlocksWithLimit",
+                json!([u64::MAX,16,{"commitment":"finalized"}])
+            ))
+            .unwrap(),
+            Call::Slots(u64::MAX)
+        );
+        for (details, full) in [("none", false), ("full", true)] {
+            let mut config =
+                json!({"transactionDetails":details,"rewards":false,"commitment":"finalized"});
+            if full {
+                config["encoding"] = json!("base64");
+                config["maxSupportedTransactionVersion"] = json!(0);
+            }
+            assert_eq!(
+                parse(&request("getBlock", json!([1, config]))).unwrap(),
+                Call::Block(1, full)
+            );
+        }
+        for (method, params) in [
+            ("sendTransaction", json!(["fake"])),
+            ("getSlot", json!([])),
+            ("getSlot", json!([{"commitment":"processed"}])),
+            ("getGenesisHash", json!([1])),
+            (
+                "getBlocksWithLimit",
+                json!([1,true,{"commitment":"finalized"}]),
+            ),
+            (
+                "getBlocksWithLimit",
+                json!([0,16,{"commitment":"finalized"}]),
+            ),
+            (
+                "getBlock",
+                json!([1,{"transactionDetails":"none","rewards":0,"commitment":"finalized"}]),
+            ),
+            (
+                "getBlock",
+                json!([true,{"transactionDetails":"none","rewards":false,"commitment":"finalized"}]),
+            ),
+        ] {
+            assert!(parse(&request(method, params)).is_err());
+        }
+        let mut value = request("getGenesisHash", json!([]));
+        value["path"] = json!("elsewhere");
+        assert!(parse(&value).is_err());
+        value = request("getGenesisHash", json!([]));
+        value["id"] = json!(true);
+        assert!(parse(&value).is_err());
+    }
+    #[test]
+    fn output_bound_is_enforced_during_serialization() {
+        assert_eq!(bounded_json(&json!("x"), 3).unwrap(), b"\"x\"");
+        assert!(bounded_json(&json!("xx"), 3).is_err());
+        assert!(deadline(Instant::now() - Duration::from_millis(1)).is_err());
+    }
+
+    #[test]
+    fn actual_rpc_encoder_preserves_header_and_empty_full_transactions() {
+        let block = ConfirmedBlock {
+            previous_blockhash: GENESIS.into(),
+            blockhash: ORIGINAL_BANK.into(),
+            parent_slot: 43,
+            transactions: vec![],
+            rewards: vec![],
+            num_partitions: Some(3),
+            block_time: Some(1_700_000_000),
+            block_height: Some(44),
+        };
+        let full = encode_block(block.clone(), true).unwrap();
+        let header = encode_block(block, false).unwrap();
+        assert_eq!(full["transactions"], json!([]));
+        assert!(header.get("transactions").is_none());
+        for key in [
+            "blockhash",
+            "previousBlockhash",
+            "parentSlot",
+            "blockTime",
+            "blockHeight",
+            "numRewardPartitions",
+        ] {
+            assert_eq!(header[key], full[key]);
+        }
+        assert_eq!(header["blockTime"], json!(1_700_000_000));
+        assert_eq!(header["numRewardPartitions"], json!(3));
+        assert!(header.get("rewards").is_none() && full.get("rewards").is_none());
+    }
+}
