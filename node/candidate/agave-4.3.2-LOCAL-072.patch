diff --git a/zolana-fast-check/src/bin/snapshot-provenance.rs b/zolana-fast-check/src/bin/snapshot-provenance.rs
new file mode 100644
--- /dev/null
+++ b/zolana-fast-check/src/bin/snapshot-provenance.rs
@@ -0,0 +1,298 @@
+//! Metadata provenance only: no Bank/accounts loader, validator, RPC or writes.
+//! Installed only as zolana-fast-check/src/bin/snapshot-provenance.rs.
+#[path = "../ancestry.rs"]
+mod ancestry;
+
+use {
+    anyhow::{Context, Result, ensure},
+    serde_json::{Value, json},
+    solana_ledger::{
+        blockstore::Blockstore,
+        blockstore_options::{AccessType, BlockstoreOptions},
+    },
+    std::{
+        fs,
+        os::unix::fs::{MetadataExt, PermissionsExt},
+        path::{Path, PathBuf},
+        sync::{
+            Arc,
+            atomic::{AtomicBool, Ordering},
+            mpsc,
+        },
+        thread,
+        time::{Duration, Instant},
+    },
+};
+
+const COPIES: &str = "/var/lib/zolana-native-072-maintenance/copies";
+const COPY_OWNER: u32 = 995;
+const COMMON_ROOT: u64 = 107_629;
+const COMMON_HASH: &str = "AWMs3U8exJH66eSVU5ckQEvDSGJ9t2674hapfeRwMENF";
+const ORIGINAL_ROOT: u64 = 44;
+const ORIGINAL_HASH: &str = "4KPfPytMfQtVoHrT3buic6vACAvww5DQbhZyFLvnW1JV";
+const ANCESTRY_SOURCE_SHA256: &str =
+    "18ecd6f0c32c8dc2bddffa52a2c10914b9e57f2467c39eb702cfec7408fde8c1";
+const BUDGET: Duration = Duration::from_secs(30);
+
+fn check_budget(deadline: Instant, cancelled: &AtomicBool) -> Result<()> {
+    if cancelled.load(Ordering::Relaxed) {
+        return Err(ancestry::AncestryError::Cancelled.into());
+    }
+    if Instant::now() >= deadline {
+        return Err(ancestry::AncestryError::Deadline.into());
+    }
+    Ok(())
+}
+
+// Walk metadata only, never read file contents. Copies must be exclusively
+// staged and owner protected; existing paths keep Blockstore::open's upstream
+// create_dir_all calls no-ops. Reject hardlinks as well as symlinks so a caller
+// cannot label an original shared inode as an isolated writable copy.
+fn protected_copy(node: usize, deadline: Instant, cancelled: &AtomicBool) -> Result<PathBuf> {
+    ensure!(
+        node < 3,
+        "only the three fixed protected copies are accepted"
+    );
+    let root = Path::new(COPIES).join(format!("node{node}"));
+    ensure!(
+        root.canonicalize()? == root,
+        "copy path contains an alias or symlink"
+    );
+    let mut pending = vec![root.clone()];
+    while let Some(path) = pending.pop() {
+        check_budget(deadline, cancelled)?;
+        let meta = fs::symlink_metadata(&path)?;
+        ensure!(
+            meta.uid() == COPY_OWNER && !meta.file_type().is_symlink(),
+            "copy metadata has a different owner or symlink"
+        );
+        if meta.is_dir() {
+            ensure!(
+                meta.permissions().mode() & 0o7777 == 0o700,
+                "copy directory must be mode0700"
+            );
+            for entry in fs::read_dir(&path)? {
+                pending.push(entry?.path());
+            }
+        } else {
+            ensure!(
+                meta.is_file()
+                    && meta.nlink() == 1
+                    && matches!(meta.permissions().mode() & 0o7777, 0o400 | 0o600),
+                "copy file must be an owner-readable private regular unlinked file"
+            );
+        }
+    }
+    ensure!(
+        root.is_dir() && root.join("rocksdb").is_dir() && root.join("rocksdb/CURRENT").is_file(),
+        "complete existing copy and RocksDB directory required"
+    );
+    Ok(root)
+}
+
+fn verify_root(
+    store: &Blockstore,
+    slot: u64,
+    expected: &str,
+    deadline: Instant,
+    cancelled: &AtomicBool,
+) -> Result<Value> {
+    check_budget(deadline, cancelled)?;
+    let meta = store.meta(slot)?.context("pinned root metadata missing")?;
+    let certified = store
+        .get_optimistic_slot(slot)?
+        .map(|(hash, _)| hash.to_string());
+    let replay = store.get_bank_hash(slot).map(|hash| hash.to_string());
+    ensure!(
+        meta.slot == slot
+            && meta.is_full()
+            && store.is_root(slot)
+            && certified.as_deref() == Some(expected)
+            && replay.as_deref().is_none_or(|hash| hash == expected),
+        "pinned root completeness, certification or Bank hash differs"
+    );
+    check_budget(deadline, cancelled)?;
+    Ok(json!({"slot":slot, "bank_hash":expected, "rooted":true,
+        "complete":true, "certified_bank_hash":certified,
+        "optional_replay_bank_hash":replay}))
+}
+
+fn verify_store(store: &Blockstore, deadline: Instant, cancelled: &AtomicBool) -> Result<Value> {
+    let common = verify_root(store, COMMON_ROOT, COMMON_HASH, deadline, cancelled)?;
+    let original = verify_root(store, ORIGINAL_ROOT, ORIGINAL_HASH, deadline, cancelled)?;
+    let report = ancestry::verify_path(store, COMMON_ROOT, ORIGINAL_ROOT, deadline, || {
+        cancelled.load(Ordering::Relaxed)
+    })?;
+    check_budget(deadline, cancelled)?;
+    Ok(json!({"common_root":common,"immutable_checkpoint":original,
+        "ancestry":{"from":report.start_slot,"to":report.target_slot,
+        "entries":report.entries,"verified":true}}))
+}
+
+fn run(deadline: Instant, cancelled: &AtomicBool) -> Result<Value> {
+    ensure!(
+        std::env::args_os().len() == 1,
+        "no arguments or alternate ledger paths accepted"
+    );
+    let mut peers = Vec::new();
+    for node in 0..3 {
+        let path = protected_copy(node, deadline, cancelled)?;
+        let store = Blockstore::open_with_options(
+            &path,
+            BlockstoreOptions {
+                access_type: AccessType::ReadOnly,
+                ..BlockstoreOptions::default()
+            },
+        )
+        .context("read-only protected-copy Blockstore open failed")?;
+        let proof = verify_store(&store, deadline, cancelled)?;
+        drop(store);
+        // Recheck after the read-only open; the external copy owner must keep
+        // these copies exclusive and unchanged throughout this short process.
+        ensure!(
+            protected_copy(node, deadline, cancelled)? == path,
+            "protected copy changed during verification"
+        );
+        peers.push(json!({"node":node,"copy":path,"proof":proof}));
+    }
+    check_budget(deadline, cancelled)?;
+    Ok(json!({"format":"zolana-original-copy-provenance-072-v1",
+        "status":"passed", "access_type":"ReadOnly", "writes_requested":false,
+        "accounts_or_bank_loaded":false, "ancestry_source_sha256":ANCESTRY_SOURCE_SHA256,
+        "owner_uid":COPY_OWNER,"directory_mode":"0700","deadline_seconds":30,
+        "peers":peers, "archive_verification":false,
+        "scope":"Retained Blockstore metadata proof; independent verified archive restore and live native audit remain required"}))
+}
+
+fn main() {
+    let began = Instant::now();
+    let deadline = began + BUDGET;
+    let cancelled = Arc::new(AtomicBool::new(false));
+    for signal in [signal_hook::consts::SIGINT, signal_hook::consts::SIGTERM] {
+        if signal_hook::flag::register(signal, Arc::clone(&cancelled)).is_err() {
+            println!(
+                "{}",
+                json!({"status":"failed","error":"cancellation signal registration failed"})
+            );
+            std::process::exit(1);
+        }
+    }
+    // A hard wall-clock guard also covers a blocked filesystem/RocksDB open.
+    // Normal completion disarms and joins it before emitting the sole result.
+    let (disarm, receiver) = mpsc::channel();
+    let watchdog = thread::spawn(move || {
+        if receiver
+            .recv_timeout(deadline.saturating_duration_since(Instant::now()))
+            .is_err()
+        {
+            println!(
+                "{}",
+                json!({"status":"failed","error":"protected-copy provenance30s deadline","archive_verification":false})
+            );
+            std::process::exit(124);
+        }
+    });
+    let result = run(deadline, &cancelled);
+    let _ = disarm.send(());
+    if watchdog.join().is_err() {
+        std::process::exit(1);
+    }
+    match result {
+        Ok(mut value) => {
+            value["elapsed_ms"] = json!(began.elapsed().as_secs_f64() * 1000.0);
+            println!("{value}");
+        }
+        Err(error) => {
+            // Errors contain public paths/metadata only; no key files are read.
+            println!(
+                "{}",
+                json!({"status":"failed","error":error.to_string(),
+                "elapsed_ms":began.elapsed().as_secs_f64()*1000.0,
+                "archive_verification":false})
+            );
+            std::process::exit(1);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use solana_ledger::blockstore_meta::SlotMeta;
+
+    fn root(store: &Blockstore, slot: u64, hash: &str, parent: Option<u64>) {
+        store
+            .put_meta(
+                slot,
+                &SlotMeta {
+                    slot,
+                    parent_slot: parent,
+                    consumed: 1,
+                    last_index: Some(0),
+                    ..SlotMeta::default()
+                },
+            )
+            .unwrap();
+        store.set_roots([slot].iter()).unwrap();
+        store
+            .insert_optimistic_slot(slot, &hash.parse().unwrap(), 0)
+            .unwrap();
+    }
+
+    #[test]
+    fn provenance_requires_both_exact_root_certificates_and_full_metadata() {
+        let directory = solana_ledger::get_tmp_ledger_path_auto_delete!();
+        let store = Blockstore::open(directory.path()).unwrap();
+        let cancelled = AtomicBool::new(false);
+        root(&store, ORIGINAL_ROOT, ORIGINAL_HASH, None);
+        root(&store, COMMON_ROOT, COMMON_HASH, Some(ORIGINAL_ROOT));
+        let deadline = Instant::now() + BUDGET;
+        let proof = verify_store(&store, deadline, &cancelled).unwrap();
+        assert_eq!(proof["ancestry"]["entries"], 2);
+        let wrong = solana_sha256_hasher::hash(b"conflicting certified hash");
+        store
+            .insert_optimistic_slot(COMMON_ROOT, &wrong, 0)
+            .unwrap();
+        assert!(verify_store(&store, deadline, &cancelled).is_err());
+        store
+            .insert_optimistic_slot(COMMON_ROOT, &COMMON_HASH.parse().unwrap(), 0)
+            .unwrap();
+        store
+            .put_meta(
+                COMMON_ROOT,
+                &SlotMeta {
+                    slot: COMMON_ROOT,
+                    parent_slot: Some(ORIGINAL_ROOT),
+                    ..SlotMeta::default()
+                },
+            )
+            .unwrap();
+        assert!(verify_store(&store, deadline, &cancelled).is_err());
+    }
+
+    #[test]
+    fn provenance_rejects_missing_ancestry_despite_exact_root_certificates() {
+        let directory = solana_ledger::get_tmp_ledger_path_auto_delete!();
+        let store = Blockstore::open(directory.path()).unwrap();
+        root(&store, ORIGINAL_ROOT, ORIGINAL_HASH, None);
+        root(&store, COMMON_ROOT, COMMON_HASH, Some(100));
+        assert!(verify_store(&store, Instant::now() + BUDGET, &AtomicBool::new(false)).is_err());
+    }
+
+    #[test]
+    fn provenance_preserves_shared_deadline_and_cancellation() {
+        let directory = solana_ledger::get_tmp_ledger_path_auto_delete!();
+        let store = Blockstore::open(directory.path()).unwrap();
+        let expired = verify_store(&store, Instant::now(), &AtomicBool::new(false)).unwrap_err();
+        assert!(matches!(
+            expired.downcast_ref::<ancestry::AncestryError>(),
+            Some(ancestry::AncestryError::Deadline)
+        ));
+        let cancelled =
+            verify_store(&store, Instant::now() + BUDGET, &AtomicBool::new(true)).unwrap_err();
+        assert!(matches!(
+            cancelled.downcast_ref::<ancestry::AncestryError>(),
+            Some(ancestry::AncestryError::Cancelled)
+        ));
+    }
+}
