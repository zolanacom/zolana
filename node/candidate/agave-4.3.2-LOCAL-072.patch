+//! Real archive loading and bounded replay tails for the original ledger only.
+//! Never creates a genesis, advances the immutable resume checkpoint, prunes
+//! Blockstore, or accepts a filename as cryptographic snapshot verification.
+use {
+    agave_snapshots::{
+        SnapshotInterval,
+        paths::get_highest_full_snapshot_archive_info,
+        snapshot_archive_info::SnapshotArchiveInfoGetter,
+        snapshot_config::{SnapshotConfig, SnapshotUsage},
+    },
+    anyhow::{Context, Result, ensure},
+    solana_core::validator::{ValidatorConfig, is_snapshot_config_valid},
+    solana_ledger::{
+        blockstore_options::BlockstoreCleanupStrategy,
+        use_snapshot_archives_at_startup::UseSnapshotArchivesAtStartup,
+    },
+    std::{
+        fs::{self, DirBuilder, File},
+        io::ErrorKind,
+        num::{NonZeroU64, NonZeroUsize},
+        os::unix::fs::{DirBuilderExt, MetadataExt, PermissionsExt},
+        path::{Path, PathBuf},
+    },
+};
+
+// Upstream SnapshotController schedules by rooted bank.block_height(), not
+// elapsed seconds. Bound replay work without tying correctness to slot timing.
+const FULL_INTERVAL_BLOCKS: u64 = 1_024;
+const RETAIN_FULL: usize = 2;
+const DIRECTORY: &str = "native-snapshots";
+
+fn paths(ledger: &Path) -> (PathBuf, PathBuf, PathBuf, PathBuf) {
+    let root = ledger.join(DIRECTORY);
+    let full = root.join("full");
+    let incremental = root.join("incremental");
+    let bank = root.join("bank");
+    (root, full, incremental, bank)
+}
+
+fn owned_directory(path: &Path, owner: u32) -> Result<()> {
+    let meta = fs::symlink_metadata(path)?;
+    ensure!(
+        meta.is_dir()
+            && !meta.file_type().is_symlink()
+            && meta.uid() == owner
+            && meta.permissions().mode() & 0o077 == 0
+            && path.canonicalize()? == path,
+        "snapshot directory must be original-owner, real and mode0700: {}",
+        path.display()
+    );
+    Ok(())
+}
+
+fn prepare_directory(path: &Path, owner: u32) -> Result<()> {
+    match DirBuilder::new().mode(0o700).create(path) {
+        Ok(()) => {
+            File::open(path.parent().context("snapshot parent missing")?)?.sync_all()?;
+        }
+        Err(error) if error.kind() == ErrorKind::AlreadyExists => {}
+        Err(error) => return Err(error.into()),
+    }
+    owned_directory(path, owner)
+}
+
+fn expected(ledger: &Path) -> SnapshotConfig {
+    let (_, full, incremental, bank) = paths(ledger);
+    SnapshotConfig {
+        usage: SnapshotUsage::LoadAndGenerate,
+        full_snapshot_archive_interval: SnapshotInterval::Slots(
+            NonZeroU64::new(FULL_INTERVAL_BLOCKS).unwrap(),
+        ),
+        incremental_snapshot_archive_interval: SnapshotInterval::Disabled,
+        full_snapshot_archives_dir: full,
+        incremental_snapshot_archives_dir: incremental,
+        bank_snapshots_dir: bank,
+        maximum_full_snapshot_archives_to_retain: NonZeroUsize::new(RETAIN_FULL).unwrap(),
+        // Buffered I/O avoids requiring extra memlock/io_uring permissions in
+        // the existing sandbox. Hash/account verification remains unchanged.
+        use_direct_io: false,
+        use_registered_io_uring_buffers: false,
+        ..SnapshotConfig::default()
+    }
+}
+
+fn full_only_inputs(ledger: &Path) -> Result<()> {
+    let (_, full, incremental, _) = paths(ledger);
+    // Disabling incremental generation does not disable upstream incremental
+    // loading. This policy accepts no incremental or downloaded input at all.
+    ensure!(
+        fs::read_dir(&incremental)?.next().is_none(),
+        "full-only original-ledger recovery refuses unexpected incremental input"
+    );
+    ensure!(
+        matches!(fs::symlink_metadata(full.join("remote")),
+        Err(error) if error.kind() == ErrorKind::NotFound),
+        "original-ledger recovery refuses a remote snapshot input directory"
+    );
+    Ok(())
+}
+
+pub(super) fn validate_configuration(config: &ValidatorConfig, ledger: &Path) -> Result<()> {
+    let value = &config.snapshot_config;
+    let wanted = expected(ledger);
+    ensure!(
+        value.usage == wanted.usage
+            && value.full_snapshot_archive_interval == wanted.full_snapshot_archive_interval
+            && value.incremental_snapshot_archive_interval == SnapshotInterval::Disabled
+            && value.full_snapshot_archives_dir == wanted.full_snapshot_archives_dir
+            && value.incremental_snapshot_archives_dir == wanted.incremental_snapshot_archives_dir
+            && value.bank_snapshots_dir == wanted.bank_snapshots_dir
+            && value.maximum_full_snapshot_archives_to_retain
+                == wanted.maximum_full_snapshot_archives_to_retain
+            && !value.use_direct_io
+            && !value.use_registered_io_uring_buffers
+            && config.use_snapshot_archives_at_startup == UseSnapshotArchivesAtStartup::Always
+            && config.run_verification
+            && matches!(
+                &config.blockstore_cleanup_strategy,
+                BlockstoreCleanupStrategy::None
+            )
+            && is_snapshot_config_valid(value),
+        "original-ledger snapshot load/generation/verification policy differs"
+    );
+    full_only_inputs(ledger)?;
+    Ok(())
+}
+
+pub(super) fn configure(
+    config: &mut ValidatorConfig,
+    ledger: &Path,
+    original_root: u64,
+) -> Result<()> {
+    let meta = fs::symlink_metadata(ledger)?;
+    ensure!(
+        meta.is_dir() && !meta.file_type().is_symlink() && ledger.canonicalize()? == ledger,
+        "snapshot binding requires the real existing original ledger"
+    );
+    ensure!(
+        config.run_verification
+            && matches!(
+                &config.blockstore_cleanup_strategy,
+                BlockstoreCleanupStrategy::None
+            ),
+        "snapshot recovery must retain verification and all Blockstore history"
+    );
+    let (root, full, incremental, bank) = paths(ledger);
+    for path in [&root, &full, &incremental, &bank] {
+        prepare_directory(path, meta.uid())?;
+    }
+    full_only_inputs(ledger)?;
+    // Upstream otherwise falls back to genesis if no archive is found, even
+    // with Always. Require a reviewed bootstrap instead of another long replay.
+    let archive = get_highest_full_snapshot_archive_info(&full)
+        .context("original ledger has no complete full snapshot archive; prepare and verify its protected-copy bootstrap first")?;
+    let file = fs::symlink_metadata(archive.path())?;
+    ensure!(
+        file.is_file()
+            && !file.file_type().is_symlink()
+            && file.uid() == meta.uid()
+            && file.permissions().mode() & 0o022 == 0
+            && file.len() > 0
+            && archive.path().canonicalize()? == *archive.path()
+            && archive.path().parent() == Some(full.as_path())
+            && archive.slot() >= original_root,
+        "snapshot archive is unsafe or predates the unchanged original checkpoint"
+    );
+    // This checks metadata only. Validator::new still performs the ordinary
+    // archive/accounts/hash validation and full canonical Blockstore tail replay.
+    config.snapshot_config = expected(ledger);
+    config.use_snapshot_archives_at_startup = UseSnapshotArchivesAtStartup::Always;
+    validate_configuration(config, ledger)?;
+    eprintln!(
+        "{}",
+        serde_json::json!({"event":"original_snapshot_archive_selected",
+        "ledger":ledger, "slot":archive.slot(), "snapshot_hash":archive.hash().0.to_string(),
+        "full_interval_blocks":FULL_INTERVAL_BLOCKS, "retain_full":RETAIN_FULL,
+        "incremental_generation":false, "startup":"always", "verification":true,
+        "immutable_checkpoint":original_root, "blockstore_pruning":false})
+    );
+    Ok(())
+}
