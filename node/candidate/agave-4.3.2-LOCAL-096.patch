+    #[test]
+    fn bounded_private_reads_refuse_symlinks_hardlinks_and_oversize() {
+        let root = std::env::temp_dir().join(format!(
+            "zolana096-public-read-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        DirBuilder::new().mode(0o700).create(&root).unwrap();
+        let path = root.join("public");
+        let mut file = OpenOptions::new()
+            .create_new(true)
+            .write(true)
+            .mode(0o600)
+            .open(&path)
+            .unwrap();
+        file.write_all(b"public-only").unwrap();
+        drop(file);
+        let owner = unsafe { libc::geteuid() };
+        assert_eq!(private_bytes(&path, owner, 20).unwrap(), b"public-only");
+        assert!(private_bytes(&path, owner, 4).is_err());
+        let linked = root.join("symlink");
+        symlink(&path, &linked).unwrap();
+        assert!(private_bytes(&linked, owner, 20).is_err());
+        let hard = root.join("hardlink");
+        fs::hard_link(&path, &hard).unwrap();
+        assert!(private_bytes(&path, owner, 20).is_err());
+        fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn certified_head_walk_requires_strict_complete_parent_path() {
+        let end = Instant::now() + Duration::from_secs(1);
+        assert_eq!(
+            certified_head(100, 44, end, |s| Ok(Some(s - 1)), |s| Ok(s == 98)).unwrap(),
+            98
+        );
+        assert!(certified_head(100, 44, end, |_| Ok(None), |_| Ok(false)).is_err());
+        assert!(certified_head(100, 44, end, |s| Ok(Some(s)), |_| Ok(false)).is_err());
+        assert!(certified_head(100, 44, end, |s| Ok(Some(s + 1)), |_| Ok(false)).is_err());
+        assert!(
+            certified_head(
+                100,
+                44,
+                end,
+                |_| anyhow::bail!("source read failed"),
+                |_| Ok(false)
+            )
+            .is_err()
+        );
+    }
+    #[test]
+    fn certified_head_walk_obeys_deadline_and_original_boundary() {
+        assert!(
+            certified_head(100, 44, Instant::now(), |s| Ok(Some(s - 1)), |_| Ok(true)).is_err()
+        );
+        assert!(
+            certified_head(
+                44,
+                44,
+                Instant::now() + Duration::from_secs(1),
+                |_| Ok(None),
+                |_| Ok(true)
+            )
+            .is_err()
+        );
+        assert!(
+            certified_head(
+                45,
+                44,
+                Instant::now() + Duration::from_secs(1),
+                |_| Ok(Some(44)),
+                |_| Ok(false)
+            )
+            .is_err()
+        );
+    }
+    #[test]
+    fn published_manifest_requires_independent_sha_and_full_v2_binding() {
+        let binding = binding();
+        let value = json!({"format":"zolana095-native-ancestry-indexed-zstd-v2","binding":binding,
+            "codec":"zstd-one-frame-level-1","record_count":520000,
+            "encoded_metadata_bytes":30000000,"decoded_metadata_bytes":2000000000u64});
+        let raw = serde_json::to_vec(&value).unwrap();
+        let pin = solana_sha256_hasher::hash(&raw).to_bytes();
+        manifest_evidence(&raw, pin, &binding).unwrap();
+        assert!(manifest_evidence(&raw, [0; 32], &binding).is_err());
+        let mut changed = binding.clone();
+        changed.snapshot_slot = 521_532;
+        assert!(manifest_evidence(&raw, pin, &changed).is_err());
+        let mut value = value;
+        value["record_count"] = json!(1_048_577);
+        let raw = serde_json::to_vec(&value).unwrap();
+        let pin = solana_sha256_hasher::hash(&raw).to_bytes();
+        assert!(manifest_evidence(&raw, pin, &binding).is_err());
+    }
+    #[test]
+    fn metadata_export_domain_keeps_original_and_older_snapshot_bounds() {
+        let binding = binding();
+        assert_eq!(binding.original.slot, 44);
+        assert_eq!(binding.snapshot_slot, SNAPSHOT_SLOTS[0]);
+        assert!(
+            binding.original.slot <= binding.prune_through
+                && binding.prune_through < binding.head.slot
+                && binding.head.slot <= binding.snapshot_parent_slot
+                && binding.snapshot_parent_slot < binding.snapshot_slot
+                && binding.snapshot_slot < SNAPSHOT_SLOTS[1]
+                && SNAPSHOT_SLOTS[1] <= binding.captured_current_root_slot
+                && binding.prune_through < CANONICAL_SLOT
+        );
+        for identity in IDENTITIES {
+            bytes32(identity).unwrap();
+        }
+        for voter in VOTERS {
+            bytes32(voter).unwrap();
+        }
+        bytes32(GENESIS).unwrap();
+        bytes32(ORIGINAL_BANK).unwrap();
+        bytes32(CANONICAL_BLOCKHASH).unwrap();
+    }
