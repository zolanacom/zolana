+    }
+    fn binding() -> ancestry_archive::ArchiveBinding {
+        let root = ancestry_archive::RootEvidence {
+            slot: ORIGINAL_SLOT,
+            is_root: true,
+            certified_bank_hash: [3; 32],
+            certified_timestamp: 1,
+            replay_bank_hash: None,
+        };
+        ancestry_archive::ArchiveBinding {
+            domain: ancestry_archive::Domain {
+                network: [67; 32],
+                genesis_hash: bytes32(GENESIS).unwrap(),
+                identity: bytes32(IDENTITIES[0]).unwrap(),
+                voter: bytes32(VOTERS[0]).unwrap(),
+                resume_sha256: [4; 32],
+                ledger_relative_path: LEDGERS[0].into(),
+            },
+            original: root.clone(),
+            head: ancestry_archive::RootEvidence {
+                slot: 520_507,
+                ..root
+            },
+            prune_through: 520_506,
+            snapshot_parent_slot: 520_507,
+            snapshot_slot: 520_508,
+            captured_current_root_slot: 522_202,
+            canonical_export_through: 522_202,
+        }
+    }
