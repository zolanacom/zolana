+//! Fixed paused-pilot FULL SlotMeta preparation into a fresh RAM namespace.
+//! No validator, replay, account, key, signed-history or retention-policy API.
+//! Stopped actors, key inaccessibility and read-only source mounts are external gates.
+use {
+    crate::{ancestry, ancestry_archive},
+    anyhow::{Context, Result, ensure},
+    serde_json::{Value, json},
+    solana_genesis_config::GenesisConfig,
+    solana_ledger::{
+        blockstore::Blockstore,
+        blockstore_options::{AccessType, BlockstoreOptions},
+    },
+    solana_pubkey::Pubkey,
+    solana_transaction_status::ConfirmedBlock,
+    std::{
+        fs::{self, DirBuilder, File, OpenOptions},
+        io::{Read, Write},
+        os::unix::fs::{DirBuilderExt, MetadataExt, OpenOptionsExt},
+        path::Path,
+        time::{Duration, Instant},
+    },
+};
+
