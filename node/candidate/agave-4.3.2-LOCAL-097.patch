+fn generated_path(value: &str) -> bool {
+    if account_or_bank_path(value) {
+        return true;
+    }
+    let p = Path::new(value);
+    for ledger in LEDGERS {
+        if p.parent() == Some(Path::new(ledger).join("native-snapshots/full").as_path()) {
+            let Some(name) = p.file_name().and_then(|s| s.to_str()) else {
+                return false;
+            };
+            if SNAPSHOTS.contains(&name) {
+                return false;
+            }
+            let Some(stem) = [".tar.zst", ".tar.bz2", ".tar.gz", ".tar.lz4"]
+                .iter()
+                .find_map(|suffix| name.strip_suffix(suffix))
+            else {
+                return false;
+            };
+            let Some(rest) = stem.strip_prefix("snapshot-") else {
+                return false;
+            };
+            let Some((slot, hash)) = rest.split_once('-') else {
+                return false;
+            };
+            return slot
+                .parse::<u64>()
+                .is_ok_and(|s| s > 521_532 && s.to_string() == slot)
+                && hash.parse::<solana_pubkey::Pubkey>().is_ok();
+        }
+    }
+    false
+}
+fn validate_provenance(p: &Provenance) -> Result<()> {
+    ensure!(
+        p.format == "zolana097-isolated-unpruned-copy-view-v1"
+            && p.resume_sha256 == RESUME
+            && p.ram_max_bytes == RAM_BYTES,
+        "fixed unpruned copy provenance differs"
+    );
+    valid_pin(&p.overlay_canary_receipt_sha256)?;
+    ensure!(
+        p.overlay_canary_receipt_sha256 != "0".repeat(64),
+        "actual overlay canary receipt required"
+    );
+    for n in [
+        p.namespace.mount,
+        p.namespace.network,
+        p.namespace.host_mount,
+        p.namespace.host_network,
+        p.source_root,
+        p.copy_root,
+        p.ram_root,
+    ] {
+        ensure!(n.valid(), "zero copy/namespace identity");
+    }
+    ensure!(
+        p.namespace.mount != p.namespace.host_mount
+            && p.namespace.network != p.namespace.host_network,
+        "host mount/network namespace is not an isolated copy"
+    );
+    ensure!(
+        p.source_root.device != p.copy_root.device
+            && p.copy_root.device == p.ram_root.device
+            && p.source_root != p.copy_root,
+        "copy root aliases original device/inode"
+    );
+    ensure!(
+        p.peers.len() == 3
+            && p.files.len() >= mandatory_paths().len()
+            && p.files.len() <= MAX_FILES,
+        "copy peer/file count differs"
+    );
+    let mut names = BTreeSet::new();
+    let mut ids = BTreeSet::new();
+    let mut origins = BTreeSet::new();
+    let mut total = 0u64;
+    let mandatory = mandatory_paths();
+    let mut groups: BTreeMap<Identity, Vec<&InputFile>> = BTreeMap::new();
+    for f in &p.files {
+        relative(&f.relative)?;
+        valid_pin(&f.sha256)?;
+        ensure!(
+            names.insert(f.relative.clone()) && f.identity.valid(),
+            "duplicate copy path or zero identity"
+        );
+        ensure!(
+            f.identity.device == p.copy_root.device && f.bytes <= MAX_FILE_BYTES,
+            "copy file size/device differs"
+        );
+        match (f.origin, f.source_identity) {
+            (Origin::Copied, Some(source)) => {
+                ensure!(
+                    source.valid() && source.device == p.source_root.device && source != f.identity,
+                    "copied file source alias/device differs"
+                );
+                origins.insert(source);
+            }
+            (Origin::Generated, None) => ensure!(
+                !mandatory.contains(&f.relative) && generated_path(&f.relative),
+                "generated origin cannot replace original authority/input"
+            ),
+            _ => anyhow::bail!("explicit copied/generated origin differs"),
+        }
+        ids.insert(f.identity);
+        groups.entry(f.identity).or_default().push(f);
+        total = total
+            .checked_add(f.bytes)
+            .context("copy byte count overflow")?;
+    }
+    for files in groups.values() {
+        if files.len() > 1 {
+            ensure!(
+                files.iter().all(|f| account_or_bank_path(&f.relative)
+                    && f.bytes == files[0].bytes
+                    && f.sha256 == files[0].sha256),
+                "new mutable hardlinks escape complete account/bank alias group"
+            );
+        }
+    }
+    ensure!(
+        total <= MAX_TOTAL_BYTES
+            && ids.is_disjoint(&origins)
+            && mandatory_paths().is_subset(&names),
+        "copy small-file total/mandatory inputs/aliases differ"
+    );
+    let resume = p
+        .files
+        .iter()
+        .find(|f| f.relative == "resume.json")
+        .unwrap();
+    ensure!(
+        resume.sha256 == RESUME,
+        "copied original resume bytes differ"
+    );
+    let mut dirs = BTreeSet::from([p.copy_root, p.ram_root]);
+    for (i, peer) in p.peers.iter().enumerate() {
+        ensure!(
+            peer.identity == IDENTITIES[i] && peer.lower_identity.device == p.source_root.device,
+            "copy peer/lower identity differs"
+        );
+        for d in [peer.upper_identity, peer.work_identity] {
+            ensure!(
+                d.valid() && d.device == p.ram_root.device && dirs.insert(d),
+                "upper/work alias or device differs"
+            );
+        }
+    }
+    Ok(())
+}
