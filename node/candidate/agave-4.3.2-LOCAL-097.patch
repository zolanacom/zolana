+    let f = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW)
+        .open(path)?;
+    let m = f.metadata()?;
+    ensure!(
+        Identity::of(&f)? == expected && m.is_dir() && m.uid() == owner && m.mode() & 0o777 == mode,
+        "copy directory identity/owner/mode differs"
