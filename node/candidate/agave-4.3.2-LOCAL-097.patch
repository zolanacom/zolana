+fn hex(bytes: &[u8; 32]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
+
+fn bytes32(value: &str) -> Result<[u8; 32]> {
+    Ok(value.parse::<Pubkey>()?.to_bytes())
+}
+
+fn deadline(end: Instant) -> Result<()> {
+    ensure!(
+        Instant::now() < end,
+        "fixed SSD verification deadline exceeded"
+    );
+    Ok(())
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Mode {
+    Verify,
+    CrashHold,
+}
+fn selected(args: &[String]) -> Result<Option<Mode>> {
+    let present = args.iter().any(|arg| arg == FLAG || arg == HOLD_FLAG);
+    if !present {
+        return Ok(None);
+    }
+    ensure!(
+        args.len() == 1,
+        "SSD verification takes only one fixed diagnostic flag"
+    );
+    match args[0].as_str() {
+        FLAG => Ok(Some(Mode::Verify)),
+        HOLD_FLAG => Ok(Some(Mode::CrashHold)),
+        _ => anyhow::bail!("fixed SSD mode required"),
+    }
+}
+
+fn directory(path: &Path, owner: u32, private: bool) -> Result<()> {
+    let meta = fs::symlink_metadata(path)?;
+    ensure!(
+        path.canonicalize()? == path
+            && meta.is_dir()
+            && !meta.file_type().is_symlink()
+            && meta.uid() == owner
+            && meta.mode() & (if private { 0o077 } else { 0o022 }) == 0,
+        "fixed canonical owned directory required"
+    );
+    Ok(())
+}
+
+// Bounded public files only. Record identity before and after reading; never
+// follow links or accept multiple links, devices, changing files or an overrun.
+fn private_bytes(path: &Path, owner: u32, maximum: u64) -> Result<Vec<u8>> {
+    let mut file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(path)?;
+    let meta = file.metadata()?;
+    ensure!(
+        path.canonicalize()? == path
+            && meta.is_file()
+            && meta.uid() == owner
+            && meta.nlink() == 1
+            && meta.mode() & 0o077 == 0
+            && meta.len() > 0
+            && meta.len() <= maximum,
+        "fixed bounded single-link private public file required"
+    );
+    let mut raw = Vec::new();
+    Read::by_ref(&mut file)
+        .take(maximum + 1)
+        .read_to_end(&mut raw)?;
+    let after = file.metadata()?;
+    ensure!(
+        raw.len() as u64 == meta.len()
+            && (
+                meta.dev(),
+                meta.ino(),
+                meta.len(),
+                meta.mode(),
+                meta.uid(),
+                meta.nlink(),
+                meta.mtime(),
+                meta.mtime_nsec(),
+                meta.ctime(),
+                meta.ctime_nsec()
+            ) == (
+                after.dev(),
+                after.ino(),
+                after.len(),
+                after.mode(),
+                after.uid(),
+                after.nlink(),
+                after.mtime(),
+                after.mtime_nsec(),
+                after.ctime(),
+                after.ctime_nsec()
+            ),
+        "bounded public input changed during read"
+    );
+    Ok(raw)
+}
+
+fn validate_public_resume(value: &Value) -> Result<()> {
+    ensure!(
+        value["genesis_hash"] == GENESIS,
+        "original public genesis differs"
+    );
+    let peers = value["nodes"]
+        .as_array()
+        .context("public peer array missing")?;
+    ensure!(peers.len() == 3, "exact original three peers required");
+    for (i, peer) in peers.iter().enumerate() {
+        ensure!(
+            peer["identity"] == IDENTITIES[i]
+                && peer["voter"] == VOTERS[i]
+                && peer["ledger"] == LEDGERS[i]
+                && peer["root_slot"].as_u64() == Some(ORIGINAL_SLOT)
+                && peer["root_bank_hash"] == ORIGINAL_BANK,
+            "original public identity/voter/ledger/checkpoint differs"
+        );
+    }
+    Ok(())
+}
+
+fn public_resume() -> Result<[u8; 32]> {
+    let raw = private_bytes(&Path::new(ROOT).join("resume.json"), OWNER, 65_536)?;
+    ensure!(
+        hex(&solana_sha256_hasher::hash(&raw).to_bytes()) == RESUME_SHA,
+        "original complete public resume SHA differs"
+    );
+    // Do not load a Manifest, Keypair, signed vote history or any filename
+    // stored in the public JSON. Only fixed public fields are inspected.
+    validate_public_resume(&serde_json::from_slice(&raw)?)?;
+    Ok(solana_sha256_hasher::hash(&raw).to_bytes())
+}
+
+fn fixed_snapshot_inventory(names: &[String], incrementals: usize) -> Result<()> {
+    let mut names = names.to_vec();
+    names.sort();
+    ensure!(
+        names == SNAPSHOT_NAMES.map(str::to_owned) && incrementals == 0,
+        "exact two inventoried full snapshots and no incremental input required"
+    );
+    Ok(())
+}
+
+fn snapshot_pins(ledger: &Path, peer: usize) -> Result<Value> {
+    let snapshots = ledger.join("native-snapshots");
+    let full = snapshots.join("full");
+    let incremental = snapshots.join("incremental");
+    for path in [&snapshots, &full, &incremental] {
+        directory(path, OWNER, false)?;
+    }
+    let names: Vec<String> = fs::read_dir(&full)?
+        .take(3)
+        .map(|entry| {
+            Ok(entry?
+                .file_name()
+                .into_string()
+                .map_err(|_| anyhow::anyhow!("non-UTF8 snapshot filename"))?)
+        })
+        .collect::<Result<_>>()?;
+    fixed_snapshot_inventory(
+        &names,
+        usize::from(fs::read_dir(&incremental)?.next().transpose()?.is_some()),
+    )?;
+    let mut pins = Vec::new();
+    for index in 0..2 {
+        let raw = private_bytes(&full.join(SNAPSHOT_NAMES[index]), OWNER, 1024 * 1024)?;
+        ensure!(
+            raw.len() as u64 == SNAPSHOT_BYTES[peer][index]
+                && hex(&solana_sha256_hasher::hash(&raw).to_bytes()) == SNAPSHOT_SHA[peer][index],
+            "actual snapshot bytes differ from fixed census pin"
+        );
+        pins.push(
+            json!({"filename":SNAPSHOT_NAMES[index],"slot":SNAPSHOT_SLOTS[index],
+            "bytes":raw.len(),"sha256":SNAPSHOT_SHA[peer][index]}),
+        );
+    }
+    Ok(json!(pins))
+}
+
+fn sha32(value: &str) -> Result<[u8; 32]> {
+    ensure!(
+        value.len() == 64
+            && value
+                .bytes()
+                .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b)),
+        "fixed lowercase SHA256 required"
+    );
+    let mut result = [0u8; 32];
+    for (index, pair) in value.as_bytes().chunks_exact(2).enumerate() {
+        result[index] = u8::from_str_radix(std::str::from_utf8(pair)?, 16)?;
+    }
+    Ok(result)
+}
+
+fn emit(value: Value) -> Result<()> {
+    let mut output = stdout().lock();
+    serde_json::to_writer(&mut output, &value)?;
+    output.write_all(b"\n")?;
+    output.flush()?;
+    Ok(())
+}
+
+fn ext4_filesystem(path: &Path) -> Result<i64> {
+    #[cfg(target_os = "linux")]
+    {
+        let name = std::ffi::CString::new(path.as_os_str().as_bytes())?;
+        let mut data = std::mem::MaybeUninit::<libc::statfs>::uninit();
+        ensure!(
+            unsafe { libc::statfs(name.as_ptr(), data.as_mut_ptr()) } == 0,
+            "cannot identify fixed SSD filesystem"
+        );
+        let data = unsafe { data.assume_init() };
+        ensure!(
+            data.f_type == 0xEF53,
+            "fixed SSD load requires ext4, never tmpfs"
+        );
+        Ok(data.f_type as i64)
+    }
+    #[cfg(not(target_os = "linux"))]
+    anyhow::bail!("fixed SSD diagnostic is Linux only")
+}
+
+fn validate_export(raw: &[u8], expected: [u8; 32]) -> Result<Value> {
+    ensure!(
+        raw.len() <= 256 * 1024 && solana_sha256_hasher::hash(raw).to_bytes() == expected,
+        "independent complete SSD export receipt SHA differs"
+    );
+    let value: Value = serde_json::from_slice(raw)?;
+    ensure!(
+        value["format"] == "zolana096-original-pilot-metadata-preparation-v1"
+            && value["status"] == "prepared-and-reloaded"
+            && value["source_root"] == ROOT
+            && value["source_access"] == "ReadOnly"
+            && value["uid"].as_u64() == Some(995)
+            && value["output_root"] == "/dev/shm/zolana-pilot-metadata-096-export-r1/data"
+            && value["original_resume_sha256"] == RESUME_SHA
+            && value["canonical_export_E"].as_u64() == Some(CANONICAL_SLOT)
+            && value["canonical_export_height"].as_u64() == Some(CANONICAL_HEIGHT)
+            && value["canonical_export_blockhash"] == CANONICAL_BLOCKHASH
+            && value["canonical_export_external_sqlite_sha256"] == CANONICAL_SQLITE_SHA
+            && value["canonical_export_external_receipt_sha256"] == CANONICAL_RECEIPT_SHA
+            && value["snapshot_binding_uses_older_slot"].as_u64() == Some(SNAPSHOT_SLOTS[0])
+            && value["peers"]
+                .as_array()
+                .is_some_and(|peers| peers.len() == 3),
+        "fixed original SSD export receipt domain differs"
+    );
+    Ok(value)
+}
+
+fn peer_binding(value: &Value, peer: usize) -> Result<ancestry_archive::ArchiveBinding> {
+    ensure!(
+        peer < 3
+            && value["identity"] == IDENTITIES[peer]
+            && value["ledger"] == LEDGERS[peer]
+            && value["generation"] == GENERATION
+            && value["manifest_sha256"] == MANIFEST_SHA[peer],
+        "fixed SSD peer/generation/manifest differs"
+    );
+    let binding: ancestry_archive::ArchiveBinding =
+        serde_json::from_value(value["binding"].clone())?;
+    let domain = &binding.domain;
+    ensure!(
+        domain.network == zolana_native_check::TEST_SLOT_NETWORK
+            && domain.genesis_hash == bytes32(GENESIS)?
+            && domain.identity == bytes32(IDENTITIES[peer])?
+            && domain.voter == bytes32(VOTERS[peer])?
+            && domain.resume_sha256 == sha32(RESUME_SHA)?
+            && domain.ledger_relative_path == LEDGERS[peer]
+            && binding.original.slot == ORIGINAL_SLOT
+            && binding.original.is_root
+            && binding.original.certified_bank_hash == bytes32(ORIGINAL_BANK)?
+            && binding.head.slot == 520_507
+            && binding.head.is_root
+            && binding.prune_through == 520_506
+            && binding.snapshot_parent_slot == 520_507
+            && binding.snapshot_slot == SNAPSHOT_SLOTS[0]
+            && binding.captured_current_root_slot == CANONICAL_SLOT
+            && binding.canonical_export_through == CANONICAL_SLOT,
+        "fixed complete SSD peer binding differs"
+    );
+    Ok(binding)
+}
+
+fn run(mode: Mode, end: Instant) -> Result<()> {
+    ensure!(
+        unsafe { libc::geteuid() } == OWNER,
+        "fixed keyless UID995 required"
+    );
+    let root = Path::new(ROOT);
+    let ssd = Path::new(OUTPUT);
+    directory(root, OWNER, false)?;
+    directory(ssd, OWNER, true)?;
+    let filesystem = ext4_filesystem(ssd)?;
+    let disk_identity = fs::metadata(ssd)?;
+    let resume_pin = public_resume()?;
+    let raw_export = private_bytes(&ssd.join("export.json"), OWNER, 256 * 1024)?;
+    let export = validate_export(&raw_export, sha32(EXPORT_SHA)?)?;
+    let expected_peers = export["peers"].as_array().context("fixed peers missing")?;
+    emit(
+        json!({"event":"pilot_metadata_ssd_verify_started","pid":std::process::id(),
+        "fixed_ssd_root":OUTPUT,"filesystem_magic":filesystem,"device":disk_identity.dev(),
+        "export_sha256":EXPORT_SHA,"mode":if mode==Mode::CrashHold {"crash-hold"} else {"verify"},
+        "keys_or_signed_history_opened":false,"writes_performed":false}),
+    )?;
+    let mut reports = Vec::new();
+    let mut agreed_bank = None;
+    for peer in 0..3 {
+        let started = Instant::now();
+        let peer_end = end.min(started + Duration::from_secs(180));
+        deadline(peer_end)?;
+        let expected = &expected_peers[peer];
+        let binding = peer_binding(expected, peer)?;
+        ensure!(
+            binding.domain.resume_sha256 == resume_pin,
+            "current public resume pin differs"
+        );
+        let ledger = root.join(LEDGERS[peer]);
+        directory(&ledger, OWNER, false)?;
+        directory(&ledger.join("rocksdb"), OWNER, false)?;
+        ensure!(
+            snapshot_pins(&ledger, peer)? == expected["snapshots"],
+            "live protected snapshot pins differ"
+        );
+        ensure!(
+            GenesisConfig::load(&ledger)?.hash().to_string() == GENESIS,
+            "original genesis differs"
+        );
+        let store = Blockstore::open_with_options(
+            &ledger,
+            BlockstoreOptions {
+                access_type: AccessType::ReadOnly,
+                ..BlockstoreOptions::default()
+            },
+        )?;
+        ensure!(
+            !store.is_primary_access() && store.max_root() == CANONICAL_SLOT,
+            "fixed read-only current source root required"
+        );
+        let current: ancestry_archive::RootEvidence =
+            serde_json::from_value(expected["current_root"].clone())?;
+        ensure!(
+            current.slot == CANONICAL_SLOT
+                && ancestry_archive::capture_root_evidence(&store, CANONICAL_SLOT)? == current
+                && ancestry_archive::capture_root_evidence(&store, ORIGINAL_SLOT)?
+                    == binding.original
+                && ancestry_archive::capture_root_evidence(&store, binding.head.slot)?
+                    == binding.head,
+            "live original/head/current certified evidence differs from fixed SSD receipt"
+        );
+        if let Some(bank) = agreed_bank {
+            ensure!(
+                bank == current.certified_bank_hash,
+                "all-three current BANK hashes differ"
+            );
+        } else {
+            agreed_bank = Some(current.certified_bank_hash);
+        }
+        let block: ConfirmedBlock = store.get_complete_block(CANONICAL_SLOT, true)?.into();
+        ensure!(
+            block.blockhash == CANONICAL_BLOCKHASH && block.block_height == Some(CANONICAL_HEIGHT),
+            "fixed current complete block header differs"
+        );
+        let peer_root = ssd.join(IDENTITIES[peer]);
+        directory(&peer_root, OWNER, true)?;
+        directory(&peer_root.join(GENERATION), OWNER, true)?;
+        let payload = fs::symlink_metadata(peer_root.join(GENERATION).join("prefix.bin"))?;
+        ensure!(
+            payload.dev() == disk_identity.dev(),
+            "SSD payload switched filesystems"
+        );
+        let loaded = ancestry_archive::load(
+            &peer_root,
+            GENERATION,
+            OWNER,
+            sha32(MANIFEST_SHA[peer])?,
+            &binding,
+            peer_end,
+            || false,
+        )?;
+        loaded.check_original_root(&store, ORIGINAL_SLOT, bytes32(ORIGINAL_BANK)?)?;
+        let full =
+            ancestry::verify_path(&store, CANONICAL_SLOT, ORIGINAL_SLOT, peer_end, || false)?;
+        let merged = loaded.verify(&store, CANONICAL_SLOT, peer_end, || false)?;
+        ensure!(
+            full.entries == 521_846 && merged.entries == full.entries,
+            "fresh SSD live/loaded complete ancestry count differs"
+        );
+        ensure!(
+            snapshot_pins(&ledger, peer)? == expected["snapshots"]
+                && store.max_root() == CANONICAL_SLOT
+                && ancestry_archive::capture_root_evidence(&store, CANONICAL_SLOT)? == current,
+            "original source changed during SSD load"
+        );
+        public_resume()?;
+        deadline(peer_end)?;
+        let report = json!({"identity":IDENTITIES[peer],"manifest_sha256":MANIFEST_SHA[peer],
+            "fixed_ssd_peer_root":peer_root,"payload_device":payload.dev(),"payload_inode":payload.ino(),
+            "payload_bytes":payload.len(),"filesystem_magic":filesystem,"head":binding.head,
+            "current_root":current,"original":binding.original,"full_live_entries":full.entries,
+            "fresh_loaded_entries":merged.entries,"fresh_process_pid":std::process::id(),
+            "elapsed_ms":started.elapsed().as_millis(),"keys_or_signed_history_opened":false,
+            "source_writes":false,"ssd_writes":false});
+        emit(json!({"event":"pilot_metadata_ssd_peer_verified","peer":report}))?;
+        reports.push(report);
+        if peer == 0 && mode == Mode::CrashHold {
+            emit(
+                json!({"event":"pilot_metadata_ssd_crash_hold_ready","pid":std::process::id(),
+                "first_peer_fully_loaded_and_verified":true,"manifest_sha256":MANIFEST_SHA[0],
+                "full_live_entries":full.entries,"fresh_loaded_entries":merged.entries,
+                "fixed_ssd_root":OUTPUT,"hold_seconds":10,"writes_performed":false}),
+            )?;
+            let hold_end = Instant::now() + Duration::from_secs(10);
+            while Instant::now() < hold_end {
+                deadline(peer_end)?;
+                std::thread::sleep(Duration::from_millis(50));
+            }
+        }
+    }
+    ensure!(
+        private_bytes(&ssd.join("export.json"), OWNER, 256 * 1024)? == raw_export,
+        "immutable SSD export receipt changed during verification"
+    );
+    public_resume()?;
+    deadline(end)?;
+    emit(json!({"event":"pilot_metadata_ssd_verify_complete",
+        "format":"zolana097-fresh-process-ssd-metadata-verification-v1","status":"verified",
+        "pid":std::process::id(),"ssd_root":OUTPUT,"filesystem_magic":filesystem,
+        "export_sha256":EXPORT_SHA,"peers":reports,"source_access":"ReadOnly",
+        "ssd_files_published_or_changed":false,"keys_or_signed_history_opened":false,
+        "validators_started":false,"retention_policy_written":false,"pruning_performed":false,
+        "ordinary_full_snapshot_load_performed":false,"host_reboot_or_powerloss_tested":false}))
+}
+
+pub(super) fn maybe_run() -> Result<bool> {
+    let Some(mode) = selected(&std::env::args().skip(1).collect::<Vec<_>>())? else {
+        return Ok(false);
+    };
+    run(mode, Instant::now() + LIFETIME)?;
+    Ok(true)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn peer() -> Value {
+        let evidence = ancestry_archive::RootEvidence {
+            slot: ORIGINAL_SLOT,
+            is_root: true,
+            certified_bank_hash: bytes32(ORIGINAL_BANK).unwrap(),
+            certified_timestamp: 1,
+            replay_bank_hash: None,
+        };
+        let binding = ancestry_archive::ArchiveBinding {
+            domain: ancestry_archive::Domain {
+                network: zolana_native_check::TEST_SLOT_NETWORK,
+                genesis_hash: bytes32(GENESIS).unwrap(),
+                identity: bytes32(IDENTITIES[0]).unwrap(),
+                voter: bytes32(VOTERS[0]).unwrap(),
+                resume_sha256: sha32(RESUME_SHA).unwrap(),
+                ledger_relative_path: LEDGERS[0].into(),
+            },
+            original: evidence.clone(),
+            head: ancestry_archive::RootEvidence {
+                slot: 520507,
+                ..evidence
+            },
+            prune_through: 520506,
+            snapshot_parent_slot: 520507,
+            snapshot_slot: 520508,
+            captured_current_root_slot: 522202,
+            canonical_export_through: 522202,
+        };
+        json!({"identity":IDENTITIES[0],"ledger":LEDGERS[0],"generation":GENERATION,
+            "manifest_sha256":MANIFEST_SHA[0],"binding":binding})
+    }
+    #[test]
+    fn ssd_modes_are_fixed_and_reject_live_or_path_arguments() {
+        assert_eq!(selected(&[FLAG.into()]).unwrap(), Some(Mode::Verify));
+        assert_eq!(
+            selected(&[HOLD_FLAG.into()]).unwrap(),
+            Some(Mode::CrashHold)
+        );
+        assert_eq!(selected(&["--service".into()]).unwrap(), None);
+        for argument in [HOLD_FLAG, "--root", "--service", "/tmp/substitute"] {
+            assert!(selected(&[FLAG.into(), argument.into()]).is_err());
+        }
+    }
+    #[test]
+    fn ssd_independent_receipt_pin_is_checked_before_json_or_bindings() {
+        assert!(validate_export(b"not JSON", sha32(EXPORT_SHA).unwrap()).is_err());
+        let raw = serde_json::to_vec(&json!({"format":"other"})).unwrap();
+        assert!(validate_export(&raw, solana_sha256_hasher::hash(&raw).to_bytes()).is_err());
+        for value in [String::from("x"), "G".repeat(64), "00".repeat(33)] {
+            assert!(sha32(&value).is_err());
+        }
+    }
+    #[test]
+    fn ssd_fixed_peer_rejects_manifest_identity_and_genesis_substitution() {
+        peer_binding(&peer(), 0).unwrap();
+        for field in ["identity", "ledger", "generation", "manifest_sha256"] {
+            let mut value = peer();
+            value[field] = json!("substituted");
+            assert!(peer_binding(&value, 0).is_err());
+        }
+        let mut value = peer();
+        value["binding"]["domain"]["genesis_hash"] = json!([0u8; 32].to_vec());
+        assert!(peer_binding(&value, 0).is_err());
+    }
+    #[test]
+    fn ssd_current_original_and_snapshot_bounds_cannot_move() {
+        for field in [
+            "prune_through",
+            "snapshot_parent_slot",
+            "snapshot_slot",
+            "captured_current_root_slot",
+            "canonical_export_through",
+        ] {
+            let mut value = peer();
+            value["binding"][field] = json!(1);
+            assert!(peer_binding(&value, 0).is_err());
+        }
+        let mut value = peer();
+        value["binding"]["original"]["slot"] = json!(45);
+        assert!(peer_binding(&value, 0).is_err());
+        assert!(peer_binding(&peer(), 1).is_err());
+    }
+    #[test]
+    fn ssd_corrupt_unknown_typed_binding_does_not_fallback() {
+        let mut value = peer();
+        value["binding"]["unknown"] = json!(true);
+        assert!(peer_binding(&value, 0).is_err());
+        let mut value = peer();
+        value["binding"]["domain"]["voter"] = json!([1, 2]);
+        assert!(peer_binding(&value, 0).is_err());
+    }
+    #[test]
+    fn ssd_fixed_pins_remain_distinct_and_ram_filesystem_is_refused() {
+        for pin in MANIFEST_SHA {
+            sha32(pin).unwrap();
+        }
+        assert_ne!(MANIFEST_SHA[0], MANIFEST_SHA[1]);
+        assert_ne!(MANIFEST_SHA[1], MANIFEST_SHA[2]);
+        assert_eq!(
+            Path::new(OUTPUT),
+            Path::new("/var/lib/zolana-metadata-096-r1/data")
+        );
+        assert_eq!(SNAPSHOT_SLOTS, [520508, 521532]);
+        assert_eq!(GENERATION, "pilot096-r1");
+        assert!(ext4_filesystem(Path::new("/dev/shm")).is_err());
+    }
+}
