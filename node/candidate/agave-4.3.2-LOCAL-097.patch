+fn public_resume() -> Result<[u8; 32]> {
+    let raw = private_bytes(&Path::new(ROOT).join("resume.json"), OWNER, 65_536)?;
+    ensure!(
+        hex(&solana_sha256_hasher::hash(&raw).to_bytes()) == RESUME_SHA,
+        "original complete public resume SHA differs"
+    );
+    // Do not load a Manifest, Keypair, signed vote history or any filename
+    // stored in the public JSON. Only fixed public fields are inspected.
+    validate_public_resume(&serde_json::from_slice(&raw)?)?;
+    Ok(solana_sha256_hasher::hash(&raw).to_bytes())
+}
