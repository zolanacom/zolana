+        !m.optional.iter().any(|s| s.starts_with("shared:")
+            || s.starts_with("master:")
+            || s.starts_with("propagate_from:")),
+        "copy mount has external propagation"
+    );
+    Ok(())
+}
+fn pinned_mount<'a>(
+    all: &'a BTreeMap<u64, Mount>,
+    pin: &MountPin,
+    point: &Path,
+) -> Result<&'a Mount> {
+    valid_pin(&pin.line_sha256)?;
+    let m = all.get(&pin.mount_id).context("expected mount ID absent")?;
+    ensure!(
+        m.id == pin.mount_id && m.point == point && m.line_sha256 == pin.line_sha256,
+        "actual copy mount record differs"
+    );
+    private_mount(m)?;
+    Ok(m)
+}
+fn directory(path: &Path, expected: Identity, owner: u32, mode: u32) -> Result<File> {
