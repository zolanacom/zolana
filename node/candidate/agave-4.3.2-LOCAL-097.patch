+    #[test]
+    fn published_manifest_requires_independent_sha_and_full_v2_binding() {
+        let binding = binding();
+        let value = json!({"format":"zolana095-native-ancestry-indexed-zstd-v2","binding":binding,
+            "codec":"zstd-one-frame-level-1","record_count":520000,
+            "encoded_metadata_bytes":30000000,"decoded_metadata_bytes":2000000000u64});
+        let raw = serde_json::to_vec(&value).unwrap();
+        let pin = solana_sha256_hasher::hash(&raw).to_bytes();
+        manifest_evidence(&raw, pin, &binding).unwrap();
+        assert!(manifest_evidence(&raw, [0; 32], &binding).is_err());
+        let mut changed = binding.clone();
+        changed.snapshot_slot = 521_532;
+        assert!(manifest_evidence(&raw, pin, &changed).is_err());
+        let mut value = value;
+        value["record_count"] = json!(1_048_577);
+        let raw = serde_json::to_vec(&value).unwrap();
+        let pin = solana_sha256_hasher::hash(&raw).to_bytes();
+        assert!(manifest_evidence(&raw, pin, &binding).is_err());
+    }
+    #[test]
+    fn metadata_export_domain_keeps_original_and_older_snapshot_bounds() {
+        let binding = binding();
+        assert_eq!(binding.original.slot, 44);
+        assert_eq!(binding.snapshot_slot, SNAPSHOT_SLOTS[0]);
+        assert!(
+            binding.original.slot <= binding.prune_through
+                && binding.prune_through < binding.head.slot
+                && binding.head.slot <= binding.snapshot_parent_slot
+                && binding.snapshot_parent_slot < binding.snapshot_slot
+                && binding.snapshot_slot < SNAPSHOT_SLOTS[1]
+                && SNAPSHOT_SLOTS[1] <= binding.captured_current_root_slot
+                && binding.prune_through < CANONICAL_SLOT
+        );
+        for identity in IDENTITIES {
+            bytes32(identity).unwrap();
+        }
+        for voter in VOTERS {
+            bytes32(voter).unwrap();
+        }
+        bytes32(GENESIS).unwrap();
+        bytes32(ORIGINAL_BANK).unwrap();
+        bytes32(CANONICAL_BLOCKHASH).unwrap();
+    }
+}
