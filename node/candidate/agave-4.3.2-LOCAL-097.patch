+fn actual_identity(file: &File, p: &InputFile, links: u64, owner: u32, group: u32) -> Result<()> {
+    let m = file.metadata()?;
+    ensure!(
+        m.is_file()
+            && m.uid() == owner
+            && m.gid() == group
+            && m.mode() & 0o777 == 0o600
+            && m.nlink() == links
+            && m.len() == p.bytes
+            && Identity::of(file)? == p.identity,
+        "copied private input identity/mode/size differs"
+    );
+    Ok(())
+}
+fn open_relative(root: &File, rel: &Path) -> Result<File> {
+    let mut parent = root.try_clone()?;
+    let names: Vec<_> = rel.components().collect();
+    for (i, part) in names.iter().enumerate() {
+        let Component::Normal(name) = part else {
+            anyhow::bail!("non-normal copied path")
+        };
+        let name = CString::new(name.as_bytes())?;
+        let is_dir = i + 1 != names.len();
+        let fd = unsafe {
+            libc::openat(
+                parent.as_raw_fd(),
+                name.as_ptr(),
+                libc::O_RDONLY
+                    | libc::O_NOFOLLOW
+                    | libc::O_NONBLOCK
+                    | libc::O_CLOEXEC
+                    | if is_dir { libc::O_DIRECTORY } else { 0 },
+            )
+        };
+        ensure!(
+            fd >= 0,
+            "open copied input refused: {}",
+            std::io::Error::last_os_error()
+        );
+        let next = unsafe { File::from_raw_fd(fd) };
+        if is_dir {
+            let m = next.metadata()?;
+            ensure!(
+                m.is_dir() && m.uid() == UID && m.gid() == GID && m.mode() & 0o777 == 0o700,
+                "copied parent is not private operator directory"
+            );
+        }
+        parent = next;
+    }
+    Ok(parent)
+}
+fn file_digest(file: &mut File, expected: &InputFile, end: Instant) -> Result<()> {
+    let before = file.metadata()?;
+    let mut total = 0u64;
+    let mut hasher = solana_sha256_hasher::Hasher::default();
+    let mut buf = [0u8; 65536];
+    loop {
+        budget(end)?;
+        let n = file.read(&mut buf)?;
+        if n == 0 {
+            break;
+        }
+        total += n as u64;
+        ensure!(total <= expected.bytes, "copied input grew");
+        hasher.hash(&buf[..n]);
+    }
+    let after = file.metadata()?;
+    ensure!(
+        total == expected.bytes
+            && sha_hex(hasher.result().to_bytes()) == expected.sha256
+            && before.dev() == after.dev()
+            && before.ino() == after.ino()
+            && before.len() == after.len()
+            && before.mtime() == after.mtime()
+            && before.mtime_nsec() == after.mtime_nsec()
+            && before.ctime() == after.ctime()
+            && before.ctime_nsec() == after.ctime_nsec(),
+        "copied input changed or digest differs"
+    );
+    Ok(())
+}
+fn sha_hex(raw: [u8; 32]) -> String {
+    raw.iter().map(|b| format!("{b:02x}")).collect()
+}
+fn tree_files(
+    path: &Path,
+    rel: &Path,
+    files: &mut BTreeSet<String>,
+    dirs: &mut usize,
+    end: Instant,
+) -> Result<()> {
+    budget(end)?;
+    ensure!(
+        rel.components().count() <= 16 && *dirs <= 1024,
+        "copy tree depth/directory bound"
+    );
+    for entry in fs::read_dir(path)? {
+        budget(end)?;
+        let entry = entry?;
+        let next = rel.join(entry.file_name());
+        let metadata = fs::symlink_metadata(entry.path())?;
+        if LEDGERS.iter().any(|l| next == Path::new(l).join("rocksdb")) {
+            ensure!(metadata.is_dir(), "overlay tree point is not directory");
+            continue;
+        }
+        ensure!(
+            !metadata.file_type().is_symlink(),
+            "copy tree symlink refused"
+        );
+        if metadata.is_dir() {
+            ensure!(
+                metadata.uid() == UID && metadata.gid() == GID && metadata.mode() & 0o777 == 0o700,
+                "copy tree directory owner/mode differs"
+            );
+            *dirs += 1;
+            tree_files(&entry.path(), &next, files, dirs, end)?;
+        } else {
+            ensure!(
+                metadata.is_file() && files.len() < MAX_FILES,
+                "copy tree special file/count bound"
+            );
+            files.insert(
+                next.to_str()
+                    .context("UTF8 copy filename required")?
+                    .to_owned(),
+            );
+        }
+    }
+    Ok(())
+}
+
+struct VerifiedCopy {
+    proof_sha256: String,
+    files: usize,
+}
+fn verify_copy(pin: &str) -> Result<VerifiedCopy> {
+    valid_pin(pin)?;
+    let end = Instant::now() + Duration::from_secs(30);
+    ensure!(
+        cfg!(target_os = "linux")
+            && unsafe { libc::getuid() } == UID
+            && unsafe { libc::geteuid() } == UID
+            && unsafe { libc::getgid() } == GID
+            && unsafe { libc::getegid() } == GID,
+        "fixed unprivileged Linux copy operator required"
+    );
+    let proof_path = Path::new(PROOF);
+    ensure!(
+        proof_path.canonicalize()? == proof_path,
+        "provenance path alias"
+    );
+    let file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(proof_path)?;
+    let m = file.metadata()?;
+    ensure!(
+        m.is_file()
+            && m.uid() == 0
+            && m.nlink() == 1
+            && m.mode() & 0o777 == 0o444
+            && m.len() > 0
+            && m.len() <= 128 * 1024,
+        "root-sealed bounded provenance required"
+    );
+    let mut raw = Vec::new();
+    file.take(128 * 1024 + 1).read_to_end(&mut raw)?;
+    ensure!(
+        raw.len() as u64 == m.len() && sha(&raw) == pin,
+        "independent complete provenance pin differs"
+    );
+    let p: Provenance = serde_json::from_slice(&raw)?;
+    validate_provenance(&p)?;
+    ensure!(
+        namespace("/proc/self/ns/mnt")? == p.namespace.mount
+            && namespace("/proc/self/ns/net")? == p.namespace.network,
+        "actual copy namespace differs"
+    );
+    let status = String::from_utf8(read_bounded(Path::new("/proc/self/status"), 65536)?)?;
+    ensure!(
+        status.lines().any(|l| l == "NoNewPrivs:\t1")
+            && ["CapInh", "CapPrm", "CapEff", "CapBnd", "CapAmb"]
+                .iter()
+                .all(|key| status
+                    .lines()
+                    .any(|l| l == format!("{key}:\t0000000000000000"))),
+        "copy operator has effective capabilities or new privileges"
+    );
+    let all = mounts(&read_bounded(
+        Path::new("/proc/self/mountinfo"),
+        256 * 1024,
+    )?)?;
+    let actual_root = File::open("/")?;
+    let namespace_root_mount = pinned_mount(&all, &p.root_mount, Path::new("/"))?;
+    ensure!(
+        mount_id(&actual_root)? == namespace_root_mount.id,
+        "namespace root mount differs"
+    );
+    let ram = directory(Path::new(RAM), p.ram_root, 0, 0o755)?;
+    let ram_mount = pinned_mount(&all, &p.ram_mount, Path::new(RAM))?;
+    ensure!(
+        ram_mount.kind == "tmpfs"
+            && ram_mount.options.contains("rw")
+            && mount_id(&ram)? == ram_mount.id,
+        "actual bounded RAM mount differs"
+    );
+    let mut fsinfo = std::mem::MaybeUninit::<libc::statvfs>::zeroed();
+    ensure!(
+        unsafe { libc::fstatvfs(ram.as_raw_fd(), fsinfo.as_mut_ptr()) } == 0,
+        "RAM capacity query failed"
+    );
+    let fsinfo = unsafe { fsinfo.assume_init() };
+    ensure!(
+        (fsinfo.f_blocks as u128) * (fsinfo.f_frsize as u128) <= RAM_BYTES as u128,
+        "copy RAM filesystem exceeds24GiB cap"
+    );
+    let root = directory(Path::new(ROOT), p.copy_root, UID, 0o700)?;
+    let root_mount = pinned_mount(&all, &p.copy_root_mount, Path::new(ROOT))?;
+    ensure!(
+        root_mount.kind == "tmpfs"
+            && root_mount.options.contains("rw")
+            && mount_id(&root)? == root_mount.id,
+        "visibleROOT is not the approved mutable NEWcopy bind"
+    );
+    for (i, peer) in p.peers.iter().enumerate() {
+        budget(end)?;
+        let ledger = Path::new(ROOT).join(LEDGERS[i]);
+        let point = ledger.join("rocksdb");
+        let mounted = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW)
+            .open(&point)?;
+        let overlay = pinned_mount(&all, &peer.overlay_mount, &point)?;
+        overlay_shape(overlay, i)?;
+        ensure!(
+            mount_id(&mounted)? == overlay.id,
+            "visibleRocksDB is not the approved overlay"
+        );
+        let lower_path = Path::new(BASE).join(format!("lowers/peer-{i}"));
+        let lower = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW)
+            .open(&lower_path)?;
+        let lower_mount = pinned_mount(&all, &peer.lower_mount, &lower_path)?;
+        ensure!(
+            Identity::of(&lower)? == peer.lower_identity
+                && mount_id(&lower)? == lower_mount.id
+                && lower_mount.options.contains("ro")
+                && lower_mount.kind == "ext4"
+                && lower_mount.root == point,
+            "originalRocksDB lower is not the fixed readonly source bind"
+        );
+        directory(
+            &Path::new(RAM).join(format!("upper/peer-{i}")),
+            peer.upper_identity,
+            UID,
+            0o700,
+        )?;
+        directory(
+            &Path::new(RAM).join(format!("work/peer-{i}")),
+            peer.work_identity,
+            UID,
+            0o700,
+        )?;
+    }
+    ensure!(
+        !Path::new(ROOT).join("retention-policy.json").try_exists()?
+            && !Path::new(ROOT)
+                .join(".retention-policy.pending")
+                .try_exists()?,
+        "unprunedcopy forbids every retention policy"
+    );
+    let immutable = immutable_paths();
+    let mut opened = Vec::new();
+    // First prove every descriptor is a disjoint copied input, before hashing any key.
+    for input in &p.files {
+        budget(end)?;
+        let rel = relative(&input.relative)?;
+        let f = open_relative(&root, &rel)?;
+        let links = p
+            .files
+            .iter()
+            .filter(|other| other.identity == input.identity)
+            .count() as u64;
+        actual_identity(&f, input, links, UID, GID)?;
+        let m = all
+            .get(&mount_id(&f)?)
+            .context("copied input actual mount absent")?;
+        private_mount(m)?;
+        ensure!(
+            m.point.starts_with(ROOT),
+            "copied file escaped visibleROOT mount tree"
+        );
+        if immutable.contains(&input.relative) {
+            ensure!(
+                m.options.contains("ro"),
+                "copied key/resume/genesis/snapshot input is not readonly"
+            );
+        }
+        opened.push((input, f));
+    }
+    let mut found = BTreeSet::new();
+    let mut directories = 1;
+    tree_files(
+        Path::new(ROOT),
+        Path::new(""),
+        &mut found,
+        &mut directories,
+        end,
+    )?;
+    ensure!(
+        found == p.files.iter().map(|f| f.relative.clone()).collect(),
+        "copy small-file tree differs from root-pinned manifest"
+    );
+    for (input, mut f) in opened {
+        file_digest(&mut f, input, end)?;
+    }
+    budget(end)?;
+    Ok(VerifiedCopy {
+        proof_sha256: pin.into(),
+        files: p.files.len(),
+    })
+}
+
+fn selected(args: &[String]) -> Result<Option<&str>> {
+    if !args.iter().any(|s| s == FLAG) {
+        return Ok(None);
+    }
+    ensure!(
+        args.len() == 3 && args[0] == FLAG && args[1] == PIN_FLAG,
+        "fixedcopy service takes only its provenanceSHA"
+    );
+    valid_pin(&args[2])?;
+    Ok(Some(&args[2]))
+}
+pub(super) fn maybe_run() -> Result<bool> {
+    let values: Vec<_> = std::env::args().skip(1).collect();
+    let Some(pin) = selected(&values)? else {
+        return Ok(false);
+    };
+    // This MUST precede prepare_root's mutable lock/log access and every key loader.
+    let view = verify_copy(pin)?;
+    let mut args = Args::parse_from(
+        ["--resume-root", ROOT, "--service"]
+            .into_iter()
+            .map(str::to_owned),
+    )?;
+    let mut evidence = prepare_root(&args)?;
+    evidence.event("isolated_unpruned_copy_provenance_verified", json!({"provenance_sha256":view.proof_sha256,"copied_small_files":view.files,"unpruned":true,"original_resume_sha256":RESUME,"funding_or_payment_operations":0}))?;
+    let mut manifest = resume::Manifest::load(&args.root)?;
+    manifest.apply_profile(&mut args)?;
+    ensure!(
+        !args.durable_ancestry_fixture && args.durable_ancestry_config_sha256.is_none(),
+        "oldfixture/policy eligibility cannot enter unprunedcopy service"
+    );
+    configure_environment(&args);
+    service::run(&args, &mut evidence, &manifest)?;
+    Ok(true)
+}
