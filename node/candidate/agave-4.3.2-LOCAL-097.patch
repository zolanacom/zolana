@@ -0,0 +1,300 @@
+//! Fixed disposable genuine-RocksDB OverlayFS diagnostic, never pilot state.
+//! The operator provides a new private lower/upper/work/merged mount namespace.
+//! This utility does not mount, copy keys, launch validators or authorize a pilot copy.
+use {
+    anyhow::{Context, Result, ensure},
+    serde_json::{Value, json},
+    solana_ledger::{
+        blockstore::{Blockstore, blockstore_purge::PurgeType},
+        blockstore_meta::SlotMeta,
+    },
+    std::{
+        fs,
+        io::{Write, stdout},
+        os::unix::fs::MetadataExt,
+        path::{Path, PathBuf},
+        time::{Duration, Instant},
+    },
+};
+
+const FLAG: &str = "--offline-overlay-canary";
+const BASE: &str = "/dev/shm/zolana-ssd-recovery-097-canary-r2";
+const OWNER: u32 = 995;
+const HOLD: Duration = Duration::from_secs(10);
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Mode {
+    Init,
+    MutateHold,
+    PurgeHold,
+    InspectMutated,
+    InspectPurged,
+}
+
+fn name(mode: Mode) -> &'static str {
+    match mode {
+        Mode::Init => "init",
+        Mode::MutateHold => "mutate-hold",
+        Mode::PurgeHold => "purge-hold",
+        Mode::InspectMutated => "inspect-mutated",
+        Mode::InspectPurged => "inspect-purged",
+    }
+}
+
+fn selected(args: &[String]) -> Result<Option<Mode>> {
+    if !args.iter().any(|arg| arg == FLAG) {
+        return Ok(None);
+    }
+    ensure!(
+        args.len() == 2 && args[0] == FLAG,
+        "canary takes one fixed mode only"
+    );
+    Ok(Some(match args[1].as_str() {
+        "init" => Mode::Init,
+        "mutate-hold" => Mode::MutateHold,
+        "purge-hold" => Mode::PurgeHold,
+        "inspect-mutated" => Mode::InspectMutated,
+        "inspect-purged" => Mode::InspectPurged,
+        _ => anyhow::bail!("unknown fixed disposable canary mode"),
+    }))
+}
+
+fn directory(path: &Path) -> Result<()> {
+    let meta = fs::symlink_metadata(path)?;
+    ensure!(
+        path.canonicalize()? == path
+            && meta.is_dir()
+            && !meta.file_type().is_symlink()
+            && meta.uid() == OWNER
+            && meta.mode() & 0o077 == 0,
+        "fixed real private UID995 canary directory required"
+    );
+    Ok(())
+}
+
+fn ledger(mode: Mode) -> PathBuf {
+    Path::new(BASE)
+        .join(if mode == Mode::Init {
+            "lower"
+        } else {
+            "merged"
+        })
+        .join("ledger")
+}
+
+fn full_meta(slot: u64, tag: u64) -> SlotMeta {
+    let mut meta = SlotMeta {
+        slot,
+        parent_slot: (slot > 1).then_some(slot - 1),
+        consumed: 3,
+        received: 3,
+        last_index: Some(2),
+        first_shred_timestamp: tag,
+        ..SlotMeta::default()
+    };
+    meta.completed_data_indexes.insert(2);
+    meta.next_slots.push(slot + 1);
+    meta
+}
+
+fn emit(value: Value) -> Result<()> {
+    let mut output = stdout().lock();
+    serde_json::to_writer(&mut output, &value)?;
+    output.write_all(b"\n")?;
+    output.flush()?;
+    Ok(())
+}
+
+fn initial(store: &Blockstore) -> Result<()> {
+    ensure!(
+        store.meta(1)? == Some(full_meta(1, 101))
+            && store.meta(2)? == Some(full_meta(2, 102))
+            && store.meta(3)?.is_none()
+            && store.is_root(1)
+            && store.is_root(2)
+            && store.max_root() == 2,
+        "exact initial disposable full metadata/root state required"
+    );
+    Ok(())
+}
+
+fn mutated(store: &Blockstore) -> Result<()> {
+    ensure!(
+        store.meta(1)? == Some(full_meta(1, 101))
+            && store.meta(2)? == Some(full_meta(2, 102))
+            && store.meta(3)? == Some(full_meta(3, 903))
+            && store.is_root(1)
+            && store.is_root(2)
+            && store.is_root(3)
+            && store.max_root() == 3,
+        "mutated disposable full metadata/root state differs"
+    );
+    Ok(())
+}
+
+fn purged(store: &Blockstore) -> Result<()> {
+    ensure!(
+        store.meta(1)?.is_none()
+            && store.meta(2)?.is_none()
+            && store.meta(3)? == Some(full_meta(3, 903))
+            && !store.is_root(1)
+            && !store.is_root(2)
+            && store.is_root(3)
+            && store.max_root() == 3,
+        "purged disposable full metadata/root state differs"
+    );
+    Ok(())
+}
+
+fn run(mode: Mode) -> Result<()> {
+    ensure!(
+        unsafe { libc::geteuid() } == OWNER,
+        "fixed UID995 disposable canary required"
+    );
+    let path = ledger(mode);
+    directory(path.parent().context("fixed canary parent missing")?)?;
+    directory(&path)?;
+    if mode == Mode::Init {
+        ensure!(
+            fs::read_dir(&path)?.next().is_none(),
+            "initial canary ledger must be fresh and empty"
+        );
+    } else {
+        directory(&path.join("rocksdb"))?;
+    }
+    let store = Blockstore::open(&path)?;
+    ensure!(
+        store.is_primary_access(),
+        "only new disposable canary may open primary"
+    );
+    match mode {
+        Mode::Init => {
+            store.put_meta(1, &full_meta(1, 101))?;
+            store.put_meta(2, &full_meta(2, 102))?;
+            store.set_roots([1, 2].iter())?;
+            store.flush_overlay_canary_metadata()?;
+            ensure!(
+                store.live_files_metadata()?.len() >= 2,
+                "synchronous metadata/root flush did not produce genuine SSTs"
+            );
+            initial(&store)?;
+        }
+        Mode::MutateHold => {
+            initial(&store)?;
+            store.put_meta(3, &full_meta(3, 903))?;
+            store.set_roots([3].iter())?;
+            mutated(&store)?;
+        }
+        Mode::PurgeHold => {
+            mutated(&store)?;
+            store.purge_slots(0, 2, PurgeType::Exact)?;
+            purged(&store)?;
+        }
+        Mode::InspectMutated => mutated(&store)?,
+        Mode::InspectPurged => purged(&store)?,
+    }
+    if matches!(mode, Mode::MutateHold | Mode::PurgeHold) {
+        emit(
+            json!({"event":"overlay_canary_hold_ready","mode":name(mode),
+            "pid":std::process::id(),"ledger":path,"max_root":store.max_root(),
+            "hold_seconds":10,"full_metadata_verified":true,"pilot_access":false}),
+        )?;
+        let end = Instant::now() + HOLD;
+        while Instant::now() < end {
+            std::thread::sleep(Duration::from_millis(50));
+        }
+    }
+    drop(store); // Init/inspect cleanly close; hold modes remain killable above.
+    emit(json!({"event":"overlay_canary_complete","mode":name(mode),
+        "ledger":path,"pilot_access":false,"keys_read":false,"validators_started":false}))
+}
+
+pub(super) fn maybe_run() -> Result<bool> {
+    let Some(mode) = selected(&std::env::args().skip(1).collect::<Vec<_>>())? else {
+        return Ok(false);
+    };
+    run(mode)?;
+    Ok(true)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn overlay_canary_accepts_only_fixed_modes_without_paths_or_live_flags() {
+        for (name, mode) in [
+            ("init", Mode::Init),
+            ("mutate-hold", Mode::MutateHold),
+            ("purge-hold", Mode::PurgeHold),
+            ("inspect-mutated", Mode::InspectMutated),
+            ("inspect-purged", Mode::InspectPurged),
+        ] {
+            assert_eq!(selected(&[FLAG.into(), name.into()]).unwrap(), Some(mode));
+        }
+        for args in [
+            vec![FLAG.into()],
+            vec![FLAG.into(), "--root".into()],
+            vec![FLAG.into(), "init".into(), "--service".into()],
+            vec!["init".into(), FLAG.into()],
+        ] {
+            assert!(selected(&args).is_err());
+        }
+        assert_eq!(selected(&["--service".into()]).unwrap(), None);
+    }
+    #[test]
+    fn overlay_canary_distinguishes_full_native_metadata_not_parent_projection() {
+        let original = full_meta(3, 103);
+        let mutated = full_meta(3, 903);
+        assert_eq!(original.slot, mutated.slot);
+        assert_eq!(original.parent_slot, mutated.parent_slot);
+        assert_ne!(original, mutated);
+        assert!(mutated.is_full());
+        assert_eq!(mutated.completed_data_indexes.iter().count(), 1);
+    }
+    #[test]
+    fn overlay_canary_genuine_store_reopens_and_preserves_exact_purge() {
+        use std::os::unix::fs::DirBuilderExt;
+        let path = std::env::temp_dir().join(format!(
+            "zolana097-canary-unit-{}-{}",
+            std::process::id(),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        fs::DirBuilder::new().mode(0o700).create(&path).unwrap();
+        let store = Blockstore::open(&path).unwrap();
+        store.put_meta(1, &full_meta(1, 101)).unwrap();
+        store.put_meta(2, &full_meta(2, 102)).unwrap();
+        store.set_roots([1, 2].iter()).unwrap();
+        store.flush_overlay_canary_metadata().unwrap();
+        assert!(store.live_files_metadata().unwrap().len() >= 2);
+        initial(&store).unwrap();
+        drop(store);
+        let readonly = Blockstore::open_with_options(
+            &path,
+            solana_ledger::blockstore_options::BlockstoreOptions {
+                access_type: solana_ledger::blockstore_options::AccessType::ReadOnly,
+                ..solana_ledger::blockstore_options::BlockstoreOptions::default()
+            },
+        )
+        .unwrap();
+        assert!(readonly.flush_overlay_canary_metadata().is_err());
+        assert!(readonly.live_files_metadata().unwrap().len() >= 2);
+        drop(readonly);
+        let store = Blockstore::open(&path).unwrap();
+        initial(&store).unwrap();
+        store.put_meta(3, &full_meta(3, 903)).unwrap();
+        store.set_roots([3].iter()).unwrap();
+        drop(store);
+        let store = Blockstore::open(&path).unwrap();
+        mutated(&store).unwrap();
+        store.purge_slots(0, 2, PurgeType::Exact).unwrap();
+        purged(&store).unwrap();
+        drop(store);
+        let store = Blockstore::open(&path).unwrap();
+        purged(&store).unwrap();
+        drop(store);
+        fs::remove_dir_all(path).unwrap();
+    }
+}
