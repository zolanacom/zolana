+        let mut wrong = names.to_vec();
+        wrong[0].push_str(".other");
+        assert!(fixed_snapshot_inventory(&wrong, 0).is_err());
+        let mut extra = names.to_vec();
+        extra.push("snapshot-600000-substitute.tar.zst".into());
+        assert!(fixed_snapshot_inventory(&extra, 0).is_err());
+        for peer in 0..3 {
+            for pin in SNAPSHOT_SHA[peer] {
+                assert_eq!(pin.len(), 64);
+                assert!(
+                    pin.bytes()
+                        .all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+                );
+            }
+        }
+    }
+    #[test]
+    fn bounded_private_reads_refuse_symlinks_hardlinks_and_oversize() {
+        let root = std::env::temp_dir().join(format!(
+            "zolana096-public-read-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, Ordering::Relaxed)
+        ));
+        DirBuilder::new().mode(0o700).create(&root).unwrap();
+        let path = root.join("public");
+        let mut file = OpenOptions::new()
+            .create_new(true)
+            .write(true)
+            .mode(0o600)
+            .open(&path)
+            .unwrap();
+        file.write_all(b"public-only").unwrap();
+        drop(file);
+        let owner = unsafe { libc::geteuid() };
+        assert_eq!(private_bytes(&path, owner, 20).unwrap(), b"public-only");
+        assert!(private_bytes(&path, owner, 4).is_err());
+        let linked = root.join("symlink");
+        symlink(&path, &linked).unwrap();
+        assert!(private_bytes(&linked, owner, 20).is_err());
+        let hard = root.join("hardlink");
+        fs::hard_link(&path, &hard).unwrap();
+        assert!(private_bytes(&path, owner, 20).is_err());
+        fs::remove_dir_all(root).unwrap();
+    }
+    #[test]
+    fn certified_head_walk_requires_strict_complete_parent_path() {
+        let end = Instant::now() + Duration::from_secs(1);
+        assert_eq!(
+            certified_head(100, 44, end, |s| Ok(Some(s - 1)), |s| Ok(s == 98)).unwrap(),
+            98
+        );
+        assert!(certified_head(100, 44, end, |_| Ok(None), |_| Ok(false)).is_err());
+        assert!(certified_head(100, 44, end, |s| Ok(Some(s)), |_| Ok(false)).is_err());
+        assert!(certified_head(100, 44, end, |s| Ok(Some(s + 1)), |_| Ok(false)).is_err());
+        assert!(
+            certified_head(
+                100,
+                44,
+                end,
+                |_| anyhow::bail!("source read failed"),
+                |_| Ok(false)
+            )
+            .is_err()
+        );
+    }
+    #[test]
+    fn certified_head_walk_obeys_deadline_and_original_boundary() {
+        assert!(
+            certified_head(100, 44, Instant::now(), |s| Ok(Some(s - 1)), |_| Ok(true)).is_err()
+        );
+        assert!(
+            certified_head(
+                44,
+                44,
+                Instant::now() + Duration::from_secs(1),
+                |_| Ok(None),
+                |_| Ok(true)
+            )
+            .is_err()
+        );
+        assert!(
+            certified_head(
+                45,
+                44,
+                Instant::now() + Duration::from_secs(1),
+                |_| Ok(Some(44)),
+                |_| Ok(false)
+            )
