+fn fixed_snapshot_inventory(names: &[String], incrementals: usize) -> Result<()> {
+    let mut names = names.to_vec();
+    names.sort();
+    ensure!(
+        names == SNAPSHOT_NAMES.map(str::to_owned) && incrementals == 0,
+        "exact two inventoried full snapshots and no incremental input required"
+    );
+    Ok(())
+}
