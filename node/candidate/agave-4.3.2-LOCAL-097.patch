+fn snapshot_pins(ledger: &Path, peer: usize) -> Result<Value> {
+    let snapshots = ledger.join("native-snapshots");
+    let full = snapshots.join("full");
+    let incremental = snapshots.join("incremental");
+    for path in [&snapshots, &full, &incremental] {
+        directory(path, OWNER, false)?;
+    }
+    let names: Vec<String> = fs::read_dir(&full)?
+        .take(3)
+        .map(|entry| {
+            Ok(entry?
+                .file_name()
+                .into_string()
+                .map_err(|_| anyhow::anyhow!("non-UTF8 snapshot filename"))?)
+        })
+        .collect::<Result<_>>()?;
+    fixed_snapshot_inventory(
+        &names,
+        usize::from(fs::read_dir(&incremental)?.next().transpose()?.is_some()),
+    )?;
+    let mut pins = Vec::new();
+    for index in 0..2 {
+        let raw = private_bytes(&full.join(SNAPSHOT_NAMES[index]), OWNER, 1024 * 1024)?;
+        ensure!(
+            raw.len() as u64 == SNAPSHOT_BYTES[peer][index]
+                && hex(&solana_sha256_hasher::hash(&raw).to_bytes()) == SNAPSHOT_SHA[peer][index],
+            "actual snapshot bytes differ from fixed census pin"
+        );
+        pins.push(
+            json!({"filename":SNAPSHOT_NAMES[index],"slot":SNAPSHOT_SLOTS[index],
+            "bytes":raw.len(),"sha256":SNAPSHOT_SHA[peer][index]}),
+        );
+    }
+    Ok(json!(pins))
+}
+
+fn certified_head(
+    mut slot: u64,
+    original: u64,
+    end: Instant,
+    mut parent: impl FnMut(u64) -> Result<Option<u64>>,
+    mut certified: impl FnMut(u64) -> Result<bool>,
+) -> Result<u64> {
+    let mut checked = 0usize;
+    loop {
+        deadline(end)?;
+        ensure!(
+            slot > original,
+            "no certified head strictly above immutable checkpoint"
+        );
+        ensure!(
+            checked < ancestry_archive::MAX_INDEXED_RECORDS,
+            "head search exceeds indexed bound"
+        );
+        checked += 1;
+        if certified(slot)? {
+            deadline(end)?;
+            return Ok(slot);
+        }
+        let next = parent(slot)?.context("snapshot parent ancestry is incomplete")?;
+        ensure!(
+            original < next && next < slot,
+            "snapshot parent chain is not strictly above original"
+        );
+        slot = next;
+    }
+}
+
+fn manifest_evidence(
+    raw: &[u8],
+    pin: [u8; 32],
+    binding: &ancestry_archive::ArchiveBinding,
+) -> Result<Value> {
+    ensure!(
+        raw.len() <= 65_536 && solana_sha256_hasher::hash(raw).to_bytes() == pin,
+        "published complete manifest differs from independent pin"
+    );
+    let value: Value = serde_json::from_slice(raw)?;
+    ensure!(
+        value["format"] == "zolana095-native-ancestry-indexed-zstd-v2"
+            && value["binding"] == serde_json::to_value(binding)?
+            && value["codec"] == "zstd-one-frame-level-1"
+            && value["record_count"]
+                .as_u64()
+                .is_some_and(|n| n > 0 && n <= 1_048_576)
+            && value["encoded_metadata_bytes"]
+                .as_u64()
+                .is_some_and(|n| n > 0 && n <= 512 * 1024 * 1024)
+            && value["decoded_metadata_bytes"]
+                .as_u64()
+                .is_some_and(|n| n > 0 && n <= 8 * 1024 * 1024 * 1024),
+        "published full V2 evidence/bounds differ"
+    );
+    Ok(value)
+}
+
+fn new_directory(path: &Path) -> Result<()> {
+    DirBuilder::new().mode(0o700).create(path)?;
+    directory(path, OWNER, true)?;
+    File::open(path.parent().context("output parent missing")?)?.sync_all()?;
+    Ok(())
+}
+
+fn run(end: Instant) -> Result<()> {
+    ensure!(
+        unsafe { libc::geteuid() } == OWNER,
+        "fixed keyless UID995 required"
+    );
+    let root = Path::new(ROOT);
+    let output = Path::new(OUTPUT);
+    directory(root, OWNER, false)?;
+    directory(output, OWNER, true)?;
+    ensure!(
+        fs::read_dir(output)?.next().is_none(),
+        "fresh empty fixed RAM output required; never adopt or overwrite"
+    );
+    let resume_pin = public_resume()?;
+    let mut reports = Vec::new();
+    let mut common_canonical_bank = None;
+    for peer in 0..3 {
+        let started = Instant::now();
+        let peer_end = end.min(started + Duration::from_secs(180));
+        deadline(peer_end)?;
+        let ledger = root.join(LEDGERS[peer]);
+        directory(&ledger, OWNER, false)?;
+        directory(&ledger.join("rocksdb"), OWNER, false)?;
+        let snapshots = snapshot_pins(&ledger, peer)?;
+        ensure!(
+            GenesisConfig::load(&ledger)?.hash().to_string() == GENESIS,
+            "fixed original genesis differs"
+        );
+        let store = Blockstore::open_with_options(
+            &ledger,
+            BlockstoreOptions {
+                access_type: AccessType::ReadOnly,
+                ..BlockstoreOptions::default()
+            },
+        )?;
+        ensure!(
+            !store.is_primary_access(),
+            "true read-only original Blockstore required"
+        );
+        let current = store.max_root();
+        ensure!(
+            current >= CANONICAL_SLOT && SNAPSHOT_SLOTS[1] <= current,
+            "current root does not cover pinned canonical export and snapshots"
+        );
+        let current_evidence = ancestry_archive::capture_root_evidence(&store, current)?;
+        let original = ancestry_archive::capture_root_evidence(&store, ORIGINAL_SLOT)?;
+        ensure!(
+            original.certified_bank_hash == bytes32(ORIGINAL_BANK)?,
+            "immutable original BANK differs"
+        );
+        let canonical = ancestry_archive::capture_root_evidence(&store, CANONICAL_SLOT)?;
+        if let Some(bank) = common_canonical_bank {
+            ensure!(
+                bank == canonical.certified_bank_hash,
+                "all-three canonical E BANK hashes differ"
+            );
+        } else {
+            common_canonical_bank = Some(canonical.certified_bank_hash);
+        }
+        let block: ConfirmedBlock = store.get_complete_block(CANONICAL_SLOT, true)?.into();
+        ensure!(
+            block.blockhash == CANONICAL_BLOCKHASH && block.block_height == Some(CANONICAL_HEIGHT),
+            "fixed complete canonical E blockhash/height differs"
+        );
+        for snapshot_slot in SNAPSHOT_SLOTS {
+            ancestry_archive::capture_root_evidence(&store, snapshot_slot)?;
+            ancestry::verify_path(&store, current, snapshot_slot, peer_end, || false)?;
+        }
+        let snapshot_meta = store
+            .meta(SNAPSHOT_SLOTS[0])?
+            .context("older snapshot full SlotMeta missing")?;
+        ensure!(
+            snapshot_meta.slot == SNAPSHOT_SLOTS[0],
+            "older snapshot SlotMeta identifies another slot"
+        );
+        let parent = snapshot_meta
+            .parent_slot
+            .context("older snapshot canonical parent missing")?;
+        ensure!(
+            ORIGINAL_SLOT < parent && parent < SNAPSHOT_SLOTS[0],
+            "real older snapshot parent bounds differ"
+        );
+        let head = certified_head(
+            parent,
+            ORIGINAL_SLOT,
+            peer_end,
+            |slot| Ok(store.meta(slot)?.map(|meta| meta.parent_slot).flatten()),
+            |slot| Ok(store.is_root(slot) && store.get_optimistic_slot(slot)?.is_some()),
+        )?;
+        let cutoff = head.checked_sub(1).context("head cannot be zero")?;
+        ensure!(
+            ORIGINAL_SLOT <= cutoff && cutoff < CANONICAL_SLOT,
+            "cutoff outside complete canonical E"
+        );
+        let full_path = ancestry::verify_path(&store, current, ORIGINAL_SLOT, peer_end, || false)?;
+        let binding = ancestry_archive::ArchiveBinding {
+            domain: ancestry_archive::Domain {
+                network: zolana_native_check::TEST_SLOT_NETWORK,
+                genesis_hash: bytes32(GENESIS)?,
+                identity: bytes32(IDENTITIES[peer])?,
+                voter: bytes32(VOTERS[peer])?,
+                resume_sha256: resume_pin,
+                ledger_relative_path: LEDGERS[peer].to_owned(),
+            },
+            original,
+            head: ancestry_archive::capture_root_evidence(&store, head)?,
+            prune_through: cutoff,
+            snapshot_parent_slot: parent,
+            snapshot_slot: SNAPSHOT_SLOTS[0],
+            captured_current_root_slot: current,
+            canonical_export_through: CANONICAL_SLOT,
+        };
+        let peer_output = output.join(IDENTITIES[peer]);
+        new_directory(&peer_output)?;
+        let published = ancestry_archive::publish_indexed(
+            &peer_output,
+            GENERATION,
+            OWNER,
+            &binding,
+            &store,
+            peer_end,
+            || false,
+        )?;
+        let loaded = ancestry_archive::load(
+            &peer_output,
+            GENERATION,
+            OWNER,
+            published.manifest_sha256,
+            &binding,
+            peer_end,
+            || false,
+        )?;
+        loaded.check_original_root(&store, ORIGINAL_SLOT, bytes32(ORIGINAL_BANK)?)?;
+        let merged_path = loaded.verify(&store, current, peer_end, || false)?;
+        ensure!(
+            full_path.entries == merged_path.entries,
+            "full/loaded original-root paths differ"
+        );
+        let raw_manifest = private_bytes(
+            &peer_output.join(GENERATION).join("manifest.json"),
+            OWNER,
+            65_536,
+        )?;
+        let manifest = manifest_evidence(&raw_manifest, published.manifest_sha256, &binding)?;
+        ensure!(
+            snapshot_pins(&ledger, peer)? == snapshots,
+            "source snapshots changed during export"
+        );
+        ensure!(
+            store.max_root() == current
+                && ancestry_archive::capture_root_evidence(&store, current)? == current_evidence,
+            "source current root changed during export"
+        );
+        public_resume()?;
+        deadline(peer_end)?;
+        let report = json!({"identity":IDENTITIES[peer],"ledger":LEDGERS[peer],
+            "generation":GENERATION,"manifest_sha256":hex(&published.manifest_sha256),
+            "manifest":manifest,"binding":binding,"current_root":current_evidence,
+            "canonical_E":canonical,"snapshots":snapshots,
+            "highest_stored_slot":store.highest_slot()?,"signed_frontier":null,
+            "full_current_to_original_entries":full_path.entries,
+            "loaded_current_to_original_entries":merged_path.entries,
+            "ordinary_full_snapshot_verification_performed":false,
+            "peer_elapsed_ms":started.elapsed().as_millis()});
+        println!(
+            "{}",
+            json!({"event":"pilot_metadata_peer_prepared","peer":report})
+        );
+        reports.push(report);
+        // Drop the per-peer read-only DB and bounded V2 index before opening the next peer.
+    }
+    public_resume()?;
+    deadline(end)?;
+    let report = json!({"format":"zolana096-original-pilot-metadata-preparation-v1",
+        "status":"prepared-and-reloaded","preparation_only":true,"source_root":ROOT,
+        "source_access":"ReadOnly","uid":OWNER,"output_root":OUTPUT,
+        "output_is_volatile_RAM":true,"durability_claim":false,
+        "original_resume_sha256":RESUME_SHA,"canonical_export_E":CANONICAL_SLOT,
+        "canonical_export_blockhash":CANONICAL_BLOCKHASH,"canonical_export_height":CANONICAL_HEIGHT,
+        "canonical_export_external_sqlite_sha256":CANONICAL_SQLITE_SHA,
+        "canonical_export_external_receipt_sha256":CANONICAL_RECEIPT_SHA,
+        "canonical_sqlite_file_opened":false,"retention_policy_written":false,
+        "pruning_performed":false,"validators_started":false,"keys_or_signed_history_opened":false,
+        "snapshot_binding_uses_older_slot":SNAPSHOT_SLOTS[0],"peers":reports});
+    let raw = serde_json::to_vec(&report)?;
+    ensure!(
+        raw.len() <= 256 * 1024,
+        "public export receipt exceeds bound"
+    );
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .custom_flags(libc::O_NOFOLLOW)
+        .open(output.join("export.json"))?;
+    file.write_all(&raw)?;
+    file.sync_all()?;
+    File::open(output)?.sync_all()?;
+    println!(
+        "{}",
+        json!({"event":"pilot_metadata_export_prepared","report":report,
+        "export_json_sha256":hex(&solana_sha256_hasher::hash(&raw).to_bytes())})
+    );
+    Ok(())
+}
+
+pub(super) fn maybe_run() -> Result<bool> {
+    if !selected(&std::env::args().skip(1).collect::<Vec<_>>())? {
+        return Ok(false);
+    }
+    run(Instant::now() + LIFETIME)?;
+    Ok(true)
+}
