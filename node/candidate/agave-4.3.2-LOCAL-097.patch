+fn mount_id(file: &File) -> Result<u64> {
+    let mut out = std::mem::MaybeUninit::<libc::statx>::zeroed();
+    let result = unsafe {
+        libc::statx(
+            file.as_raw_fd(),
+            c"".as_ptr(),
+            libc::AT_EMPTY_PATH | libc::AT_SYMLINK_NOFOLLOW,
+            libc::STATX_MNT_ID,
+            out.as_mut_ptr(),
+        )
+    };
+    ensure!(
+        result == 0,
+        "statx mount identity unavailable: {}",
+        std::io::Error::last_os_error()
+    );
+    let out = unsafe { out.assume_init() };
+    ensure!(
+        out.stx_mask & libc::STATX_MNT_ID != 0 && out.stx_mnt_id > 0,
+        "actual mount ID absent"
+    );
+    Ok(out.stx_mnt_id)
+}
+fn unescape_path(text: &str) -> Result<PathBuf> {
+    let bytes = text.as_bytes();
+    let mut out = Vec::new();
+    let mut at = 0;
+    while at < bytes.len() {
+        if bytes[at] == b'\\' {
+            ensure!(at + 3 < bytes.len(), "mount escape truncated");
+            let value = match &bytes[at + 1..at + 4] {
+                b"040" => b' ',
+                b"011" => b'\t',
+                b"012" => b'\n',
+                b"134" => b'\\',
+                _ => anyhow::bail!("unknown mount escape"),
+            };
+            out.push(value);
+            at += 4;
+        } else {
+            out.push(bytes[at]);
+            at += 1;
+        }
+    }
+    let path = PathBuf::from(String::from_utf8(out)?);
+    ensure!(path.is_absolute(), "absolute mount path required");
+    Ok(path)
+}
+fn mounts(raw: &[u8]) -> Result<BTreeMap<u64, Mount>> {
+    ensure!(raw.len() <= 256 * 1024, "mount table byte bound");
+    let mut result = BTreeMap::new();
+    for line in std::str::from_utf8(raw)?.lines() {
+        ensure!(
+            line.len() <= 8192 && result.len() < 2048,
+            "mount table line/count bound"
+        );
+        let (left, right) = line.split_once(" - ").context("mount separator absent")?;
+        let a: Vec<_> = left.split_whitespace().collect();
+        let b: Vec<_> = right.split_whitespace().collect();
+        ensure!(a.len() >= 6 && b.len() == 3, "mount record shape differs");
+        let id = a[0].parse()?;
+        let entry = Mount {
+            id,
+            root: unescape_path(a[3])?,
+            point: unescape_path(a[4])?,
+            options: a[5].split(',').map(str::to_owned).collect(),
+            optional: a[6..].iter().map(|s| (*s).to_owned()).collect(),
+            kind: b[0].into(),
+            super_options: b[2].split(',').map(str::to_owned).collect(),
+            line_sha256: sha(line.as_bytes()),
+        };
+        ensure!(result.insert(id, entry).is_none(), "duplicate mount ID");
+    }
+    ensure!(!result.is_empty(), "empty mount table");
+    Ok(result)
+}
+fn private_mount(m: &Mount) -> Result<()> {
