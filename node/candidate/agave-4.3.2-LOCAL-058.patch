diff --git a/zolana-fast-check/src/service.rs b/zolana-fast-check/src/service.rs
new file mode 100644
--- /dev/null
+++ b/zolana-fast-check/src/service.rs
@@ -0,0 +1,179 @@
+//! Resume-only service lifetime for a separately sealed Linux supervisor.
+//! No genesis construction, benchmark transfers, funding, or metadata replacement.
+use {
+    super::{Args, Evidence, check_alpenglow, external_fixture_ready, resume},
+    anyhow::{Context, Result, ensure},
+    serde_json::json,
+    signal_hook::{
+        SigId,
+        consts::{SIGINT, SIGTERM},
+    },
+    std::{
+        sync::{
+            Arc,
+            atomic::{AtomicBool, Ordering},
+        },
+        thread::sleep,
+        time::Duration,
+    },
+};
+
+struct StopSignals {
+    stopped: Arc<AtomicBool>,
+    registrations: Vec<SigId>,
+}
+
+impl StopSignals {
+    fn install() -> Result<Self> {
+        let mut value = Self {
+            stopped: Arc::new(AtomicBool::new(false)),
+            registrations: Vec::new(),
+        };
+        for signal in [SIGTERM, SIGINT] {
+            value.registrations.push(
+                signal_hook::flag::register(signal, value.stopped.clone())
+                    .context("register service stop signal")?,
+            );
+        }
+        Ok(value)
+    }
+
+    fn stopped(&self) -> bool {
+        self.stopped.load(Ordering::Relaxed)
+    }
+
+    fn wait(&self) {
+        while !self.stopped() {
+            sleep(Duration::from_millis(100));
+        }
+    }
+}
+
+impl Drop for StopSignals {
+    fn drop(&mut self) {
+        for registration in self.registrations.drain(..) {
+            signal_hook::low_level::unregister(registration);
+        }
+    }
+}
+
+pub(super) fn run(args: &Args, evidence: &mut Evidence, manifest: &resume::Manifest) -> Result<()> {
+    ensure!(
+        args.resume && args.service && args.hold_seconds == 0,
+        "service requires the original resume-only invocation"
+    );
+    ensure!(
+        args.private && args.slot_anchors,
+        "service requires the original NPOOL004 profile"
+    );
+    agave_logger::setup_with_default("warn");
+    let signals = StopSignals::install()?;
+    evidence.event(
+        "service_start",
+        json!({"original_root": args.root, "whole_process_resume": true,
+        "benchmark_transactions": false, "new_genesis": false, "mac_validators_started": false}),
+    )?;
+    let mut cluster = manifest.start(&args.root)?;
+    let result = (|| {
+        evidence.event(
+            "whole_process_original_ledger_restored",
+            manifest.validate_restored(&cluster, args)?,
+        )?;
+        evidence.event(
+            "real_alpenglow_ready",
+            json!({"genesis_hash": cluster.genesis_config.hash().to_string(),
+            "peers": check_alpenglow(&cluster, &args.root)?}),
+        )?;
+        // A stop received during startup must never publish a ready generation.
+        if !signals.stopped() {
+            let mut ready = external_fixture_ready(&cluster, args)?;
+            ready["service_mode"] = json!(true);
+            evidence.event("external_mac_fixture_ready", ready)?;
+            signals.wait();
+        }
+        Ok(())
+    })();
+    cluster.close_preserve_ledgers();
+    ensure!(
+        cluster
+            .validators
+            .values()
+            .all(|node| node.validator.is_none()),
+        "managed service validators remain running"
+    );
+    evidence.event("managed_validators_stopped", json!({"ledgers_preserved": true,
+        "signed_vote_histories_preserved": true, "mac_validators_started": false, "service_mode": true}))?;
+    if let Err(error) = &result {
+        evidence.event(
+            "failed",
+            json!({"error": format!("{error:#}"), "service_mode": true}),
+        )?;
+    }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn parse(arguments: &[&str]) -> Result<Args> {
+        Args::parse_from(arguments.iter().map(|value| (*value).to_owned()))
+    }
+
+    #[test]
+    fn service_parse_accepts_only_original_resume_without_benchmark_options() {
+        let args = parse(&["--resume-root", "/original", "--service"]).unwrap();
+        assert!(args.resume && args.service);
+        assert_eq!(args.root, std::path::Path::new("/original"));
+        assert_eq!(args.hold_seconds, 0);
+        for extra in [
+            vec!["--nodes", "1"],
+            vec!["--samples", "3"],
+            vec!["--restart-one"],
+            vec!["--quorum-loss-rejoin"],
+            vec!["--private"],
+            vec!["--slot-anchors"],
+            vec!["--mac-relay", "11111111111111111111111111111111"],
+            vec!["--hold-seconds", "0"],
+        ] {
+            let mut values = vec!["--resume-root", "/original", "--service"];
+            values.extend(extra);
+            assert!(
+                parse(&values).is_err(),
+                "accepted forbidden options: {values:?}"
+            );
+        }
+        assert!(parse(&["--root", "/fresh", "--service"]).is_err());
+        assert!(parse(&["--service"]).is_err());
+    }
+
+    #[test]
+    fn ordinary_bounded_benchmark_and_resume_modes_remain_available() {
+        let args = parse(&[
+            "--root",
+            "/fresh",
+            "--slot-anchors",
+            "--nodes",
+            "3",
+            "--samples",
+            "1",
+        ])
+        .unwrap();
+        assert!(!args.service && !args.resume && args.private && args.slot_anchors);
+        assert_eq!(args.nodes, 3);
+        assert!(parse(&["--root", "/fresh", "--hold-seconds", "601"]).is_err());
+        let args = parse(&["--resume-root", "/original", "--hold-seconds", "600"]).unwrap();
+        assert!(args.resume && !args.service);
+    }
+
+    #[test]
+    fn actual_sigterm_and_sigint_set_the_stop_flag_without_terminating_the_process() {
+        for signal in [SIGTERM, SIGINT] {
+            let signals = StopSignals::install().unwrap();
+            assert!(!signals.stopped());
+            assert_eq!(unsafe { libc::raise(signal) }, 0);
+            assert!(signals.stopped());
+            signals.wait();
+        }
+    }
+}
