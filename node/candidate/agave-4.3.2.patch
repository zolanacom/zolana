+//! Permanent replay protection, authenticated by proof-derived PDA addresses.
+use crate::{id, pool_address};
+use solana_pubkey::Pubkey;
+
+pub const MARKER_BYTES: usize = 40;
+
+pub fn address(nullifier: &[u8; 32]) -> Pubkey {
+    Pubkey::find_program_address(
+        &[
+            b"native-payment-spent-v1",
+            pool_address().as_ref(),
+            nullifier,
+        ],
+        &id(),
+    )
+    .0
+}
+
+pub fn encode(nullifier: &[u8; 32]) -> [u8; MARKER_BYTES] {
+    let mut bytes = [0; MARKER_BYTES];
+    bytes[..8].copy_from_slice(b"NSPENT01");
+    bytes[8..].copy_from_slice(nullifier);
+    bytes
+}
diff --git a/zolana-native/adapter/src/processor.rs b/zolana-native/adapter/src/processor.rs
new file mode 100644
--- /dev/null
+++ b/zolana-native/adapter/src/processor.rs
@@ -0,0 +1,404 @@
+use crate::{FINALIZE_COMPUTE_UNITS, id, nullifiers, pool_address, staging::Buffer};
+use native_payments::{
+    state::PoolState,
+    verification::{MAX_EXPIRY_WINDOW, PaymentVerifier, ValidationView, bundle_version},
+    wire,
+};
+use orchard::circuit::VerifyingKey;
+use solana_instruction::error::InstructionError as Error;
+use solana_program_runtime::invoke_context::InvokeContext;
+use solana_sdk_ids::system_program;
+use std::{
+    collections::BTreeSet,
+    sync::{Arc, LazyLock},
+};
+
+static KEY: LazyLock<Arc<VerifyingKey>> =
+    LazyLock::new(|| Arc::new(VerifyingKey::build(bundle_version().circuit_version())));
+
+pub fn process(context: &mut InvokeContext) -> Result<(), Error> {
+    let instruction = context
+        .transaction_context
+        .get_current_instruction_context()?
+        .get_instruction_data()
+        .to_vec();
+    let (&opcode, rest) = instruction
+        .split_first()
+        .ok_or(Error::InvalidInstructionData)?;
+    context
+        .compute_meter
+        .consume_checked(if opcode == 3 || opcode == 5 {
+            FINALIZE_COMPUTE_UNITS
+        } else {
+            10_000
+        })
+        .map_err(|_| Error::ComputationalBudgetExceeded)?;
+    if context.get_stack_height() != 1 {
+        return Err(Error::InvalidInstructionData);
+    }
+    let slot = context.environment_config.sysvar_cache().get_clock()?.slot;
+    if opcode == 3 {
+        if !rest.is_empty() {
+            return Err(Error::InvalidInstructionData);
+        }
+        return finalize(context, slot, None);
+    }
+    if opcode == 5 {
+        if !context.get_feature_set().native_inline_payments {
+            return Err(Error::InvalidInstructionData);
+        }
+        return finalize(context, slot, Some(rest));
+    }
+    let instruction_context = context
+        .transaction_context
+        .get_current_instruction_context()?;
+    if instruction_context.get_number_of_instruction_accounts() != 2
+        || !instruction_context.is_instruction_account_signer(1)?
+    {
+        return Err(Error::MissingRequiredSignature);
+    }
+    let sponsor = *instruction_context.get_key_of_instruction_account(1)?;
+    let buffer_key = *instruction_context.get_key_of_instruction_account(0)?;
+    if buffer_key == pool_address() || buffer_key == sponsor {
+        return Err(Error::InvalidArgument);
+    }
+    let mut account = instruction_context.try_borrow_instruction_account(0)?;
+    if account.get_owner() != &id() {
+        return Err(Error::InvalidAccountOwner);
+    }
+    let mut buffer = if opcode == 0 {
+        if rest.len() != 44 || !instruction_context.is_instruction_account_signer(0)? {
+            return Err(Error::InvalidInstructionData);
+        }
+        let expiry = u64::from_le_bytes(rest[36..44].try_into().unwrap());
+        if expiry < slot || expiry.saturating_sub(slot) > MAX_EXPIRY_WINDOW {
+            return Err(Error::InvalidInstructionData);
+        }
+        Buffer::initialize(
+            account.get_data(),
+            sponsor.to_bytes(),
+            u32::from_le_bytes(rest[..4].try_into().unwrap()),
+            rest[4..36].try_into().unwrap(),
+            expiry,
+        )?
+    } else {
+        Buffer::decode(account.get_data())?
+    };
+    if buffer.sponsor() != sponsor.to_bytes() {
+        return Err(Error::MissingRequiredSignature);
+    }
+    if opcode != 4 && slot > buffer.expiry() {
+        return Err(Error::InvalidInstructionData);
+    }
+    match opcode {
+        0 => {}
+        1 => {
+            if rest.len() < 5 {
+                return Err(Error::InvalidInstructionData);
+            }
+            buffer.write(
+                u32::from_le_bytes(rest[..4].try_into().unwrap()),
+                &rest[4..],
+            )?;
+        }
+        2 => {
+            if !rest.is_empty() {
+                return Err(Error::InvalidInstructionData);
+            }
+            buffer.seal()?;
+        }
+        4 => {
+            if !rest.is_empty() {
+                return Err(Error::InvalidInstructionData);
+            }
+            let lamports = account.get_lamports();
+            account.checked_sub_lamports(lamports)?;
+            account.set_data_length(0)?;
+            drop(account);
+            instruction_context
+                .try_borrow_instruction_account(1)?
+                .checked_add_lamports(lamports)?;
+            return Ok(());
+        }
+        _ => return Err(Error::InvalidInstructionData),
+    }
+    account.set_data_from_slice(buffer.bytes())
+}
+
+fn finalize(context: &mut InvokeContext, slot: u64, inline: Option<&[u8]>) -> Result<(), Error> {
+    let sponsor_index = if inline.is_some() { 1 } else { 2 };
+    let system_index = if inline.is_some() { 2 } else { 3 };
+    let nullifier_start = if inline.is_some() { 3 } else { 4 };
+    let (state, mut buffer, sponsor) = {
+        let instruction = context
+            .transaction_context
+            .get_current_instruction_context()?;
+        let count = instruction.get_number_of_instruction_accounts();
+        if (if inline.is_some() {
+            count != 5
+        } else {
+            ![6, 7].contains(&count)
+        }) || !instruction.is_instruction_account_signer(sponsor_index)?
+        {
+            return Err(Error::MissingRequiredSignature);
+        }
+        if instruction.get_key_of_instruction_account(0)? != &pool_address()
+            || instruction.get_key_of_instruction_account(system_index)? != &system_program::id()
+        {
+            return Err(Error::InvalidArgument);
+        }
+        let sponsor = *instruction.get_key_of_instruction_account(sponsor_index)?;
+        if inline.is_none()
+            && (instruction.get_key_of_instruction_account(1)? == &pool_address()
+                || instruction.get_key_of_instruction_account(1)? == &sponsor)
+        {
+            return Err(Error::InvalidArgument);
+        }
+        let pool = instruction.try_borrow_instruction_account(0)?;
+        let public = instruction.try_borrow_instruction_account(sponsor_index)?;
+        if pool.get_owner() != &id()
+            || public.get_owner() != &system_program::id()
+            || !public.get_data().is_empty()
+        {
+            return Err(Error::InvalidAccountOwner);
+        }
+        let state = PoolState::decode(pool.get_data()).map_err(|_| Error::InvalidAccountData)?;
+        if state.uses_slot_anchors() && !context.get_feature_set().native_slot_anchors {
+            return Err(Error::InvalidAccountData);
+        }
+        if pool.get_lamports()
+            < state
+                .rent_floor
+                .checked_add(state.backing)
+                .ok_or(Error::ArithmeticOverflow)?
+        {
+            return Err(Error::InsufficientFunds);
+        }
+        let buffer = if inline.is_none() {
+            let staged = instruction.try_borrow_instruction_account(1)?;
+            if staged.get_owner() != &id() {
+                return Err(Error::InvalidAccountOwner);
+            }
+            Some(Buffer::decode(staged.get_data())?)
+        } else {
+            None
+        };
+        (state, buffer, sponsor)
+    };
+    let payment = if let Some(bytes) = inline {
+        native_payments::envelope::decode(state.network, slot, bytes)
+            .map_err(|_| Error::InvalidInstructionData)?
+            .payment
+    } else {
+        let staged = buffer.as_ref().ok_or(Error::InvalidAccountData)?;
+        if staged.sponsor() != sponsor.to_bytes() || slot > staged.expiry() {
+            return Err(Error::InvalidArgument);
+        }
+        wire::decode(state.network, staged.payload()?).map_err(|_| Error::InvalidInstructionData)?
+    };
+    if payment.context.shielded_fee.is_some() && !context.get_feature_set().native_shielded_fees {
+        return Err(Error::InvalidInstructionData);
+    }
+    if payment.context.sponsor != sponsor.to_bytes() {
+        return Err(Error::MissingRequiredSignature);
+    }
+    let recipient_index = {
+        let instruction = context
+            .transaction_context
+            .get_current_instruction_context()?;
+        match payment.context.withdrawal_recipient {
+            None => {
+                if instruction.get_number_of_instruction_accounts()
+                    != if inline.is_some() { 5 } else { 6 }
+                {
+                    return Err(Error::InvalidArgument);
+                }
+                sponsor_index
+            }
+            Some(key) => {
+                if !context.get_feature_set().native_recipient_withdrawals
+                    || instruction.get_number_of_instruction_accounts() != 7
+                {
+                    return Err(Error::InvalidInstructionData);
+                }
+                if instruction.get_key_of_instruction_account(6)?.to_bytes() != key
+                    || !instruction.is_instruction_account_writable(6)?
+                {
+                    return Err(Error::InvalidArgument);
+                }
+                let recipient = instruction.try_borrow_instruction_account(6)?;
+                // Keep the explicit ordinary-account constraint even on this
+                // Agave release, which deprecates the executable accessor.
+                #[allow(deprecated)]
+                let executable = recipient.is_executable();
+                if recipient.get_owner() != &system_program::id()
+                    || !recipient.get_data().is_empty()
+                    || executable
+                    || !solana_pubkey::Pubkey::new_from_array(key).is_on_curve()
+                    || key == sponsor.to_bytes()
+                {
+                    return Err(Error::InvalidAccountOwner);
+                }
+                let final_balance = recipient
+                    .get_lamports()
+                    .checked_add(payment.context.public_value_balance as u64)
+                    .ok_or(Error::ArithmeticOverflow)?;
+                if final_balance
+                    < context
+                        .environment_config
+                        .sysvar_cache()
+                        .get_rent()?
+                        .minimum_balance(0)
+                {
+                    return Err(Error::AccountNotRentExempt);
+                }
+                6
+            }
+        }
+    };
+    let nullifiers: [[u8; 32]; 2] = std::array::from_fn(|index| {
+        payment
+            .bundle
+            .actions()
+            .get(index)
+            .unwrap()
+            .nullifier()
+            .to_bytes()
+    });
+    if nullifiers[0] == nullifiers[1] {
+        return Err(Error::InvalidInstructionData);
+    }
+    {
+        let instruction = context
+            .transaction_context
+            .get_current_instruction_context()?;
+        for (index, nullifier) in nullifiers.iter().enumerate() {
+            let account_index = nullifier_start + index as u16;
+            if instruction.get_key_of_instruction_account(account_index)?
+                != &nullifiers::address(nullifier)
+            {
+                return Err(Error::InvalidArgument);
+            }
+            if !instruction.is_instruction_account_writable(account_index)? {
+                return Err(Error::InvalidArgument);
+            }
+            let marker = instruction.try_borrow_instruction_account(account_index)?;
+            // Any native-owned account at this address fails closed, including
+            // malformed markers. Only this finalizer can sign for the PDA.
+            if marker.get_owner() == &id() {
+                return Err(Error::InvalidInstructionData);
+            }
+            if marker.get_owner() != &system_program::id() || !marker.get_data().is_empty() {
+                return Err(Error::InvalidAccountData);
+            }
+        }
+    }
+    let roots = state
+        .accepted_roots(slot)
+        .map_err(|_| Error::InvalidAccountData)?;
+    // Public movement is executed below, atomically with these verified effects.
+    let effects = PaymentVerifier::with_shared_key(state.network, Arc::clone(&KEY))
+        .map_err(|_| Error::InvalidAccountData)?
+        .verify(
+            &payment.bundle,
+            &payment.context,
+            &ValidationView {
+                current_slot: slot,
+                accepted_anchors: &roots,
+                // Both proof-derived accounts were authenticated above. Neither
+                // exists in the native spent set. No RPC-supplied state is used.
+                spent_nullifiers: &BTreeSet::new(),
+                authorized_public_value_balance: payment.context.public_value_balance,
+            },
+        )
+        .map_err(|_| Error::InvalidInstructionData)?;
+    let next = state
+        .with_payment(&effects)
+        .map_err(|_| Error::InvalidInstructionData)?;
+    if let Some(staged) = buffer.as_mut() {
+        staged.consume()?;
+    }
+    if effects.public_value_balance < 0 {
+        context.native_invoke_signed(
+            solana_system_interface::instruction::transfer(
+                &sponsor,
+                &pool_address(),
+                effects.public_value_balance.unsigned_abs(),
+            ),
+            &[],
+        )?;
+    } else if effects.public_value_balance > 0 {
+        let instruction = context
+            .transaction_context
+            .get_current_instruction_context()?;
+        instruction
+            .try_borrow_instruction_account(0)?
+            .checked_sub_lamports(effects.public_value_balance as u64)?;
+        instruction
+            .try_borrow_instruction_account(recipient_index)?
+            .checked_add_lamports(effects.public_value_balance as u64)?;
+    }
+    for (index, nullifier) in effects.nullifiers.iter().enumerate() {
+        let address = nullifiers::address(nullifier);
+        let pool_key = pool_address();
+        let (_, bump) = solana_pubkey::Pubkey::find_program_address(
+            &[b"native-payment-spent-v1", pool_key.as_ref(), nullifier],
+            &id(),
+        );
+        let bump_seed = [bump];
+        let signer_seeds: &[&[u8]] = &[
+            b"native-payment-spent-v1",
+            pool_key.as_ref(),
+            nullifier,
+            &bump_seed,
+        ];
+        let existing = context
+            .transaction_context
+            .get_current_instruction_context()?
+            .try_borrow_instruction_account(nullifier_start + index as u16)?
+            .get_lamports();
+        // Zero-lamport accounts are purged even when rent is free.
+        let rent = context
+            .environment_config
+            .sysvar_cache()
+            .get_rent()?
+            .minimum_balance(nullifiers::MARKER_BYTES)
+            .max(1);
+        // Allocate/assign rather than create_account: an unsolicited transfer to
+        // an unused PDA must not make an otherwise valid note unspendable.
+        if existing < rent {
+            context.native_invoke_signed(
+                solana_system_interface::instruction::transfer(&sponsor, &address, rent - existing),
+                &[],
+            )?;
+        }
+        context.native_invoke_signed(
+            solana_system_interface::instruction::allocate(
+                &address,
+                nullifiers::MARKER_BYTES as u64,
+            ),
+            &[signer_seeds],
+        )?;
+        context.native_invoke_signed(
+            solana_system_interface::instruction::assign(&address, &id()),
+            &[signer_seeds],
+        )?;
+        context
+            .transaction_context
+            .get_current_instruction_context()?
+            .try_borrow_instruction_account(nullifier_start + index as u16)?
+            .set_data_from_slice(&nullifiers::encode(nullifier))?;
+    }
+    let instruction = context
+        .transaction_context
+        .get_current_instruction_context()?;
+    instruction
+        .try_borrow_instruction_account(0)?
+        .set_data_from_slice(&next.encode())?;
+    if let Some(staged) = buffer {
+        instruction
+            .try_borrow_instruction_account(1)?
+            .set_data_from_slice(staged.bytes())?;
+    }
+    Ok(())
+}
diff --git a/zolana-native/adapter/src/staging.rs b/zolana-native/adapter/src/staging.rs
new file mode 100644
--- /dev/null
+++ b/zolana-native/adapter/src/staging.rs
@@ -0,0 +1,109 @@
+use native_payments::staging::{MAX_CHUNK_BYTES, MAX_PAYLOAD_BYTES, payload_digest};
+use solana_instruction::error::InstructionError as Error;
+
+pub const HEADER: usize = 96;
+pub const ACCOUNT_BYTES: usize = HEADER + MAX_PAYLOAD_BYTES;
+
+pub struct Buffer {
+    bytes: Vec<u8>,
+}
+
+impl Buffer {
+    pub fn initialize(
+        bytes: &[u8],
+        sponsor: [u8; 32],
+        length: u32,
+        digest: [u8; 32],
+        expiry: u64,
+    ) -> Result<Self, Error> {
+        if bytes.len() != ACCOUNT_BYTES
+            || bytes.iter().any(|b| *b != 0)
+            || length == 0
+            || length as usize > MAX_PAYLOAD_BYTES
+        {
+            return Err(Error::InvalidAccountData);
+        }
+        let mut bytes = bytes.to_vec();
+        bytes[..8].copy_from_slice(b"NBUF0001");
+        bytes[8..40].copy_from_slice(&sponsor);
+        bytes[40..44].copy_from_slice(&length.to_le_bytes());
+        bytes[48..80].copy_from_slice(&digest);
+        bytes[80..88].copy_from_slice(&expiry.to_le_bytes());
+        Ok(Self { bytes })
+    }
+    pub fn decode(bytes: &[u8]) -> Result<Self, Error> {
+        if bytes.len() != ACCOUNT_BYTES
+            || &bytes[..8] != b"NBUF0001"
+            || !matches!(bytes[88], 0 | 1 | 3)
+            || bytes[89..HEADER].iter().any(|b| *b != 0)
+        {
+            return Err(Error::InvalidAccountData);
+        }
+        let value = Self {
+            bytes: bytes.to_vec(),
+        };
+        if value.length() == 0
+            || value.length() > MAX_PAYLOAD_BYTES
+            || value.received() > value.length()
+            || (value.bytes[88] != 0 && value.received() != value.length())
+            || value.bytes[HEADER + value.received()..]
+                .iter()
+                .any(|byte| *byte != 0)
+        {
+            return Err(Error::InvalidAccountData);
+        }
+        Ok(value)
+    }
+    pub fn sponsor(&self) -> [u8; 32] {
+        self.bytes[8..40].try_into().unwrap()
+    }
+    pub fn expiry(&self) -> u64 {
+        u64::from_le_bytes(self.bytes[80..88].try_into().unwrap())
+    }
+    fn length(&self) -> usize {
+        u32::from_le_bytes(self.bytes[40..44].try_into().unwrap()) as usize
+    }
+    fn received(&self) -> usize {
+        u32::from_le_bytes(self.bytes[44..48].try_into().unwrap()) as usize
+    }
+    pub fn write(&mut self, offset: u32, chunk: &[u8]) -> Result<(), Error> {
+        let offset = offset as usize;
+        if self.bytes[88] != 0
+            || offset != self.received()
+            || chunk.is_empty()
+            || chunk.len() > MAX_CHUNK_BYTES
+            || offset
+                .checked_add(chunk.len())
+                .is_none_or(|end| end > self.length())
+        {
+            return Err(Error::InvalidInstructionData);
+        }
+        self.bytes[HEADER + offset..HEADER + offset + chunk.len()].copy_from_slice(chunk);
+        self.bytes[44..48].copy_from_slice(&((offset + chunk.len()) as u32).to_le_bytes());
+        Ok(())
+    }
+    pub fn seal(&mut self) -> Result<(), Error> {
+        if self.bytes[88] != 0
+            || self.received() != self.length()
+            || payload_digest(&self.bytes[HEADER..HEADER + self.length()]) != self.bytes[48..80]
+        {
+            return Err(Error::InvalidAccountData);
+        }
+        self.bytes[88] = 1;
+        Ok(())
+    }
+    pub fn payload(&self) -> Result<&[u8], Error> {
+        if self.bytes[88] != 1 {
+            return Err(Error::InvalidAccountData);
+        }
+        Ok(&self.bytes[HEADER..HEADER + self.length()])
+    }
+    pub fn consume(&mut self) -> Result<(), Error> {
+        self.payload()?;
+        self.bytes[88] = 3;
+        Ok(())
+    }
+    pub fn bytes(&self) -> &[u8] {
+        &self.bytes
+    }
+}
