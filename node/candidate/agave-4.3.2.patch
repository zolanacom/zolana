@@ -0,0 +1,254 @@
+//! Admission and serialization evidence only. The fixture's proof is invalid;
+//! successful admission must never be confused with successful execution.
+use {
+    agave_transaction_view::{
+        resolved_transaction_view::ResolvedTransactionView,
+        transaction_view::SanitizedTransactionView,
+    },
+    native_payment_program::{
+        ACTIVATION_ID, INLINE_PAYMENT_ACTIVATION_ID, SHIELDED_FEE_ACTIVATION_ID, instructions,
+    },
+    native_payments::staging::payload_digest,
+    payment_lab::{
+        admission_fixture::unverified_shielded_fee_payload, proof_smoke::FIXTURE_GENESIS,
+    },
+    solana_account::AccountSharedData,
+    solana_compute_budget_interface::ComputeBudgetInstruction,
+    solana_entry::entry::Entry,
+    solana_feature_gate_interface::{Feature, create_account},
+    solana_genesis_config::GenesisConfig,
+    solana_instruction::{AccountMeta, Instruction},
+    solana_keypair::Keypair,
+    solana_pubkey::Pubkey,
+    solana_runtime::{bank::Bank, native_payment_admission::MAX_NATIVE_TRANSACTION_BYTES},
+    solana_runtime_transaction::{
+        runtime_transaction::RuntimeTransaction, sanitize_config::sanitize_config,
+    },
+    solana_signer::Signer,
+    solana_transaction::{
+        Transaction, TransactionVerificationMode,
+        sanitized::{MessageHash, SanitizedTransaction},
+        versioned::VersionedTransaction,
+    },
+};
+
+fn bank(relay: &Keypair, omitted: Option<Pubkey>) -> Bank {
+    let mut genesis = GenesisConfig::default();
+    genesis.accounts.insert(
+        relay.pubkey(),
+        AccountSharedData::new(1_000_000_000, 0, &solana_sdk_ids::system_program::id()).into(),
+    );
+    for feature in [
+        ACTIVATION_ID,
+        SHIELDED_FEE_ACTIVATION_ID,
+        INLINE_PAYMENT_ACTIVATION_ID,
+    ] {
+        if Some(feature) != omitted {
+            genesis.accounts.insert(
+                feature,
+                create_account(
+                    &Feature {
+                        activated_at: Some(0),
+                    },
+                    1_000_000,
+                )
+                .into(),
+            );
+        }
+    }
+    Bank::new_for_tests(&genesis)
+}
+
+fn transaction(bank: &Bank, relay: &Keypair, instructions: &[Instruction]) -> Transaction {
+    Transaction::new_signed_with_payer(
+        instructions,
+        Some(&relay.pubkey()),
+        &[relay],
+        bank.last_blockhash(),
+    )
+}
+
+fn check(bank: &Bank, transaction: Transaction) -> bool {
+    let transaction: VersionedTransaction = transaction.into();
+    let bytes = wincode::serialize(&transaction).unwrap();
+    let bank_ok = bank
+        .verify_transaction(transaction, TransactionVerificationMode::FullVerification)
+        .is_ok();
+    let parsed = match bank.native_payment_transaction_size_limit() {
+        Some(limit) => SanitizedTransactionView::try_new_sanitized_with_legacy_size_limit(
+            bytes.as_slice(),
+            &sanitize_config(),
+            limit,
+        ),
+        None => SanitizedTransactionView::try_new_sanitized(bytes.as_slice(), &sanitize_config()),
+    };
+    let view_ok = parsed
+        .ok()
+        .and_then(|view| {
+            let view = RuntimeTransaction::<SanitizedTransactionView<_>>::try_new(
+                view,
+                MessageHash::Compute,
+                None,
+            )
+            .ok()?;
+            let resolved = RuntimeTransaction::<ResolvedTransactionView<_>>::try_new(
+                view,
+                None,
+                bank.get_reserved_account_keys(),
+            )
+            .ok()?;
+            bank.check_native_payment_admission(&resolved).ok()
+        })
+        .is_some();
+    assert_eq!(
+        bank_ok, view_ok,
+        "Bank/replay and native banking View admission must agree"
+    );
+    bank_ok
+}
+
+#[test]
+fn full_native_bytes_pass_sdk_view_entry_and_shared_admission() {
+    let relay = Keypair::new();
+    let bank = bank(&relay, None);
+    let payload = unverified_shielded_fee_payload(relay.pubkey().to_bytes(), FIXTURE_GENESIS, 100);
+    let list = [
+        ComputeBudgetInstruction::set_compute_unit_limit(1_400_000),
+        instructions::inline(FIXTURE_GENESIS, &payload).unwrap(),
+    ];
+    let candidate = transaction(&bank, &relay, &list);
+    let versioned: VersionedTransaction = candidate.clone().into();
+    let bytes = wincode::serialize(&versioned).unwrap();
+    assert_eq!(payload.len(), 9_230);
+    assert!(bytes.len() > 9_332 && bytes.len() < MAX_NATIVE_TRANSACTION_BYTES);
+
+    let decoded: VersionedTransaction =
+        wincode::config::deserialize_exact(&bytes, wincode::config::DefaultConfig::default())
+            .unwrap();
+    assert_eq!(wincode::serialize(&decoded).unwrap(), bytes);
+    let admitted: RuntimeTransaction<SanitizedTransaction> = bank
+        .verify_transaction(decoded, TransactionVerificationMode::FullVerification)
+        .unwrap();
+    assert_eq!(
+        bank.check_native_payment_admission(&admitted).unwrap(),
+        Some(payload_digest(&payload))
+    );
+    bank.resanitize_transaction_minimally(&admitted, bank.epoch(), u64::MAX)
+        .unwrap();
+
+    // The published API keeps its ordinary packet limit. Only the explicitly
+    // gated structural API plus strict classifier can admit the native frame.
+    assert!(
+        SanitizedTransactionView::try_new_sanitized(bytes.as_slice(), &sanitize_config()).is_err()
+    );
+    let view = SanitizedTransactionView::try_new_sanitized_with_legacy_size_limit(
+        bytes.as_slice(),
+        &sanitize_config(),
+        bank.native_payment_transaction_size_limit().unwrap(),
+    )
+    .unwrap();
+    let view = RuntimeTransaction::<SanitizedTransactionView<_>>::try_new(
+        view,
+        MessageHash::Compute,
+        None,
+    )
+    .unwrap();
+    let resolved = RuntimeTransaction::<ResolvedTransactionView<_>>::try_new(
+        view,
+        None,
+        bank.get_reserved_account_keys(),
+    )
+    .unwrap();
+    assert_eq!(
+        bank.check_native_payment_admission(&resolved).unwrap(),
+        Some(payload_digest(&payload))
+    );
+
+    let entry = Entry::new(&bank.last_blockhash(), 1, vec![candidate]);
+    let encoded_entries = wincode::serialize(&vec![entry.clone()]).unwrap();
+    let recovered: Vec<Entry> = wincode::config::deserialize_exact(
+        &encoded_entries,
+        wincode::config::DefaultConfig::default(),
+    )
+    .unwrap();
+    assert_eq!(recovered, vec![entry]);
+    assert_eq!(
+        wincode::serialize(&recovered[0].transactions[0]).unwrap(),
+        bytes
+    );
+    assert!(recovered[0].verify(&bank.last_blockhash()));
+    let mut forged = recovered[0].transactions[0].clone();
+    if let solana_message::VersionedMessage::Legacy(message) = &mut forged.message {
+        message.instructions[1].data[200] ^= 1;
+    }
+    assert!(
+        bank.verify_transaction(forged, TransactionVerificationMode::FullVerification)
+            .is_err()
+    );
+}
+
+#[test]
+fn native_exception_rejects_extra_effects_bad_bindings_and_disabled_features() {
+    let relay = Keypair::new();
+    let bank = bank(&relay, None);
+    let payload = unverified_shielded_fee_payload(relay.pubkey().to_bytes(), FIXTURE_GENESIS, 100);
+    let list = vec![
+        ComputeBudgetInstruction::set_compute_unit_limit(1_400_000),
+        instructions::inline(FIXTURE_GENESIS, &payload).unwrap(),
+    ];
+    assert!(check(&bank, transaction(&bank, &relay, &list)));
+    for feature in [
+        ACTIVATION_ID,
+        SHIELDED_FEE_ACTIVATION_ID,
+        INLINE_PAYMENT_ACTIVATION_ID,
+    ] {
+        let disabled = self::bank(&relay, Some(feature));
+        assert!(!check(&disabled, transaction(&disabled, &relay, &list)));
+    }
+
+    let mut altered = list.clone();
+    altered[0] = ComputeBudgetInstruction::set_compute_unit_limit(200_000);
+    assert!(!check(&bank, transaction(&bank, &relay, &altered)));
+
+    let mut altered = list.clone();
+    altered.push(ComputeBudgetInstruction::set_compute_unit_price(1));
+    assert!(!check(&bank, transaction(&bank, &relay, &altered)));
+
+    let mut altered = list.clone();
+    altered[1].accounts[3] = AccountMeta::new(Pubkey::new_unique(), false);
+    assert!(!check(&bank, transaction(&bank, &relay, &altered)));
+
+    let mut altered = list.clone();
+    altered[1].accounts[3].is_writable = false;
+    assert!(!check(&bank, transaction(&bank, &relay, &altered)));
+
+    let mut altered = list.clone();
+    altered[1].data[1 + 66] ^= 1; // Envelope payload identity.
+    assert!(!check(&bank, transaction(&bank, &relay, &altered)));
+
+    let mut altered = list.clone();
+    altered[1].data.push(0);
+    assert!(!check(&bank, transaction(&bank, &relay, &altered)));
+
+    let mut altered = list.clone();
+    altered[1].data.resize(MAX_NATIVE_TRANSACTION_BYTES, 0);
+    assert!(!check(&bank, transaction(&bank, &relay, &altered)));
+
+    let ordinary = [Instruction::new_with_bytes(
+        Pubkey::new_unique(),
+        &vec![9; 2_000],
+        vec![],
+    )];
+    assert!(!check(&bank, transaction(&bank, &relay, &ordinary)));
+    let ordinary = [Instruction::new_with_bytes(
+        Pubkey::new_unique(),
+        &[9; 16],
+        vec![],
+    )];
+    assert!(check(&bank, transaction(&bank, &relay, &ordinary)));
+
+    let other_relay = Keypair::new();
+    let mut altered = list.clone();
+    altered[1].accounts[1].pubkey = other_relay.pubkey();
+    assert!(!check(&bank, transaction(&bank, &other_relay, &altered)));
+}
