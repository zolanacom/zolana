+#!/usr/bin/env python3
+"""Fail closed if the recorded transaction-view vendor source differs."""
+import hashlib
+import json
+from pathlib import Path
+
+root = Path(__file__).resolve().parent / "agave-transaction-view"
+manifest = json.loads((root / "ZOLANA-PROVENANCE.json").read_text())
+expected = manifest["original_sha256"] | manifest["patched_sha256"]
+actual_files = {str(path.relative_to(root)) for path in root.rglob("*") if path.is_file()}
+assert actual_files == set(expected) | {"ZOLANA-PROVENANCE.json"}, "vendor file set changed"
+for name, expected_hash in expected.items():
+    actual_hash = hashlib.sha256((root / name).read_bytes()).hexdigest()
+    assert actual_hash == expected_hash, f"vendor hash mismatch: {name}"
+assert set(manifest["patched_sha256"]) == set(manifest["modified_files"])
+print(f"verified transaction-view {manifest['version']}: {len(expected)} exact files; "
+      f"{len(manifest['modified_files'])} explicitly recorded local modifications")
