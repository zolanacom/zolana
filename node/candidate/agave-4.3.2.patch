+//! A bounded native-payment exception to ordinary transaction size limits.
+//!
+//! The same checks run for banking ingress, ledger replay and re-sanitization.
+//! Admission only checks framing and transaction bindings. It does not verify a
+//! payment proof, assert execution success, or establish consensus finality.
+use {
+    agave_feature_set::FeatureSet,
+    native_payment_program::{
+        ACTIVATION_ID, INLINE_PAYMENT_ACTIVATION_ID, SHIELDED_FEE_ACTIVATION_ID, id, nullifiers,
+        pool_address,
+    },
+    native_payments::envelope,
+    solana_packet::PACKET_DATA_SIZE,
+    solana_pubkey::Pubkey,
+    solana_runtime_transaction::transaction_with_meta::TransactionWithMeta,
+    solana_sdk_ids::{compute_budget, system_program},
+    solana_transaction::versioned::TransactionVersion,
+    solana_transaction_error::{TransactionError, TransactionResult},
+    std::collections::HashSet,
+};
+
+/// Bounds the entire serialized signed transaction, including outer framing.
+/// Ordinary legacy/v0 transactions and transaction-v1 keep their existing caps.
+pub const MAX_NATIVE_TRANSACTION_BYTES: usize = 16_384;
+const NATIVE_COMPUTE_UNIT_LIMIT: u32 = 1_400_000;
+const FRAME_NETWORK_OFFSET: usize = 8 + 2 + 16;
+
+pub(crate) fn native_enabled(feature_set: &FeatureSet) -> bool {
+    feature_set.is_active(&ACTIVATION_ID)
+        && feature_set.is_active(&SHIELDED_FEE_ACTIVATION_ID)
+        && feature_set.is_active(&INLINE_PAYMENT_ACTIVATION_ID)
+}
+
+/// Check the normal size limit, or the narrowly scoped native-payment exception.
+///
+/// The payment network is decoded from the envelope and checked against its
+/// signed inner payload here. The executing builtin independently checks it
+/// against the pool's genesis-pinned network before any effects can commit.
+pub fn check_admission(
+    transaction: &impl TransactionWithMeta,
+    feature_set: &FeatureSet,
+    current_slot: u64,
+) -> TransactionResult<Option<[u8; 32]>> {
+    let size = transaction.serialized_size();
+    let normal_limit = match transaction.version() {
+        TransactionVersion::Number(1) if feature_set.snapshot().enable_tx_v1 => {
+            solana_message::v1::MAX_TRANSACTION_SIZE
+        }
+        TransactionVersion::Number(1) => return Err(TransactionError::UnsupportedVersion),
+        _ => PACKET_DATA_SIZE,
+    };
+    if size <= normal_limit {
+        return Ok(None);
+    }
+    if size > MAX_NATIVE_TRANSACTION_BYTES
+        || !matches!(transaction.version(), TransactionVersion::Legacy(_))
+        || !native_enabled(feature_set)
+        || transaction.num_transaction_signatures() != 1
+        || transaction.signatures().len() != 1
+        || transaction.num_readonly_signed_static_accounts() != 0
+        || transaction.num_readonly_unsigned_static_accounts() != 3
+        || transaction.num_lookup_tables() != 0
+        || transaction.num_instructions() != 2
+    {
+        return Err(TransactionError::SanitizeFailure);
+    }
+
+    let mut instructions = transaction.program_instructions_iter();
+    let (budget_program, budget) = instructions
+        .next()
+        .ok_or(TransactionError::SanitizeFailure)?;
+    let (payment_program, payment) = instructions
+        .next()
+        .ok_or(TransactionError::SanitizeFailure)?;
+    let mut expected_budget = [0u8; 5];
+    expected_budget[0] = 2; // ComputeBudgetInstruction::SetComputeUnitLimit.
+    expected_budget[1..].copy_from_slice(&NATIVE_COMPUTE_UNIT_LIMIT.to_le_bytes());
+    if budget_program != &compute_budget::id()
+        || !budget.accounts.is_empty()
+        || budget.data != expected_budget
+        || payment_program != &id()
+        || payment.accounts.len() != 5
+        || instructions.next().is_some()
+    {
+        return Err(TransactionError::SanitizeFailure);
+    }
+    let frame = payment
+        .data
+        .strip_prefix(&[5])
+        .ok_or(TransactionError::SanitizeFailure)?;
+    let network: [u8; 32] = frame
+        .get(FRAME_NETWORK_OFFSET..FRAME_NETWORK_OFFSET + 32)
+        .and_then(|bytes| bytes.try_into().ok())
+        .ok_or(TransactionError::SanitizeFailure)?;
+    let decoded = envelope::decode(network, current_slot, frame)
+        .map_err(|_| TransactionError::SanitizeFailure)?;
+    let relay = Pubkey::new_from_array(decoded.payment.context.sponsor);
+    let expected_accounts = [
+        pool_address(),
+        relay,
+        system_program::id(),
+        nullifiers::address(&decoded.payment.bundle.actions()[0].nullifier().to_bytes()),
+        nullifiers::address(&decoded.payment.bundle.actions()[1].nullifier().to_bytes()),
+    ];
+    let static_keys = transaction.static_account_keys();
+    let expected_keys: HashSet<_> = expected_accounts
+        .iter()
+        .copied()
+        .chain([id(), compute_budget::id()])
+        .collect();
+    if static_keys.len() != 7
+        || expected_keys.len() != 7
+        || static_keys.iter().copied().collect::<HashSet<_>>() != expected_keys
+        || transaction.fee_payer() != &relay
+    {
+        return Err(TransactionError::SanitizeFailure);
+    }
+    for (position, expected) in expected_accounts.iter().enumerate() {
+        let index = usize::from(payment.accounts[position]);
+        if static_keys.get(index) != Some(expected)
+            || transaction.is_signer(index) != (position == 1)
+            || transaction.is_writable(index) != (position != 2)
+        {
+            return Err(TransactionError::SanitizeFailure);
+        }
+    }
+    for program in [id(), compute_budget::id()] {
+        let index = static_keys
+            .iter()
+            .position(|key| *key == program)
+            .ok_or(TransactionError::SanitizeFailure)?;
+        if transaction.is_signer(index) || transaction.is_writable(index) {
+            return Err(TransactionError::SanitizeFailure);
+        }
+    }
+    Ok(Some(decoded.payment_id))
+}
