+//! Cheap public encoding fixture; its proof and spend signatures are invalid.
+//! This exists only to test admission boundaries without doing redundant proving.
+use {
+    native_payments::{
+        Error,
+        verification::{ACTION_COUNT, AuthorizationContext, bundle_version},
+        wire,
+    },
+    orchard::{
+        Bundle, Proof,
+        builder::{Builder, BundleType},
+        bundle::Authorized,
+        keys::{FullViewingKey, Scope, SpendingKey},
+        primitives::redpallas,
+        tree::Anchor,
+        value::NoteValue,
+    },
+};
+
+pub fn unverified_shielded_fee_payload(
+    relay: [u8; 32],
+    network: [u8; 32],
+    expires_at: u64,
+) -> Vec<u8> {
+    let version = bundle_version();
+    let key = Option::<SpendingKey>::from(SpendingKey::from_bytes([7; 32])).unwrap();
+    let mut builder = Builder::new(
+        BundleType::DEFAULT,
+        version,
+        version.default_flags(),
+        Anchor::empty_tree(),
+    )
+    .unwrap();
+    builder
+        .add_output(
+            None,
+            FullViewingKey::from(&key).address_at(0u32, Scope::External),
+            NoteValue::from_raw(1),
+            [0; 512],
+        )
+        .unwrap();
+    let (bundle, _) = builder.build::<i64>(&mut rand::rng()).unwrap().unwrap();
+    let bundle: Bundle<Authorized, i64> = bundle.map_authorization(
+        &mut (),
+        |_, _, _| redpallas::Signature::from([0; 64]),
+        |_, _| {
+            Authorized::from_parts(
+                Proof::new(vec![0; Proof::expected_proof_size(ACTION_COUNT)]),
+                redpallas::Signature::from([0; 64]),
+            )
+        },
+    );
+    let bundle = bundle
+        .try_map_value_balance::<_, Error, _>(|_| Ok(7))
+        .unwrap();
+    wire::encode(
+        network,
+        &AuthorizationContext {
+            expires_at,
+            public_value_balance: 7,
+            sponsor: relay,
+            withdrawal_recipient: None,
+            shielded_fee: Some(7),
+        },
+        &bundle,
+    )
+    .unwrap()
+}
