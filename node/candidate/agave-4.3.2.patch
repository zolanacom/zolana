@@ -0,0 +1,320 @@
+//! Opt-in loopback transport for the isolated native-payment pilot.
+//!
+//! One connection carries `u32::to_le_bytes(wire.len()) || wire`, followed by
+//! one JSON-line admission response. An acknowledgement is never finality.
+//! This does not forward to the ordinary TPU: callers retry the identical signed
+//! bytes against configured pilot validators until the current leader admits it.
+use {
+    crate::banking_trace::BankingPacketSender,
+    solana_perf::packet::{BytesPacket, Meta, PacketBatch, bytes::Bytes},
+    solana_poh::poh_recorder::PohRecorder,
+    solana_pubkey::Pubkey,
+    solana_runtime::native_payment_admission::MAX_NATIVE_TRANSACTION_BYTES,
+    solana_transaction::{TransactionVerificationMode, versioned::VersionedTransaction},
+    std::{
+        collections::{HashMap, VecDeque},
+        env,
+        io::{self, Read, Write},
+        net::{IpAddr, Ipv4Addr, SocketAddr, TcpListener, TcpStream},
+        sync::{
+            Arc, LazyLock, Mutex, RwLock,
+            atomic::{AtomicBool, Ordering},
+        },
+        thread::{self, JoinHandle},
+        time::{Duration, Instant},
+    },
+};
+
+const ENVIRONMENT: &str = "ZOLANA_NATIVE_INGRESS";
+const REQUEST_TIMEOUT: Duration = Duration::from_secs(2);
+const MAX_REQUESTS_PER_SECOND: usize = 8;
+/// At most 16 native packets can be queued through this listener; each is at
+/// most 16 KiB. The listener rejects when the shared queue is already busy.
+const MAX_BANKING_QUEUE_BATCHES: usize = 16;
+
+static LOCAL_ENDPOINTS: LazyLock<Mutex<HashMap<Pubkey, SocketAddr>>> =
+    LazyLock::new(|| Mutex::new(HashMap::new()));
+
+/// Inspect explicitly enabled pilot listeners in an in-process test cluster.
+/// There is no listener, registry entry or discovery publication by default.
+#[cfg(any(test, feature = "dev-context-only-utils"))]
+pub fn local_address(identity: &Pubkey) -> Option<SocketAddr> {
+    LOCAL_ENDPOINTS.lock().unwrap().get(identity).copied()
+}
+
+struct EndpointGuard {
+    identity: Pubkey,
+    address: SocketAddr,
+}
+
+impl EndpointGuard {
+    fn register(identity: Pubkey, address: SocketAddr) -> io::Result<Self> {
+        let mut endpoints = LOCAL_ENDPOINTS.lock().unwrap();
+        if endpoints.contains_key(&identity) {
+            return Err(io::Error::new(
+                io::ErrorKind::AlreadyExists,
+                "native identity already bound",
+            ));
+        }
+        endpoints.insert(identity, address);
+        Ok(Self { identity, address })
+    }
+}
+
+impl Drop for EndpointGuard {
+    fn drop(&mut self) {
+        let mut endpoints = LOCAL_ENDPOINTS.lock().unwrap();
+        if endpoints.get(&self.identity) == Some(&self.address) {
+            endpoints.remove(&self.identity);
+        }
+    }
+}
+
+pub(crate) fn spawn_if_configured(
+    identity: Pubkey,
+    sender: BankingPacketSender,
+    recorder: Arc<RwLock<PohRecorder>>,
+    exit: Arc<AtomicBool>,
+) -> io::Result<Option<JoinHandle<()>>> {
+    let value = match env::var(ENVIRONMENT) {
+        Ok(value) => value,
+        Err(env::VarError::NotPresent) => return Ok(None),
+        Err(error) => return Err(io::Error::new(io::ErrorKind::InvalidInput, error)),
+    };
+    let address: SocketAddr = value.parse().map_err(|_| {
+        io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "invalid native pilot ingress address",
+        )
+    })?;
+    validate_address(address)?;
+    let listener = TcpListener::bind(address)?;
+    listener.set_nonblocking(true)?;
+    let registered = EndpointGuard::register(identity, listener.local_addr()?)?;
+    info!(
+        "native pilot ingress listening on {}; admission is not finality",
+        listener.local_addr()?
+    );
+    thread::Builder::new()
+        .name("zolNativeIngress".into())
+        .spawn(move || {
+            let _registered = registered;
+            // Deliberately one synchronous connection at a time: there is no
+            // unbounded connection/task queue and each request has a deadline.
+            let mut recent = VecDeque::with_capacity(MAX_REQUESTS_PER_SECOND);
+            while !exit.load(Ordering::Relaxed) {
+                match listener.accept() {
+                    Ok((mut stream, _)) => {
+                        let _ = stream.set_nodelay(true);
+                        if stream
+                            .set_read_timeout(Some(Duration::from_millis(100)))
+                            .is_err()
+                            || stream
+                                .set_write_timeout(Some(Duration::from_millis(500)))
+                                .is_err()
+                        {
+                            continue;
+                        }
+                        let response = handle_request(&mut stream, &sender, &recorder, &mut recent);
+                        let _ = serde_json::to_writer(&mut stream, &response);
+                        let _ = stream.write_all(b"\n");
+                    }
+                    Err(error) if error.kind() == io::ErrorKind::WouldBlock => {
+                        thread::sleep(Duration::from_millis(10));
+                    }
+                    Err(error) => {
+                        warn!("native pilot ingress accept failed: {error}");
+                        break;
+                    }
+                }
+            }
+        })
+        .map(Some)
+}
+
+fn validate_address(address: SocketAddr) -> io::Result<()> {
+    if address.ip() != IpAddr::V4(Ipv4Addr::LOCALHOST) {
+        return Err(io::Error::new(
+            io::ErrorKind::PermissionDenied,
+            "native pilot ingress must bind 127.0.0.1",
+        ));
+    }
+    Ok(())
+}
+
+fn handle_request(
+    stream: &mut TcpStream,
+    sender: &BankingPacketSender,
+    recorder: &RwLock<PohRecorder>,
+    recent: &mut VecDeque<Instant>,
+) -> serde_json::Value {
+    let error = |status: &str| serde_json::json!({"status": status, "finalized": false});
+    let bytes = match read_frame(stream, Instant::now() + REQUEST_TIMEOUT) {
+        Ok(bytes) => bytes,
+        Err(_) => return error("invalid_frame"),
+    };
+    let Some(bank) = recorder.read().unwrap().bank() else {
+        return error("not_leader_retry_identical_bytes");
+    };
+    let now = Instant::now();
+    if !take_quota(recent, now) || sender.len() >= MAX_BANKING_QUEUE_BATCHES {
+        return error("busy_retry_identical_bytes");
+    }
+    let config = wincode::config::DefaultConfig::default()
+        .with_preallocation_size_limit::<MAX_NATIVE_TRANSACTION_BYTES>();
+    let transaction: VersionedTransaction = match wincode::config::deserialize_exact(&bytes, config)
+    {
+        Ok(transaction) => transaction,
+        Err(_) => return error("invalid_transaction"),
+    };
+    // Match strict canonical serialized bytes; never hash a reinterpreted wire.
+    if !matches!(wincode::serialize(&transaction), Ok(canonical) if canonical == bytes) {
+        return error("noncanonical_transaction");
+    }
+    let transaction =
+        match bank.verify_transaction(transaction, TransactionVerificationMode::FullVerification) {
+            Ok(transaction) => transaction,
+            Err(_) => return error("invalid_transaction"),
+        };
+    let payment_id = match bank.check_native_payment_admission(&transaction) {
+        Ok(Some(payment_id)) => payment_id,
+        _ => return error("not_native_payment"),
+    };
+    let slot = bank.slot();
+    if bank.is_frozen()
+        || recorder
+            .read()
+            .unwrap()
+            .bank()
+            .as_ref()
+            .map(|bank| bank.slot())
+            != Some(slot)
+    {
+        return error("not_leader_retry_identical_bytes");
+    }
+    let signature = transaction.signature().to_string();
+    let mut meta = Meta::default();
+    meta.size = bytes.len();
+    let packet = PacketBatch::Single(BytesPacket::new(Bytes::from(bytes), meta));
+    match sender.send(Arc::new(packet)) {
+        Ok(0) => serde_json::json!({
+            "status": "admitted",
+            "signature": signature,
+            "paymentId": payment_id,
+            "slot": slot,
+            "finalized": false,
+        }),
+        _ => error("busy_retry_identical_bytes"),
+    }
+}
+
+fn take_quota(recent: &mut VecDeque<Instant>, now: Instant) -> bool {
+    while recent
+        .front()
+        .is_some_and(|then| now.saturating_duration_since(*then) >= Duration::from_secs(1))
+    {
+        recent.pop_front();
+    }
+    if recent.len() >= MAX_REQUESTS_PER_SECOND {
+        return false;
+    }
+    recent.push_back(now);
+    true
+}
+
+fn read_frame(reader: &mut impl Read, deadline: Instant) -> io::Result<Vec<u8>> {
+    let mut length = [0u8; 4];
+    read_until(reader, &mut length, deadline)?;
+    let length = u32::from_le_bytes(length) as usize;
+    if length == 0 || length > MAX_NATIVE_TRANSACTION_BYTES {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "invalid native frame length",
+        ));
+    }
+    let mut bytes = vec![0; length];
+    read_until(reader, &mut bytes, deadline)?;
+    Ok(bytes)
+}
+
+fn read_until(reader: &mut impl Read, mut bytes: &mut [u8], deadline: Instant) -> io::Result<()> {
+    while !bytes.is_empty() {
+        if Instant::now() >= deadline {
+            return Err(io::Error::new(
+                io::ErrorKind::TimedOut,
+                "native frame deadline",
+            ));
+        }
+        match reader.read(bytes) {
+            Ok(0) => return Err(io::ErrorKind::UnexpectedEof.into()),
+            Ok(count) => bytes = &mut bytes[count..],
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    io::ErrorKind::WouldBlock
+                        | io::ErrorKind::TimedOut
+                        | io::ErrorKind::Interrupted
+                ) => {}
+            Err(error) => return Err(error),
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn framing_is_bounded_complete_and_deadlined() {
+        let deadline = Instant::now() + Duration::from_secs(1);
+        let mut bytes = (MAX_NATIVE_TRANSACTION_BYTES as u32).to_le_bytes().to_vec();
+        bytes.extend(vec![7; MAX_NATIVE_TRANSACTION_BYTES]);
+        assert_eq!(
+            read_frame(&mut bytes.as_slice(), deadline).unwrap(),
+            vec![7; MAX_NATIVE_TRANSACTION_BYTES]
+        );
+        for bytes in [
+            vec![],
+            vec![1, 0, 0],
+            vec![0; 4],
+            vec![1, 0, 0, 0],
+            ((MAX_NATIVE_TRANSACTION_BYTES + 1) as u32)
+                .to_le_bytes()
+                .to_vec(),
+        ] {
+            assert!(read_frame(&mut bytes.as_slice(), deadline).is_err());
+        }
+        assert!(read_frame(&mut [1, 0, 0, 0, 7].as_slice(), Instant::now()).is_err());
+    }
+
+    #[test]
+    fn listener_is_loopback_only_and_quota_is_bounded() {
+        assert!(validate_address("127.0.0.1:0".parse().unwrap()).is_ok());
+        for address in ["0.0.0.0:1234", "192.0.2.1:1234", "[::1]:1234"] {
+            assert!(validate_address(address.parse().unwrap()).is_err());
+        }
+        let now = Instant::now();
+        let mut recent = VecDeque::new();
+        for _ in 0..MAX_REQUESTS_PER_SECOND {
+            assert!(take_quota(&mut recent, now));
+        }
+        assert!(!take_quota(&mut recent, now + Duration::from_millis(999)));
+        assert!(take_quota(&mut recent, now + Duration::from_secs(1)));
+        assert_eq!(recent.len(), 1);
+    }
+
+    #[test]
+    fn endpoint_registration_is_exclusive_and_recovers_on_drop() {
+        let identity = Pubkey::new_unique();
+        let address = "127.0.0.1:12345".parse().unwrap();
+        assert!(local_address(&identity).is_none());
+        let binding = EndpointGuard::register(identity, address).unwrap();
+        assert_eq!(local_address(&identity), Some(address));
+        assert!(EndpointGuard::register(identity, address).is_err());
+        drop(binding);
+        assert!(local_address(&identity).is_none());
+        drop(EndpointGuard::register(identity, address).unwrap());
+        assert!(local_address(&identity).is_none());
+    }
+}
