@@ -0,0 +1,950 @@
+//! Bounded Linux-only baseline for the real upstream Alpenglow path.
+//!
+//! Optional native-ingress smoke times in-memory private receive/respend.
+//! Neither mode claims production validator independence or durable Mac readiness.
+//! Every ledger and key belongs to a fresh owner-only invocation directory.
+
+mod resume;
+
+use {
+    agave_votor::vote_history_storage::{FileVoteHistoryStorage, VoteHistoryStorage},
+    anyhow::{Context, Result, bail, ensure},
+    serde_json::{Value, json},
+    solana_account::AccountSharedData,
+    solana_commitment_config::CommitmentConfig,
+    solana_core::{native_payment_ingress, validator::ValidatorConfig},
+    solana_feature_gate_interface::{Feature, create_account},
+    solana_keypair::Keypair,
+    solana_local_cluster::{
+        cluster::Cluster,
+        integration_tests::ValidatorKeys,
+        local_cluster::{ClusterConfig, LocalCluster},
+        validator_configs::make_identical_validator_configs,
+    },
+    solana_native_token::LAMPORTS_PER_SOL,
+    solana_net_utils::SocketAddrSpace,
+    solana_pubkey::Pubkey,
+    solana_rent::Rent,
+    solana_rpc_client::rpc_client::RpcClient,
+    solana_rpc_client_api::config::RpcSendTransactionConfig,
+    solana_signature::Signature,
+    solana_signer::Signer,
+    solana_transaction_status_client_types::TransactionConfirmationStatus,
+    std::{
+        env,
+        fs::{DirBuilder, File, OpenOptions},
+        io::{Write, stdout},
+        net::SocketAddr,
+        num::NonZeroUsize,
+        os::unix::fs::{DirBuilderExt, OpenOptionsExt, PermissionsExt},
+        path::{Path, PathBuf},
+        thread::sleep,
+        time::{Duration, Instant},
+    },
+    zolana_native_check::{
+        TEST_NETWORK, TEST_SLOT_NETWORK, native_features_for_profile, new_slot_pool_account,
+        pool_account, rpc_smoke,
+    },
+};
+
+const UPSTREAM_COMMIT: &str = "a203300045b405f86c9c84308b2eae76af69ac3b";
+// Fresh public recipients must satisfy rent exemption as well as transfer rules.
+const PUBLIC_AMOUNT: u64 = LAMPORTS_PER_SOL;
+
+struct Args {
+    root: PathBuf,
+    resume: bool,
+    nodes: usize,
+    samples: usize,
+    restart_one: bool,
+    quorum_loss_rejoin: bool,
+    private: bool,
+    slot_anchors: bool,
+    mac_relay: Option<Pubkey>,
+    hold_seconds: u64,
+}
+
+impl Args {
+    fn parse() -> Result<Self> {
+        let mut args = env::args().skip(1);
+        let (mut root, mut nodes, mut samples, mut restart_one, mut private) =
+            (None, 1, 3, false, false);
+        let mut quorum_loss_rejoin = false;
+        let mut slot_anchors = false;
+        let mut resume = false;
+        let (mut mac_relay, mut hold_seconds) = (None, 0u64);
+        while let Some(arg) = args.next() {
+            match arg.as_str() {
+                "--root" | "--resume-root" => {
+                    ensure!(root.is_none(), "choose exactly one --root or --resume-root");
+                    resume = arg == "--resume-root";
+                    root = Some(PathBuf::from(args.next().context("root option needs a path")?));
+                },
+                "--nodes" => nodes = args.next().context("--nodes needs a count")?.parse()?,
+                "--samples" => samples = args.next().context("--samples needs a count")?.parse()?,
+                "--restart-one" => restart_one = true,
+                "--quorum-loss-rejoin" => quorum_loss_rejoin = true,
+                "--private" => private = true,
+                "--slot-anchors" => {
+                    slot_anchors = true;
+                    private = true;
+                }
+                "--mac-relay" => {
+                    mac_relay = Some(
+                        args.next()
+                            .context("--mac-relay needs a public key")?
+                            .parse::<Pubkey>()?,
+                    )
+                }
+                "--hold-seconds" => {
+                    hold_seconds = args
+                        .next()
+                        .context("--hold-seconds needs a duration")?
+                        .parse()?
+                }
+                _ => bail!(
+                    "use --root FRESH_ABSOLUTE_PATH | --resume-root ORIGINAL_FIXTURE_ROOT [--nodes 1|2|3] [--samples 1..5] [--restart-one] [--quorum-loss-rejoin] [--private|--slot-anchors] [--mac-relay PUBLIC_KEY --hold-seconds 1..600]"
+                ),
+            }
+        }
+        ensure!(
+            (1..=3).contains(&nodes),
+            "one to three staked validators required"
+        );
+        ensure!(
+            hold_seconds <= 600,
+            "hold duration exceeds the ten-minute development bound"
+        );
+        if resume {
+            ensure!(nodes == 1 && !restart_one && !quorum_loss_rejoin && !private && !slot_anchors && mac_relay.is_none(),
+                "resume restores topology/network/profile from its original metadata; omit genesis options");
+        }
+        if let Some(relay) = mac_relay {
+            ensure!(
+                private && hold_seconds > 0 && relay.is_on_curve(),
+                "Mac fixture requires private mode, a bounded hold and a public signing address"
+            );
+        }
+        ensure!((1..=5).contains(&samples), "one to five samples required");
+        ensure!(
+            !(restart_one || quorum_loss_rejoin) || nodes == 3,
+            "restart/quorum acceptance requires three equal-stake validators"
+        );
+        Ok(Self {
+            root: root.context("--root or --resume-root is required")?,
+            resume,
+            nodes,
+            samples,
+            restart_one,
+            quorum_loss_rejoin,
+            private,
+            slot_anchors,
+            mac_relay,
+            hold_seconds,
+        })
+    }
+
+    fn network(&self) -> [u8; 32] {
+        if self.slot_anchors {
+            TEST_SLOT_NETWORK
+        } else {
+            TEST_NETWORK
+        }
+    }
+}
+
+struct Evidence {
+    file: File,
+    _root_lock: File,
+}
+
+impl Evidence {
+    fn event(&mut self, kind: &str, data: Value) -> Result<()> {
+        let event = json!({"event": kind, "data": data});
+        serde_json::to_writer(&mut self.file, &event)?;
+        self.file.write_all(b"\n")?;
+        self.file.sync_all()?;
+        let mut output = stdout().lock();
+        serde_json::to_writer(&mut output, &event)?;
+        output.write_all(b"\n")?;
+        output.flush()?;
+        Ok(())
+    }
+}
+
+fn prepare_root(args: &Args) -> Result<Evidence> {
+    let root = &args.root;
+    ensure!(
+        cfg!(target_os = "linux"),
+        "acceptance runs only on Linux; do not start Mac validators"
+    );
+    ensure!(root.is_absolute(), "--root must be absolute");
+    let parent = root.parent().context("root needs a parent")?;
+    ensure!(
+        parent.canonicalize()? == parent,
+        "root parent must be a real canonical directory"
+    );
+    ensure!(
+        root.file_name().is_some(),
+        "root must be a new child directory"
+    );
+    if args.resume {
+        resume::check_root(root)?;
+    } else {
+        DirBuilder::new().mode(0o700).create(root)
+            .context("fresh root required; never reset an existing run")?;
+        DirBuilder::new().mode(0o700).create(root.join("ledgers"))?;
+        resume::check_root(root)?;
+    }
+    let mut lock_options = OpenOptions::new();
+    lock_options.read(true).write(true).mode(0o600).custom_flags(libc::O_NOFOLLOW);
+    if !args.resume { lock_options.create_new(true); }
+    let root_lock = lock_options.open(root.join("process.lock"))?;
+    use std::os::unix::fs::MetadataExt;
+    let lock_meta = root_lock.metadata()?;
+    ensure!(lock_meta.is_file() && lock_meta.len() == 0 && lock_meta.permissions().mode() & 0o077 == 0
+        && lock_meta.uid() == unsafe { libc::geteuid() }, "fixture process lock must be an empty current-owner private file");
+    root_lock.try_lock().context("another process still owns this fixture; no duplicate validator identities may start")?;
+    root_lock.sync_all()?;
+    File::open(root)?.sync_all()?;
+    let mut log_options = OpenOptions::new();
+    log_options.write(true).mode(0o600).custom_flags(libc::O_NOFOLLOW);
+    if args.resume { log_options.append(true); } else { log_options.create_new(true); }
+    let log = log_options.open(root.join("events.jsonl"))?;
+    let log_meta = log.metadata()?;
+    ensure!(log_meta.is_file() && log_meta.permissions().mode() & 0o077 == 0
+        && log_meta.uid() == unsafe { libc::geteuid() }, "fixture event log must remain a private current-owner file");
+    Ok(Evidence { file: log, _root_lock: root_lock })
+}
+
+fn configure_environment(args: &Args) {
+    // No thread or runtime has started. Recovery never uses the temporary-ledger
+    // constructor, but keep its directory scoped in case an invariant regresses.
+    unsafe {
+        env::set_var("FARF_DIR", args.root.join("ledgers"));
+        if args.private { env::set_var("ZOLANA_NATIVE_INGRESS", "127.0.0.1:0"); }
+        else { env::remove_var("ZOLANA_NATIVE_INGRESS"); }
+    }
+}
+
+fn save_key(root: &Path, name: &str, key: &Keypair) -> Result<()> {
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(root.join(name))?;
+    serde_json::to_writer(&mut file, &key.to_bytes().as_slice())?;
+    file.write_all(b"\n")?;
+    file.sync_all()?;
+    Ok(())
+}
+
+fn client(cluster: &LocalCluster, key: &Pubkey) -> Result<RpcClient> {
+    let address = cluster
+        .get_contact_info(key)
+        .context("missing managed validator")?
+        .rpc()
+        .context("managed validator RPC missing")?;
+    ensure!(
+        address.ip().is_loopback(),
+        "managed RPC must be loopback-only"
+    );
+    Ok(RpcClient::new_with_timeout_and_commitment(
+        format!("http://{address}"),
+        Duration::from_secs(3),
+        CommitmentConfig::finalized(),
+    ))
+}
+
+fn check_alpenglow(cluster: &LocalCluster, root: &Path) -> Result<Value> {
+    let mut peers = Vec::new();
+    for (key, node) in &cluster.validators {
+        ensure!(
+            node.info.ledger_path.canonicalize()?.starts_with(root),
+            "ledger escaped fresh run root"
+        );
+        let validator = node
+            .validator
+            .as_ref()
+            .context("managed validator is stopped")?;
+        let forks = validator.bank_forks.read().unwrap();
+        ensure!(
+            forks.migration_status().is_alpenglow_enabled(),
+            "real Alpenglow is not enabled"
+        );
+        let bank = forks.root_bank();
+        ensure!(
+            bank.feature_set
+                .is_active(&agave_feature_set::alpenglow::id()),
+            "Alpenglow feature inactive"
+        );
+        ensure!(
+            bank.get_alpenglow_genesis_certificate().is_some(),
+            "genesis certificate missing"
+        );
+        peers.push(
+            json!({"identity": key.to_string(), "ledger": node.info.ledger_path,
+            "rpc": node.info.contact_info.rpc().context("managed validator RPC missing")?.to_string(), "root_slot": bank.slot(),
+            "root_bank_hash": bank.hash().to_string(), "migration_alpenglow_enabled": true,
+            "alpenglow_feature_active": true, "genesis_certificate_present": true}),
+        );
+    }
+    Ok(json!(peers))
+}
+
+fn public_send(
+    cluster: &LocalCluster,
+    keys: &[Pubkey],
+    number: usize,
+    evidence: &mut Evidence,
+) -> Result<()> {
+    let payer = &cluster.funding_keypair;
+    let destination = Keypair::new().pubkey();
+    let rpc = client(cluster, &keys[0])?;
+    let blockhash = rpc.get_latest_blockhash()?;
+    let transaction =
+        solana_system_transaction::transfer(payer, &destination, PUBLIC_AMOUNT, blockhash);
+    let expected = transaction.signatures[0];
+    let began = Instant::now();
+    let returned = rpc.send_transaction_with_config(
+        &transaction,
+        RpcSendTransactionConfig {
+            max_retries: Some(0),
+            ..RpcSendTransactionConfig::default()
+        },
+    )?;
+    ensure!(returned == expected, "RPC substituted transaction identity");
+    let admitted_ms = began.elapsed().as_secs_f64() * 1000.0;
+    let mut observations = vec![None; keys.len()];
+    let mut last_relay = Instant::now();
+    let mut identical_resends = 0u64;
+    let mut last_relay_error: Option<String> = None;
+    while observations.iter().any(Option::is_none) {
+        if began.elapsed() >= Duration::from_secs(60) {
+            let mut peers = Vec::new();
+            for key in keys {
+                let node_rpc = client(cluster, key)?;
+                let status = node_rpc.get_signature_statuses_with_history(&[expected]);
+                let root = node_rpc.get_slot_with_commitment(CommitmentConfig::finalized());
+                peers.push(json!({"identity": key.to_string(),
+                    "status": status.as_ref().ok(), "status_error": status.as_ref().err().map(|error| error.to_string()),
+                    "finalized_root": root.as_ref().ok(), "root_error": root.as_ref().err().map(|error| error.to_string())}));
+            }
+            let diagnostic = json!({"signature": expected.to_string(), "elapsed_ms": began.elapsed().as_millis(),
+                "identical_resends": identical_resends, "last_relay_error": last_relay_error, "peers": peers});
+            evidence.event("public_rpc_finality_timeout", diagnostic.clone())?;
+            bail!("actual finalized RPC status deadline exceeded: {diagnostic}");
+        }
+        // Admission can race a leader handoff or reconnect. Keep the exact
+        // originally signed packet/blockhash/signature, never replace its identity.
+        if last_relay.elapsed() >= Duration::from_millis(250) {
+            match rpc.send_transaction_with_config(&transaction, RpcSendTransactionConfig {
+                skip_preflight: true, max_retries: Some(0), ..RpcSendTransactionConfig::default()
+            }) {
+                Ok(signature) => ensure!(signature == expected, "RPC substituted retransmission identity"),
+                Err(error) => last_relay_error = Some(error.to_string()),
+            }
+            identical_resends += 1;
+            last_relay = Instant::now();
+        }
+        for (index, key) in keys.iter().enumerate() {
+            if observations[index].is_some() {
+                continue;
+            }
+            let node_rpc = client(cluster, key)?;
+            let response = match node_rpc.get_signature_statuses_with_history(&[expected]) {
+                Ok(response) => response,
+                Err(_) => continue, // Reconnects remain pending until the same bounded deadline.
+            };
+            if let Some(status) = &response.value[0] {
+                ensure!(
+                    status.err.is_none() && status.status.is_ok(),
+                    "submitted public transaction failed execution"
+                );
+                if status.confirmation_status == Some(TransactionConfirmationStatus::Finalized) {
+                    ensure!(
+                        status.confirmations.is_none(),
+                        "finalized response is not rooted"
+                    );
+                    let finalized_slot = match node_rpc.get_slot_with_commitment(CommitmentConfig::finalized()) {
+                        Ok(slot) => slot,
+                        Err(_) => continue,
+                    };
+                    ensure!(
+                        finalized_slot >= status.slot,
+                        "finalized RPC root precedes transaction"
+                    );
+                    let balance = match node_rpc.get_balance(&destination) {
+                        Ok(balance) => balance,
+                        Err(_) => continue,
+                    };
+                    ensure!(
+                        balance == PUBLIC_AMOUNT,
+                        "finalized recipient balance differs"
+                    );
+                    observations[index] = Some(
+                        json!({"identity": key.to_string(), "transaction_slot": status.slot,
+                        "finalized_root": finalized_slot, "status_context_slot": response.context.slot,
+                        "confirmation_status": "finalized", "execution_success": true,
+                        "recipient_balance": balance, "milliseconds_from_submit": began.elapsed().as_secs_f64() * 1000.0}),
+                    );
+                }
+            }
+        }
+        if observations.iter().any(Option::is_none) {
+            sleep(Duration::from_millis(10));
+        }
+    }
+    evidence.event(
+        "public_rpc_finalized",
+        json!({"number": number, "signature": expected.to_string(),
+        "destination": destination.to_string(), "rpc_admission_milliseconds": admitted_ms,
+        "identical_resends": identical_resends, "last_relay_error": last_relay_error,
+        "all_peer_finalized_observation_milliseconds": began.elapsed().as_secs_f64() * 1000.0,
+        "peers": observations, "private_payment_benchmark": false}),
+    )
+}
+
+fn native_endpoints(keys: &[Pubkey]) -> Result<Vec<SocketAddr>> {
+    keys.iter()
+        .map(|key| {
+            let address = native_payment_ingress::local_address(key)
+                .context("explicit native pilot listener is not ready")?;
+            ensure!(
+                address.ip().is_loopback(),
+                "native pilot ingress escaped loopback"
+            );
+            Ok(address)
+        })
+        .collect()
+}
