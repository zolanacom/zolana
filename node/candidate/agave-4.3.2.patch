+    fn history(ix: solana_instruction::Instruction) -> HistoryInstruction {
+        HistoryInstruction {
+            accounts: ix
+                .accounts
+                .iter()
+                .map(|meta| (meta.pubkey, meta.is_signer))
+                .collect(),
+            data: ix.data,
