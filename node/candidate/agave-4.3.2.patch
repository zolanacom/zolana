+fn baseline(args: &Args, evidence: &mut Evidence, resume_manifest: Option<&resume::Manifest>) -> Result<()> {
+    agave_logger::setup_with_default("warn");
+    evidence.event(
+        "start",
+        json!({"upstream_commit": UPSTREAM_COMMIT, "nodes": args.nodes,
+        "samples": args.samples, "root": args.root, "whole_process_resume": args.resume, "mac_validators_started": false,
+        "scope": "co-located Linux Alpenglow baseline", "private_mode": args.private,
+        "slot_anchors": args.slot_anchors,
+        "threshold_overrides": false, "quorum_loss_rejoin_requested": args.quorum_loss_rejoin}),
+    )?;
+    let mut cluster = if let Some(manifest) = resume_manifest {
+        manifest.start(&args.root)?
+    } else {
+        let validator_config = pilot_validator_config(true);
+        let node_keys: Vec<_> = (0..args.nodes)
+            .map(|_| (ValidatorKeys::new(), true))
+            .collect();
+        for (index, (keys, _)) in node_keys.iter().enumerate() {
+            save_key(
+                &args.root,
+                &format!("identity-{index}.json"),
+                &keys.node_keypair,
+            )?;
+            save_key(
+                &args.root,
+                &format!("voter-{index}.json"),
+                &keys.vote_keypair,
+            )?;
+        }
+        let mut config = ClusterConfig {
+            validator_configs: make_identical_validator_configs(&validator_config, args.nodes),
+            validator_keys: Some(node_keys),
+            node_stakes: vec![10 * LAMPORTS_PER_SOL; args.nodes],
+            slots_per_epoch: 2048,
+            stakers_slot_offset: 2048,
+            skip_warmup_slots: true,
+            ..ClusterConfig::default()
+        };
+        if args.private {
+            let rent = Rent::default();
+            config.additional_accounts.push((
+                native_payment_program::pool_address(),
+                if args.slot_anchors {
+                    new_slot_pool_account(args.network(), &rent)
+                } else {
+                    pool_account(args.network(), &rent)
+                },
+            ));
+            for feature in native_features_for_profile(args.slot_anchors) {
+                config.additional_accounts.push((
+                    feature,
+                    create_account(
+                        &Feature {
+                            activated_at: Some(0),
+                        },
+                        1_000_000,
+                    ),
+                ));
+            }
+        }
+        if let Some(relay) = args.mac_relay {
+            // Only a fresh synthetic Mac fixture's public key enters genesis. No
+            // validator, funding or operator private key leaves this Linux process.
+            config.additional_accounts.push((
+                relay,
+                AccountSharedData::new(10_000_000_000, 0, &solana_sdk_ids::system_program::id()),
+            ));
+        }
+        let cluster = LocalCluster::new_alpenglow(&mut config, SocketAddrSpace::Unspecified);
+        save_key(&args.root, "funding.json", &cluster.funding_keypair)?;
+        cluster
+    };
+    let mut keys = cluster.get_node_pubkeys();
+    keys.sort();
+    let result = (|| {
+        if let Some(manifest) = resume_manifest {
+            evidence.event("whole_process_original_ledger_restored", manifest.validate_restored(&cluster, args)?)?;
+        }
+        evidence.event(
+            "real_alpenglow_ready",
+            json!({"genesis_hash": cluster.genesis_config.hash().to_string(),
+            "peers": check_alpenglow(&cluster, &args.root)?}),
+        )?;
+        for number in 1..=args.samples {
+            public_send(&cluster, &keys, number, evidence)?;
+        }
+        if args.hold_seconds > 0 {
+            resume::record(&args.root, &cluster, args)?;
+            evidence.event("whole_process_resume_metadata_durable", json!({
+                "manifest": args.root.join("resume.json"), "original_ledgers_only": true,
+                "root_lock_held": true, "sigkill_test_completed": false,
+            }))?;
+        }
+        let private = if args.private && args.mac_relay.is_none() && !args.resume {
+            for node in cluster.validators.values() {
+                let forks = node
+                    .validator
+                    .as_ref()
+                    .context("native peer stopped")?
+                    .bank_forks
+                    .read()
+                    .unwrap();
+                ensure!(
+                    native_features_for_profile(args.slot_anchors)
+                        .iter()
+                        .all(|feature| forks.root_bank().feature_set.is_active(feature)),
+                    "one or more native features inactive"
+                );
+            }
+            let endpoints = native_endpoints(&keys)?;
+            evidence.event(
+                "private_ingress_ready",
+                json!({"endpoints": endpoints,
+                "ordinary_rpc_packet_cap_unchanged": true, "admission_is_finality": false}),
+            )?;
+            let report = rpc_smoke::run_with_ingress(
+                &client(&cluster, &keys[0])?,
+                &cluster.funding_keypair,
+                &endpoints,
+            )
+            .map_err(|error| anyhow::anyhow!("{error}"))?;
+            evidence.event("private_in_memory_receive_respend", report.clone())?;
+            let audit = audit_private(&cluster, &keys, &report, args.network(), args.slot_anchors)?;
+            evidence.event("private_all_peer_finalized_and_recorded", audit.clone())?;
+            Some((report, audit["native_state"].clone()))
+        } else {
+            None
+        };
+        if args.restart_one {
+            let identity = keys[2];
+            let mut node = cluster.exit_node(&identity);
+            let storage = FileVoteHistoryStorage::new(node.info.ledger_path.clone());
+            let signed_history = storage
+                .load(&identity)
+                .context("verify original signed vote history before restart")?;
+            let original_path = storage.filename(&identity);
+            ensure!(
+                original_path.is_file(),
+                "original durable vote history missing"
+            );
+            node.config.require_vote_history = true;
+            node.config.wait_for_supermajority = None;
+            ensure!(node.config.new_hard_forks.is_none(), "restart must not introduce a hard fork");
+            evidence.event("restart_original_ledger", json!({"identity": identity.to_string(),
+                "ledger": node.info.ledger_path, "verified_vote_history_root": signed_history.root(),
+                "require_vote_history": true, "orderly_restart": true, "sigkill_test": false}))?;
+            cluster.restart_node(&identity, node, SocketAddrSpace::Unspecified);
+            public_send(&cluster, &keys, args.samples + 1, evidence)?;
+            evidence.event(
+                "restart_finality_recovered",
+                check_alpenglow(&cluster, &args.root)?,
+            )?;
+            if let Some((report, expected_state)) = &private {
+                let recovered =
+                    audit_private(&cluster, &keys, report, args.network(), args.slot_anchors)?;
+                ensure!(
+                    recovered["native_state"] == *expected_state,
+                    "original-ledger restart changed native pool or permanent nullifiers"
+                );
+                ensure!(
+                    native_endpoints(&keys)?.len() == args.nodes,
+                    "restarted native pilot listener missing"
+                );
+                evidence.event("private_state_preserved_after_orderly_restart", recovered)?;
+            }
+        }
+        if args.quorum_loss_rejoin {
+            quorum_loss_rejoin(&mut cluster, &keys, args, private.as_ref(), evidence)?;
+        }
+        if args.hold_seconds > 0 {
+            resume::record(&args.root, &cluster, args)?;
+            evidence.event("whole_process_resume_metadata_durable", json!({
+                "manifest": args.root.join("resume.json"), "original_ledgers_only": true,
+                "root_lock_held": true, "sigkill_test_completed": false,
+            }))?;
+            let endpoints = if args.private {
+                native_endpoints(&keys)?
+            } else {
+                Vec::new()
+            };
+            let peers = keys.iter().map(|key| -> Result<Value> {
+                let rpc = cluster.get_contact_info(key).context("missing held peer")?.rpc()
+                    .context("managed validator RPC missing")?;
+                if args.private {
+                    let forks = cluster.validators[key].validator.as_ref().context("held peer stopped")?.bank_forks.read().unwrap();
+                    ensure!(native_features_for_profile(args.slot_anchors).iter()
+                        .all(|feature| forks.root_bank().feature_set.is_active(feature)), "held native feature inactive");
+                }
+                Ok(json!({"identity": key.to_string(), "rpc": rpc.to_string(),
+                    "native_ingress": native_payment_ingress::local_address(key).map(|address| address.to_string())}))
+            }).collect::<Result<Vec<_>>>()?;
+            evidence.event("external_mac_fixture_ready", json!({
+                "network": {"network": args.network(), "genesis_hash": cluster.genesis_config.hash().to_string()},
+                "pool_format": if args.slot_anchors { "NPOOL004" } else { "NPOOL003" },
+                "peers": peers, "ingress": endpoints, "mac_relay": args.mac_relay.map(|key| key.to_string()),
+                "hold_seconds": args.hold_seconds, "shared_private_smoke_skipped": args.mac_relay.is_some() || args.resume,
+                "operator_private_keys_exported": false,
+            }))?;
+            sleep(Duration::from_secs(args.hold_seconds));
+            evidence.event(
+                "external_mac_fixture_hold_finished",
+                json!({"bounded_hold_seconds": args.hold_seconds}),
+            )?;
+        }
+        Ok(())
+    })();
+    cluster.close_preserve_ledgers();
+    ensure!(
+        cluster
+            .validators
+            .values()
+            .all(|node| node.validator.is_none()),
+        "managed validators remain running"
+    );
+    evidence.event(
+        "managed_validators_stopped",
+        json!({"ledgers_preserved": true, "mac_validators_started": false}),
+    )?;
+    result
+}
+
+fn main() -> Result<()> {
+    let mut args = Args::parse()?;
+    let mut evidence = prepare_root(&args)?;
+    let resume_manifest = if args.resume {
+        let manifest = resume::Manifest::load(&args.root)?;
+        manifest.apply_profile(&mut args)?;
+        Some(manifest)
+    } else { None };
+    configure_environment(&args);
+    match baseline(&args, &mut evidence, resume_manifest.as_ref()) {
+        Ok(()) => evidence.event(
+            "passed",
+            json!({"public_rpc_baseline_only": !args.private,
+            "private_ingress_in_memory_smoke_completed": args.private && args.mac_relay.is_none() && !args.resume,
+            "whole_process_resume_verified": args.resume,
+            "private_receive_to_respend_goal_complete": false}),
+        ),
+        Err(error) => {
+            evidence.event("failed", json!({"error": format!("{error:#}")}))?;
+            Err(error)
+        }
+    }
+}
diff --git a/zolana-fast-check/src/resume.rs b/zolana-fast-check/src/resume.rs
new file mode 100644
--- /dev/null
+++ b/zolana-fast-check/src/resume.rs
@@ -0,0 +1,286 @@
+//! Owner-only, original-ledger whole-process recovery for this isolated fixture.
+//! No ledger creation, genesis replacement, account migration, or vote-history reset.
+use {
+    super::{Args, UPSTREAM_COMMIT, pilot_validator_config},
+    agave_votor::vote_history_storage::{FileVoteHistoryStorage, VoteHistoryStorage},
+    anyhow::{Context, Result, ensure},
+    serde::{Deserialize, Serialize},
+    serde_json::{Value, json},
+    solana_genesis_config::GenesisConfig,
+    solana_keypair::Keypair,
+    solana_ledger::{ancestor_iterator::AncestorIterator, blockstore::Blockstore},
+    solana_local_cluster::local_cluster::{ExistingValidator, LocalCluster},
+    solana_net_utils::SocketAddrSpace,
+    solana_pubkey::Pubkey,
+    solana_signer::Signer,
+    std::{
+        collections::HashSet,
+        fs::{self, File, OpenOptions},
+        io::{Read, Write},
+        os::unix::fs::{MetadataExt, OpenOptionsExt, PermissionsExt},
+        path::{Component, Path, PathBuf},
+        sync::Arc,
+        thread::sleep,
+        time::{Duration, Instant},
+    },
+};
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct NodeRecord {
+    identity: String,
+    voter: String,
+    identity_file: String,
+    voter_file: String,
+    ledger: PathBuf,
+    root_slot: u64,
+    root_bank_hash: String,
+    vote_history_root: u64,
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Manifest {
+    format: String,
+    upstream_commit: String,
+    original_root: PathBuf,
+    ledger_prefix: PathBuf,
+    genesis_hash: String,
+    shred_version: u16,
+    funding_public_key: String,
+    private: bool,
+    slot_anchors: bool,
+    mac_relay: Option<String>,
+    nodes: Vec<NodeRecord>,
+}
+
+fn uid() -> u32 {
+    // Linux-only fixture entrypoint checks the target before reaching this code.
+    unsafe { libc::geteuid() }
+}
+
+pub(super) fn check_root(root: &Path) -> Result<()> {
+    let meta = fs::symlink_metadata(root)?;
+    ensure!(meta.is_dir() && !meta.file_type().is_symlink() && meta.uid() == uid()
+        && meta.permissions().mode() & 0o077 == 0 && root.canonicalize()? == root,
+        "original fixture root must be a real current-owner directory with mode 0700");
+    let prefix = root.join("ledgers");
+    ensure!(prefix.canonicalize()? == prefix && fs::metadata(&prefix)?.uid() == uid(),
+        "original fixture ledger prefix missing or changed");
+    Ok(())
+}
+
+fn private_bytes(path: &Path, maximum: u64) -> Result<Vec<u8>> {
+    let mut file = OpenOptions::new().read(true).custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK).open(path)?;
+    let meta = file.metadata()?;
+    ensure!(meta.is_file() && meta.uid() == uid() && meta.permissions().mode() & 0o077 == 0 && meta.len() <= maximum,
+        "resume file must be a bounded current-owner private regular file");
+    let mut bytes = Vec::new();
+    (&mut file).take(maximum + 1).read_to_end(&mut bytes)?;
+    ensure!(bytes.len() as u64 <= maximum, "resume file exceeded its bound");
+    Ok(bytes)
+}
+
+fn child(root: &Path, relative: &Path) -> Result<PathBuf> {
+    ensure!(!relative.as_os_str().is_empty() && relative.components().all(|part| matches!(part, Component::Normal(_))),
+        "resume path must be a simple relative child of the original fixture");
+    let path = root.join(relative);
+    ensure!(path.canonicalize()? == path && path.starts_with(root) && fs::metadata(&path)?.uid() == uid(),
+        "resume path changed, is not owned, or escaped the original fixture");
+    Ok(path)
+}
+
+fn check_vote_file(storage: &FileVoteHistoryStorage, identity: &Pubkey) -> Result<()> {
+    let path = storage.filename(identity);
+    let meta = fs::symlink_metadata(&path)?;
+    ensure!(path.canonicalize()? == path && meta.is_file() && meta.uid() == uid(),
+        "original signed vote-history path is not a real current-owner file");
+    Ok(())
+}
+
+// Live Alpenglow persists the certified BANK hash in optimistic_slots (see
+// votor::root_utils::set_root). bank_hash is filled by startup replay and the
+// Tower duplicate/repair path, so it may be absent in a healthy live Votor node.
+// Require the exact Votor-persisted hash and real root bit. If the optional
+// replay/repair hash exists, it must independently agree as well.
+fn retained_root(blockstore: &Blockstore, slot: u64, expected: &str) -> Result<(bool, Value)> {
+    let replay_hash = blockstore.get_bank_hash(slot).map(|hash| hash.to_string());
+    let certified_hash = blockstore.get_optimistic_slot(slot)?.map(|(hash, _)| hash.to_string());
+    let is_root = blockstore.is_root(slot);
+    let observation = json!({"slot": slot, "actual_bank_hash": expected,
+        "blockstore_bank_hash": replay_hash, "blockstore_is_root": is_root,
+        "blockstore_alpenglow_root_bank_hash": certified_hash});
+    ensure!(replay_hash.as_deref().is_none_or(|hash| hash == expected)
+        && certified_hash.as_deref().is_none_or(|hash| hash == expected),
+        "retained original BANK hash conflicts with the captured root: {observation}");
+    Ok((is_root && certified_hash.as_deref() == Some(expected), observation))
+}
+
+fn key(root: &Path, name: &str) -> Result<Keypair> {
+    let path = child(root, Path::new(name))?;
+    let bytes: Vec<u8> = serde_json::from_slice(&private_bytes(&path, 4096)?)?;
+    Keypair::try_from(bytes.as_slice()).map_err(|error| anyhow::anyhow!("invalid original fixture key: {error}"))
+}
+
+impl Manifest {
+    pub(super) fn load(root: &Path) -> Result<Self> {
+        check_root(root)?;
+        let value: Self = serde_json::from_slice(&private_bytes(&root.join("resume.json"), 65_536)?)?;
+        ensure!(value.format == "zolana-fast-process-resume-v1" && value.upstream_commit == UPSTREAM_COMMIT
+            && value.original_root == root && value.ledger_prefix == root.join("ledgers")
+            && (1..=3).contains(&value.nodes.len()) && (!value.slot_anchors || value.private),
+            "resume metadata is not this exact original bounded candidate fixture");
+        let mut identities = HashSet::new();
+        for node in &value.nodes {
+            ensure!(identities.insert(node.identity.clone()) && node.root_slot > 0,
+                "duplicate resume identity or missing pre-hold root");
+            let identity = key(root, &node.identity_file)?;
+            let voter = key(root, &node.voter_file)?;
+            ensure!(identity.pubkey().to_string() == node.identity && voter.pubkey().to_string() == node.voter,
+                "original identity or voting key differs from resume metadata");
+            let ledger = child(root, &node.ledger)?;
+            ensure!(ledger.starts_with(&value.ledger_prefix) && ledger != value.ledger_prefix && ledger.is_dir(),
+                "resume ledger is outside the explicit original candidate ledger prefix");
+            ensure!(GenesisConfig::load(&ledger)?.hash().to_string() == value.genesis_hash,
+                "original ledger genesis differs");
+            let storage = FileVoteHistoryStorage::new(ledger);
+            check_vote_file(&storage, &identity.pubkey())?;
+            let history = storage.load(&identity.pubkey()).context("verify original signed vote history")?;
+            ensure!(history.root() >= node.vote_history_root,
+                "signed vote history rolled behind its pre-hold checkpoint");
+        }
+        ensure!(key(root, "funding.json")?.pubkey().to_string() == value.funding_public_key,
+            "original fixture funding key differs");
+        Ok(value)
+    }
+
+    pub(super) fn apply_profile(&self, args: &mut Args) -> Result<()> {
+        args.nodes = self.nodes.len();
+        args.private = self.private;
+        args.slot_anchors = self.slot_anchors;
+        args.mac_relay = self.mac_relay.as_ref().map(|value| value.parse::<Pubkey>()).transpose()?;
+        Ok(())
+    }
+
+    pub(super) fn start(&self, root: &Path) -> Result<LocalCluster> {
+        let mut existing = Vec::new();
+        for node in &self.nodes {
+            existing.push((ExistingValidator {
+                identity: Arc::new(key(root, &node.identity_file)?),
+                voter: Arc::new(key(root, &node.voter_file)?),
+                ledger_path: child(root, &node.ledger)?,
+            }, pilot_validator_config(false)));
+        }
+        let genesis = GenesisConfig::load(&existing[0].0.ledger_path)?;
+        ensure!(genesis.hash().to_string() == self.genesis_hash, "resume genesis changed");
+        Ok(LocalCluster::resume_existing_alpenglow(genesis, key(root, "funding.json")?, existing,
+            self.shred_version, SocketAddrSpace::Unspecified)?)
+    }
+
+    pub(super) fn validate_restored(&self, cluster: &LocalCluster, args: &Args) -> Result<Value> {
+        ensure!(cluster.genesis_config.hash().to_string() == self.genesis_hash,
+            "resumed cluster substituted a genesis");
+        let began = Instant::now();
+        loop {
+            let mut peers = Vec::new();
+            for expected in &self.nodes {
+                let identity: Pubkey = expected.identity.parse()?;
+                let node = cluster.validators.get(&identity).context("resumed identity missing")?;
+                ensure!(node.info.ledger_path == args.root.join(&expected.ledger)
+                    && node.info.voting_keypair.pubkey().to_string() == expected.voter
+                    && node.config.require_vote_history && node.config.wait_for_supermajority.is_none()
+                    && node.config.new_hard_forks.is_none(), "resumed ledger/key/safety configuration differs");
+                let validator = node.validator.as_ref().context("resumed validator stopped")?;
+                let forks = validator.bank_forks.read().unwrap();
+                let bank = forks.root_bank();
+                if bank.slot() < expected.root_slot || !forks.migration_status().is_alpenglow_enabled() {
+                    continue;
+                }
+                ensure!(bank.feature_set.is_active(&agave_feature_set::alpenglow::id())
+                    && bank.get_alpenglow_genesis_certificate().is_some(),
+                    "resumed validator lacks original active Alpenglow state");
+                let (retained, root_evidence) = retained_root(&validator.blockstore,
+                    expected.root_slot, &expected.root_bank_hash)?;
+                ensure!(retained,
+                    "original pre-hold certified root BANK hash is absent in retained ledger: {root_evidence}");
+                ensure!(AncestorIterator::new_inclusive(bank.slot(), &validator.blockstore)
+                    .take(100_000).any(|slot| slot == expected.root_slot),
+                    "resumed root is not a descendant of the original pre-hold root");
+                if args.private {
+                    ensure!(zolana_native_check::native_features_for_profile(args.slot_anchors).iter()
+                        .all(|feature| bank.feature_set.is_active(feature)), "resumed native feature inactive");
+                    let account = bank.get_account(&native_payment_program::pool_address()).context("resumed native pool missing")?;
+                    use solana_account::ReadableAccount;
+                    let pool = native_payments::state::PoolState::decode(account.data()).map_err(|error| anyhow::anyhow!("{error}"))?;
+                    ensure!(pool.network == args.network() && pool.uses_slot_anchors() == args.slot_anchors,
+                        "resumed native network/profile differs; refusing migration");
+                }
+                peers.push(json!({"identity": expected.identity, "voter": expected.voter,
+                    "ledger": node.info.ledger_path, "original_root_slot": expected.root_slot,
+                    "original_root_bank_hash": expected.root_bank_hash, "resumed_root_slot": bank.slot(),
+                    "original_signed_vote_history_required": true, "original_root_is_ancestor": true,
+                    "retained_root_bank_hash_evidence": root_evidence}));
+            }
+            if peers.len() == self.nodes.len() {
+                return Ok(json!({"same_genesis": true, "whole_process_resume": true, "new_ports_only": true,
+                    "new_ledger_created": false, "vote_history_reset": false, "peers": peers}));
+            }
+            ensure!(began.elapsed() < Duration::from_secs(60), "resumed original roots did not recover before deadline");
+            sleep(Duration::from_millis(50));
+        }
+    }
+}
+
+pub(super) fn record(root: &Path, cluster: &LocalCluster, args: &Args) -> Result<()> {
+    if args.resume || root.join("resume.json").exists() {
+        Manifest::load(root)?;
+        return Ok(());
+    }
+    let mut nodes = Vec::new();
+    for (identity, node) in &cluster.validators {
+        let index = (0..args.nodes).find(|index| key(root, &format!("identity-{index}.json"))
+            .is_ok_and(|key| key.pubkey() == *identity)).context("original saved identity key path missing")?;
+        let storage = FileVoteHistoryStorage::new(node.info.ledger_path.clone());
+        check_vote_file(&storage, identity)?;
+        let history = storage.load(identity).context("verify signed vote history before hold")?;
+        let validator = node.validator.as_ref().context("cannot save stopped validator resume metadata")?;
+        // Pin one actual root. Do not chase advancing roots while waiting for
+        // the Votor/storage queues, and never hold BankForks locked during wait.
+        let (root_slot, root_bank_hash) = {
+            let forks = validator.bank_forks.read().unwrap();
+            let bank = forks.root_bank();
+            (bank.slot(), bank.hash().to_string())
+        };
+        ensure!(root_slot > 0, "pre-hold root has not advanced from genesis");
+        let began = Instant::now();
+        loop {
+            let (retained, observation) = retained_root(&validator.blockstore, root_slot, &root_bank_hash)?;
+            if began.elapsed() < Duration::from_millis(50) || retained {
+                eprintln!("{}", json!({"event": "pre_hold_root_storage_diagnostic", "identity": identity.to_string(),
+                    "elapsed_ms": began.elapsed().as_millis(), "retained": retained, "evidence": observation}));
+            }
+            if retained { break; }
+            ensure!(began.elapsed() < Duration::from_secs(20),
+                "pre-hold certified root BANK hash did not reach original blockstore: {observation}");
+            sleep(Duration::from_millis(50));
+        }
+        nodes.push(NodeRecord { identity: identity.to_string(), voter: node.info.voting_keypair.pubkey().to_string(),
+            identity_file: format!("identity-{index}.json"), voter_file: format!("voter-{index}.json"),
+            ledger: node.info.ledger_path.strip_prefix(root)?.to_owned(), root_slot,
+            root_bank_hash, vote_history_root: history.root() });
+    }
+    nodes.sort_by(|a, b| a.identity.cmp(&b.identity));
+    let manifest = Manifest { format: "zolana-fast-process-resume-v1".into(), upstream_commit: UPSTREAM_COMMIT.into(),
+        original_root: root.to_owned(), ledger_prefix: root.join("ledgers"),
+        genesis_hash: cluster.genesis_config.hash().to_string(), shred_version: cluster.shred_version(),
+        funding_public_key: cluster.funding_keypair.pubkey().to_string(), private: args.private,
+        slot_anchors: args.slot_anchors, mac_relay: args.mac_relay.map(|key| key.to_string()), nodes };
+    let mut file = OpenOptions::new().write(true).create_new(true).mode(0o600).custom_flags(libc::O_NOFOLLOW)
+        .open(root.join("resume.json"))?;
+    serde_json::to_writer_pretty(&mut file, &manifest)?;
+    file.write_all(b"\n")?;
+    file.sync_all()?;
+    File::open(root)?.sync_all()?;
+    Manifest::load(root)?;
+    Ok(())
+}
