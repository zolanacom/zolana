+/// Check real finalized statuses and recorded transaction bytes on every peer,
+/// then compare the exact native pool and permanent nullifier account state.
+fn audit_private(
+    cluster: &LocalCluster,
+    keys: &[Pubkey],
+    report: &Value,
+    expected_network: [u8; 32],
+    slot_anchors: bool,
+) -> Result<Value> {
+    let payments = report["payments"]
+        .as_array()
+        .context("missing private payment report")?;
+    ensure!(
+        payments.len() == 3,
+        "expected three private receive/change payments"
+    );
+    let mut peers = Vec::new();
+    let mut expected_state: Option<Value> = None;
+    for key in keys {
+        let rpc = client(cluster, key)?;
+        let started = Instant::now();
+        let mut finalized = Vec::new();
+        for payment in payments {
+            let signature: Signature = payment["signature"]
+                .as_str()
+                .context("missing exact native signature")?
+                .parse()?;
+            let expected_slot = payment["slot"]
+                .as_u64()
+                .context("missing native execution slot")?;
+            loop {
+                ensure!(
+                    started.elapsed() < Duration::from_secs(60),
+                    "private peer finality deadline exceeded"
+                );
+                let response = rpc.get_signature_statuses_with_history(&[signature])?;
+                if let Some(status) = &response.value[0] {
+                    ensure!(
+                        status.err.is_none() && status.status.is_ok(),
+                        "private execution failed on a peer"
+                    );
+                    if status.confirmation_status == Some(TransactionConfirmationStatus::Finalized)
+                    {
+                        ensure!(
+                            status.confirmations.is_none() && status.slot == expected_slot,
+                            "peer finalized a different native execution identity"
+                        );
+                        let root = rpc.get_slot_with_commitment(CommitmentConfig::finalized())?;
+                        ensure!(
+                            root >= status.slot,
+                            "peer root precedes private transaction"
+                        );
+                        let node = &cluster.validators[key];
+                        let validator =
+                            node.validator.as_ref().context("private peer is stopped")?;
+                        let entries = validator.blockstore.get_slot_entries(status.slot, 0)?;
+                        let recorded = entries
+                            .iter()
+                            .flat_map(|entry| &entry.transactions)
+                            .find(|transaction| transaction.signatures.first() == Some(&signature))
+                            .context(
+                                "finalized native transaction missing from recorded ledger entries",
+                            )?;
+                        let wire = wincode::serialize(recorded)?;
+                        ensure!(
+                            Some(wire.len() as u64) == payment["packet_bytes"].as_u64(),
+                            "recorded native transaction size differs from submitted packet"
+                        );
+                        ensure!(
+                            wire.len() > 1232,
+                            "private network test did not record the full oversized proof"
+                        );
+                        finalized.push(json!({"signature": signature.to_string(), "slot": status.slot,
+                            "finalized_root": root, "recorded_transaction_bytes": wire.len(),
+                            "recorded_transaction_sha256": solana_sha256_hasher::hash(&wire).to_string()}));
+                        break;
+                    }
+                }
+                sleep(Duration::from_millis(20));
+            }
+        }
+        // Read the rolling V4 pool at its own finalized context. Marker accounts
+        // are immutable, but live pool checkpoint buffers legitimately differ
+        // across peers that have rooted different empty blocks.
+        let response = rpc.get_account_with_commitment(
+            &native_payment_program::pool_address(),
+            CommitmentConfig::finalized(),
+        )?;
+        let pool_context = response.context.slot;
+        let pool_account = response.value.context("finalized native pool missing")?;
+        let mut anchor_observation = Value::Null;
+        let mut accounts = rpc.get_program_accounts(&native_payment_program::id())?;
+        let scanned_program_accounts = accounts.len();
+        accounts.sort_by_key(|(address, _)| *address);
+        let mut markers = 0;
+        let mut pool_state = None;
+        let mut observed = Vec::new();
+        for (address, scanned_account) in accounts {
+            let account = if address == native_payment_program::pool_address() {
+                pool_account.clone()
+            } else {
+                scanned_account
+            };
+            ensure!(
+                !account.executable && account.owner == native_payment_program::id(),
+                "invalid native account owner or executable state"
+            );
+            if address == native_payment_program::pool_address() {
+                let pool = native_payments::state::PoolState::decode(&account.data)
+                    .map_err(|error| anyhow::anyhow!("{error}"))?;
+                ensure!(
+                    pool.network == expected_network
+                        && pool.uses_slot_anchors() == slot_anchors
+                        && pool.note_count() == 8
+                        && pool.backing == 994,
+                    "finalized native pool differs from private payment accounting"
+                );
+                ensure!(
+                    account.lamports
+                        >= pool
+                            .rent_floor
+                            .checked_add(pool.backing)
+                            .context("pool backing overflow")?,
+                    "native pool has insufficient real backing"
+                );
+                pool_state = Some(
+                    json!({"note_count": pool.note_count(), "backing": pool.backing,
+                    "root": pool.root(), "network": pool.network,
+                    "rent_floor": pool.rent_floor, "slot_anchors": slot_anchors}),
+                );
+                if slot_anchors {
+                    let history = pool.slot_anchors().context("V4 slot checkpoints missing")?;
+                    let checkpoint = history
+                        .entries()
+                        .last()
+                        .context("V4 final checkpoint missing")?;
+                    ensure!(
+                        checkpoint.slot == pool_context
+                            && checkpoint.note_count == pool.note_count()
+                            && checkpoint.root == pool.root(),
+                        "V4 checkpoint does not bind its finalized account context"
+                    );
+                    anchor_observation = json!({"finalized_context_slot": pool_context,
+                        "checkpoint_slot": checkpoint.slot, "retained_checkpoints": history.entries().len(),
+                        "pool_data_sha256_at_context": solana_sha256_hasher::hash(&account.data).to_string()});
+                }
+            } else {
+                ensure!(
+                    account.data.len() == native_payment_program::nullifiers::MARKER_BYTES
+                        && &account.data[..8] == b"NSPENT01",
+                    "unexpected native account or malformed spent marker"
+                );
+                let nullifier: [u8; 32] = account.data[8..].try_into()?;
+                ensure!(
+                    native_payment_program::nullifiers::address(&nullifier) == address,
+                    "permanent nullifier marker address mismatch"
+                );
+                markers += 1;
+            }
+            observed.push(
+                json!({"address": address.to_string(), "lamports": account.lamports,
+                "data_sha256": if slot_anchors && address == native_payment_program::pool_address() {
+                    None
+                } else { Some(solana_sha256_hasher::hash(&account.data).to_string()) }}),
+            );
+        }
+        ensure!(
+            markers == 8 && pool_state.is_some(),
+            "missing native pool or permanent nullifiers: markers={}, pool_found={}, scanned_program_accounts={}, identity={}, pool_context_slot={}",
+            markers, pool_state.is_some(), scanned_program_accounts, key, pool_context
+        );
+        let state =
+            json!({"accounts": observed, "pool": pool_state, "permanent_nullifiers": markers});
+        if let Some(expected) = &expected_state {
+            ensure!(
+                *expected == state,
+                "canonical peers disagree on native state"
+            );
+        } else {
+            expected_state = Some(state.clone());
+        }
+        peers.push(json!({"identity": key.to_string(), "finalized_payments": finalized,
+            "pool_finalized_context_slot": pool_context, "slot_anchor_observation": anchor_observation}));
+    }
+    Ok(json!({"peers": peers, "native_state": expected_state}))
+}
+
+/// Stop two of the original three equal-stake nodes. A signed valid public
+/// packet and advancing local clocks must not manufacture finalized roots when
+/// only one third of stake remains. Restart exactly the original ledgers and
+/// signed voting histories, without a startup supermajority or hard-fork override.
+fn quorum_loss_rejoin(
+    cluster: &mut LocalCluster,
+    keys: &[Pubkey],
+    args: &Args,
+    private: Option<&(Value, Value)>,
+    evidence: &mut Evidence,
+) -> Result<()> {
+    ensure!(keys.len() == 3 && cluster.validators.len() == 3,
+        "quorum-loss test requires exactly three original equal-stake nodes");
+    let survivor = keys[0];
+    let mut stopped = Vec::new();
+    for identity in &keys[1..] {
+        let mut node = cluster.exit_node(identity);
+        let storage = FileVoteHistoryStorage::new(node.info.ledger_path.clone());
+        let history = storage.load(identity).context("verify original signed history before quorum rejoin")?;
+        let vote_file = storage.filename(identity);
+        ensure!(vote_file.canonicalize()? == vote_file && vote_file.is_file()
+            && node.info.ledger_path.canonicalize()? == node.info.ledger_path
+            && node.info.ledger_path.starts_with(args.root.join("ledgers")),
+            "quorum rejoin must retain the exact original ledger and voting history");
+        node.config.require_vote_history = true;
+        node.config.wait_for_supermajority = None;
+        ensure!(node.config.new_hard_forks.is_none() && node.config.warp_slot.is_none()
+            && node.config.run_verification && node.config.blockstore_options.recovery_mode.is_none(),
+            "quorum rejoin must not change verification or reset consensus state");
+        evidence.event("quorum_original_node_stopped", json!({"identity": identity.to_string(),
+            "ledger": node.info.ledger_path, "verified_signed_vote_history_root": history.root(),
+            "require_vote_history": true, "wait_for_supermajority": null,
+            "orderly_stop": true, "sigkill_test": false}))?;
+        stopped.push((*identity, node));
+    }
+    // Drain any certificate already received while all original voters were up.
+    sleep(Duration::from_secs(2));
+    let rpc = client(cluster, &survivor)?;
+    let root_before = rpc.get_slot_with_commitment(CommitmentConfig::finalized())?;
+    let bank_root_before = cluster.validators[&survivor].validator.as_ref()
+        .context("quorum survivor stopped")?.bank_forks.read().unwrap().root();
+    let destination = Keypair::new().pubkey();
+    let transaction = solana_system_transaction::transfer(&cluster.funding_keypair,
+        &destination, PUBLIC_AMOUNT, rpc.get_latest_blockhash()?);
+    let signature = transaction.signatures[0];
+    let returned = rpc.send_transaction_with_config(&transaction, RpcSendTransactionConfig {
+        skip_preflight: true, max_retries: Some(0), ..RpcSendTransactionConfig::default()
+    })?;
+    ensure!(returned == signature, "quorum probe signature substituted");
+    let began = Instant::now();
+    let mut observations = 0;
+    while began.elapsed() < Duration::from_secs(8) {
+        let response = rpc.get_signature_statuses_with_history(&[signature])?;
+        if let Some(status) = &response.value[0] {
+            ensure!(status.confirmation_status != Some(TransactionConfirmationStatus::Finalized),
+                "fresh transaction finalized with only one third of original stake online");
+        }
+        let rpc_root = rpc.get_slot_with_commitment(CommitmentConfig::finalized())?;
+        let bank_root = cluster.validators[&survivor].validator.as_ref()
+            .context("quorum survivor stopped")?.bank_forks.read().unwrap().root();
+        ensure!(rpc_root == root_before && bank_root == bank_root_before,
+            "finalized root advanced without quorum: RPC {root_before}->{rpc_root}, Bank {bank_root_before}->{bank_root}");
+        observations += 1;
+        sleep(Duration::from_millis(100));
+    }
+    evidence.event("insufficient_stake_did_not_finalize", json!({"survivor": survivor.to_string(),
+        "online_original_stake_numerator": 1, "online_original_stake_denominator": 3,
+        "probe_signature": signature.to_string(), "finalized_rpc_root": root_before,
+        "actual_bank_root": bank_root_before, "observation_count": observations,
+        "elapsed_ms": began.elapsed().as_millis(), "threshold_overrides": false}))?;
+    for (identity, node) in stopped {
+        cluster.restart_node(&identity, node, SocketAddrSpace::Unspecified);
+        let node = &cluster.validators[&identity];
+        ensure!(node.config.require_vote_history && node.config.wait_for_supermajority.is_none()
+            && node.config.new_hard_forks.is_none(), "rejoined node lost original-history safety configuration");
+    }
+    public_send(cluster, keys, args.samples + 2, evidence)?;
+    evidence.event("quorum_rejoined_original_ledgers_finalized", check_alpenglow(cluster, &args.root)?)?;
+    if let Some((report, expected_state)) = private {
+        let recovered = audit_private(cluster, keys, report, args.network(), args.slot_anchors)?;
+        ensure!(recovered["native_state"] == *expected_state,
+            "quorum loss/rejoin changed original private payments, pool or permanent nullifiers");
+        ensure!(native_endpoints(keys)?.len() == 3, "rejoined native listeners missing");
+        evidence.event("private_state_preserved_after_quorum_rejoin", recovered)?;
+    }
+    Ok(())
+}
+
+fn pilot_validator_config(initial_genesis: bool) -> ValidatorConfig {
+    let mut config = ValidatorConfig::default_for_test();
+    config.wait_for_supermajority = initial_genesis.then_some(0);
+    config.rpc_config.enable_rpc_transaction_history = true;
+    config.rpc_config.rpc_threads = 1;
+    config.rpc_config.rpc_blocking_threads = 1;
+    config.block_production_num_workers = NonZeroUsize::new(2).unwrap();
+    config
+}
