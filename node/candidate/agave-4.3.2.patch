+++ b/zolana-native/harness/tests/support/snapshot_roundtrip.rs
@@ -0,0 +1,75 @@
+//! Test-only use of Agave's real full archive and verified AccountsDb restore.
+//! This does not serialize only the native pool or assert network finality.
+use {
+    agave_snapshots::snapshot_config::SnapshotConfig,
+    solana_accounts_db::accounts_db::ACCOUNTS_DB_CONFIG_FOR_TESTING,
+    solana_genesis_config::GenesisConfig,
+    solana_hash::Hash,
+    solana_runtime::{
+        bank::Bank,
+        runtime_config::RuntimeConfig,
+        snapshot_bank_utils::{bank_from_snapshot_archives, bank_to_full_snapshot_archive},
+        snapshot_utils::create_tmp_accounts_dir_for_tests,
+    },
+    std::sync::Arc,
+    tempfile::TempDir,
+};
+
+/// Deterministic test ticks complete the slot before the ordinary freeze hook.
+pub fn complete_and_freeze(bank: &Bank) {
+    let mut hash = [0x53; 32];
+    hash[..8].copy_from_slice(&bank.slot().to_le_bytes());
+    let hash = Hash::from(hash);
+    while !bank.is_complete() {
+        bank.register_tick_for_test(&hash);
+    }
+    bank.set_block_id(Some(hash));
+    bank.freeze();
+}
+
+/// Keep the returned directories alive as long as the restored Bank/forks.
+/// Archive validation and accounts/hash verification are not disabled.
+pub fn full_snapshot_restore(bank: &Bank, genesis: &GenesisConfig) -> (Bank, Vec<TempDir>) {
+    assert!(bank.is_complete());
+    assert!(bank.is_frozen());
+    let bank_snapshots = tempfile::tempdir().unwrap();
+    let full_archives = tempfile::tempdir().unwrap();
+    let incremental_archives = tempfile::tempdir().unwrap();
+    let (accounts_parent, accounts_run) = create_tmp_accounts_dir_for_tests();
+    let config = SnapshotConfig {
+        bank_snapshots_dir: bank_snapshots.path().to_path_buf(),
+        full_snapshot_archives_dir: full_archives.path().to_path_buf(),
+        incremental_snapshot_archives_dir: incremental_archives.path().to_path_buf(),
+        use_direct_io: false,
+        use_registered_io_uring_buffers: false,
+        ..SnapshotConfig::default()
+    };
+    let archive = bank_to_full_snapshot_archive(&config, bank).unwrap();
+    let restored = bank_from_snapshot_archives(
+        &[accounts_run],
+        &archive,
+        None,
+        &config,
+        genesis,
+        &RuntimeConfig::default(),
+        None,
+        Some(*bank.leader()),
+        None,
+        false,
+        false,
+        true,
+        ACCOUNTS_DB_CONFIG_FOR_TESTING,
+        None,
+        Arc::default(),
+    )
+    .unwrap();
+    (
+        restored,
+        vec![
+            bank_snapshots,
+            full_archives,
+            incremental_archives,
+            accounts_parent,
+        ],
+    )
+}
