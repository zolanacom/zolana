+//! Narrow development harness recovery from original existing Alpenglow ledgers.
+//! This constructor creates sockets only; it never initializes a genesis/ledger.
+use {
+    super::*,
+    agave_votor::vote_history_storage::VoteHistoryStorage,
+    std::{collections::HashSet, fs, os::unix::fs::MetadataExt},
+};
+
+pub struct ExistingValidator {
+    pub identity: Arc<Keypair>,
+    pub voter: Arc<Keypair>,
+    pub ledger_path: PathBuf,
+}
+
+impl LocalCluster {
+    pub fn resume_existing_alpenglow(
+        genesis_config: GenesisConfig,
+        funding_keypair: Keypair,
+        existing: Vec<(ExistingValidator, ValidatorConfig)>,
+        shred_version: u16,
+        socket_addr_space: SocketAddrSpace,
+    ) -> Result<Self> {
+        if !(1..=3).contains(&existing.len())
+            || shred_version != compute_shred_version(&genesis_config.hash(), None)
+        {
+            return Err(Error::other("invalid bounded existing-ledger cluster"));
+        }
+        let mut identities = HashSet::new();
+        let mut prepared = Vec::new();
+        for (old, mut config) in existing {
+            if !identities.insert(old.identity.pubkey())
+                || old.ledger_path.canonicalize()? != old.ledger_path
+                || !fs::metadata(&old.ledger_path)?.is_dir()
+                || GenesisConfig::load(&old.ledger_path)?.hash() != genesis_config.hash()
+                || config.new_hard_forks.as_ref().is_some_and(|slots| !slots.is_empty())
+                || config.wait_for_supermajority.is_some()
+                || config.warp_slot.is_some()
+                || !config.run_verification
+                || config.blockstore_options.recovery_mode.is_some()
+            {
+                return Err(Error::other("existing genesis, identity, or verification configuration differs"));
+            }
+            // The upstream path helper migrates an old account layout if either
+            // subdirectory is absent. Recovery explicitly forbids that behavior.
+            for suffix in ["accounts/run", "accounts/snapshot", "rocksdb"] {
+                let path = old.ledger_path.join(suffix);
+                if path.canonicalize()? != path || !fs::metadata(&path)?.is_dir()
+                    || fs::metadata(&path)?.uid() != fs::metadata(&old.ledger_path)?.uid() {
+                    return Err(Error::other("original account layout missing; refusing migration"));
+                }
+            }
+            let storage = FileVoteHistoryStorage::new(old.ledger_path.clone());
+            let vote_file = storage.filename(&old.identity.pubkey());
+            if vote_file.canonicalize()? != vote_file || !fs::symlink_metadata(&vote_file)?.is_file()
+                || fs::metadata(&vote_file)?.uid() != fs::metadata(&old.ledger_path)?.uid() {
+                return Err(Error::other("original signed vote history missing"));
+            }
+            storage.load(&old.identity.pubkey())
+                .map_err(|error| Error::other(format!("invalid original signed vote history: {error}")))?;
+            config.require_vote_history = true;
+            config.expected_genesis_hash = Some(genesis_config.hash());
+            config.expected_shred_version = Some(shred_version);
+            let mut node = Node::new_localhost_with_pubkey(&old.identity.pubkey());
+            node.info.set_shred_version(shred_version);
+            config.rpc_addrs = Some((node.info.rpc().unwrap(), node.info.rpc_pubsub().unwrap()));
+            let record = ClusterValidatorInfo {
+                info: ValidatorInfo {
+                    keypair: old.identity,
+                    voting_keypair: old.voter,
+                    ledger_path: old.ledger_path,
+                    contact_info: node.info.clone(),
+                },
+                config,
+                validator: None,
+            };
+            prepared.push((node, record));
+        }
+        let contacts: Vec<_> = prepared.iter().map(|(node, _)| node.info.clone()).collect();
+        let mut cluster = Self {
+            funding_keypair,
+            entry_point_info: contacts[0].clone(),
+            validators: HashMap::new(),
+            genesis_config,
+            shred_version,
+        };
+        let mut failure = None;
+        std::thread::scope(|scope| {
+            let mut handles = Vec::new();
+            for (node, record) in prepared {
+                let identity = record.info.keypair.pubkey();
+                let peers = contacts.iter().filter(|peer| peer.pubkey() != &identity).cloned().collect();
+                handles.push(scope.spawn(move || {
+                    Self::restart_node_with_context(record, (node, peers), socket_addr_space)
+                }));
+            }
+            for handle in handles {
+                match handle.join() {
+                    Ok(record) => { cluster.validators.insert(record.info.keypair.pubkey(), record); }
+                    Err(_) => { failure = Some(Error::other("existing-ledger validator startup panicked; original ledgers preserved")); }
+                }
+            }
+        });
+        if let Some(error) = failure {
+            cluster.close_preserve_ledgers();
+            return Err(error);
+        }
+        Ok(cluster)
+    }
+}
