+++ b/zolana-native/harness/src/rpc_smoke.rs
@@ -0,0 +1,308 @@
+//! Synthetic payments over native ingress, with actual finality read over RPC.
+//! Run only against an
+//! isolated candidate whose native pool is empty; never resets existing state.
+use native_payment_program::{instructions, pool_address, staging::ACCOUNT_BYTES};
+use native_payments::{staging::{payload_digest, MAX_CHUNK_BYTES}, state::PoolState, wire};
+use native_wallet::{history::WalletState, keys::{Network, WalletKey}, payments::{Payment, PaymentProver}};
+use solana_commitment_config::CommitmentConfig;
+use solana_compute_budget_interface::ComputeBudgetInstruction;
+use solana_instruction::Instruction;
+use solana_keypair::Keypair;
+use solana_rpc_client::rpc_client::RpcClient;
+use solana_signer::Signer;
+use solana_system_interface::instruction as system;
+use solana_transaction::{Transaction, versioned::VersionedTransaction};
+use std::{io::{BufRead, BufReader, Read, Write}, net::{SocketAddr, TcpStream}, thread::sleep, time::{Duration, Instant}};
+
+type Result<T> = std::result::Result<T, Box<dyn std::error::Error>>;
+
+fn tx(client: &RpcClient, relay: &Keypair, list: &[Instruction], extra: &[&Keypair]) -> Result<Transaction> {
+    let mut signers = vec![relay];
+    signers.extend_from_slice(extra);
+    Ok(Transaction::new_signed_with_payer(list, Some(&relay.pubkey()), &signers, client.get_latest_blockhash()?))
+}
+fn send_finalized(client: &RpcClient, transaction: &Transaction) -> Result<(String, u64)> {
+    let signature = client.send_transaction(transaction)?;
+    let start = Instant::now();
+    while start.elapsed() < Duration::from_secs(30) {
+        let response = client.get_signature_statuses(&[signature])?;
+        if let Some(status) = &response.value[0] {
+            if let Some(error) = &status.err {
+                return Err(format!("candidate transaction failed: {error:?}").into());
+            }
+            if status.satisfies_commitment(CommitmentConfig::finalized()) {
+                return Ok((signature.to_string(), status.slot));
+            }
+        }
+        sleep(Duration::from_millis(20));
+    }
+    Err("timed out waiting for genuine RPC finalized status".into())
+}
+/// Admission acknowledgements never resolve a payment. Every retry uses the
+/// exact same signed bytes; only an execution status marked finalized succeeds.
+fn native_finalized(client: &RpcClient, transaction: &Transaction, endpoints: &[SocketAddr]) -> Result<(String, u64)> {
+    let versioned: VersionedTransaction = transaction.clone().into();
+    let wire = wincode::serialize(&versioned)?;
+    if wire.len() > solana_runtime::native_payment_admission::MAX_NATIVE_TRANSACTION_BYTES {
+        return Err("native transaction exceeds the pilot wire bound".into());
+    }
+    let signature = transaction.signatures[0];
+    let start = Instant::now();
+    let mut next_send = Instant::now();
+    while start.elapsed() < Duration::from_secs(30) {
+        if Instant::now() >= next_send {
+            for endpoint in endpoints {
+                // A closed connection or lost ACK leaves the same transaction
+                // pending. Re-send its exact bytes to the next candidate leader.
+                let _ = submit_native(*endpoint, &wire, &signature.to_string());
+            }
+            next_send = Instant::now() + Duration::from_millis(250);
+        }
+        let response = client.get_signature_statuses(&[signature])?;
+        if let Some(status) = &response.value[0] {
+            if let Some(error) = &status.err {
+                return Err(format!("native payment execution failed: {error:?}").into());
+            }
+            if status.satisfies_commitment(CommitmentConfig::finalized()) {
+                return Ok((signature.to_string(), status.slot));
+            }
+        }
+        sleep(Duration::from_millis(20));
+    }
+    Err(format!("native payment still unresolved after timeout; retain exact signature {signature}").into())
+}
+fn submit_native(endpoint: SocketAddr, wire: &[u8], expected_signature: &str) -> Result<()> {
+    if !endpoint.ip().is_loopback() {
+        return Err("pilot native ingress endpoints must be loopback".into());
+    }
+    let mut stream = TcpStream::connect_timeout(&endpoint, Duration::from_millis(250))?;
+    stream.set_nodelay(true)?;
+    stream.set_read_timeout(Some(Duration::from_millis(500)))?;
+    stream.set_write_timeout(Some(Duration::from_millis(500)))?;
+    stream.write_all(&(u32::try_from(wire.len())?).to_le_bytes())?;
+    stream.write_all(wire)?;
+    let mut line = String::new();
+    BufReader::new(stream.take(2_048)).read_line(&mut line)?;
+    let response: serde_json::Value = serde_json::from_str(&line)?;
+    if response["finalized"] != false {
+        return Err("ingress acknowledgement made an invalid finality claim".into());
+    }
+    if response["status"] == "admitted" && response["signature"] == expected_signature {
+        return Ok(());
+    }
+    Err(format!("native admission pending: {}", response["status"]).into())
+}
+/// Returns one coherent finalized account snapshot. A later RPC response may
+/// have advanced its root; this exact account and its context slot stay paired.
+fn finalized_pool_snapshot(client: &RpcClient, minimum_slot: u64) -> Result<(PoolState, u64)> {
+    for _ in 0..50 {
+        let response = client.get_account_with_commitment(&pool_address(), CommitmentConfig::finalized())?;
+        let context_slot = response.context.slot;
+        let account = response.value.ok_or("native pool missing")?;
+        if account.owner != native_payment_program::id() {
+            return Err("candidate pool owner mismatch".into());
+        }
+        let pool = PoolState::decode(&account.data)?;
+        let coherent = !pool.uses_slot_anchors() || pool.slot_anchors()
+            .and_then(|history| history.entries().last())
+            .is_some_and(|checkpoint| checkpoint.slot == context_slot && checkpoint.note_count == pool.note_count() && checkpoint.root == pool.root());
+        if context_slot >= minimum_slot && coherent {
+            return Ok((pool, context_slot));
+        }
+        sleep(Duration::from_millis(20));
+    }
+    Err("finalized pool snapshot did not reach its canonical slot checkpoint".into())
+}
+fn finalized_pool(client: &RpcClient) -> Result<PoolState> {
+    Ok(finalized_pool_snapshot(client, 0)?.0)
+}
+
+/// This synthetic isolated runner knows every native payment it submits. It
+/// verifies that payment in its actual finalized execution slot, seals every
+/// produced canonical block (including empty blocks), and reconciles against the
+/// exact account snapshot at S. An unexpected other payment fails reconciliation.
+fn synchronize(
+    client: &RpcClient,
+    states: &mut [&mut WalletState],
+    known_payment: Option<(&[u8], u64)>,
+    network: [u8; 32],
+) -> Result<u64> {
+    let minimum_slot = known_payment.map_or(0, |(_, slot)| slot);
+    let (pool, snapshot_slot) = finalized_pool_snapshot(client, minimum_slot)?;
+    if !pool.uses_slot_anchors() {
+        if let Some((bytes, slot)) = known_payment {
+            let decoded = wire::decode(network, bytes)?;
+            for state in states.iter_mut() {
+                state.accept(&decoded.bundle, &decoded.context, slot)?;
+            }
+        }
+        for state in states.iter() {
+            state.reconcile(&pool)?;
+        }
+        return Ok(snapshot_slot);
+    }
+    let first = states.first().ok_or("no wallet replay states")?;
+    let last = first.pool.slot_anchors().and_then(|history| history.entries().last())
+        .ok_or("V4 wallet must seal authenticated empty genesis slot zero first")?.slot;
+    if snapshot_slot < last {
+        return Err("finalized RPC snapshot moved behind wallet history".into());
+    }
+    if states.iter().any(|state| state.pool.slot_anchors().and_then(|h| h.entries().last()).map(|c| c.slot) != Some(last)) {
+        return Err("wallet replay heads differ".into());
+    }
+    // The runner has a deliberately bounded fresh-chain replay range. It never
+    // invents checkpoints for skipped slots or copies an RPC anchor assertion.
+    if snapshot_slot - last > 10_000 {
+        return Err("fresh pilot wallet synchronization exceeded its bounded replay range".into());
+    }
+    let produced = if snapshot_slot == last {
+        Vec::new()
+    } else {
+        client.get_blocks_with_commitment(last + 1, Some(snapshot_slot), CommitmentConfig::finalized())?
+    };
+    if snapshot_slot > last && produced.last() != Some(&snapshot_slot) {
+        return Err("canonical block list does not reach the pool snapshot context".into());
+    }
+    if produced.windows(2).any(|pair| pair[0] >= pair[1])
+        || produced.iter().any(|slot| *slot <= last || *slot > snapshot_slot) {
+        return Err("canonical block list is unordered or outside the snapshot range".into());
+    }
+    if let Some((_, slot)) = known_payment {
+        if !produced.contains(&slot) {
+            return Err("finalized payment slot is missing from canonical replay range".into());
+        }
+    }
+    let decoded = known_payment.map(|(bytes, slot)| wire::decode(network, bytes).map(|payment| (payment, slot))).transpose()?;
+    for slot in produced {
+        if let Some((payment, payment_slot)) = &decoded {
+            if slot == *payment_slot {
+                for state in states.iter_mut() {
+                    state.accept(&payment.bundle, &payment.context, slot)?;
+                }
+            }
+        }
+        for state in states.iter_mut() {
+            state.finish_slot(slot)?;
+        }
+    }
+    for state in states.iter() {
+        state.reconcile(&pool)?;
+    }
+    Ok(snapshot_slot)
+}
+fn fund(client: &RpcClient, relay: &Keypair, bytes: &[u8], network: [u8;32], expiry: u64) -> Result<u64> {
+    let buffer = Keypair::new();
+    let create = tx(client, relay, &[
+        system::create_account(&relay.pubkey(), &buffer.pubkey(), client.get_minimum_balance_for_rent_exemption(ACCOUNT_BYTES)?, ACCOUNT_BYTES as u64, &native_payment_program::id()),
+        instructions::initialize(buffer.pubkey(), relay.pubkey(), bytes.len() as u32, payload_digest(bytes), expiry),
+    ], &[&buffer])?;
+    send_finalized(client, &create)?;
+    for (i, chunk) in bytes.chunks(MAX_CHUNK_BYTES).enumerate() {
+        send_finalized(client, &tx(client, relay, &[instructions::write(buffer.pubkey(), relay.pubkey(), (i * MAX_CHUNK_BYTES) as u32, chunk)], &[])?)?;
+    }
+    send_finalized(client, &tx(client, relay, &[instructions::seal(buffer.pubkey(), relay.pubkey())], &[])?)?;
+    let decoded = wire::decode(network, bytes)?;
+    let nfs = std::array::from_fn(|i| decoded.bundle.actions()[i].nullifier().to_bytes());
+    let mut list = vec![ComputeBudgetInstruction::set_compute_unit_limit(1_400_000)];
+    list.extend(instructions::finalize_and_close(buffer.pubkey(), relay.pubkey(), nfs, None));
+    let (_, slot) = send_finalized(client, &tx(client, relay, &list, &[])?)?;
+    Ok(slot)
+}
+
+fn expected_markers(network: [u8; 32], payload: &[u8]) -> Result<Vec<serde_json::Value>> {
+    let decoded = wire::decode(network, payload)?;
+    Ok(decoded.bundle.actions().iter().map(|action| {
+        let nullifier = action.nullifier().to_bytes();
+        serde_json::json!({"address": native_payment_program::nullifiers::address(&nullifier).to_string(),
+            "nullifier": nullifier, "marker_bytes": native_payment_program::nullifiers::MARKER_BYTES})
+    }).collect())
+}
+
+/// Two successive private receives and Alice's change reuse. Proof preparation
+/// and recipient readiness are included in the per-payment measurements.
+/// The initial proving key and deposit are separately recorded setup costs.
+pub fn run_with_ingress(client: &RpcClient, relay: &Keypair, endpoints: &[SocketAddr]) -> Result<serde_json::Value> {
+    if endpoints.is_empty() {
+        return Err("native ingress endpoint required; ordinary RPC retains its packet cap".into());
+    }
+    let pool = finalized_pool(client)?;
+    if pool.note_count() != 0 || pool.backing != 0 {
+        return Err("RPC smoke requires a fresh isolated native pool; existing pool was preserved".into());
+    }
+    let network = Network { network: pool.network, genesis_hash: client.get_genesis_hash()?.to_string() };
+    let alice = WalletKey::generate(network.clone())?;
+    let bob = WalletKey::generate(network.clone())?;
+    let charlie = WalletKey::generate(network)?;
+    let state_key_started = Instant::now();
+    let create_state = |wallet: &WalletKey| -> Result<WalletState> {
+        if pool.uses_slot_anchors() {
+            let mut state = WalletState::new_slot_anchored(wallet, pool.rent_floor)?;
+            state.finish_slot(0)?;
+            Ok(state)
+        } else {
+            WalletState::new(wallet, pool.rent_floor)
+        }
+    };
+    let mut a = create_state(&alice)?;
+    let mut b = create_state(&bob)?;
+    let mut c = create_state(&charlie)?;
+    let state_key_ms = state_key_started.elapsed().as_millis();
+    let initial_sync_started = Instant::now();
+    synchronize(client, &mut [&mut a, &mut b, &mut c], None, pool.network)?;
+    let initial_sync_ms = initial_sync_started.elapsed().as_millis();
+    let start = Instant::now();
+    let prover = PaymentProver::new();
+    let key_ms = start.elapsed().as_millis();
+    let expiry = client.get_slot()? + 1_000;
+    let deposit = prover.build(&alice, &a, relay.pubkey().to_bytes(), expiry, Payment::Deposit { amount: 1_000, recipient: &alice.address_text() })?;
+    let mut expected_nullifiers = expected_markers(pool.network, &deposit)?;
+    let slot = fund(client, relay, &deposit, pool.network, expiry)?;
+    synchronize(client, &mut [&mut a, &mut b, &mut c], Some((&deposit, slot)), pool.network)?;
+    let mut timings = Vec::new();
+    for step in 0..3 {
+        let started = Instant::now();
+        synchronize(client, &mut [&mut a, &mut b, &mut c], None, pool.network)?;
+        let expiry = client.get_slot()? + 1_000;
+        let proof_started = Instant::now();
+        let prep_ms = proof_started.duration_since(started).as_millis();
+        let bytes = match step {
+            0 => prover.build(&alice, &a, relay.pubkey().to_bytes(), expiry, Payment::ShieldedSend { amount: 100, recipient: &bob.address_text(), fee: 2 })?,
+            1 => prover.build(&bob, &b, relay.pubkey().to_bytes(), expiry, Payment::ShieldedSend { amount: 40, recipient: &charlie.address_text(), fee: 2 })?,
+            _ => prover.build(&alice, &a, relay.pubkey().to_bytes(), expiry, Payment::ShieldedSend { amount: 20, recipient: &charlie.address_text(), fee: 2 })?,
+        };
+        let proof_ms = proof_started.elapsed().as_millis();
+        let transaction = tx(client, relay, &[
+            ComputeBudgetInstruction::set_compute_unit_limit(1_400_000),
+            instructions::inline(pool.network, &bytes)?,
+        ], &[])?;
+        let versioned: VersionedTransaction = transaction.clone().into();
+        let packet_bytes = wincode::serialized_size(&versioned)?;
+        let (signature, slot) = native_finalized(client, &transaction, endpoints)?;
+        let finalized_ms = started.elapsed().as_millis();
+        let replay_context_slot = synchronize(client, &mut [&mut a, &mut b, &mut c], Some((&bytes, slot)), pool.network)?;
+        let ready_ms = started.elapsed().as_millis();
+        expected_nullifiers.extend(expected_markers(pool.network, &bytes)?);
+        timings.push(serde_json::json!({
+            "payment": (["alice_to_bob", "bob_to_charlie", "alice_change_to_charlie"][step]),
+            "prep_ms": prep_ms, "proof_ms": proof_ms, "finalized_ms": finalized_ms,
+            "in_memory_recipient_spendable_ms": ready_ms, "packet_bytes": packet_bytes,
+            "signature": signature, "slot": slot, "wallet_replay_context_slot": replay_context_slot,
+        }));
+    }
+    if (a.balance()?, b.balance()?, c.balance()?) != (876, 58, 60) {
+        return Err("final private balances failed conservation check".into());
+    }
+    let last_pool = finalized_pool(client)?;
+    if last_pool.backing != 994 || last_pool.note_count() != 8 {
+        return Err("final pool backing or commitment count mismatch".into());
+    }
+    Ok(serde_json::json!({
+        "pool_profile": if pool.uses_slot_anchors() { "NPOOL004-slot-anchors" } else { "NPOOL003-legacy" },
+        "network": pool.network,
+        "wallet_verification_key_setup_ms": state_key_ms, "initial_sync_ms": initial_sync_ms, "proof_key_setup_ms": key_ms, "payments": timings,
+        "alice_balance": a.balance()?, "bob_balance": b.balance()?, "charlie_balance": c.balance()?,
+        "pool_backing": last_pool.backing, "pool_note_count": last_pool.note_count(),
+        "expected_nullifiers": expected_nullifiers,
+        "scope": "isolated native-ingress synthetic test; finalized status via RPC; verified/decrypted in-memory recipient state; no durable wallet or light-client certificate claim",
+    }))
+}
