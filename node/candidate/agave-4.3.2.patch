new file mode 100644
--- /dev/null
+++ b/zolana-native/harness/tests/slot_anchors.rs
@@ -0,0 +1,125 @@
+//! Freeze/hash/state recovery evidence; no transaction finality claim.
+use {
+    native_payment_program::{SLOT_ANCHOR_ACTIVATION_ID, id, pool_address},
+    native_payments::state::{PoolState, SLOT_STATE_BYTES, STATE_BYTES},
+    solana_account::{AccountSharedData, ReadableAccount},
+    solana_feature_gate_interface::{Feature, create_account},
+    solana_genesis_config::GenesisConfig,
+    solana_leader_schedule::SlotLeader,
+    solana_runtime::{bank::Bank, bank_forks::BankForks},
+};
+
+fn genesis(v4: bool, enabled: bool) -> GenesisConfig {
+    let mut genesis = GenesisConfig::default();
+    let bytes = if v4 { SLOT_STATE_BYTES } else { STATE_BYTES };
+    let floor = genesis.rent.minimum_balance(bytes);
+    let state = if v4 {
+        PoolState::new_slot_anchored([43; 32], floor).unwrap()
+    } else {
+        PoolState::new([42; 32], floor).unwrap()
+    };
+    let mut pool = AccountSharedData::new(floor, bytes, &id());
+    pool.set_data_from_slice(&state.encode());
+    genesis.accounts.insert(pool_address(), pool.into());
+    if enabled {
+        genesis.accounts.insert(
+            SLOT_ANCHOR_ACTIVATION_ID,
+            create_account(
+                &Feature {
+                    activated_at: Some(0),
+                },
+                1_000_000,
+            )
+            .into(),
+        );
+    }
+    genesis
+}
+
+fn pool(bank: &Bank) -> PoolState {
+    PoolState::decode(bank.get_account(&pool_address()).unwrap().data()).unwrap()
+}
+
+#[test]
+fn freeze_checkpoints_empty_slots_and_is_hash_deterministic_on_replay() {
+    let genesis = genesis(true, true);
+    let forks = BankForks::new_rw_arc(Bank::new_for_tests(&genesis));
+    let independent_forks = BankForks::new_rw_arc(Bank::new_for_tests(&genesis));
+    let parent = forks.read().unwrap().root_bank();
+    let independent = independent_forks.read().unwrap().root_bank();
+    parent.freeze();
+    independent.freeze();
+    assert_eq!(parent.hash(), independent.hash());
+    assert_eq!(pool(&parent).slot_anchors().unwrap().entries()[0].slot, 0);
+    let bytes = pool(&parent).encode();
+    parent.freeze();
+    assert_eq!(pool(&parent).encode(), bytes);
+
+    let leader = SlotLeader::new_unique();
+    let child = Bank::new_from_parent(parent, leader, 3);
+    let child = forks
+        .write()
+        .unwrap()
+        .insert(child)
+        .clone_without_scheduler();
+    let replay = Bank::new_from_parent(independent, leader, 3);
+    let replay = independent_forks
+        .write()
+        .unwrap()
+        .insert(replay)
+        .clone_without_scheduler();
+    child.freeze();
+    replay.freeze();
+    assert_eq!(child.hash(), replay.hash());
+    assert_eq!(pool(&child).encode(), pool(&replay).encode());
+    assert_eq!(
+        pool(&child)
+            .slot_anchors()
+            .unwrap()
+            .entries()
+            .iter()
+            .map(|entry| entry.slot)
+            .collect::<Vec<_>>(),
+        vec![0, 3]
+    );
+
+    let checkpoint = PoolState::decode(&pool(&child).encode()).unwrap();
+    assert_eq!(checkpoint.encode(), pool(&child).encode());
+    let grandchild = Bank::new_from_parent(child, leader, 1024);
+    let grandchild = forks
+        .write()
+        .unwrap()
+        .insert(grandchild)
+        .clone_without_scheduler();
+    grandchild.freeze();
+    assert_eq!(
+        pool(&grandchild)
+            .slot_anchors()
+            .unwrap()
+            .entries()
+            .iter()
+            .map(|entry| entry.slot)
+            .collect::<Vec<_>>(),
+        vec![1024]
+    );
+    assert!(pool(&grandchild).accepted_roots(1024).unwrap().is_empty());
+    assert!(
+        pool(&grandchild)
+            .accepted_roots(1025)
+            .unwrap()
+            .contains(&pool(&grandchild).root())
+    );
+}
+
+#[test]
+fn feature_activation_does_not_migrate_legacy_state_and_v4_gate_is_explicit() {
+    let genesis = genesis(false, true);
+    let legacy = Bank::new_for_tests(&genesis);
+    let before = pool(&legacy).encode();
+    legacy.freeze();
+    assert_eq!(pool(&legacy).encode(), before);
+    assert!(!pool(&legacy).uses_slot_anchors());
+    let inactive = Bank::new_for_tests(&self::genesis(true, false));
+    inactive.freeze();
+    assert!(pool(&inactive).slot_anchors().unwrap().entries().is_empty());
+}
diff --git a/zolana-native/harness/tests/snapshot_recovery.rs b/zolana-native/harness/tests/snapshot_recovery.rs
new file mode 100644
--- /dev/null
+++ b/zolana-native/harness/tests/snapshot_recovery.rs
@@ -0,0 +1,540 @@
+//! Real full-snapshot/AccountsDb recovery with V4 native payment proofs.
+//! A Bank fixture verifies persistence and replay protection, not consensus finality.
+#[path = "support/snapshot_roundtrip.rs"]
+mod snapshot_roundtrip;
+
+use {
+    native_payment_program::{
+        ACTIVATION_ID, INLINE_PAYMENT_ACTIVATION_ID, SHIELDED_FEE_ACTIVATION_ID,
+        SLOT_ANCHOR_ACTIVATION_ID, id, instructions, nullifiers, pool_address,
+        staging::ACCOUNT_BYTES,
+    },
+    native_payments::{
+        staging::{MAX_CHUNK_BYTES, payload_digest},
+        state::{PoolState, SLOT_STATE_BYTES},
+        wire,
+    },
+    native_wallet::{
+        history::WalletState,
+        keys::{Network, WalletKey},
+        payments::{Payment, PaymentProver},
+    },
+    payment_lab::proof_smoke::FIXTURE_GENESIS,
+    snapshot_roundtrip::{complete_and_freeze, full_snapshot_restore},
+    solana_account::{AccountSharedData, ReadableAccount, WritableAccount},
+    solana_compute_budget_interface::ComputeBudgetInstruction,
+    solana_feature_gate_interface::{Feature, create_account},
+    solana_genesis_config::GenesisConfig,
+    solana_instruction_error::InstructionError,
+    solana_keypair::Keypair,
+    solana_pubkey::Pubkey,
+    solana_rent::Rent,
+    solana_runtime::{bank::Bank, bank_forks::BankForks},
+    solana_signer::Signer,
+    solana_system_interface::instruction as system,
+    solana_transaction::{Transaction, TransactionVerificationMode},
+    solana_transaction_error::TransactionError,
+    std::{
+        collections::BTreeSet,
+        sync::{Arc, RwLock},
+    },
+};
+
+fn genesis(relay: &Keypair) -> GenesisConfig {
+    let mut config = GenesisConfig::default();
+    config.rent = Rent::free();
+    config.accounts.insert(
+        relay.pubkey(),
+        AccountSharedData::new(10_000_000_000, 0, &solana_sdk_ids::system_program::id()).into(),
+    );
+    // The pool itself must remain live on a free-rent fixture as well.
+    let floor = config.rent.minimum_balance(SLOT_STATE_BYTES).max(1);
+    let mut pool = AccountSharedData::new(floor, SLOT_STATE_BYTES, &id());
+    pool.set_data_from_slice(
+        &PoolState::new_slot_anchored(FIXTURE_GENESIS, floor)
+            .unwrap()
+            .encode(),
+    );
+    config.accounts.insert(pool_address(), pool.into());
+    for feature in [
+        ACTIVATION_ID,
+        INLINE_PAYMENT_ACTIVATION_ID,
+        SHIELDED_FEE_ACTIVATION_ID,
+        SLOT_ANCHOR_ACTIVATION_ID,
+    ] {
+        config.accounts.insert(
+            feature,
+            create_account(
+                &Feature {
+                    activated_at: Some(0),
+                },
+                1_000_000,
+            )
+            .into(),
+        );
+    }
+    config
+}
+
+fn pool(bank: &Bank) -> PoolState {
+    PoolState::decode(bank.get_account(&pool_address()).unwrap().data()).unwrap()
+}
+
+fn child(forks: &Arc<RwLock<BankForks>>, parent: &Arc<Bank>, slot: u64) -> Arc<Bank> {
+    assert!(parent.is_frozen());
+    let next = Bank::new_from_parent(Arc::clone(parent), *parent.leader(), slot);
+    forks
+        .write()
+        .unwrap()
+        .insert(next)
+        .clone_without_scheduler()
+}
+
+fn inline(bank: &Bank, relay: &Keypair, payload: &[u8]) -> Transaction {
+    Transaction::new_signed_with_payer(
+        &[
+            ComputeBudgetInstruction::set_compute_unit_limit(1_400_000),
+            instructions::inline(FIXTURE_GENESIS, payload).unwrap(),
+        ],
+        Some(&relay.pubkey()),
+        &[relay],
+        bank.last_blockhash(),
+    )
+}
+
+// Deposits use the supported V1/V2 staging path. The complete inline envelope
+// is intentionally reserved for V3 shielded-fee payments.
+fn staged_deposit(bank: &Bank, relay: &Keypair, payload: &[u8]) {
+    let buffer = Keypair::new();
+    let create = Transaction::new_signed_with_payer(
+        &[
+            system::create_account(
+                &relay.pubkey(),
+                &buffer.pubkey(),
+                bank.get_minimum_balance_for_rent_exemption(ACCOUNT_BYTES),
+                ACCOUNT_BYTES as u64,
+                &id(),
+            ),
+            instructions::initialize(
+                buffer.pubkey(),
+                relay.pubkey(),
+                payload.len() as u32,
+                payload_digest(payload),
+                64,
+            ),
+        ],
+        Some(&relay.pubkey()),
+        &[relay, &buffer],
+        bank.last_blockhash(),
+    );
+    bank.process_transaction(&create).unwrap();
+    for (index, chunk) in payload.chunks(MAX_CHUNK_BYTES).enumerate() {
+        let write = Transaction::new_signed_with_payer(
+            &[instructions::write(
+                buffer.pubkey(),
+                relay.pubkey(),
+                (index * MAX_CHUNK_BYTES) as u32,
+                chunk,
+            )],
+            Some(&relay.pubkey()),
+            &[relay],
+            bank.last_blockhash(),
+        );
+        bank.process_transaction(&write).unwrap();
+    }
+    let seal = Transaction::new_signed_with_payer(
+        &[instructions::seal(buffer.pubkey(), relay.pubkey())],
+        Some(&relay.pubkey()),
+        &[relay],
+        bank.last_blockhash(),
+    );
+    bank.process_transaction(&seal).unwrap();
+    let decoded = wire::decode(FIXTURE_GENESIS, payload).unwrap();
+    let nullifiers = std::array::from_fn(|i| decoded.bundle.actions()[i].nullifier().to_bytes());
+    let mut instructions = vec![ComputeBudgetInstruction::set_compute_unit_limit(1_400_000)];
+    instructions.extend(instructions::finalize_and_close(
+        buffer.pubkey(),
+        relay.pubkey(),
+        nullifiers,
+        None,
+    ));
+    let finalization = Transaction::new_signed_with_payer(
+        &instructions,
+        Some(&relay.pubkey()),
+        &[relay],
+        bank.last_blockhash(),
+    );
+    bank.process_transaction(&finalization).unwrap();
+    assert!(bank.get_account(&buffer.pubkey()).is_none());
+}
+
+fn accept(states: &mut [&mut WalletState], bank: &Bank, payload: &[u8]) {
+    let decoded = wire::decode(FIXTURE_GENESIS, payload).unwrap();
+    for state in states {
+        state
+            .accept(&decoded.bundle, &decoded.context, bank.slot())
+            .unwrap();
+        state.reconcile(&pool(bank)).unwrap();
+    }
+}
+
+fn finish(states: &mut [&mut WalletState], bank: &Bank) {
+    complete_and_freeze(bank);
+    for state in states {
+        state.finish_slot(bank.slot()).unwrap();
+        state.reconcile(&pool(bank)).unwrap();
+        assert_eq!(state.pool.encode(), pool(bank).encode());
+    }
+}
+
+fn markers(payloads: &[&Vec<u8>]) -> Vec<Pubkey> {
+    payloads
+        .iter()
+        .flat_map(|payload| {
+            let payment = wire::decode(FIXTURE_GENESIS, payload).unwrap();
+            payment
+                .bundle
+                .actions()
+                .iter()
+                .map(|action| nullifiers::address(&action.nullifier().to_bytes()))
+                .collect::<Vec<_>>()
+        })
+        .collect()
+}
+
+fn assert_durable_equal(before: &Bank, after: &Bank, relay: &Keypair, markers: &[Pubkey]) {
+    assert_eq!(before.slot(), after.slot());
+    assert_eq!(before.hash(), after.hash());
+    assert_eq!(pool(before).encode(), pool(after).encode());
+    for key in [pool_address(), relay.pubkey()]
+        .into_iter()
+        .chain(markers.iter().copied())
+    {
+        assert_eq!(
+            before.get_account(&key),
+            after.get_account(&key),
+            "account {key}"
+        );
+    }
+    for marker in markers {
+        let account = after.get_account(marker).unwrap();
+        assert_eq!(account.owner(), &id());
+        assert_eq!(account.data().len(), nullifiers::MARKER_BYTES);
+        assert_eq!(&account.data()[..8], b"NSPENT01");
+        assert_eq!(
+            account.lamports(),
+            1,
+            "free rent must still preserve a live spent marker"
+        );
+    }
+}
+
+#[test]
+fn free_rent_full_snapshot_restores_v4_nullifiers_and_recipient_and_change_respending() {
+    let relay = Keypair::new();
+    let config = genesis(&relay);
+    let (zero, forks) = Bank::new_with_bank_forks_for_tests(&config);
+    let network = Network {
+        network: FIXTURE_GENESIS,
+        genesis_hash: config.hash().to_string(),
+    };
+    let alice = WalletKey::generate(network.clone()).unwrap();
+    let bob = WalletKey::generate(network.clone()).unwrap();
+    let charlie = WalletKey::generate(network).unwrap();
+    assert_eq!(config.rent.minimum_balance(nullifiers::MARKER_BYTES), 0);
+    let floor = config.rent.minimum_balance(SLOT_STATE_BYTES).max(1);
+    let mut alice_state = WalletState::new_slot_anchored(&alice, floor).unwrap();
+    let mut bob_state = WalletState::new_slot_anchored(&bob, floor).unwrap();
+    let mut charlie_state = WalletState::new_slot_anchored(&charlie, floor).unwrap();
+    finish(
+        &mut [&mut alice_state, &mut bob_state, &mut charlie_state],
+        &zero,
+    );
+    let prover = PaymentProver::new();
+
+    let one = child(&forks, &zero, 1);
+    let deposit = prover
+        .build(
+            &alice,
+            &alice_state,
+            relay.pubkey().to_bytes(),
+            64,
+            Payment::Deposit {
+                amount: 1_000,
+                recipient: &alice.address_text(),
+            },
+        )
+        .unwrap();
+    staged_deposit(&one, &relay, &deposit);
+    accept(
+        &mut [&mut alice_state, &mut bob_state, &mut charlie_state],
+        &one,
+        &deposit,
+    );
+    finish(
+        &mut [&mut alice_state, &mut bob_state, &mut charlie_state],
+        &one,
+    );
+
+    let two = child(&forks, &one, 2);
+    let first = prover
+        .build(
+            &alice,
+            &alice_state,
+            relay.pubkey().to_bytes(),
+            64,
+            Payment::ShieldedSend {
+                amount: 100,
+                recipient: &bob.address_text(),
+                fee: 2,
+            },
+        )
+        .unwrap();
+    let first_tx = inline(&two, &relay, &first);
+    two.process_transaction(&first_tx).unwrap();
+    accept(
+        &mut [&mut alice_state, &mut bob_state, &mut charlie_state],
+        &two,
+        &first,
+    );
+    finish(
+        &mut [&mut alice_state, &mut bob_state, &mut charlie_state],
+        &two,
+    );
+
+    // Prepare Alice's change spend before Bob advances the tree, retaining a
+    // completed prior-slot anchor through the later snapshot.
+    let change = prover
+        .build(
+            &alice,
+            &alice_state,
+            relay.pubkey().to_bytes(),
+            64,
+            Payment::ShieldedSend {
+                amount: 20,
+                recipient: &charlie.address_text(),
+                fee: 2,
+            },
+        )
+        .unwrap();
+    let three = child(&forks, &two, 3);
+    let forwarded = prover
+        .build(
+            &bob,
+            &bob_state,
+            relay.pubkey().to_bytes(),
+            64,
+            Payment::ShieldedSend {
+                amount: 40,
+                recipient: &charlie.address_text(),
+                fee: 2,
+            },
+        )
+        .unwrap();
+    three
+        .process_transaction(&inline(&three, &relay, &forwarded))
+        .unwrap();
+    accept(
+        &mut [&mut alice_state, &mut bob_state, &mut charlie_state],
+        &three,
+        &forwarded,
+    );
+    finish(
+        &mut [&mut alice_state, &mut bob_state, &mut charlie_state],
+        &three,
+    );
+
+    let four = child(&forks, &three, 4);
+    four.process_transaction(&inline(&four, &relay, &change))
+        .unwrap();
+    accept(
+        &mut [&mut alice_state, &mut bob_state, &mut charlie_state],
+        &four,
+        &change,
+    );
+    finish(
+        &mut [&mut alice_state, &mut bob_state, &mut charlie_state],
+        &four,
+    );
+    assert_eq!(pool(&four).backing, 994);
+    assert_eq!(pool(&four).note_count(), 8);
+    assert_eq!(alice_state.balance().unwrap(), 876);
+    assert_eq!(bob_state.balance().unwrap(), 58);
+    assert_eq!(charlie_state.balance().unwrap(), 60);
+    let spent_markers = markers(&[&deposit, &first, &forwarded, &change]);
+    assert_eq!(spent_markers.len(), 8);
+    assert_eq!(spent_markers.iter().collect::<BTreeSet<_>>().len(), 8);
+    let checkpoint = pool(&four)
+        .slot_anchors()
+        .unwrap()
+        .entries()
+        .last()
+        .unwrap()
+        .clone();
+    assert_eq!(checkpoint.slot, 4);
+    assert_eq!(checkpoint.note_count, 8);
+    assert_eq!(checkpoint.root, pool(&four).root());
+
+    let (restored, _snapshot_dirs) = full_snapshot_restore(&four, &config);
+    assert_durable_equal(&four, &restored, &relay, &spent_markers);
+    let (restored, restored_forks) = restored.wrap_with_bank_forks_for_tests();
+    let five = child(&restored_forks, &restored, 5);
+
+    // Recover wallet witnesses from the complete known canonical history,
+    // including the empty genesis slot, instead of trusting remote roots.
+    let mut alice_recovered = WalletState::new_slot_anchored(&alice, floor).unwrap();
+    let mut bob_recovered = WalletState::new_slot_anchored(&bob, floor).unwrap();
+    let mut charlie_recovered = WalletState::new_slot_anchored(&charlie, floor).unwrap();
+    for state in [
+        &mut alice_recovered,
+        &mut bob_recovered,
+        &mut charlie_recovered,
+    ] {
+        state.finish_slot(0).unwrap();
+        for (slot, payload) in [(1, &deposit), (2, &first), (3, &forwarded), (4, &change)] {
+            let payment = wire::decode(FIXTURE_GENESIS, payload).unwrap();
+            state
+                .accept(&payment.bundle, &payment.context, slot)
+                .unwrap();
+            state.finish_slot(slot).unwrap();
+        }
+        state.reconcile(&pool(&restored)).unwrap();
+        assert_eq!(state.pool.encode(), pool(&restored).encode());
+        assert!(state.spendable_anchor().is_ok());
+    }
+
+    // Identical proof, fresh outer signature and valid native shape: rejection
+    // must come from the restored spent markers, not the signature cache.
+    let duplicate = inline(&five, &relay, &first);
+    assert_ne!(duplicate.signatures, first_tx.signatures);
+    let admitted = five
+        .verify_transaction(
+            duplicate.clone().into(),
+            TransactionVerificationMode::FullVerification,
+        )
+        .unwrap();
+    let duplicate_fee = five.get_fee_for_message(admitted.message()).unwrap();
+    assert_eq!(
+        duplicate_fee, 5_000,
+        "fixture retains the normal outer signature fee"
+    );
+    let before_duplicate = five.get_account(&pool_address());
+    let mut expected_relay = five.get_account(&relay.pubkey()).unwrap();
+    expected_relay.set_lamports(
+        expected_relay
+            .lamports()
+            .checked_sub(duplicate_fee)
+            .unwrap(),
+    );
+    assert_eq!(
+        five.process_transaction(&duplicate),
+        Err(TransactionError::InstructionError(
+            1,
+            InstructionError::InvalidInstructionData
+        ))
+    );
+    assert_eq!(five.get_account(&pool_address()), before_duplicate);
+    // Failed execution still pays the official outer transaction fee, while
+    // no shielded reimbursement, new marker funding or pool debit commits.
+    assert_eq!(five.get_account(&relay.pubkey()), Some(expected_relay));
+    assert_eq!(alice_recovered.balance().unwrap(), 876);
+    assert_eq!(bob_recovered.balance().unwrap(), 58);
+    assert_eq!(charlie_recovered.balance().unwrap(), 60);
+    for marker in &spent_markers {
+        assert_eq!(five.get_account(marker), restored.get_account(marker));
+    }
+
+    // Both a previously received note and pre-existing change are spendable
+    // after verified full Bank/AccountsDb restoration and history reconstruction.
+    let recipient_send = prover
+        .build(
+            &charlie,
+            &charlie_recovered,
+            relay.pubkey().to_bytes(),
+            64,
+            Payment::ShieldedSend {
+                amount: 10,
+                recipient: &bob.address_text(),
+                fee: 2,
+            },
+        )
+        .unwrap();
+    five.process_transaction(&inline(&five, &relay, &recipient_send))
+        .unwrap();
+    accept(
+        &mut [
+            &mut alice_recovered,
+            &mut bob_recovered,
+            &mut charlie_recovered,
+        ],
+        &five,
+        &recipient_send,
+    );
+    finish(
+        &mut [
+            &mut alice_recovered,
+            &mut bob_recovered,
+            &mut charlie_recovered,
+        ],
+        &five,
+    );
+    let six = child(&restored_forks, &five, 6);
+    let recovered_change = prover
+        .build(
+            &alice,
+            &alice_recovered,
+            relay.pubkey().to_bytes(),
+            64,
+            Payment::ShieldedSend {
+                amount: 5,
+                recipient: &bob.address_text(),
+                fee: 2,
+            },
+        )
+        .unwrap();
+    six.process_transaction(&inline(&six, &relay, &recovered_change))
+        .unwrap();
+    accept(
+        &mut [
+            &mut alice_recovered,
+            &mut bob_recovered,
+            &mut charlie_recovered,
+        ],
+        &six,
+        &recovered_change,
+    );
+    finish(
+        &mut [
+            &mut alice_recovered,
+            &mut bob_recovered,
+            &mut charlie_recovered,
+        ],
+        &six,
+    );
+    assert_eq!(alice_recovered.balance().unwrap(), 869);
+    assert_eq!(bob_recovered.balance().unwrap(), 73);
+    assert_eq!(charlie_recovered.balance().unwrap(), 48);
+    assert_eq!(pool(&six).backing, 990);
+    assert_eq!(pool(&six).note_count(), 12);
+    let all_markers = markers(&[
+        &deposit,
+        &first,
+        &forwarded,
+        &change,
+        &recipient_send,
+        &recovered_change,
+    ]);
+    assert_eq!(all_markers.iter().collect::<BTreeSet<_>>().len(), 12);
+    let (restored_again, _second_snapshot_dirs) = full_snapshot_restore(&six, &config);
+    assert_durable_equal(&six, &restored_again, &relay, &all_markers);
+    assert_eq!(
+        pool(&restored_again)
+            .slot_anchors()
+            .unwrap()
+            .entries()
+            .last()
+            .unwrap()
+            .slot,
+        6
+    );
+}
