+//! Native payment helpers for the isolated supported Agave candidate.
+//! No production wallets, keys, ledgers, or network services are modified here.
+use native_payment_program::{id, pool_address, ACTIVATION_ID, INLINE_PAYMENT_ACTIVATION_ID, SHIELDED_FEE_ACTIVATION_ID, SLOT_ANCHOR_ACTIVATION_ID, WITHDRAWAL_ACTIVATION_ID};
+use native_payments::state::{PoolState, SLOT_STATE_BYTES, STATE_BYTES};
+use solana_account::AccountSharedData;
+use solana_feature_gate_interface::{create_account, Feature};
+use solana_keypair::Keypair;
+use solana_pubkey::Pubkey;
+use solana_rent::Rent;
+use solana_signer::Signer;
+use solana_test_validator::TestValidatorGenesis;
+
+pub const TEST_NETWORK: [u8; 32] = [0x42; 32];
+/// A separate fresh genesis domain; this never migrates an existing V3 pool.
+pub const TEST_SLOT_NETWORK: [u8; 32] = [0x43; 32];
+pub fn native_features() -> [Pubkey; 4] {
+    [ACTIVATION_ID, WITHDRAWAL_ACTIVATION_ID, SHIELDED_FEE_ACTIVATION_ID, INLINE_PAYMENT_ACTIVATION_ID]
+}
+pub fn native_features_for_profile(slot_anchors: bool) -> Vec<Pubkey> {
+    let mut features = native_features().to_vec();
+    if slot_anchors {
+        features.push(SLOT_ANCHOR_ACTIVATION_ID);
+    }
+    features
+}
+pub fn new_slot_pool_account(network: [u8; 32], rent: &Rent) -> AccountSharedData {
+    let floor = rent.minimum_balance(SLOT_STATE_BYTES);
+    let mut pool = AccountSharedData::new(floor, SLOT_STATE_BYTES, &id());
+    pool.set_data_from_slice(&PoolState::new_slot_anchored(network, floor).expect("nonzero test network").encode());
+    pool
+}
+pub fn pool_account(network: [u8; 32], rent: &Rent) -> AccountSharedData {
+    let floor = rent.minimum_balance(STATE_BYTES);
+    let mut pool = AccountSharedData::new(floor, STATE_BYTES, &id());
+    pool.set_data_from_slice(&PoolState::new(network, floor).expect("nonzero test network").encode());
+    pool
+}
+pub fn test_genesis(relay: &Keypair, network: [u8; 32]) -> TestValidatorGenesis {
+    let mut genesis = TestValidatorGenesis::default();
+    genesis.activate_alpenglow();
+    genesis.add_account(pool_address(), pool_account(network, &genesis.rent));
+    genesis.add_account(relay.pubkey(), AccountSharedData::new(10_000_000_000, 0, &solana_sdk_ids::system_program::id()));
+    for feature in native_features() {
+        genesis.add_account(feature, create_account(&Feature { activated_at: Some(0) }, 1_000_000));
+    }
+    genesis
+}
+
+/// Explicit V4 fresh-network setup. Existing V3 helpers and data stay unchanged.
+pub fn test_genesis_v4(relay: &Keypair) -> TestValidatorGenesis {
+    let mut genesis = test_genesis(relay, TEST_SLOT_NETWORK);
+    genesis.add_account(pool_address(), new_slot_pool_account(TEST_SLOT_NETWORK, &genesis.rent));
+    genesis.add_account(SLOT_ANCHOR_ACTIVATION_ID, create_account(&Feature { activated_at: Some(0) }, 1_000_000));
+    genesis
+}
+
+pub mod rpc_smoke;
