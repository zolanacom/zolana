+        let decoded = wire::decode(wallet.network.network, &deposit).unwrap();
+        state.accept(&decoded.bundle, &decoded.context, 1).unwrap();
+        let recipient = wallet.public_keypair().pubkey().to_bytes();
+        let bytes = prover
+            .build(
+                &wallet,
+                &state,
+                sponsor,
+                100,
+                Payment::WithdrawTo {
+                    amount: 1_000_000,
+                    recipient,
