+            )
+            .unwrap();
+        let ix = history(instructions::inline(alice.network.network, &bytes).unwrap());
+        let before = replay.state.pool.encode();
+        let spent_before = replay.state.spent.clone();
+        let buffer_count = replay.buffers.len();
+        let mut invalid = Vec::new();
+        for index in 0..5 {
+            let mut accounts = ix.accounts.clone();
+            accounts[index].0 = Pubkey::new_unique();
+            invalid.push(HistoryInstruction {
+                accounts,
+                data: ix.data.clone(),
+            });
+        }
+        let mut unsigned = ix.accounts.clone();
+        unsigned[1].1 = false;
+        invalid.push(HistoryInstruction {
+            accounts: unsigned,
+            data: ix.data.clone(),
+        });
+        let mut extra = ix.accounts.clone();
+        extra.push((Pubkey::new_unique(), false));
+        invalid.push(HistoryInstruction {
+            accounts: extra,
+            data: ix.data.clone(),
+        });
+        let mut trailing = ix.data.clone();
+        trailing.push(0);
+        invalid.push(HistoryInstruction {
+            accounts: ix.accounts.clone(),
+            data: trailing,
+        });
+        let mut wrong_domain = ix.data.clone();
+        // Opcode, envelope magic, version, then its domain.
+        wrong_domain[1 + 8 + 2] ^= 1;
+        invalid.push(HistoryInstruction {
+            accounts: ix.accounts.clone(),
+            data: wrong_domain,
+        });
+        for invalid in invalid {
+            assert!(replay.apply_verified(&invalid, 2).is_err());
+            assert_eq!(replay.state.pool.encode(), before);
+            assert_eq!(replay.state.spent, spent_before);
+            assert_eq!(replay.state.balance().unwrap(), 100);
+            assert_eq!(replay.buffers.len(), buffer_count);
+        }
+        assert!(replay.apply_verified(&ix, 101).is_err());
+        // An interruption before replaying the instruction resumes from the
+        // authenticated checkpoint, without any staged bytes for this payment.
+        replay =
+            Replay::restore_with_key(&alice, replay.snapshot(), Some(Arc::clone(&key))).unwrap();
+        let accepted = replay.apply_verified(&ix, 2).unwrap().unwrap();
+        assert_eq!(accepted.payload_digest().unwrap(), payload_digest(&bytes));
+        accepted.apply(&mut bob_state).unwrap();
+        accepted.apply(&mut charlie_state).unwrap();
+        assert_eq!(replay.state.balance().unwrap(), 72);
+        assert_eq!(bob_state.balance().unwrap(), 25);
+        assert_eq!(replay.buffers.len(), buffer_count);
+        let accepted_pool = replay.state.pool.encode();
+        assert!(replay.apply_verified(&ix, 2).is_err());
+        assert_eq!(replay.state.pool.encode(), accepted_pool);
+
+        replay =
+            Replay::restore_with_key(&alice, replay.snapshot(), Some(Arc::clone(&key))).unwrap();
+        let mut bob_replay = Replay::restore_with_key(
+            &bob,
+            Replay::from_state(bob_state).snapshot(),
+            Some(Arc::clone(&key)),
+        )
+        .unwrap();
+        let payment = wire::decode(alice.network.network, &bytes).unwrap();
+        for action in payment.bundle.actions() {
+            assert!(replay.state.spent.contains(&action.nullifier().to_bytes()));
+            assert!(
+                bob_replay
+                    .state
+                    .spent
+                    .contains(&action.nullifier().to_bytes())
+            );
+        }
+        assert!(replay.apply_verified(&ix, 3).is_err());
+        assert!(bob_replay.apply_verified(&ix, 3).is_err());
+        assert_eq!(replay.state.balance().unwrap(), 72);
+        assert_eq!(bob_replay.state.balance().unwrap(), 25);
+        for owned in replay.state.unspent() {
+            replay.state.witness(owned.position).unwrap();
+        }
+
+        // The received note and its rebuilt witness can fund the very next
+        // native payment; this is replay/proof correctness, not a latency test.
+        let forward = prover
+            .build(
+                &bob,
+                &bob_replay.state,
+                sponsor.to_bytes(),
+                100,
+                Payment::ShieldedSend {
+                    amount: 10,
+                    recipient: &charlie.address_text(),
+                    fee: 2,
+                },
+            )
+            .unwrap();
+        let forward = history(instructions::inline(bob.network.network, &forward).unwrap());
+        let accepted = bob_replay.apply_verified(&forward, 3).unwrap().unwrap();
+        accepted.apply(&mut replay.state).unwrap();
+        accepted.apply(&mut charlie_state).unwrap();
+        assert_eq!(replay.state.balance().unwrap(), 72);
+        assert_eq!(bob_replay.state.balance().unwrap(), 13);
+        assert_eq!(charlie_state.balance().unwrap(), 10);
+        assert_eq!(charlie_state.pool.backing, 95);
+        replay.state.reconcile(&bob_replay.state.pool).unwrap();
+        charlie_state.reconcile(&bob_replay.state.pool).unwrap();
+    }
+
+    #[test]
+    fn verified_history_fans_out_only_at_the_identical_checkpoint() {
+        let network = Network {
+            network: [9; 32],
+            genesis_hash: bs58::encode([8; 32]).into_string(),
+        };
+        let alice = WalletKey::generate(network.clone()).unwrap();
+        let bob = WalletKey::generate(network).unwrap();
+        let mut primary = Replay::new(&alice, 1000).unwrap();
+        let mut same_view = WalletState::new(&alice, 1000).unwrap();
+        let mut other_view = WalletState::new(&bob, 1000).unwrap();
+        let sponsor = Pubkey::new_unique();
+        let buffer = Pubkey::new_unique();
+        let bytes = payments::build(
+            &alice,
+            &primary.state,
+            sponsor.to_bytes(),
+            100,
+            Payment::Deposit {
+                amount: 100,
+                recipient: &alice.address_text(),
+            },
+        )
+        .unwrap();
+        let mut history = vec![instructions::initialize(
+            buffer,
+            sponsor,
+            bytes.len() as u32,
+            payload_digest(&bytes),
+            100,
+        )];
+        for (index, chunk) in bytes.chunks(MAX_CHUNK_BYTES).enumerate() {
+            history.push(instructions::write(
+                buffer,
+                sponsor,
+                (index * MAX_CHUNK_BYTES) as u32,
+                chunk,
+            ));
+        }
+        history.push(instructions::seal(buffer, sponsor));
+        let payment = wire::decode(alice.network.network, &bytes).unwrap();
+        history.push(instructions::finalize(
+            buffer,
+            sponsor,
+            std::array::from_fn(|i| payment.bundle.actions()[i].nullifier().to_bytes()),
+        ));
+        let mut accepted = None;
+        for (index, ix) in history.into_iter().enumerate() {
+            accepted = primary
+                .apply_verified(
+                    &HistoryInstruction {
+                        accounts: ix
+                            .accounts
+                            .iter()
+                            .map(|meta| (meta.pubkey, meta.is_signer))
+                            .collect(),
+                        data: ix.data,
+                    },
+                    1,
+                )
+                .unwrap()
+                .or(accepted);
+            if index == 2 {
+                // A checkpoint may land in the middle of an upload. Resume its
+                // bytes and authorization, rather than losing open buffers.
+                primary = Replay::restore(&alice, primary.snapshot()).unwrap();
+            }
+        }
+        let accepted = accepted.unwrap();
+        accepted.apply(&mut same_view).unwrap();
+        accepted.apply(&mut other_view).unwrap();
+        assert_eq!(same_view.balance().unwrap(), 100);
+        assert_eq!(other_view.balance().unwrap(), 0);
+        let restored = Replay::restore(&alice, primary.snapshot()).unwrap();
+        assert_eq!(restored.state.balance().unwrap(), 100);
+        assert_eq!(restored.state.spent, primary.state.spent);
+        assert_eq!(
+            restored.state.witness(0).unwrap().auth_path(),
+            primary.state.witness(0).unwrap().auth_path()
+        );
+        assert!(Replay::restore(&bob, primary.snapshot()).is_err());
+        let mut corrupted = serde_json::to_value(primary.snapshot()).unwrap();
+        corrupted["notes"][0]["value"] = serde_json::json!(101);
+        assert!(Replay::restore(&alice, serde_json::from_value(corrupted).unwrap()).is_err());
+        let mut corrupted = serde_json::to_value(primary.snapshot()).unwrap();
+        corrupted["leaves"][0] = serde_json::to_value([0u8; 32]).unwrap();
+        assert!(Replay::restore(&alice, serde_json::from_value(corrupted).unwrap()).is_err());
+        let unowned_position = (0..primary.state.tree.len())
+            .find(|position| {
+                !primary
+                    .state
+                    .notes
+                    .iter()
+                    .any(|owned| owned.position as usize == *position)
+            })
+            .unwrap();
+        let mut corrupted = serde_json::to_value(primary.snapshot()).unwrap();
+        corrupted["leaves"][unowned_position] = serde_json::to_value([0u8; 32]).unwrap();
+        assert!(Replay::restore(&alice, serde_json::from_value(corrupted).unwrap()).is_err());
+        let mut corrupted = serde_json::to_value(primary.snapshot()).unwrap();
+        corrupted["leaves"].as_array_mut().unwrap().pop();
+        assert!(Replay::restore(&alice, serde_json::from_value(corrupted).unwrap()).is_err());
+        same_view.reconcile(&primary.state.pool).unwrap();
+        other_view.reconcile(&primary.state.pool).unwrap();
+        assert!(accepted.apply(&mut same_view).is_err());
+        other_view.pool.backing += 1;
+        assert!(accepted.apply(&mut other_view).is_err());
+    }
+}
diff --git a/zolana-native/wallet-core/src/history/snapshot.rs b/zolana-native/wallet-core/src/history/snapshot.rs
new file mode 100644
--- /dev/null
+++ b/zolana-native/wallet-core/src/history/snapshot.rs
@@ -0,0 +1,160 @@
+//! Internal snapshots are accepted only after wallet-key authenticated decryption.
+use super::*;
+use orchard::{
+    Address,
+    note::{ExtractedNoteCommitment, NoteVersion, RandomSeed, Rho},
+    value::NoteValue,
+};
+use serde::{Deserialize, Serialize};
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct ReplaySnapshot {
+    pool: Vec<u8>,
+    leaves: Vec<[u8; 32]>,
+    spent: BTreeSet<[u8; 32]>,
+    notes: Vec<SavedNote>,
+    buffers: Vec<([u8; 32], Vec<u8>)>,
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct SavedNote {
+    position: u32,
+    recipient: Vec<u8>,
+    value: u64,
+    rho: [u8; 32],
+    rseed: [u8; 32],
+    version: u8,
+}
+
+impl Replay {
+    pub(crate) fn snapshot(&self) -> ReplaySnapshot {
+        ReplaySnapshot {
+            pool: self.state.pool.encode(),
+            leaves: self
+                .state
+                .tree
+                .leaves
+                .iter()
+                .map(MerkleHashOrchard::to_bytes)
+                .collect(),
+            spent: self.state.spent.clone(),
+            notes: self
+                .state
+                .notes
+                .iter()
+                .map(|owned| SavedNote {
+                    position: owned.position,
+                    recipient: owned.note.recipient().to_raw_address_bytes().to_vec(),
+                    value: owned.note.value().inner(),
+                    rho: owned.note.rho().to_bytes(),
+                    rseed: *owned.note.rseed().as_bytes(),
+                    version: match owned.note.version() {
+                        NoteVersion::V2 => 2,
+                        NoteVersion::V3 => 3,
+                    },
+                })
+                .collect(),
+            buffers: self
+                .buffers
+                .iter()
+                .map(|(key, value)| (key.to_bytes(), value.bytes().to_vec()))
+                .collect(),
+        }
+    }
+
+    #[cfg(test)]
+    pub(crate) fn restore(wallet: &WalletKey, snapshot: ReplaySnapshot) -> Result<Self> {
+        Self::restore_with_key(wallet, snapshot, None)
+    }
+
+    pub(crate) fn restore_with_key(
+        wallet: &WalletKey,
+        snapshot: ReplaySnapshot,
+        key: Option<Arc<VerifyingKey>>,
+    ) -> Result<Self> {
+        let pool = PoolState::decode(&snapshot.pool)?;
+        if pool.network != wallet.network.network
+            || snapshot.leaves.len() as u64 != pool.note_count()
+            || snapshot.spent.len() as u64 != pool.note_count()
+        {
+            return Err("cached tree, network or spent set mismatch".into());
+        }
+        let mut state = match key {
+            Some(key) => WalletState::with_key(wallet, pool.rent_floor, key)?,
+            None => WalletState::new(wallet, pool.rent_floor)?,
+        };
+        state.pool = pool;
+        state.tree = WitnessTree::from_leaves(
+            snapshot
+                .leaves
+                .into_iter()
+                .map(|leaf| {
+                    Option::from(MerkleHashOrchard::from_bytes(&leaf))
+                        .ok_or_else(|| "invalid cached tree leaf".into())
+                })
+                .collect::<Result<Vec<_>>>()?,
+        )?;
+        state.spent = snapshot.spent;
+        let mut positions = BTreeSet::new();
+        for saved in snapshot.notes {
+            if !positions.insert(saved.position) || saved.value == 0 {
+                return Err("invalid cached note position or value".into());
+            }
+            let raw = saved
+                .recipient
+                .try_into()
+                .map_err(|_| "invalid cached recipient length")?;
+            let recipient = Option::<Address>::from(Address::from_raw_address_bytes(&raw))
+                .ok_or("invalid cached recipient")?;
+            if state.view.scope_for_address(&recipient).is_none() {
+                return Err("cached note belongs to another wallet".into());
+            }
+            let rho =
+                Option::<Rho>::from(Rho::from_bytes(&saved.rho)).ok_or("invalid cached rho")?;
+            let rseed = Option::<RandomSeed>::from(RandomSeed::from_bytes(saved.rseed, &rho))
+                .ok_or("invalid cached note randomness")?;
+            let version = match saved.version {
+                2 => NoteVersion::V2,
+                3 => NoteVersion::V3,
+                _ => return Err("invalid cached note version".into()),
+            };
+            // These components were obtained by validated note decryption before
+            // the authenticated cache was written; never import untrusted notes.
+            let note = Option::<Note>::from(Note::from_parts(
+                recipient,
+                NoteValue::from_raw(saved.value),
+                rho,
+                rseed,
+                version,
+            ))
+            .ok_or("invalid cached note")?;
+            let leaf = state
+                .tree
+                .leaves
+                .get(saved.position as usize)
+                .ok_or("cached note is outside the tree")?;
+            if leaf.to_bytes() != ExtractedNoteCommitment::from(note.commitment()).to_bytes() {
+                return Err("cached note commitment mismatch".into());
+            }
+            state.notes.push(OwnedNote {
+                note,
+                position: saved.position,
+            });
+        }
+        state.reconcile(&state.pool)?;
+        let mut buffers = HashMap::new();
+        for (key, encoded) in snapshot.buffers {
+            let key = Pubkey::new_from_array(key);
+            let buffer = Buffer::decode(&encoded)?;
+            if key == pool_address()
+                || key.to_bytes() == buffer.sponsor()
+                || buffers.insert(key, buffer).is_some()
+            {
+                return Err("invalid cached staging account".into());
+            }
+        }
+        Ok(Self { state, buffers })
+    }
+}
diff --git a/zolana-native/wallet-core/src/keys.rs b/zolana-native/wallet-core/src/keys.rs
new file mode 100644
--- /dev/null
+++ b/zolana-native/wallet-core/src/keys.rs
@@ -0,0 +1,418 @@
+use crate::Result;
+use chacha20poly1305::{
+    aead::{Aead, Payload},
+    KeyInit, XChaCha20Poly1305, XNonce,
+};
+use orchard::{
+    keys::{FullViewingKey, Scope, SpendingKey},
+    Address,
+};
+use serde::{Deserialize, Serialize};
+use std::{
+    fs::{self, OpenOptions},
+    io::{Read, Write},
+    os::unix::fs::{DirBuilderExt, OpenOptionsExt, PermissionsExt},
+    path::Path,
+};
+use zeroize::Zeroizing;
+
+const ROUNDS: u32 = 600_000;
+const FORMAT: &str = "native-wallet-seed-v1";
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+pub struct Network {
+    pub network: [u8; 32],
+    pub genesis_hash: String,
+}
+
+impl Network {
+    pub fn load(path: &Path) -> Result<Self> {
+        let value: serde_json::Value = serde_json::from_slice(&fs::read(path)?)?;
+        if value["pool_format"] != "NPOOL003"
+            || value["program"] != native_payment_program::id().to_string()
+            || value["pool"] != native_payment_program::pool_address().to_string()
+        {
+            return Err(
+                "network configuration does not describe this native payment protocol".into(),
+            );
+        }
+        let network: Self = serde_json::from_value(value)?;
+        network.validate()?;
+        Ok(network)
+    }
+
+    pub(crate) fn validate(&self) -> Result<()> {
+        if self.network == [0; 32] || bs58::decode(&self.genesis_hash).into_vec()?.len() != 32 {
+            return Err("invalid network domain or genesis fingerprint".into());
+        }
+        Ok(())
+    }
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Envelope {
+    format: String,
+    network: Network,
+    rounds: u32,
+    salt: [u8; 16],
+    nonce: [u8; 24],
+    ciphertext: Vec<u8>,
+}
+
+impl Envelope {
+    fn aad(&self) -> Result<Vec<u8>> {
+        Ok(serde_json::to_vec(&(
+            &self.format,
+            &self.network,
+            self.rounds,
+            self.salt,
+            self.nonce,
+        ))?)
+    }
+}
+
+pub struct WalletKey {
+    seed: Zeroizing<[u8; 32]>,
+    pub network: Network,
+}
+
+impl WalletKey {
+    pub fn generate(network: Network) -> Result<Self> {
+        network.validate()?;
+        loop {
+            let seed = rand::random::<[u8; 32]>();
+            if bool::from(SpendingKey::from_bytes(seed).is_some()) {
+                return Ok(Self {
+                    seed: Zeroizing::new(seed),
+                    network,
+                });
+            }
+        }
+    }
+
+    pub fn spending_key(&self) -> SpendingKey {
+        Option::from(SpendingKey::from_bytes(*self.seed)).expect("validated spending seed")
+    }
+
+    pub fn viewing_key(&self) -> FullViewingKey {
+        FullViewingKey::from(&self.spending_key())
+    }
+    pub fn receiving_address(&self) -> Address {
+        self.viewing_key().address_at(0u32, Scope::External)
+    }
+    pub fn change_address(&self) -> Address {
+        self.viewing_key().address_at(0u32, Scope::Internal)
+    }
+
+    /// Independent Ed25519 authority recoverable from the same encrypted seed.
+    /// Network/genesis separation prevents cross-chain public key reuse.
+    pub fn public_keypair(&self) -> solana_keypair::Keypair {
+        let mut hash = blake2b_simd::Params::new()
+            .hash_length(32)
+            .personal(b"NPayPublicKeyV1!")
+            .key(&self.seed[..])
+            .to_state();
+        hash.update(&self.network.network);
+        hash.update(self.network.genesis_hash.as_bytes());
+        let secret =
+            Zeroizing::new(<[u8; 32]>::try_from(hash.finalize().as_bytes()).expect("32 bytes"));
+        solana_keypair::Keypair::new_from_array(*secret)
+    }
+
+    /// A separate fee authority keeps the existing recipient-bound protocol
+    /// unchanged and prevents withdrawal credits from masking fee expenditure.
+    pub fn fee_keypair(&self) -> solana_keypair::Keypair {
+        let mut hash = blake2b_simd::Params::new()
+            .hash_length(32)
+            .personal(b"NPayFeeKeyV1!!!!")
+            .key(&self.seed[..])
+            .to_state();
+        hash.update(&self.network.network);
+        hash.update(self.network.genesis_hash.as_bytes());
+        let secret =
+            Zeroizing::new(<[u8; 32]>::try_from(hash.finalize().as_bytes()).expect("32 bytes"));
+        solana_keypair::Keypair::new_from_array(*secret)
+    }
+
+    pub(crate) fn scan_cache_key(&self) -> Zeroizing<[u8; 32]> {
+        let mut hash = blake2b_simd::Params::new()
+            .hash_length(32)
+            .personal(b"NPayCacheKeyV1!!")
+            .key(&self.seed[..])
+            .to_state();
+        hash.update(&self.network.network);
+        hash.update(self.network.genesis_hash.as_bytes());
+        Zeroizing::new(hash.finalize().as_bytes().try_into().expect("32-byte key"))
+    }
+
+    pub fn save(&self, path: &Path, password: &[u8]) -> Result<()> {
+        validate_password(password)?;
+        let mut envelope = Envelope {
+            format: FORMAT.to_owned(),
+            network: self.network.clone(),
+            rounds: ROUNDS,
+            salt: rand::random(),
+            nonce: rand::random(),
+            ciphertext: Vec::new(),
+        };
+        let key = derive(password, &envelope.salt);
+        let cipher =
+            XChaCha20Poly1305::new_from_slice(&key[..]).map_err(|_| "key initialization failed")?;
+        envelope.ciphertext = cipher
+            .encrypt(
+                &XNonce::from(envelope.nonce),
+                Payload {
+                    msg: &self.seed[..],
+                    aad: &envelope.aad()?,
+                },
+            )
+            .map_err(|_| "seed encryption failed")?;
+        write_private_new(path, &serde_json::to_vec_pretty(&envelope)?)
+    }
+
+    pub fn open(path: &Path, password: &[u8], expected: &Network) -> Result<Self> {
+        validate_password(password)?;
+        let bytes = read_private(path, 4096)?;
+        let envelope: Envelope = serde_json::from_slice(&bytes)?;
+        if envelope.format != FORMAT
+            || envelope.rounds != ROUNDS
+            || envelope.ciphertext.len() != 48
+            || &envelope.network != expected
+        {
+            return Err("seed format or network mismatch".into());
+        }
+        expected.validate()?;
+        let key = derive(password, &envelope.salt);
+        let cipher =
+            XChaCha20Poly1305::new_from_slice(&key[..]).map_err(|_| "key initialization failed")?;
+        let plain = Zeroizing::new(
+            cipher
+                .decrypt(
+                    &XNonce::from(envelope.nonce),
+                    Payload {
+                        msg: &envelope.ciphertext,
+                        aad: &envelope.aad()?,
+                    },
+                )
+                .map_err(|_| "password is incorrect or encrypted seed was modified")?,
+        );
+        let seed: [u8; 32] = plain
+            .as_slice()
+            .try_into()
+            .map_err(|_| "invalid seed length")?;
+        if !bool::from(SpendingKey::from_bytes(seed).is_some()) {
+            return Err("invalid spending seed".into());
+        }
+        Ok(Self {
+            seed: Zeroizing::new(seed),
+            network: expected.clone(),
+        })
+    }
+
+    pub fn address_text(&self) -> String {
+        encode_address(&self.network, &self.receiving_address())
+    }
+}
+
+pub(crate) fn derive(password: &[u8], salt: &[u8]) -> Zeroizing<[u8; 32]> {
+    let mut output = Zeroizing::new([0; 32]);
+    pbkdf2::pbkdf2::<hmac::Hmac<sha2::Sha256>>(password, salt, ROUNDS, &mut output[..]);
+    output
+}
+
+pub(crate) fn validate_password(password: &[u8]) -> Result<()> {
+    if !(12..=1024).contains(&password.len()) {
+        return Err("password file must contain 12 to 1024 bytes".into());
+    }
+    Ok(())
+}
+
+pub fn read_password(path: &Path) -> Result<Zeroizing<Vec<u8>>> {
+    let bytes = read_private(path, 1024)?;
+    validate_password(&bytes)?;
+    Ok(bytes)
+}
+
+/// A bounded pipe avoids writing a web session password to a named disk file.
+pub fn read_password_input(input: impl Read) -> Result<Zeroizing<Vec<u8>>> {
+    let mut bytes = Zeroizing::new(Vec::new());
+    input.take(1025).read_to_end(&mut bytes)?;
+    validate_password(&bytes)?;
+    Ok(bytes)
+}
+
+pub fn read_private(path: &Path, maximum: usize) -> Result<Zeroizing<Vec<u8>>> {
+    let mut file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(path)?;
+    let metadata = file.metadata()?;
+    if !metadata.is_file() || metadata.permissions().mode() & 0o077 != 0 {
+        return Err(
+            "secret file must be a regular file readable only by its owner (mode 0600 or 0400)"
+                .into(),
+        );
+    }
+    let mut bytes = Zeroizing::new(Vec::new());
+    (&mut file)
+        .take(maximum as u64 + 1)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() > maximum {
+        return Err("secret file exceeds its size bound".into());
+    }
+    Ok(bytes)
+}
+
+pub fn write_private_new(path: &Path, bytes: &[u8]) -> Result<()> {
+    if let Some(parent) = path
+        .parent()
+        .filter(|parent| !parent.as_os_str().is_empty())
+    {
+        fs::DirBuilder::new()
+            .recursive(true)
+            .mode(0o700)
+            .create(parent)?;
+    }
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(path)?;
+    file.write_all(bytes)?;
+    file.sync_all()?;
+    fs::File::open(
+        path.parent()
+            .filter(|p| !p.as_os_str().is_empty())
+            .unwrap_or(Path::new(".")),
+    )?
+    .sync_all()?;
+    Ok(())
+}
+
+pub fn encode_address(network: &Network, address: &Address) -> String {
+    let mut bytes = vec![1];
+    bytes.extend_from_slice(&network_tag(network));
+    bytes.extend_from_slice(&address.to_raw_address_bytes());
+    let checksum = blake2b_simd::blake2b(&bytes);
+    bytes.extend_from_slice(&checksum.as_bytes()[..4]);
+    format!("npriv1{}", bs58::encode(bytes).into_string())
+}
+
+pub fn decode_address(network: &Network, text: &str) -> Result<Address> {
+    if text.len() > 140 {
+        return Err("invalid receiving address length".into());
+    }
+    let bytes = bs58::decode(
+        text.strip_prefix("npriv1")
+            .ok_or("invalid receiving address prefix")?,
+    )
+    .into_vec()?;
+    if bytes.len() != 80
+        || bytes[0] != 1
+        || bytes[1..33] != network_tag(network)
+        || blake2b_simd::blake2b(&bytes[..76]).as_bytes()[..4] != bytes[76..]
+    {
+        return Err("receiving address checksum or network mismatch".into());
+    }
+    Option::from(Address::from_raw_address_bytes(
+        &bytes[33..76].try_into().unwrap(),
+    ))
+    .ok_or_else(|| "invalid shielded address encoding".into())
+}
+
+fn network_tag(network: &Network) -> [u8; 32] {
+    let mut state = blake2b_simd::Params::new()
+        .hash_length(32)
+        .personal(b"NPayWalletAddrV1")
+        .to_state();
+    state.update(&network.network);
+    state.update(network.genesis_hash.as_bytes());
+    state
+        .finalize()
+        .as_bytes()
+        .try_into()
+        .expect("32-byte address domain")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use solana_signer::Signer;
+
+    #[test]
+    fn encrypted_seed_restores_independent_network_bound_public_signing_authority() {
+        let dir = tempfile::tempdir().unwrap();
+        let network = Network {
+            network: [5; 32],
+            genesis_hash: bs58::encode([7; 32]).into_string(),
+        };
+        let wallet = WalletKey::generate(network.clone()).unwrap();
+        let path = dir.path().join("backup");
+        wallet
+            .save(&path, b"public authority test password")
+            .unwrap();
+        let restored = WalletKey::open(&path, b"public authority test password", &network).unwrap();
+        let key = restored.public_keypair();
+        let fee = restored.fee_keypair();
+        assert_eq!(fee.pubkey(), wallet.fee_keypair().pubkey());
+        assert_ne!(fee.pubkey(), key.pubkey());
+        assert!(fee
+            .sign_message(b"user paid fees")
+            .verify(fee.pubkey().as_ref(), b"user paid fees"));
+        assert_eq!(key.pubkey(), wallet.public_keypair().pubkey());
+        assert!(key
+            .sign_message(b"user-controlled native account")
+            .verify(key.pubkey().as_ref(), b"user-controlled native account"));
+        let mut other = restored;
+        other.network.network[0] ^= 1;
+        assert_ne!(other.public_keypair().pubkey(), key.pubkey());
+        assert_ne!(other.fee_keypair().pubkey(), fee.pubkey());
+    }
+
+    #[test]
+    fn piped_passwords_are_bounded_even_without_end_of_input() {
+        assert!(read_password_input(&b"too short"[..]).is_err());
+        assert_eq!(read_password_input(&[b'x'; 1024][..]).unwrap().len(), 1024);
+        assert!(read_password_input(std::io::repeat(b'x')).is_err());
+    }
+
+    #[test]
+    fn seed_only_recovery_rejects_wrong_password_network_and_tampering() {
+        let network = Network {
+            network: [3; 32],
+            genesis_hash: bs58::encode([5; 32]).into_string(),
+        };
+        let wallet = WalletKey::generate(network.clone()).unwrap();
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("encrypted-seed.json");
+        wallet.save(&path, b"a unique local test password").unwrap();
+        assert!(wallet.save(&path, b"a unique local test password").is_err());
+        let restored = WalletKey::open(&path, b"a unique local test password", &network).unwrap();
+        assert_eq!(restored.address_text(), wallet.address_text());
+        assert!(WalletKey::open(&path, b"wrong local test password", &network).is_err());
+        let other = Network {
+            network: [4; 32],
+            ..network.clone()
+        };
+        assert!(WalletKey::open(&path, b"a unique local test password", &other).is_err());
+        assert!(decode_address(&other, &wallet.address_text()).is_err());
+        let same_domain_other_genesis = Network {
+            genesis_hash: bs58::encode([6; 32]).into_string(),
+            ..network.clone()
+        };
+        assert!(decode_address(&same_domain_other_genesis, &wallet.address_text()).is_err());
+        assert_eq!(
+            decode_address(&network, &wallet.address_text())
+                .unwrap()
+                .to_raw_address_bytes(),
+            wallet.receiving_address().to_raw_address_bytes()
+        );
+        let mut data: Envelope = serde_json::from_slice(&fs::read(&path).unwrap()).unwrap();
+        data.ciphertext[0] ^= 1;
+        fs::write(&path, serde_json::to_vec(&data).unwrap()).unwrap();
+        assert!(WalletKey::open(&path, b"a unique local test password", &network).is_err());
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o644)).unwrap();
+        assert!(read_private(&path, 4096).is_err());
+    }
+}
