+++ b/zolana-native/harness/src/bin/native-wire-check.rs
@@ -0,0 +1,58 @@
+//! Golden SDK3 -> SDK4 wire compatibility check only. No broadcast, proof
+//! verification, native admission, execution, finality, or wallet-key access.
+use {
+    solana_runtime::native_payment_admission::MAX_NATIVE_TRANSACTION_BYTES,
+    solana_transaction::{versioned::{TransactionVersion, VersionedTransaction}},
+    std::{
+        fs::{self, File},
+        io::Read,
+        os::unix::fs::MetadataExt,
+        path::Path,
+    },
+};
+
+fn read_packet(path: &Path) -> Result<Vec<u8>, Box<dyn std::error::Error>> {
+    let before = fs::symlink_metadata(path)?;
+    if !before.file_type().is_file() || before.len() == 0 || before.len() > MAX_NATIVE_TRANSACTION_BYTES as u64 {
+        return Err("wire input must be a nonempty regular file of at most 16 KiB".into());
+    }
+    let file = File::open(path)?;
+    let opened = file.metadata()?;
+    if !opened.is_file() || (opened.dev(), opened.ino(), opened.len()) != (before.dev(), before.ino(), before.len()) {
+        return Err("wire input changed while opening".into());
+    }
+    let mut wire = Vec::with_capacity(opened.len() as usize);
+    file.take((MAX_NATIVE_TRANSACTION_BYTES + 1) as u64).read_to_end(&mut wire)?;
+    if wire.len() != opened.len() as usize || wire.len() > MAX_NATIVE_TRANSACTION_BYTES {
+        return Err("wire input size changed while reading".into());
+    }
+    Ok(wire)
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<_> = std::env::args_os().collect();
+    if args.len() != 2 {
+        return Err("usage: native-wire-check <bounded-raw-transaction-file>".into());
+    }
+    let wire = read_packet(Path::new(&args[1]))?;
+    let config = wincode::config::DefaultConfig::default()
+        .with_preallocation_size_limit::<MAX_NATIVE_TRANSACTION_BYTES>();
+    let transaction: VersionedTransaction = wincode::config::deserialize_exact(&wire, config)?;
+    transaction.sanitize()?;
+    if !matches!(transaction.version(), TransactionVersion::Legacy(_)) || transaction.signatures.len() != 1 {
+        return Err("golden native wire check requires a legacy transaction with one outer signer".into());
+    }
+    if wincode::serialize(&transaction)? != wire {
+        return Err("SDK4 canonical bytes differ from the provided SDK3 packet".into());
+    }
+    transaction.verify_and_hash_message()?;
+    let digest = solana_sha256_hasher::hash(&wire);
+    let wire_sha256: String = digest.to_bytes().iter().map(|byte| format!("{byte:02x}")).collect();
+    println!("{}", serde_json::json!({
+        "wire_sha256": wire_sha256,
+        "wire_bytes": wire.len(),
+        "signature": transaction.signatures[0].to_string(),
+        "version": "legacy",
+    }));
+    Ok(())
+}
