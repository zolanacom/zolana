+fn durable_reload_after_standard_purge_and_db_reopen_uses_fresh_file_prefix() {
+    let archive_dir = Fixture::new();
+    let db_dir = Fixture::new();
+    let store = Blockstore::open(&db_dir.0).unwrap();
+    let values: Vec<_> = records()
+        .into_iter()
+        .chain([(12, meta(12, Some(9))), (15, meta(15, Some(12)))])
+        .collect();
+    let slots: Vec<_> = values.iter().map(|(s, _)| *s).collect();
+    for (slot, meta) in &values {
+        store.put_meta(*slot, meta).unwrap();
+        let hash = solana_sha256_hasher::hash(&slot.to_le_bytes());
+        store.insert_bank_hash(*slot, hash, true);
+        store
+            .insert_optimistic_slot(*slot, &hash, *slot as i64)
+            .unwrap();
+    }
+    store.set_roots(slots.iter()).unwrap();
+    let mut expected = binding();
+    expected.original = capture_root_evidence(&store, 3).unwrap();
+    expected.head = capture_root_evidence(&store, 9).unwrap();
+    let before = crate::ancestry::verify_path(&store, 15, 3, budget(), || false).unwrap();
+    let published = publish(
+        &archive_dir.0,
+        "one",
+        owner(),
+        &expected,
+        records(),
+        budget(),
+        || false,
+    )
+    .unwrap();
+    // All original prefix input is moved into publish; no prefix instance is
+    // retained across this actual DB purge and close.
+    store.purge_slots(0, 7, PurgeType::Exact).unwrap();
+    drop(store);
+    let reopened = Blockstore::open(&db_dir.0).unwrap();
+    assert!(reopened.meta(3).unwrap().is_none());
