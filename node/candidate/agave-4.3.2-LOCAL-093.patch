+//! Immutable bounded native ancestry generations. The expected complete binding
+//! and manifest digest MUST come from independent caller policy. This file does
+//! not choose snapshots, authorize pruning, or replace current-root certification.
+use {
+    crate::ancestry::{
+        AncestryError, AncestryReport,
+        prefix::{
+            MAX_META_BYTES, MAX_PREFIX_BYTES, MAX_RECORDS, ValidatedPrefix, decode_full_meta,
+            encode_full_meta,
+        },
+    },
+    anyhow::{Context, anyhow, bail},
+    serde::{Deserialize, Serialize},
+    solana_ledger::{blockstore::Blockstore, blockstore_meta::SlotMeta},
+    std::{
+        ffi::CString,
+        fs::File,
+        io::{Read, Write},
+        os::{
+            fd::{AsRawFd, FromRawFd},
+            unix::{ffi::OsStrExt, fs::MetadataExt},
+        },
+        path::{Component, Path},
+        time::Instant,
+    },
+};
+
+pub(crate) type ArchiveError = anyhow::Error;
+const FORMAT: &str = "zolana093-native-ancestry-archive-v1";
+const MAGIC: &[u8; 8] = b"ZANCP001";
+const MAX_MANIFEST: usize = 64 * 1024;
+const MAX_PAYLOAD: usize = MAX_PREFIX_BYTES as usize + MAX_RECORDS * 44 + 12;
+
+#[cfg(test)]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum PublicationPoint {
+    BeforeRename,
+    AfterCommit,
+}
+
+#[cfg(test)]
+thread_local! {
+    static PUBLICATION_HOOK: std::cell::RefCell<Option<Box<dyn FnMut(PublicationPoint)>>> =
+        std::cell::RefCell::new(None);
+}
+
+#[cfg(test)]
+fn publication_hook(point: PublicationPoint) {
+    PUBLICATION_HOOK.with(|hook| {
+        if let Some(callback) = hook.borrow_mut().as_mut() {
+            callback(point);
+        }
+    });
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Domain {
+    pub network: [u8; 32],
+    pub genesis_hash: [u8; 32],
+    pub identity: [u8; 32],
+    pub voter: [u8; 32],
+    pub resume_sha256: [u8; 32],
+    pub ledger_relative_path: String,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct RootEvidence {
+    pub slot: u64,
+    pub is_root: bool,
+    pub certified_bank_hash: [u8; 32],
+    pub certified_timestamp: i64,
+    pub replay_bank_hash: Option<[u8; 32]>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct ArchiveBinding {
+    pub domain: Domain,
+    pub original: RootEvidence,
+    pub head: RootEvidence,
+    pub prune_through: u64,
+    pub snapshot_parent_slot: u64,
+    pub snapshot_slot: u64,
+    pub captured_current_root_slot: u64,
+    pub canonical_export_through: u64,
+}
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Manifest {
+    format: String,
+    binding: ArchiveBinding,
+    record_count: usize,
+    payload_bytes: usize,
+    payload_sha256: [u8; 32],
+}
+
+pub(crate) struct PublishedArchive {
+    pub manifest_sha256: [u8; 32],
+}
+
+pub(crate) struct LoadedArchive {
+    binding: ArchiveBinding,
+    prefix: ValidatedPrefix,
+}
+
+fn digest(raw: &[u8]) -> [u8; 32] {
+    solana_sha256_hasher::hash(raw).to_bytes()
+}
+
+fn budget(deadline: Instant, cancelled: &mut impl FnMut() -> bool) -> Result<(), ArchiveError> {
+    if cancelled() {
+        bail!("ancestry archive operation cancelled");
+    }
+    if Instant::now() >= deadline {
+        bail!("ancestry archive operation deadline exceeded");
+    }
+    Ok(())
+}
+
+fn valid_binding(binding: &ArchiveBinding) -> Result<(), ArchiveError> {
+    let path = Path::new(&binding.domain.ledger_relative_path);
+    if binding.domain.ledger_relative_path.is_empty()
+        || binding.domain.ledger_relative_path.len() > 256
+        || !path.components().all(|c| matches!(c, Component::Normal(_)))
+    {
+        bail!("invalid archive ledger-relative domain path");
+    }
+    for evidence in [&binding.original, &binding.head] {
+        if !evidence.is_root
+            || evidence
+                .replay_bank_hash
+                .is_some_and(|h| h != evidence.certified_bank_hash)
+        {
+            bail!("archive root evidence is not the pinned certified root");
+        }
+    }
+    if !(binding.original.slot <= binding.prune_through
+        && binding.prune_through < binding.head.slot
+        && binding.head.slot <= binding.snapshot_parent_slot
+        && binding.snapshot_parent_slot < binding.snapshot_slot
+        && binding.snapshot_slot <= binding.captured_current_root_slot
+        && binding.canonical_export_through > binding.prune_through)
+    {
+        bail!("archive cutoff/snapshot/export bounds differ");
+    }
+    Ok(())
+}
+
+pub(crate) fn capture_root_evidence(
+    store: &Blockstore,
+    slot: u64,
+) -> Result<RootEvidence, ArchiveError> {
+    if !store.is_root(slot) {
+        bail!("archive evidence slot is not rooted");
+    }
+    let (hash, timestamp) = store
+        .get_optimistic_slot(slot)?
+        .ok_or_else(|| anyhow!("archive evidence lacks certified bank hash"))?;
+    let evidence = RootEvidence {
+        slot,
+        is_root: true,
+        certified_bank_hash: hash.to_bytes(),
+        certified_timestamp: timestamp,
+        replay_bank_hash: store.get_bank_hash(slot).map(|h| h.to_bytes()),
+    };
+    if evidence
+        .replay_bank_hash
+        .is_some_and(|h| h != evidence.certified_bank_hash)
+    {
+        bail!("archive evidence replay and certified hash conflict");
+    }
+    Ok(evidence)
+}
+
+fn checked_fd(fd: i32, what: &str) -> Result<File, ArchiveError> {
+    if fd < 0 {
+        return Err(std::io::Error::last_os_error()).with_context(|| what.to_owned());
+    }
+    // Successful descriptor is uniquely owned by the returned File.
+    Ok(unsafe { File::from_raw_fd(fd) })
+}
+
+fn c_name(name: &[u8]) -> Result<CString, ArchiveError> {
+    CString::new(name).context("archive path contains a NUL")
+}
+
+fn check_owner(file: &File, owner: u32, directory: bool) -> Result<(), ArchiveError> {
+    let m = file.metadata()?;
+    if m.uid() != owner
+        || m.mode() & 0o077 != 0
+        || (directory && !m.is_dir())
+        || (!directory && (!m.is_file() || m.nlink() != 1))
+    {
+        bail!("archive file type, owner, permissions or link count differs");
+    }
+    Ok(())
+}
+
+fn open_root(path: &Path, owner: u32) -> Result<File, ArchiveError> {
+    if !path.is_absolute() {
+        bail!("archive root must be absolute");
+    }
+    let mut directory = checked_fd(
+        unsafe {
+            libc::open(
+                c"/".as_ptr(),
+                libc::O_RDONLY | libc::O_DIRECTORY | libc::O_CLOEXEC,
+            )
+        },
+        "open filesystem root",
+    )?;
+    // O_NOFOLLOW on EVERY component; subsequent operations use pinned dirfds.
+    for component in path.components() {
+        match component {
+            Component::RootDir => {}
+            Component::Normal(name) => {
+                let name = c_name(name.as_bytes())?;
+                directory = checked_fd(
+                    unsafe {
+                        libc::openat(
+                            directory.as_raw_fd(),
+                            name.as_ptr(),
+                            libc::O_RDONLY | libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+                        )
+                    },
+                    "open archive directory component",
+                )?;
+            }
+            _ => bail!("archive root path contains a non-normal component"),
+        }
+    }
+    check_owner(&directory, owner, true)?;
+    Ok(directory)
+}
+
+fn valid_generation(name: &str) -> Result<(), ArchiveError> {
+    if name.is_empty()
+        || name.len() > 64
+        || !name
+            .bytes()
+            .all(|c| c.is_ascii_alphanumeric() || c == b'-' || c == b'_')
+    {
+        bail!("invalid immutable archive generation name");
+    }
+    Ok(())
+}
+
+fn open_child(
+    directory: &File,
+    name: &str,
+    owner: u32,
+    is_dir: bool,
+) -> Result<File, ArchiveError> {
+    let name = c_name(name.as_bytes())?;
+    let flags = libc::O_RDONLY
+        | libc::O_NOFOLLOW
+        | libc::O_CLOEXEC
+        | if is_dir {
+            libc::O_DIRECTORY
+        } else {
+            libc::O_NONBLOCK
+        };
+    let file = checked_fd(
+        unsafe { libc::openat(directory.as_raw_fd(), name.as_ptr(), flags) },
+        "open archive child",
+    )?;
+    check_owner(&file, owner, is_dir)?;
+    Ok(file)
+}
+
+fn write_new(directory: &File, name: &str, owner: u32, raw: &[u8]) -> Result<(), ArchiveError> {
+    let name = c_name(name.as_bytes())?;
+    let mut file = checked_fd(
+        unsafe {
+            libc::openat(
+                directory.as_raw_fd(),
+                name.as_ptr(),
+                libc::O_WRONLY | libc::O_CREAT | libc::O_EXCL | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+                0o600,
+            )
+        },
+        "create exclusive archive file",
+    )?;
+    check_owner(&file, owner, false)?;
+    file.write_all(raw)?;
+    file.sync_all()?;
+    Ok(())
+}
+
+fn read_bounded(mut file: File, max: usize) -> Result<Vec<u8>, ArchiveError> {
+    let expected = file.metadata()?.len();
+    if expected == 0 || expected > max as u64 {
+        bail!("archive file exceeds byte bound");
+    }
+    let mut raw = Vec::new();
+    (&mut file).take(max as u64 + 1).read_to_end(&mut raw)?;
+    if raw.len() > max || raw.len() as u64 != expected || file.metadata()?.len() != expected {
+        bail!("archive file size changed or read was incomplete");
+    }
+    Ok(raw)
+}
+
+fn payload(prefix: &ValidatedPrefix) -> Result<Vec<u8>, ArchiveError> {
+    let count = prefix.records().count();
+    let mut raw = Vec::new();
+    raw.extend_from_slice(MAGIC);
+    raw.extend_from_slice(&(count as u32).to_le_bytes());
+    for (slot, meta) in prefix.records().rev() {
+        let encoded = encode_full_meta(meta)?;
+        raw.extend_from_slice(&slot.to_le_bytes());
+        raw.extend_from_slice(&(encoded.len() as u32).to_le_bytes());
+        raw.extend_from_slice(&digest(&encoded));
+        raw.extend_from_slice(&encoded);
+        if raw.len() > MAX_PAYLOAD {
+            bail!("archive payload exceeds byte bound");
+        }
+    }
+    Ok(raw)
+}
+
+fn decode_payload(
+    raw: &[u8],
+    expected_count: usize,
+    deadline: Instant,
+    cancelled: &mut impl FnMut() -> bool,
+) -> Result<Vec<(u64, SlotMeta)>, ArchiveError> {
+    if raw.len() < 12 || raw.len() > MAX_PAYLOAD || &raw[..8] != MAGIC {
+        bail!("invalid archive payload frame");
+    }
+    let count = u32::from_le_bytes(raw[8..12].try_into().unwrap()) as usize;
+    if count == 0 || count > MAX_RECORDS || count != expected_count {
+        bail!("invalid archive record count");
+    }
+    let mut offset = 12usize;
+    let mut result = Vec::with_capacity(count);
+    let mut previous = None;
+    let mut total = 0u64;
+    for _ in 0..count {
+        budget(deadline, cancelled)?;
+        let header_end = offset
+            .checked_add(44)
+            .filter(|v| *v <= raw.len())
+            .ok_or_else(|| anyhow!("truncated archive record header"))?;
+        let header = &raw[offset..header_end];
+        let slot = u64::from_le_bytes(header[..8].try_into().unwrap());
+        let size = u32::from_le_bytes(header[8..12].try_into().unwrap()) as usize;
+        if size == 0 || size > MAX_META_BYTES || previous.is_some_and(|p| slot >= p) {
+            bail!("archive record bound or order differs");
+        }
+        total = total
+            .checked_add(size as u64)
+            .ok_or_else(|| anyhow!("archive byte overflow"))?;
+        if total > MAX_PREFIX_BYTES {
+            bail!("archive exceeds canonical byte bound");
+        }
+        let end = header_end
+            .checked_add(size)
+            .filter(|v| *v <= raw.len())
+            .ok_or_else(|| anyhow!("truncated archive metadata"))?;
+        let encoded = &raw[header_end..end];
+        if digest(encoded).as_slice() != &header[12..44] {
+            bail!("archive record digest differs");
+        }
+        result.push((slot, decode_full_meta(slot, encoded)?));
+        offset = end;
+        previous = Some(slot);
+        budget(deadline, cancelled)?;
+    }
+    if offset != raw.len() {
+        bail!("trailing archive payload bytes");
+    }
+    Ok(result)
+}
+
+pub(crate) fn publish(
+    root: &Path,
+    generation: &str,
+    owner_uid: u32,
+    binding: &ArchiveBinding,
+    records: Vec<(u64, SlotMeta)>,
+    deadline: Instant,
+    mut cancelled: impl FnMut() -> bool,
+) -> Result<PublishedArchive, ArchiveError> {
+    budget(deadline, &mut cancelled)?;
+    valid_generation(generation)?;
+    valid_binding(binding)?;
+    let prefix = ValidatedPrefix::try_from_metadata(
+        binding.original.slot,
+        binding.head.slot,
+        binding.prune_through,
+        records,
+        deadline,
+        &mut cancelled,
+    )?;
+    let raw = payload(&prefix)?;
+    budget(deadline, &mut cancelled)?;
+    let manifest = serde_json::to_vec(&Manifest {
+        format: FORMAT.into(),
+        binding: binding.clone(),
+        record_count: prefix.records().count(),
+        payload_bytes: raw.len(),
+        payload_sha256: digest(&raw),
+    })?;
+    if manifest.len() > MAX_MANIFEST {
+        bail!("archive manifest exceeds byte bound");
+    }
+    let parent = open_root(root, owner_uid)?;
+    let pending = format!(".pending-{generation}");
+    let pending_c = c_name(pending.as_bytes())?;
+    if unsafe { libc::mkdirat(parent.as_raw_fd(), pending_c.as_ptr(), 0o700) } != 0 {
+        return Err(std::io::Error::last_os_error())
+            .context("create exclusive pending archive generation");
+    }
+    // Preserve an incomplete generation on failure. Never resume, overwrite or
+    // publish it merely because files happen to be present after a crash.
+    parent.sync_all()?;
+    let directory = open_child(&parent, &pending, owner_uid, true)?;
+    write_new(&directory, "prefix.bin", owner_uid, &raw)?;
+    budget(deadline, &mut cancelled)?;
+    write_new(&directory, "manifest.json", owner_uid, &manifest)?;
+    directory.sync_all()?;
+    budget(deadline, &mut cancelled)?;
+    #[cfg(test)]
+    publication_hook(PublicationPoint::BeforeRename);
+    let final_c = c_name(generation.as_bytes())?;
+    #[cfg(target_os = "linux")]
+    if unsafe {
+        libc::renameat2(
+            parent.as_raw_fd(),
+            pending_c.as_ptr(),
+            parent.as_raw_fd(),
+            final_c.as_ptr(),
+            libc::RENAME_NOREPLACE,
+        )
+    } != 0
+    {
+        return Err(std::io::Error::last_os_error())
+            .context("publish exclusive archive generation");
+    }
+    #[cfg(not(target_os = "linux"))]
+    bail!("exclusive native archive publication currently requires Linux");
+    parent.sync_all()?;
+    #[cfg(test)]
+    publication_hook(PublicationPoint::AfterCommit);
+    budget(deadline, &mut cancelled)?;
+    Ok(PublishedArchive {
+        manifest_sha256: digest(&manifest),
+    })
+}
+
+pub(crate) fn load(
+    root: &Path,
+    generation: &str,
+    owner_uid: u32,
+    expected_manifest_sha256: [u8; 32],
+    expected: &ArchiveBinding,
+    deadline: Instant,
+    mut cancelled: impl FnMut() -> bool,
+) -> Result<LoadedArchive, ArchiveError> {
+    budget(deadline, &mut cancelled)?;
+    valid_generation(generation)?;
+    valid_binding(expected)?;
+    let parent = open_root(root, owner_uid)?;
+    let directory = open_child(&parent, generation, owner_uid, true)?;
+    let raw_manifest = read_bounded(
+        open_child(&directory, "manifest.json", owner_uid, false)?,
+        MAX_MANIFEST,
+    )?;
+    if digest(&raw_manifest) != expected_manifest_sha256 {
+        bail!("externally pinned archive manifest digest differs");
+    }
+    let manifest: Manifest = serde_json::from_slice(&raw_manifest)?;
+    if manifest.format != FORMAT
+        || &manifest.binding != expected
+        || manifest.record_count == 0
+        || manifest.record_count > MAX_RECORDS
+        || manifest.payload_bytes > MAX_PAYLOAD
+    {
+        bail!("archive manifest format, binding or bounds differ");
+    }
+    budget(deadline, &mut cancelled)?;
+    let raw = read_bounded(
+        open_child(&directory, "prefix.bin", owner_uid, false)?,
+        MAX_PAYLOAD,
+    )?;
+    if raw.len() != manifest.payload_bytes || digest(&raw) != manifest.payload_sha256 {
+        bail!("archive payload size or digest differs");
+    }
+    let records = decode_payload(&raw, manifest.record_count, deadline, &mut cancelled)?;
+    let prefix = ValidatedPrefix::try_from_metadata(
+        expected.original.slot,
+        expected.head.slot,
+        expected.prune_through,
+        records,
+        deadline,
+        &mut cancelled,
+    )?;
+    budget(deadline, &mut cancelled)?;
+    Ok(LoadedArchive {
+        binding: expected.clone(),
+        prefix,
+    })
+}
+
+impl LoadedArchive {
+    pub(crate) fn binding(&self) -> &ArchiveBinding {
+        &self.binding
+    }
+
+    pub(crate) fn read_meta(
+        &self,
+        store: &Blockstore,
+        slot: u64,
+    ) -> Result<Option<SlotMeta>, String> {
+        self.prefix.read_meta(store, slot)
+    }
+
+    pub(crate) fn verify(
+        &self,
+        store: &Blockstore,
+        start: u64,
+        deadline: Instant,
+        cancelled: impl FnMut() -> bool,
+    ) -> Result<AncestryReport, AncestryError> {
+        self.prefix.verify(store, start, deadline, cancelled)
+    }
+
+    pub(crate) fn check_original_root(
+        &self,
+        store: &Blockstore,
+        original_slot: u64,
+        pinned_bank_hash: [u8; 32],
+    ) -> Result<(), ArchiveError> {
+        let original = &self.binding.original;
+        if original.slot != original_slot
+            || original.certified_bank_hash != pinned_bank_hash
+            || original_slot > self.binding.prune_through
+        {
+            bail!("archive does not preserve the caller's original checkpoint");
+        }
+        // Full metadata conflict or a live read/decode error always fails.
+        self.prefix
+            .read_meta(store, original_slot)
+            .map_err(|e| anyhow!(e))?
+            .ok_or_else(|| anyhow!("original checkpoint metadata unavailable"))?;
+        if store.meta(original_slot)?.is_some() {
+            // Preserve the existing root predicate: a matching live certified
+            // hash, and an absent-or-matching replay hash. Timestamp and the
+            // presence of a matching optional replay hash are not new gates.
+            if capture_root_evidence(store, original_slot)?.certified_bank_hash
+                != original.certified_bank_hash
+            {
+                bail!("live original-root evidence conflicts with archive");
+            }
+        } else {
+            if let Some((hash, _)) = store.get_optimistic_slot(original_slot)? {
+                if hash.to_bytes() != original.certified_bank_hash {
+                    bail!("remaining live original certificate conflicts with archive");
+                }
+            }
+            if let Some(hash) = store.get_bank_hash(original_slot) {
+                if hash.to_bytes() != original.certified_bank_hash {
+                    bail!("remaining live original bank hash conflicts with archive");
+                }
+            }
+        }
+        Ok(())
+    }
+}
