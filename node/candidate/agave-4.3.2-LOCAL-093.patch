+// Explicit offline operations apply ONLY to newly marked disposable093 roots.
+// Their closed full canonical SQLite export is independently captured/validated
+// by the controller; this Rust helper binds exact bytes and the supplied exact
+// target, and does not claim to parse SQLite or establish light-client proof.
+struct DurableOperation {
+    root: PathBuf,
+    generation: Option<String>,
+    canonical_path: Option<PathBuf>,
+    canonical_sha256: Option<[u8; 32]>,
+    canonical_through: Option<u64>,
+    canonical_blockhash: Option<[u8; 32]>,
+    minimum_snapshot: Option<u64>,
+    policy_sha256: Option<[u8; 32]>,
+}
+
+fn operation_args(
+    mut args: impl Iterator<Item = String>,
+) -> Result<Option<(bool, DurableOperation)>> {
+    let Some(first) = args.next() else {
+        return Ok(None);
+    };
+    let prepare = match first.as_str() {
+        "--durable-ancestry-prepare" => true,
+        "--durable-ancestry-purge" => false,
+        _ => return Ok(None),
+    };
+    let mut value = DurableOperation {
+        root: PathBuf::from(
+            args.next()
+                .context("offline durable operation needs its exact original root")?,
+        ),
+        generation: None,
+        canonical_path: None,
+        canonical_sha256: None,
+        canonical_through: None,
+        canonical_blockhash: None,
+        minimum_snapshot: None,
+        policy_sha256: None,
+    };
+    let mut seen = HashSet::new();
+    while let Some(option) = args.next() {
+        ensure!(
+            seen.insert(option.clone()),
+            "duplicate durable operation option"
+        );
+        let input = args
+            .next()
+            .context("durable operation option requires a value")?;
+        match option.as_str() {
+            "--generation" if prepare => value.generation = Some(input),
+            "--canonical-export" if prepare => value.canonical_path = Some(input.into()),
+            "--canonical-export-sha256" if prepare => {
+                value.canonical_sha256 = Some(hex_pin(&input)?)
+            }
+            "--canonical-export-through" if prepare => {
+                value.canonical_through = Some(input.parse()?)
+            }
+            "--canonical-export-blockhash" if prepare => {
+                value.canonical_blockhash = Some(hash_bytes(&input)?)
+            }
+            "--minimum-snapshot-slot" if prepare => value.minimum_snapshot = Some(input.parse()?),
+            "--policy-sha256" if !prepare => value.policy_sha256 = Some(hex_pin(&input)?),
+            _ => {
+                anyhow::bail!("unknown or inapplicable offline durable operation option: {option}")
+            }
+        }
+    }
+    ensure!(
+        value.root.is_absolute(),
+        "offline durable root must be absolute"
+    );
+    if prepare {
+        ensure!(
+            value.generation.as_ref().is_some_and(|v| !v.is_empty()
+                && v.len() <= 64
+                && v.bytes()
+                    .all(|c| c.is_ascii_alphanumeric() || c == b'-' || c == b'_'))
+                && value.canonical_path.as_deref()
+                    == Some(Path::new("canonical/full-history.sqlite3"))
+                && value.canonical_sha256.is_some()
+                && value.canonical_through.is_some_and(|s| s > 0)
+                && value.canonical_blockhash.is_some_and(|h| h != [0; 32])
+                && value.minimum_snapshot.is_some_and(|s| s > 0),
+            "prepare needs explicit generation, canonical export path/SHA/target slot/blockhash and minimum snapshot slot"
+        );
+    } else {
+        ensure!(
+            value.policy_sha256.is_some(),
+            "purge needs an independent explicit policy SHA256"
+        );
+    }
+    Ok(Some((prepare, value)))
+}
+
+fn offline_lock(root: &Path) -> Result<File> {
+    check_root(root)?;
+    let file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(root.join("process.lock"))?;
+    let meta = file.metadata()?;
+    ensure!(
+        meta.is_file()
+            && meta.uid() == uid()
+            && meta.len() == 0
+            && meta.nlink() == 1
+            && meta.permissions().mode() & 0o077 == 0,
+        "offline operation requires original private process lock"
+    );
+    file.try_lock()
+        .context("validator process still owns fixture; offline operation refused")?;
+    Ok(file)
+}
+
+fn owned_directory(root: &Path) -> Result<()> {
+    match DirBuilder::new().mode(0o700).create(root) {
+        Ok(()) => File::open(root.parent().context("directory parent missing")?)?.sync_all()?,
+        Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {}
+        Err(error) => return Err(error.into()),
+    }
+    let meta = fs::symlink_metadata(root)?;
+    ensure!(
+        meta.is_dir()
+            && !meta.file_type().is_symlink()
+            && meta.uid() == uid()
+            && meta.permissions().mode() & 0o077 == 0
+            && root.canonicalize()? == root,
+        "durable preparation directory is not a real private owned path"
+    );
+    Ok(())
+}
+
+fn open_original_store(ledger: &Path) -> Result<Blockstore> {
+    let database = ledger.join("rocksdb");
+    let meta = fs::symlink_metadata(&database)?;
+    ensure!(
+        meta.is_dir()
+            && !meta.file_type().is_symlink()
+            && meta.uid() == uid()
+            && database.canonicalize()? == database,
+        "original blockstore directory missing/changed; never create a replacement"
+    );
+    Ok(Blockstore::open(ledger)?)
+}
+
+fn full_prefix(
+    store: &Blockstore,
+    head: u64,
+    original: u64,
+    deadline: Instant,
+) -> Result<Vec<(u64, solana_ledger::blockstore_meta::SlotMeta)>> {
+    ancestry::verify_path(store, head, original, deadline, || false)?;
+    let mut records = Vec::new();
+    let mut slot = head;
+    loop {
+        ensure!(
+            Instant::now() < deadline && records.len() < ancestry::prefix::MAX_RECORDS,
+            "fresh fixture ancestry exceeds its preparation deadline or 4096-record bound"
+        );
+        let meta = store.meta(slot)?.context("full prefix metadata vanished")?;
+        ensure!(meta.slot == slot, "full prefix slot substitution");
+        let parent = meta.parent_slot;
+        records.push((slot, meta));
+        if slot == original {
+            break;
+        }
+        let next = parent.context("full prefix parent missing")?;
+        ensure!(
+            original <= next && next < slot,
+            "full prefix parent passed original checkpoint"
+        );
+        slot = next;
+    }
+    Ok(records)
+}
+
+fn publish_policy(root: &Path, policy: &DurablePolicy) -> Result<[u8; 32]> {
+    let mut raw = serde_json::to_vec_pretty(policy)?;
+    raw.push(b'\n');
+    ensure!(
+        raw.len() <= 65536,
+        "aggregate retention policy exceeds bound"
+    );
+    let pending = root.join(".retention-policy.pending");
+    let target = root.join("retention-policy.json");
+    let mut file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .custom_flags(libc::O_NOFOLLOW)
+        .open(&pending)?;
+    file.write_all(&raw)?;
+    file.sync_all()?;
+    // Atomic exclusive publication. A crash before unlink leaves two links and
+    // the loader refuses; no partial/truncated policy becomes eligible.
+    fs::hard_link(&pending, &target)?;
+    File::open(root)?.sync_all()?;
+    fs::remove_file(&pending)?;
+    File::open(root)?.sync_all()?;
+    Ok(solana_sha256_hasher::hash(&raw).to_bytes())
+}
+
+fn public_policy(policy: &DurablePolicy, pin: &[u8; 32]) -> Value {
+    json!({"format":policy.format,"fixture_root":policy.fixture_root,"policy_sha256":hex(pin),
+        "preparation_only":true,"full_snapshot_verification_required_on_resume":true,
+        "canonical_export":{"relative_path":policy.canonical_export.relative_path,
+            "sha256":hex(&policy.canonical_export.file_sha256),"through_slot":policy.canonical_export.through_slot,
+            "through_blockhash":Pubkey::new_from_array(policy.canonical_export.through_blockhash).to_string()},
+        "peers":policy.peers.iter().map(|p| json!({"identity":Pubkey::new_from_array(p.binding.domain.identity).to_string(),
+            "original_root_slot":p.binding.original.slot,"original_root_bank_hash":Pubkey::new_from_array(p.binding.original.certified_bank_hash).to_string(),
+            "head_slot":p.binding.head.slot,"head_bank_hash":Pubkey::new_from_array(p.binding.head.certified_bank_hash).to_string(),
+            "prune_through":p.binding.prune_through,"snapshot_parent_slot":p.binding.snapshot_parent_slot,
+            "oldest_snapshot_slot":p.binding.snapshot_slot,"captured_current_root_slot":p.binding.captured_current_root_slot,
+            "snapshots":p.snapshots,"ancestry_manifest_sha256":hex(&p.manifest_sha256)})).collect::<Vec<_>>()})
+}
