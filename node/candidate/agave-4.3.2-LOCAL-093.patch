+// Offline fresh093 fixture preparation only. The two generated archives live
+// in each original ledger root; no filename is treated as verified bank state.
+// These copies become eligible only after the ordinary full snapshot loader.
+pub(super) fn protect_generated(
+    ledger: &Path,
+    original_root: u64,
+    minimum_slot: u64,
+) -> Result<Vec<PinnedArchive>> {
+    let owner = fs::metadata(ledger)?.uid();
+    owned_directory(ledger, owner)?;
+    let mut sources: Vec<_> = agave_snapshots::paths::full_snapshot_archives_iter(ledger).collect();
+    sources.sort_by_key(|info| info.slot());
+    ensure!(
+        sources.len() == 2
+            && sources[0].slot() > original_root
+            && sources[0].slot() >= minimum_slot
+            && sources[0].slot() < sources[1].slot(),
+        "need exactly two real generated full archives strictly after the payment threshold"
+    );
+    let (root, full, incremental, bank) = paths(ledger);
+    for path in [&root, &full, &incremental, &bank] {
+        prepare_directory(path, owner)?;
+    }
+    full_only_inputs(ledger)?;
+    ensure!(
+        fs::read_dir(&full)?.next().is_none(),
+        "protected snapshot directory must be fresh and empty; no overwrite or automatic retry"
+    );
+    let mut pins = Vec::new();
+    for source in sources {
+        let filename = source
+            .path()
+            .file_name()
+            .and_then(|v| v.to_str())
+            .context("generated full archive filename is not UTF8")?
+            .to_owned();
+        ensure!(
+            source.path().parent() == Some(ledger)
+                && Path::new(&filename).components().count() == 1
+                && !filename.starts_with('.'),
+            "generated archive is not a direct original-ledger child"
+        );
+        let digest = file_digest(source.path(), owner, 8 * 1024 * 1024 * 1024)?;
+        let mut input = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+            .open(source.path())?;
+        let mut output = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .custom_flags(libc::O_NOFOLLOW)
+            .open(full.join(&filename))?;
+        let copied = std::io::copy(
+            &mut (&mut input).take(8 * 1024 * 1024 * 1024 + 1),
+            &mut output,
+        )?;
+        ensure!(
+            copied > 0 && copied <= 8 * 1024 * 1024 * 1024,
+            "generated archive copy exceeded bound"
+        );
+        output.flush()?;
+        output.sync_all()?;
+        ensure!(
+            file_digest(source.path(), owner, 8 * 1024 * 1024 * 1024)? == digest
+                && file_digest(&full.join(&filename), owner, 8 * 1024 * 1024 * 1024)? == digest,
+            "generated/protected full archive changed during copy"
+        );
+        pins.push(PinnedArchive {
+            filename,
+            slot: source.slot(),
+            snapshot_hash: source.hash().0.to_string(),
+            file_sha256: digest,
+        });
+    }
+    File::open(&full)?.sync_all()?;
+    Ok(pins)
+}
