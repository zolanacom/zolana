+//! Native disposable filesystem/DB fixtures only. No real genesis, validator,
+//! snapshot, BLS certificate or financial state is produced by these unit tests.
+use {
+    super::*,
+    solana_ledger::blockstore::PurgeType,
+    std::{
+        fs,
+        os::unix::fs::{DirBuilderExt, PermissionsExt, symlink},
+        path::PathBuf,
+        sync::atomic::{AtomicU64, Ordering},
+        time::Duration,
+    },
+};
+
+static SEQUENCE: AtomicU64 = AtomicU64::new(0);
+struct Fixture(PathBuf);
+impl Fixture {
+    fn new() -> Self {
+        let path = std::env::temp_dir().join(format!(
+            "zolana093-archive-{}-{}",
+            std::process::id(),
+            SEQUENCE.fetch_add(1, Ordering::Relaxed)
+        ));
+        fs::DirBuilder::new().mode(0o700).create(&path).unwrap();
+        Self(path)
+    }
+}
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        fs::remove_dir_all(&self.0).unwrap();
+    }
+}
+fn owner() -> u32 {
+    unsafe { libc::geteuid() }
+}
+fn budget() -> Instant {
+    Instant::now() + Duration::from_secs(10)
+}
+fn hash(slot: u64) -> [u8; 32] {
+    digest(&slot.to_le_bytes())
+}
+fn meta(slot: u64, parent: Option<u64>) -> SlotMeta {
+    let mut value = SlotMeta {
+        slot,
+        parent_slot: parent,
+        consumed: 2,
+        received: 2,
+        last_index: Some(1),
+        ..SlotMeta::default()
+    };
+    value.completed_data_indexes.insert(1);
+    value.next_slots.push(slot + 2);
+    value
+}
+fn records() -> Vec<(u64, SlotMeta)> {
+    vec![
+        (9, meta(9, Some(7))),
+        (7, meta(7, Some(3))),
+        (3, meta(3, None)),
+    ]
+}
+fn evidence(slot: u64) -> RootEvidence {
+    RootEvidence {
+        slot,
+        is_root: true,
+        certified_bank_hash: hash(slot),
+        certified_timestamp: slot as i64,
+        replay_bank_hash: Some(hash(slot)),
+    }
+}
+fn binding() -> ArchiveBinding {
+    ArchiveBinding {
+        domain: Domain {
+            network: [7; 32],
+            genesis_hash: [11; 32],
+            identity: [1; 32],
+            voter: [2; 32],
