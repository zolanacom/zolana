+    assert!(reopened.get_optimistic_slot(3).unwrap().is_none());
+    assert!(reopened.get_bank_hash(3).is_none());
+    assert!(crate::ancestry::verify_path(&reopened, 15, 3, budget(), || false).is_err());
+    let loaded = load(
+        &archive_dir.0,
+        "one",
+        owner(),
+        published.manifest_sha256,
+        &expected,
+        budget(),
+        || false,
+    )
