+    let original = fs::read(root.0.join("one/prefix.bin")).unwrap();
+    let mut raw = original.clone();
+    raw[0] ^= 1;
+    let pin = repin_payload(&root.0, &raw);
+    assert!(load_fixture(&root.0, "one", pin).is_err());
+    let mut raw = original.clone();
+    raw[8..12].copy_from_slice(&u32::MAX.to_le_bytes());
+    let pin = repin_payload(&root.0, &raw);
+    assert!(load_fixture(&root.0, "one", pin).is_err());
+    let mut raw = original.clone();
+    raw.extend_from_slice(&[0]);
+    let pin = repin_payload(&root.0, &raw);
+    assert!(load_fixture(&root.0, "one", pin).is_err());
+    let mut raw = original;
+    let size = u32::from_le_bytes(raw[20..24].try_into().unwrap()) as usize;
+    let mut changed = decode_full_meta(9, &raw[56..56 + size]).unwrap();
+    changed.parent_slot = Some(9);
+    let encoded = encode_full_meta(&changed).unwrap();
+    assert_eq!(encoded.len(), size);
+    raw[24..56].copy_from_slice(&digest(&encoded));
+    raw[56..56 + size].copy_from_slice(&encoded);
+    let pin = repin_payload(&root.0, &raw);
+    assert!(load_fixture(&root.0, "one", pin).is_err());
+}
