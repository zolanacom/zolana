+    loaded.check_original_root(&reopened, 3, hash(3)).unwrap();
+    assert!(loaded.check_original_root(&reopened, 3, hash(4)).is_err());
+    assert_eq!(reopened.meta(9).unwrap().unwrap(), meta(9, Some(7)));
+    assert_eq!(capture_root_evidence(&reopened, 15).unwrap(), evidence(15));
+    drop(loaded);
+    assert_eq!(
+        load(
+            &archive_dir.0,
+            "one",
+            owner(),
+            published.manifest_sha256,
+            &expected,
+            budget(),
+            || false
+        )
+        .unwrap()
+        .verify(&reopened, 15, budget(), || false)
+        .unwrap(),
+        before
+    );
+}
