+fn prepare_durable(root: &Path, args: DurableOperation, manifest: &Manifest) -> Result<Value> {
+    ensure!(
+        !root.join("retention-policy.json").try_exists()?
+            && !root.join(".retention-policy.pending").try_exists()?,
+        "retention preparation requires fresh policy paths; no overwrite/retry"
+    );
+    let canonical_path = args
+        .canonical_path
+        .context("canonical export path missing")?;
+    ensure!(
+        canonical_path == Path::new("canonical/full-history.sqlite3"),
+        "only the fixed full canonical export path is permitted"
+    );
+    let canonical_sha = args
+        .canonical_sha256
+        .context("canonical export pin missing")?;
+    ensure!(
+        restart_snapshots::file_digest(&child(root, &canonical_path)?, uid(), 1024 * 1024 * 1024)?
+            == canonical_sha,
+        "closed full canonical export bytes differ before preparation"
+    );
+    let through_slot = args.canonical_through.context("canonical target missing")?;
+    let through_blockhash = args
+        .canonical_blockhash
+        .context("canonical target hash missing")?;
+    ensure!(
+        through_slot > 0 && through_blockhash != [0; 32],
+        "canonical export exact nonzero target required"
+    );
+    let resume_sha =
+        solana_sha256_hasher::hash(&private_bytes(&root.join("resume.json"), 65536)?).to_bytes();
+    let deadline = Instant::now() + Duration::from_secs(60);
+    let mut peers = Vec::new();
+    let archive_base = root.join("durable-ancestry");
+    owned_directory(&archive_base)?;
+    for node in &manifest.nodes {
+        let ledger = child(root, &node.ledger)?;
+        let store = open_original_store(&ledger)?;
+        let current = store.max_root();
+        ancestry_archive::capture_root_evidence(&store, current)?;
+        let protected = restart_snapshots::protect_generated(
+            &ledger,
+            node.root_slot,
+            args.minimum_snapshot
+                .context("minimum snapshot slot missing")?,
+        )?;
+        ensure!(
+            protected[1].slot <= current,
+            "generated snapshot exceeds captured live certified root"
+        );
+        let snapshot_slot = protected[0].slot;
+        let parent = store
+            .meta(snapshot_slot)?
+            .context("oldest snapshot canonical metadata missing")?
+            .parent_slot
+            .context("oldest snapshot canonical parent missing")?;
+        ensure!(
+            node.root_slot < parent && parent < snapshot_slot,
+            "snapshot parent does not leave a pruneable certified checkpoint interval"
+        );
+        let mut head = parent;
+        let mut count = 0;
+        loop {
+            ensure!(
+                Instant::now() < deadline && count < ancestry::prefix::MAX_RECORDS,
+                "certified head search exceeded fixture budget"
+            );
+            if store.is_root(head) && store.get_optimistic_slot(head)?.is_some() {
+                break;
+            }
+            let meta = store
+                .meta(head)?
+                .context("snapshot parent ancestry missing")?;
+            let next = meta.parent_slot.context("snapshot parent chain ended")?;
+            ensure!(
+                node.root_slot < next && next < head,
+                "no certified head strictly above original root"
+            );
+            head = next;
+            count += 1;
+        }
+        let cutoff = head.checked_sub(1).context("head cannot be genesis")?;
+        ensure!(
+            node.root_slot <= cutoff && cutoff < through_slot,
+            "prune cutoff not covered by full canonical export"
+        );
+        ancestry::verify_path(&store, current, node.root_slot, deadline, || false)?;
+        let records = full_prefix(&store, head, node.root_slot, deadline)?;
+        let binding = ancestry_archive::ArchiveBinding {
+            domain: ancestry_archive::Domain {
+                network: zolana_native_check::TEST_SLOT_NETWORK,
+                genesis_hash: hash_bytes(&manifest.genesis_hash)?,
+                identity: hash_bytes(&node.identity)?,
+                voter: hash_bytes(&node.voter)?,
+                resume_sha256: resume_sha,
+                ledger_relative_path: node
+                    .ledger
+                    .to_str()
+                    .context("ledger path is not UTF8")?
+                    .to_owned(),
+            },
+            original: ancestry_archive::capture_root_evidence(&store, node.root_slot)?,
+            head: ancestry_archive::capture_root_evidence(&store, head)?,
+            prune_through: cutoff,
+            snapshot_parent_slot: parent,
+            snapshot_slot,
+            captured_current_root_slot: current,
+            canonical_export_through: through_slot,
+        };
+        ensure!(
+            binding.original.certified_bank_hash == hash_bytes(&node.root_bank_hash)?,
+            "original root certificate differs from immutable resume manifest"
+        );
+        let snapshots = restart_snapshots::PinnedSnapshots {
+            selected_filename: protected[1].filename.clone(),
+            protected,
+            oldest_parent_slot: parent,
+        };
+        restart_snapshots::validate_pins(&ledger, &snapshots, node.root_slot)?;
+        let archive_root = archive_base.join(&node.identity);
+        owned_directory(&archive_root)?;
+        let generation = args
+            .generation
+            .as_ref()
+            .context("archive generation missing")?;
+        let published = ancestry_archive::publish(
+            &archive_root,
+            generation,
+            uid(),
+            &binding,
+            records,
