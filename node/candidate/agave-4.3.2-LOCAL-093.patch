+pub(super) fn file_digest(path: &Path, owner: u32, maximum: u64) -> Result<[u8; 32]> {
+    let mut file = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(path)?;
+    let meta = file.metadata()?;
+    ensure!(
+        meta.is_file()
+            && meta.uid() == owner
+            && meta.nlink() == 1
+            && meta.permissions().mode() & 0o022 == 0
+            && meta.len() > 0
+            && meta.len() <= maximum
+            && path.canonicalize()? == path,
+        "unsafe or oversized pinned fixture file"
+    );
+    let mut hasher = solana_sha256_hasher::Hasher::default();
+    let mut buffer = [0u8; 65536];
+    let mut total = 0u64;
+    loop {
+        let n = file.read(&mut buffer)?;
+        if n == 0 {
+            break;
+        }
+        total = total.checked_add(n as u64).context("file size overflow")?;
+        ensure!(total <= maximum, "pinned fixture file grew beyond bound");
+        hasher.hash(&buffer[..n]);
+    }
+    ensure!(
+        total == meta.len() && file.metadata()?.len() == meta.len(),
+        "pinned file changed while hashing"
+    );
+    Ok(hasher.result().to_bytes())
+}
