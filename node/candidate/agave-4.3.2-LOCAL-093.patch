+pub(super) fn maybe_durable_operation() -> Result<bool> {
+    let Some((prepare, args)) = operation_args(std::env::args().skip(1))? else {
+        return Ok(false);
+    };
+    ensure!(
+        cfg!(target_os = "linux"),
+        "durable offline fixture operations are Linux-only"
+    );
+    let root = args.root.clone();
+    let _lock = offline_lock(&root)?;
+    let manifest = Manifest::load(&root)?;
+    ensure!(
+        manifest.durable_ancestry_fixture
+            && manifest.nodes.len() == 3
+            && manifest.private
+            && manifest.slot_anchors,
+        "offline durable operation refuses every pre-existing/non-disposable fixture"
+    );
+    let result = if prepare {
+        prepare_durable(&root, args, &manifest)?
+    } else {
+        purge_durable(
+            &root,
+            args.policy_sha256.context("policy pin missing")?,
+            &manifest,
+        )?
+    };
+    println!("{}", serde_json::to_string(&result)?);
+    Ok(true)
+}
