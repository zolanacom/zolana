+    }
+    let policy = DurablePolicy {
+        format: "zolana093-disposable-durable-retention-v1".into(),
+        fixture_root: root.to_owned(),
+        resume_sha256: resume_sha,
+        canonical_export: CanonicalExport {
+            relative_path: canonical_path,
+            file_sha256: canonical_sha,
