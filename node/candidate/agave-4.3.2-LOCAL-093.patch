+// Re-exec only the test harness, never the validator CLI. The environment is
+// consumed exclusively inside this cfg(test) module; production has no fault
+// environment or hook. Both cases use public disposable fixture data only.
+fn publication_kill_case(point: PublicationPoint, test_name: &str) {
+    use std::{
+        fs::OpenOptions,
+        os::unix::{fs::OpenOptionsExt, process::ExitStatusExt},
+        process::{Child, Command, Stdio},
+        thread,
+    };
+    const CHILD_CASE: &str = "ZOLANA093_TEST_PUBLICATION_CHILD";
+    const CHILD_ROOT: &str = "ZOLANA093_TEST_PUBLICATION_ROOT";
+    let label = match point {
+        PublicationPoint::BeforeRename => "before",
+        PublicationPoint::AfterCommit => "after",
+    };
+    let new_binding = || {
+        let mut value = binding();
+        value.captured_current_root_slot = 18;
+        value.canonical_export_through = 18;
+        value
+    };
+    if let Some(child_case) = std::env::var_os(CHILD_CASE) {
+        assert_eq!(child_case.as_os_str(), std::ffi::OsStr::new(label));
+        let root = PathBuf::from(std::env::var_os(CHILD_ROOT).unwrap());
+        assert!(root.is_absolute());
+        let marker = root.join("publication-point-seen");
+        PUBLICATION_HOOK.with(|hook| {
+            *hook.borrow_mut() = Some(Box::new(move |observed| {
+                if observed == point {
+                    let mut file = OpenOptions::new()
+                        .write(true)
+                        .create_new(true)
+                        .mode(0o600)
+                        .open(&marker)
+                        .unwrap();
+                    file.write_all(b"observed").unwrap();
+                    file.sync_all().unwrap();
+                    // Parent kills this process; do not execute the next step.
+                    loop {
+                        thread::park();
+                    }
+                }
+            }));
+        });
+        publish(
+            &root,
+            "new",
+            owner(),
+            &new_binding(),
+            records(),
+            budget(),
+            || false,
+        )
+        .unwrap();
+        panic!("publication test hook was not reached");
+    }
+
+    struct ChildGuard(Child);
+    impl Drop for ChildGuard {
+        fn drop(&mut self) {
+            if self.0.try_wait().ok().flatten().is_none() {
+                let _ = self.0.kill();
+                let _ = self.0.wait();
+            }
+        }
+    }
+    let root = Fixture::new();
+    let old = publish_fixture(&root.0, "old");
+    // Expected NEW digest is computed out-of-band from independently known
+    // typed fixture/binding before the child writes anything. Never read the
+    // produced manifest to choose the expected pin.
+    let expected_binding = new_binding();
+    let prefix =
+        ValidatedPrefix::try_from_metadata(3, 9, 7, records(), budget(), || false).unwrap();
+    let raw = payload(&prefix).unwrap();
+    let expected_manifest = serde_json::to_vec(&Manifest {
+        format: FORMAT.into(),
+        binding: expected_binding.clone(),
+        record_count: 3,
+        payload_bytes: raw.len(),
+        payload_sha256: digest(&raw),
+    })
+    .unwrap();
+    let expected_pin = digest(&expected_manifest);
+    assert_ne!(expected_pin, old.manifest_sha256);
+    drop(prefix);
+    let child = Command::new(std::env::current_exe().unwrap())
+        .arg(test_name)
+        .arg("--exact")
+        .arg("--nocapture")
+        .arg("--test-threads=1")
+        .env(CHILD_CASE, label)
+        .env(CHILD_ROOT, &root.0)
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap();
+    let mut child = ChildGuard(child);
+    let until = Instant::now() + Duration::from_secs(10);
+    while !root.0.join("publication-point-seen").exists() {
+        assert!(
+            child.0.try_wait().unwrap().is_none(),
+            "publication child exited before its hook"
+        );
+        assert!(
+            Instant::now() < until,
+            "publication child did not reach hook in time"
+        );
+        thread::sleep(Duration::from_millis(5));
+    }
+    // std Child::kill on this Unix fixture sends SIGKILL; verify the actual
+    // termination signal rather than treating an ordinary process exit as it.
+    child.0.kill().unwrap();
+    let status = child.0.wait().unwrap();
+    assert_eq!(status.signal(), Some(libc::SIGKILL));
+    load_fixture(&root.0, "old", old.manifest_sha256).unwrap();
+    let loaded = load(
+        &root.0,
+        "new",
+        owner(),
+        expected_pin,
+        &expected_binding,
+        budget(),
+        || false,
+    );
+    match point {
+        PublicationPoint::BeforeRename => {
+            assert!(loaded.is_err());
+            assert!(!root.0.join("new").exists());
+            assert!(root.0.join(".pending-new/manifest.json").exists());
+        }
+        PublicationPoint::AfterCommit => {
+            let loaded = loaded.unwrap();
+            assert_eq!(loaded.binding(), &expected_binding);
+            assert!(!root.0.join(".pending-new").exists());
+            let db = Fixture::new();
+            let store = Blockstore::open(&db.0).unwrap();
+            store.put_meta(9, &meta(9, Some(7))).unwrap();
+            assert_eq!(
+                loaded
+                    .verify(&store, 9, budget(), || false)
+                    .unwrap()
+                    .entries,
+                3
+            );
+            loaded.check_original_root(&store, 3, hash(3)).unwrap();
+        }
+    }
+    // SIGKILL publication/reload is tested, not host power-loss or a validator
+    // crash; the separate full-validator scenario remains an integration gate.
+}
