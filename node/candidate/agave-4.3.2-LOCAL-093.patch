+fn purge_durable(root: &Path, expected_pin: [u8; 32], manifest: &Manifest) -> Result<Value> {
+    let loaded = load_durable(root, expected_pin, manifest)?;
+    let deadline = Instant::now() + Duration::from_secs(60);
+    let mut stores = Vec::new();
+    // Preflight EVERY peer before the first purge. A partial failed mutation is
+    // left for forensic inspection; it is never automatically retried/reset.
+    for (peer, archive) in loaded.policy.peers.iter().zip(&loaded.archives) {
+        let ledger = child(root, Path::new(&peer.binding.domain.ledger_relative_path))?;
+        let store = open_original_store(&ledger)?;
+        ensure!(
+            store.max_root() == peer.binding.captured_current_root_slot
+                && store.meta(peer.binding.original.slot)?.is_some(),
+            "purge fixture already changed or was previously pruned"
+        );
+        ancestry_archive::capture_root_evidence(&store, peer.binding.captured_current_root_slot)?;
+        check_live_durable_head(&store, &peer.binding)?;
+        archive.check_original_root(
+            &store,
+            peer.binding.original.slot,
+            peer.binding.original.certified_bank_hash,
+        )?;
+        archive.verify(
+            &store,
+            peer.binding.captured_current_root_slot,
+            deadline,
+            || false,
+        )?;
+        stores.push(store);
+    }
+    for ((peer, archive), store) in loaded
+        .policy
+        .peers
+        .iter()
+        .zip(&loaded.archives)
+        .zip(&stores)
+    {
+        store.purge_slots(
+            0,
+            peer.binding.prune_through,
+            solana_ledger::blockstore::blockstore_purge::PurgeType::Exact,
+        )?;
+        ensure!(
+            store.meta(peer.binding.original.slot)?.is_none()
+                && store.meta(peer.binding.head.slot)?.is_some(),
+            "ordinary purge did not remove old metadata or damaged live certified head"
+        );
+        ancestry_archive::capture_root_evidence(store, peer.binding.captured_current_root_slot)?;
+        check_live_durable_head(store, &peer.binding)?;
+        archive.check_original_root(
+            store,
+            peer.binding.original.slot,
+            peer.binding.original.certified_bank_hash,
+        )?;
+        archive.verify(
+            store,
+            peer.binding.captured_current_root_slot,
+            deadline,
+            || false,
+        )?;
+    }
+    let mut result = public_policy(&loaded.policy, &expected_pin);
+    result["operation"] = json!("ordinary_exact_purge_complete");
+    result["old_checkpoint_metadata_pruned_all_peers"] = json!(true);
+    result["merged_full_ancestry_verified_all_peers"] = json!(true);
+    Ok(result)
+}
