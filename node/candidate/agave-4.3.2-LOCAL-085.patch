+    }
+    let nodes = bank.epoch_staked_nodes(202).context("actual explicit202 node route missing")?;
+    ensure!(nodes.len() == 3,"actual explicit202 node count differs");
+    for row in expected["staked_nodes"].as_array().context("expected staked node rows")? {
+        let node = Pubkey::from_str(row["node"].as_str().context("node key")?)?;
+        ensure!(nodes.get(&node).copied() == row["stake"].as_u64()
