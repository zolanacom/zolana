+//! Read-only LOCAL085 copied signed-history inspection, no keys or networking.
+use agave_votor::vote_history_storage::{FileVoteHistoryStorage, VoteHistoryStorage};
+use anyhow::{Result, ensure};
+use serde_json::{Value, json};
+use solana_pubkey::Pubkey;
+use solana_ledger::{blockstore::Blockstore, blockstore_options::{AccessType,BlockstoreOptions}};
+use std::{fs, os::unix::fs::MetadataExt, path::Path};
+
+fn main() -> Result<()> {
+    ensure!(std::env::args().len() == 1, "fixed copied-history inspection only");
+    let root = Path::new("/var/lib/zolana-vat-085-r1/network");
+    let manifest: Value = serde_json::from_slice(&fs::read(root.join("resume.json"))?)?;
+    ensure!(manifest["genesis_hash"] == "Ehh8b8thLqA1jqUsskkfrmgRRxPuFsUETb7N4pjebv2p" && manifest["original_root"] == root.to_str().unwrap(), "copied history identity changed");
+    let nodes = manifest["nodes"].as_array().ok_or_else(|| anyhow::anyhow!("missing copied peers"))?;
+    ensure!(nodes.len() == 3, "three copied peers required");
+    let mut rows = Vec::new();
+    for node in nodes {
+        let identity: Pubkey = node["identity"].as_str().unwrap_or("").parse()?;
+        let ledger = root.join(node["ledger"].as_str().unwrap_or(""));
+        ensure!(ledger.canonicalize()? == ledger && ledger.starts_with(root.join("ledgers")), "unexpected copied ledger path");
+        let storage = FileVoteHistoryStorage::new(ledger);
+        let path = storage.filename(&identity);
+        let meta = fs::symlink_metadata(&path)?;
+        ensure!(meta.is_file() && meta.uid() == 995 && meta.len() <= 64 * 1024 * 1024 && path.canonicalize()? == path, "bounded original-owner signed history required");
+        // FileVoteHistoryStorage validates its signature and embedded public
+        // identity. Its existing-directory check executes under a read-only
+        // systemd mount; no store method is reachable here.
+        let history = storage.load(&identity)?;
+        let bytes = fs::read(&path)?;
+        let pin: String = solana_sha256_hasher::hash(&bytes).to_bytes().iter().map(|b| format!("{b:02x}")).collect();
+        let mut votes = history.votes_cast_since(history.root().saturating_sub(1));
+        ensure!(votes.len() <= 1024, "unexpectedly large retained public signed tail");
+        votes.sort_by_key(|vote| (vote.slot(), vote.get_type()));
+        let tail = votes.iter().map(|vote| json!({"slot":vote.slot(),
+            "type":format!("{:?}",vote.get_type()),"block_id":vote.block_id().map(ToString::to_string)})).collect::<Vec<_>>();
+        let blockstore = Blockstore::open_with_options(&root.join(node["ledger"].as_str().unwrap()),
+            BlockstoreOptions { access_type:AccessType::ReadOnly, ..BlockstoreOptions::default() })?;
+        ensure!(!blockstore.is_primary_access(), "read-only certified-root inspection required");
+        let root_slot = blockstore.max_root();
+        let certified = blockstore.get_optimistic_slot(root_slot)?;
+        let replay_hash = blockstore.get_bank_hash(root_slot);
+        ensure!(blockstore.is_root(root_slot) && certified.is_some(), "latest rooted bank certificate missing");
+        if let Some(replayed) = replay_hash {
+            ensure!(Some(replayed) == certified.map(|(hash,_)| hash), "latest rooted bank hash conflicts");
+        }
+        rows.push(json!({"identity":identity.to_string(),"signed_history_root":history.root(),
+            "root_epoch":history.root()/2048,"highest_parent_ready_slot":history.highest_parent_ready_slot(),
+            "highest_parent_ready":history.highest_parent_ready().map(|(slot,parent)|json!({"slot":slot,"parent_slot":parent.slot,"parent_block_id":parent.block_id.to_string()})),
+            "latest_retained_vote_slot":votes.iter().map(|vote|vote.slot()).max(),
+            "retained_authenticated_vote_payloads":tail,
+            "blockstore_max_root":root_slot,"certified_bank_hash":certified.map(|(hash,_)|hash.to_string()),
+            "blockstore_replay_bank_hash":replay_hash.map(|hash|hash.to_string()),
+            "file_sha256":pin,"file_bytes":bytes.len(),"signature_and_embedded_identity_verified":true,
+            "retained_vote_hash_kind":"Alpenglow block ID, not Bank hash"}));
+    }
+    println!("{}", json!({"format":"zolana085-copied-signed-history-tail-observation-v1","genesis_hash":manifest["genesis_hash"],"peers":rows,"validator_started":false,"keys_read":false,"transactions_signed":false}));
+    Ok(())
+}
