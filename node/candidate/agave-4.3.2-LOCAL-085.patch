+        for field in ["node", "authorized202", "bls", "weight"] {
+            let mut map = accounts.as_ref().clone();
+            if field == "weight" {
+                map.get_mut(&vote).unwrap().0 += 1;
+            } else {
+                let mut state = VoteStateV4::deserialize(account.account().data(), &vote).unwrap();
+                match field {
+                    "node" => state.node_pubkey = Pubkey::new_unique(),
+                    "authorized202" => {
+                        state.authorized_voters.insert(202, Pubkey::new_unique());
+                    }
+                    _ => state.bls_pubkey_compressed = None,
