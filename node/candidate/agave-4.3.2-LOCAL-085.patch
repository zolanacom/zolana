+#[test]
+fn ancestry_parallel_one_shared_deadline_joins_every_worker_without_partial_success() {
+    let active_count = AtomicUsize::new(0);
+    let ended = AtomicUsize::new(0);
+    let began = Instant::now();
+    let expected_deadline = began + Duration::from_millis(40);
+    let result = run_parallel(
+        vec![0, 1, 2],
+        expected_deadline,
+        || false,
+        |_, deadline, abort| {
+            let _active = active(&active_count);
+            assert_eq!(deadline, expected_deadline);
+            let result = loop {
+                if let Err(error) = check_budget(deadline, &mut || abort.load(Ordering::Acquire)) {
+                    break Err(error);
+                }
+                thread::sleep(Duration::from_millis(1));
+            };
+            ended.fetch_add(1, Ordering::SeqCst);
+            result
+        },
+    );
+    assert!(matches!(result, Err(AncestryError::Deadline)));
+    assert_eq!(active_count.load(Ordering::SeqCst), 0);
+    assert_eq!(ended.load(Ordering::SeqCst), 3);
+    assert!(began.elapsed() < Duration::from_secs(2));
+}
+
+#[test]
+fn ancestry_parallel_external_non_send_cancellation_stops_and_joins_all_walks() {
