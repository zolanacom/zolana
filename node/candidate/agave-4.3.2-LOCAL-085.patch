@@ -0,0 +1,192 @@
+//! Disposable synthetic Bank bookkeeping; actual anchor replay is a separate gate.
+use super::*;
+use crate::genesis_utils::{
+    create_genesis_config_with_alpenglow_vote_accounts, ValidatorVoteKeypairs,
+};
+use solana_signer::Signer;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+fn fixture() -> (
+    Arc<Bank>,
+    Arc<RwLock<crate::bank_forks::BankForks>>,
+    [Pubkey; 3],
+    SlotLeader,
+) {
+    let keys = (0..3)
+        .map(|_| ValidatorVoteKeypairs::new_rand())
+        .collect::<Vec<_>>();
+    let genesis = create_genesis_config_with_alpenglow_vote_accounts(
+        1_000_000_000_000_000,
+        &keys,
+        vec![10_000_000_000; 3],
+    )
+    .genesis_config;
+    let mut bank = Bank::new_for_tests(&genesis);
+    let votes = std::array::from_fn(|i| keys[i].vote_keypair.pubkey());
+    for vote in votes {
+        let mut account = bank.get_account(&vote).unwrap();
+        account.set_lamports(5_000_000_000_000);
+        bank.store_account_and_update_capitalization(&vote, &account);
+    }
+    bank.epoch_stakes.insert(
+        202,
+        VersionedEpochStakes::new(
+            SerdeStakesToStakeFormat::from(Stakes::<StakeAccount<Delegation>>::new(
+                VoteAccounts::default(),
+                0,
+            )),
+            202,
+        ),
+    );
+    bank.freeze();
+    let leader = SlotLeader {
+        id: keys[0].node_keypair.pubkey(),
+        vote_address: votes[0],
+    };
+    let (bank, forks) = bank.wrap_with_bank_forks_for_tests();
+    (bank, forks, votes, leader)
+}
+
+#[test]
+fn unready_query_cannot_poison_once_cell_before_valid_immutable_derivation() {
+    let (parent, _forks, _, _) = fixture();
+    let projected = VersionedEpochStakes::new(
+        SerdeStakesToStakeFormat::from(parent.get_top_epoch_stakes()),
+        202,
+    );
+    let cell = OnceLock::new();
+    let calls = AtomicUsize::new(0);
+    assert!(frozen_view(false, &cell, || {
+        calls.fetch_add(1, Ordering::SeqCst);
+        Some(projected.clone())
+    })
+    .is_none());
+    assert!(cell.get().is_none());
+    assert_eq!(calls.load(Ordering::SeqCst), 0);
+    assert!(frozen_view(true, &cell, || {
+        calls.fetch_add(1, Ordering::SeqCst);
+        Some(projected.clone())
+    })
+    .is_some());
+    assert_eq!(calls.load(Ordering::SeqCst), 1);
+    assert!(frozen_view(true, &cell, || panic!(
+        "immutable membership must be memoized"
+    ))
+    .is_some());
+}
+
+#[test]
+fn public_view_refuses_non_anchor_without_changes_or_false_memoization() {
+    let (parent, forks, votes, leader) = fixture();
+    let child = Bank::new_from_parent_with_bank_forks(&forks, Arc::clone(&parent), leader, 1);
+    let before = (
+        child.capitalization(),
+        votes.map(|vote| child.get_account(&vote).unwrap()),
+        child.epoch_stakes.clone(),
+    );
+    assert!(child.pilot_epoch202_recovery_view().is_none());
+    assert!(child.pilot_epoch202_view.get().is_none());
+    child.freeze();
+    assert!(child.pilot_epoch202_recovery_view().is_none());
+    assert!(child.pilot_epoch202_view.get().is_none());
+    assert_eq!(
+        before.1,
+        votes.map(|vote| child.get_account(&vote).unwrap())
+    );
+    assert_eq!(before.2, child.epoch_stakes);
+    // Freeze may burn an unrelated preexisting incinerator balance; view itself does not.
+    let frozen_cap = child.capitalization();
+    assert!(child.pilot_epoch202_recovery_view().is_none());
+    assert_eq!(frozen_cap, child.capitalization());
+}
+
+#[test]
+fn alternative_children_each_pay_deferred202_and_parent_remains_untouched() {
+    let (parent, forks, votes, leader) = fixture();
+    let projected = VersionedEpochStakes::new(
+        SerdeStakesToStakeFormat::from(parent.get_top_epoch_stakes()),
+        202,
+    );
+    let balances = votes.map(|vote| parent.get_balance(&vote));
+    let parent_hash = parent.hash();
+    let parent_cap = parent.capitalization();
+    let parent_map = parent.epoch_stakes.clone();
+    let mut first = Bank::new_from_parent(Arc::clone(&parent), leader, 1);
+    let mut second = Bank::new_from_parent(Arc::clone(&parent), leader, 2);
+    for child in [&mut first, &mut second] {
+        let vat = child.vat_to_burn_per_epoch();
+        let before = child.capitalization();
+        child.pilot_epoch202_install(projected.clone());
+        assert_eq!(
+            votes.map(|vote| child.get_balance(&vote)),
+            balances.map(|balance| balance - vat)
+        );
+        assert_eq!(
+            child.get_balance(&solana_sdk_ids::incinerator::id()),
+            3 * vat
+        );
+        let after = votes.map(|vote| child.get_balance(&vote));
+        child.pilot_epoch202_install(projected.clone());
+        assert_eq!(after, votes.map(|vote| child.get_balance(&vote)));
+        child.freeze();
+        assert_eq!(child.capitalization(), before - 3 * vat);
+    }
+    // Register both alternate children in the held real ForkGraph after the
+    // mutable bookkeeping assertions, as the ordinary helper does.
+    forks.write().unwrap().insert(first);
+    forks.write().unwrap().insert(second);
+    assert_eq!(parent_hash, parent.hash());
+    assert_eq!(parent_cap, parent.capitalization());
+    assert_eq!(balances, votes.map(|vote| parent.get_balance(&vote)));
+    assert_eq!(parent_map, parent.epoch_stakes);
+}
+
+#[test]
+fn restored_positive_membership_is_not_debited_or_replaced() {
+    let (parent, forks, votes, leader) = fixture();
+    let projected = VersionedEpochStakes::new(
+        SerdeStakesToStakeFormat::from(parent.get_top_epoch_stakes()),
+        202,
+    );
+    let mut paid = Bank::new_from_parent(parent, leader, 1);
+    paid.pilot_epoch202_install(projected.clone());
+    paid.freeze();
+    let saved = wincode::serialize(paid.epoch_stakes.get(&202).unwrap()).unwrap();
+    let restored: DeserializableVersionedEpochStakes = wincode::deserialize(&saved).unwrap();
+    let paid = forks
+        .write()
+        .unwrap()
+        .insert(paid)
+        .clone_without_scheduler();
+    let mut next = Bank::new_from_parent(paid, leader, 3);
+    next.epoch_stakes.insert(202, restored.into());
+    let before = (
+        votes.map(|vote| next.get_balance(&vote)),
+        next.capitalization(),
+        next.epoch_stakes.clone(),
+    );
+    next.pilot_epoch202_install(projected);
+    assert_eq!(
+        before,
+        (
+            votes.map(|vote| next.get_balance(&vote)),
+            next.capitalization(),
+            next.epoch_stakes.clone()
+        )
+    );
+    forks.write().unwrap().insert(next);
+}
+
+#[test]
+fn linked_build_info_declares_distinct_upgrade_and_exact_fixed_pins() {
+    let info = Bank::pilot_epoch202_build_info_v1();
+    assert_eq!(info["format"], "zolana085-epoch202-runtime-build-v1");
+    assert_eq!(info["compiled_new_feature"], true);
+    assert_eq!(info["compiled_old_retry_feature"], false);
+    assert_eq!(info["activation_first_slot"], 413696);
+    assert_eq!(info["consensus_output_sha256"], CONSENSUS);
+    assert_ne!(
+        info["root_anchor"]["raw_input_sha256"],
+        info["signed_parent"]["raw_input_sha256"]
+    );
+}
