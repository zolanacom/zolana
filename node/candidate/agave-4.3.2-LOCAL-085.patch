+// Consumer-only fixtures: real ordinary genesis stake maps stand in for a
+// validated runtime view. These tests do not claim exact695 anchor acceptance
+// or cryptographic certificate verification; existing pool/verifier tests own
+// verification. We test the actual filtering, enqueue and accounting path.
+
+fn pilot_epoch202_batch() -> Vec<Arc<Certificate>> {
+    [
+        CertificateType::Skip(201 * 2048 + 17),
+        CertificateType::Notarize(Block {
+            slot: 202 * 2048,
+            block_id: Hash::new_unique(),
+        }),
+        CertificateType::Finalize(203 * 2048),
+        CertificateType::FinalizeFast(Block {
+            slot: 202 * 2048 + 1,
+            block_id: Hash::new_unique(),
+        }),
+    ]
+    .into_iter()
+    .enumerate()
+    .map(|(index, cert_type)| {
+        Arc::new(Certificate {
+            cert_type,
+            signature: BLSSignature([0; BLS_SIGNATURE_AFFINE_SIZE]),
+            bitmap: vec![index as u8 + 1],
+        })
+    })
+    .collect()
+}
+
+fn pilot_epoch202_assert_payloads(op: BLSOp, refresh: bool, expected: &[Arc<Certificate>]) {
+    let (was_refresh, actual) = match op {
+        BLSOp::PushCertificates { certificates } => (false, certificates),
+        BLSOp::RefreshCertificates { certificates } => (true, certificates),
+        _ => panic!("certificate operation changed into a vote"),
+    };
+    assert_eq!(was_refresh, refresh);
+    assert_eq!(actual.len(), expected.len());
+    for (actual, expected) in actual.iter().zip(expected) {
+        assert!(Arc::ptr_eq(actual, expected));
+        assert_eq!(actual.as_ref(), expected.as_ref());
+    }
+}
+
