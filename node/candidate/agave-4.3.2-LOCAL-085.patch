+        let vote = Pubkey::from_str(row["vote"].as_str().context("expected vote key")?)?;
+        let account = accounts.get(&vote).context("expected actual view voter missing")?;
+        let epoch_account = bank.epoch_vote_accounts(202).and_then(|map|map.get(&vote))
+            .context("actual epoch_vote_accounts route missing")?;
