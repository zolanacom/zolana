+#[test]
+fn pilot_vat_recovery_real_epochs_signed_atomic_funding_and_replay() {
+    let fixture = Fixture::new([67; 32]);
+    let mut expected = None;
+    for _replay in 0..2 {
+        let (expired, forks) = fixture.expire();
+        let bank = fixture.child(&forks, expired, 411_648);
+        assert_eq!(bank.epoch(), 201);
+        assert!(bank.pilot_empty_future_stakes_recovery_active());
+        assert_eq!(bank.epoch_stakes(202).unwrap().total_stake(), 0);
+        assert!(crate::leader_schedule_utils::leader_schedule(202, &bank).is_none());
+        assert!(crate::leader_schedule_utils::leader_schedule(201, &bank).is_some());
+        let current = bank.epoch_stakes(201).unwrap().total_stake();
+        assert!(current > 0);
+        let no_funds = fixture.child(&forks, bank, 411_649);
+        assert_eq!(no_funds.epoch_stakes(202).unwrap().total_stake(), 0);
+        for key in &fixture.validators {
+            assert_eq!(no_funds.get_balance(&key.vote_keypair.pubkey()), REMAINDER);
+        }
+        let tx = fixture.grant(&no_funds);
+        tx.verify().unwrap();
+        let treasury = no_funds.get_balance(&fixture.mint.pubkey());
+        let capital_before_funding = no_funds.capitalization();
+        no_funds.process_transaction(&tx).unwrap();
+        assert_eq!(
+            no_funds.get_balance(&fixture.mint.pubkey()),
+            treasury - 3 * GRANT
+        );
+        assert_eq!(no_funds.capitalization(), capital_before_funding);
+        // Normal signed funding alone cannot mutate the already empty snapshot.
+        assert_eq!(no_funds.epoch_stakes(202).unwrap().total_stake(), 0);
+        let funded = fixture.child(&forks, no_funds, 411_650);
+        assert_eq!(funded.epoch_stakes(202).unwrap().total_stake(), current);
+        assert!(!funded.pilot_empty_future_stakes_recovery_active());
+        let schedule202 = crate::leader_schedule_utils::leader_schedule(202, &funded).unwrap();
+        assert_eq!(schedule202.get_slot_leaders().count(), 2048);
+        for key in &fixture.validators {
+            assert_eq!(
+                funded.get_balance(&key.vote_keypair.pubkey()),
+                REMAINDER + GRANT - VAT
+            );
+        }
+        assert_eq!(
+            funded.get_balance(&solana_sdk_ids::incinerator::id()),
+            3 * VAT
+        );
+        funded.freeze();
+        assert_eq!(funded.capitalization(), capital_before_funding - 3 * VAT);
+        let same_epoch = fixture.child(&forks, funded, 411_651);
+        for key in &fixture.validators {
+            assert_eq!(
+                same_epoch.get_balance(&key.vote_keypair.pubkey()),
+                REMAINDER + GRANT - VAT
+            );
+        }
+        let epoch202 = fixture.child(&forks, same_epoch, 202 * 2048);
+        assert!(epoch202.epoch_stakes(202).unwrap().total_stake() > 0);
+        assert!(epoch202.epoch_stakes(203).unwrap().total_stake() > 0);
+        let epoch203 = fixture.child(&forks, epoch202, 203 * 2048);
+        assert!(epoch203.epoch_stakes(203).unwrap().total_stake() > 0);
