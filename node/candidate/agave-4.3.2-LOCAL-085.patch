+fn immutable_state(bank: &Bank, votes: [Pubkey; 3]) -> Result<serde_json::Value> {
+    let raw_map = wincode::serialize(bank.epoch_stakes_map()).context("serialize raw epoch map")?;
+    let calculated_capitalization = bank.calculate_capitalization_for_tests();
+    ensure!(calculated_capitalization == bank.capitalization(),
+        "recorded capitalization does not equal independently scanned account balances");
+    let accounts = votes.iter().map(|vote| {
+        let account = bank.get_account(vote).context("original vote missing")?;
+        Ok(json!({"vote":vote.to_string(),"balance":account.lamports(),"owner":account.owner().to_string(),
+            "data_sha256":sha256_hex(account.data())}))
+    }).collect::<Result<Vec<_>>>()?;
+    let rewards = bank.rewards.read().unwrap().iter().map(|(key,info)|json!({
+        "pubkey":key.to_string(),"kind":format!("{:?}",info.reward_type),
+        "lamports":info.lamports,"post_balance":info.post_balance,"commission_bps":info.commission_bps,
+    })).collect::<Vec<_>>();
+    let pool = bank.get_account(&native_payment_program::pool_address()).context("original pool missing")?;
+    let pool_state = native_payments::state::PoolState::decode(pool.data())
+        .map_err(|error|anyhow::anyhow!("public pool decode failed: {error:?}"))?;
+    ensure!(pool.owner() == &native_payment_program::id() && pool_state.network == [67;32]
+        && pool_state.uses_slot_anchors() && pool.data().len() >= 1088, "original pool domain/header required");
+    Ok(json!({"slot":bank.slot(),"bank_hash":bank.hash().to_string(),"frozen":bank.is_frozen(),
+        "capitalization":bank.capitalization(),"independent_account_sum":calculated_capitalization,
+        "raw_epoch_map_sha256":sha256_hex(&raw_map),
+        "raw202_total":bank.epoch_stakes_map().get(&202).map(|stakes|stakes.total_stake()),
+        "raw203_total":bank.epoch_stakes_map().get(&203).map(|stakes|stakes.total_stake()),
+        "raw_current_total":bank.get_current_epoch_total_stake(),"votes":accounts,"rewards":rewards,
+        "pool":{"lamports":pool.lamports(),"owner":pool.owner().to_string(),"data_sha256":sha256_hex(pool.data()),
+            "prefix1088_sha256":sha256_hex(&pool.data()[..1088]),"backing":pool_state.backing,"note_count":pool_state.note_count()},
+        "incinerator_lamports":bank.get_balance(&solana_sdk_ids::incinerator::id())}))
+}
