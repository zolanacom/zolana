+}
+
+fn requested(args: &[String]) -> Result<Option<usize>> {
+    if !args.iter().any(|arg|arg == "--offline-202-probe") { return Ok(None); }
+    ensure!(args.len() == 2 && args[0] == "--offline-202-probe", "--offline-202-probe takes only fixed peer index0|1|2");
+    let node: usize = args[1].parse().context("fixed peer index")?;
+    ensure!(node < 3 && args[1] == node.to_string(), "only fixed original peer0|1|2 allowed");
+    Ok(Some(node))
+}
+
+pub(crate) fn maybe_run() -> Result<bool> {
+    let Some(node) = requested(&std::env::args().skip(1).collect::<Vec<_>>())? else { return Ok(false); };
+    if let Err(error) = run(node) {
+        emit(json!({"event":"offline_candidate_epoch202_probe_failed","node":node,"error":format!("{error:#}"),
+            "live_recovery_accepted":false}));
+        return Err(error);
+    }
+    Ok(true)
+}
+
