+        "prospective_consensus_outputs_equal":consensus_equal,
+        "runtime_repair_accepted":false,
+        "selected_replay_computed_diagnostics":*records.lock().unwrap(),
+        "validators_started":false,"keys_read":false,"financial_operations":0,
+        "copied_ledger_writable":false,"authoritative_accounts_writable":false,
+        "new202_projection_implemented":false,"new202_bank_created":false}));
+    ensure!(consensus_equal, "complete root694 and signed695 future consensus outputs differ; root review required");
+    Ok(())
+}
+fn main() {
+    if let Err(error) = run() { emit(json!({"event":"offline_diagnostic_failed","error":format!("{error:#}")})); std::process::exit(1); }
+}
