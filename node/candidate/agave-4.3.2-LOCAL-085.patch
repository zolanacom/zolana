+//! Bounded read-only public diagnostics for offline pilot bank restoration.
+//! Does not retry admission, burn VAT, update epoch maps or submit transactions.
+use super::*;
+use serde_json::{json, Value};
+
+use super::pilot_epoch202_shared::*;
+
+impl Bank {
+    /// Exactly three caller-reviewed PUBLIC vote addresses. No key material,
+    /// account bytes, delegation addresses or private wallet state is returned.
+    pub fn pilot_vat_diagnostic(&self, votes: [Pubkey; 3]) -> Value {
+        let minimum = self.minimum_vote_account_balance_for_vat();
+        let (cached, delegation_count, references) = {
+            let stakes = self.stakes_cache.stakes();
+            let references = votes.map(|vote| {
+                let mut count = 0u64;
+                let mut nominal = 0u128;
+                for (_, account) in stakes.stake_delegations().iter() {
+                    let delegation = account.delegation();
+                    if delegation.voter_pubkey == vote {
+                        count += 1;
+                        nominal += u128::from(delegation.stake);
+                    }
+                }
+                (count, nominal.to_string())
+            });
+            (
+                stakes.vote_accounts().clone(),
+                stakes.stake_delegations().len(),
+                references,
+            )
+        };
+        let cached_total = cached
+            .delegated_stakes()
+            .map(|(_, stake)| u128::from(stake))
+            .sum::<u128>();
+        let top = self.get_top_epoch_stakes();
+        let top_total = top
+            .vote_accounts()
+            .delegated_stakes()
+            .map(|(_, stake)| u128::from(stake))
+            .sum::<u128>();
+        let rows = votes.iter().enumerate().map(|(index, vote)| {
+            let cache = cached.get(vote);
+            let actual = self.get_account(vote);
+            let actual_vote = actual.clone().and_then(|account| VoteAccount::try_from(account).ok());
+            json!({
+                "vote": vote.to_string(),
+                "cached_present": cache.is_some(),
+                "cached_stake": cached.get_delegated_stake(vote),
+                "cached_lamports": cache.map(VoteAccount::lamports),
+                "cached_owner": cache.map(|account| account.owner().to_string()),
+                "cached_node": cache.map(|account| account.node_pubkey().to_string()),
+                "cached_bls_present": cache.map(|account| account.vote_state_view().bls_pubkey_compressed().is_some()),
+                "cached_balance_sufficient": cache.map(|account| account.lamports() >= minimum),
+                "accounts_db_present": actual.is_some(),
+                "accounts_db_lamports": actual.as_ref().map(ReadableAccount::lamports),
+                "accounts_db_owner": actual.as_ref().map(|account| account.owner().to_string()),
+                "accounts_db_vote_parse_ok": actual_vote.is_some(),
+                "accounts_db_bls_present": actual_vote.as_ref().map(|account| account.vote_state_view().bls_pubkey_compressed().is_some()),
+                "accounts_db_node": actual_vote.as_ref().map(|account| account.node_pubkey().to_string()),
+                "decoded_vote_state": actual_vote.as_ref().map(|account| decoded_vote_state(vote, account)),
+                "accounts_db_balance_sufficient": actual.as_ref().map(|account| account.lamports() >= minimum),
+                "cached_account_equals_accounts_db": cache.zip(actual.as_ref()).map(|(left, right)| left.account() == right),
+                "delegation_references": references[index].0,
+                "nominal_delegation_lamports": references[index].1,
+                "filtered_top_stake": top.vote_accounts().get_delegated_stake(vote),
+            })
+        }).collect::<Vec<_>>();
+        let pool = self.get_account(&native_payment_program::pool_address());
+        let pool_owner_ok = pool
+            .as_ref()
+            .is_some_and(|a| a.owner() == &native_payment_program::id());
+        let pool_magic_ok = pool
+            .as_ref()
+            .is_some_and(|a| a.data().get(..8) == Some(b"NPOOL004".as_slice()));
+        let decoded = pool
+            .as_ref()
+            .map(|a| native_payments::state::PoolState::decode(a.data()));
+        let pool_decode_ok = decoded.as_ref().is_some_and(|result| result.is_ok());
+        let state = decoded.as_ref().and_then(|result| result.as_ref().ok());
+        let pool_network_ok = state.is_some_and(|state| state.network == [67; 32]);
+        let pool_anchors_ok = state.is_some_and(|state| state.uses_slot_anchors());
+        let mut requested = votes;
+        requested.sort_unstable_by_key(|vote| vote.to_bytes());
+        let mut original = ORIGINAL_VOTES;
+        original.sort_unstable_by_key(|vote| vote.to_bytes());
+        let expected_three = requested == original;
+        let eligible_exact = top.vote_accounts().len() == 3
+            && ORIGINAL_VOTES
+                .iter()
+                .all(|vote| top.vote_accounts().get_delegated_stake(vote) > 0);
+        let actual_bls = ORIGINAL_VOTES.iter().all(|vote| {
+            self.get_account(vote)
+                .and_then(|account| VoteAccount::try_from(account).ok())
+                .is_some_and(|account| account.vote_state_view().bls_pubkey_compressed().is_some())
+        });
+        let cache_actual = ORIGINAL_VOTES.iter().all(|vote| {
+            cached
+                .get(vote)
+                .zip(self.get_account(vote).as_ref())
+                .is_some_and(|(cache, actual)| cache.account() == actual)
+        });
+        let entries = ORIGINAL_VOTES
+            .iter()
+            .filter_map(|vote| {
+                let account = self.get_account(vote)?;
+                Some(EligibleInput {
+                    vote: *vote,
+                    delegated_weight: top.vote_accounts().get_delegated_stake(vote),
+                    actual_lamports: account.lamports(),
+                    owner: *account.owner(),
+                    vote_data_sha256: solana_sha256_hasher::hash(account.data()).to_bytes(),
+                })
+            })
+            .collect::<Vec<_>>();
+        let mut entries = entries;
+        entries.sort_unstable_by_key(|entry| entry.vote.to_bytes());
+        let conditions = [
+            ("source_epoch_is_201", self.epoch() == 201),
+            ("frozen_bank", self.is_frozen()),
+            ("expected_three_vote_set", expected_three),
+            ("eligible_set_exact", eligible_exact),
+            ("actual_vote_bls", actual_bls),
+            ("cache_equals_accounts_db", cache_actual),
+            (
+                "alpenglow",
+                self.feature_set.snapshot().alpenglow && self.is_alpenglow(),
+            ),
+            (
+                "epoch_schedule",
+                self.epoch_schedule.slots_per_epoch == 2048
+                    && self.epoch_schedule.leader_schedule_slot_offset == 2048
+                    && !self.epoch_schedule.warmup,
+            ),
+            (
+                "pool_guard",
+                pool_owner_ok
+                    && pool_magic_ok
+                    && pool_decode_ok
+                    && pool_network_ok
+                    && pool_anchors_ok,
+            ),
+        ];
+        let satisfied = conditions.iter().all(|(_, value)| *value);
+        let prospective = prospective_consensus_outputs(
+            top.vote_accounts(),
+            &self.epoch_schedule,
+            self.vat_to_burn_per_epoch(),
+            minimum,
+        );
+        let prospective_report = json!({
+            "format":"zolana085-epoch202-consensus-comparison-v1",
+            "preconditions_satisfied":satisfied && prospective.is_some(),
+            "digest_sha256":if satisfied { prospective.as_ref().map(consensus_digest) } else { None },
+            "outputs":prospective,
+            "full_vote_account_equality_claimed":false,
+            "bank_map_changed":false,"accounts_changed":false,
+        });
+        let eligible_report = json!({
+            "format": "zolana085-epoch202-eligible-inputs-v1",
+            "source_epoch": 201, "target_epoch": 202,
+            "vat": self.vat_to_burn_per_epoch(), "minimum_vote_balance": minimum,
+            "eligible_count": top.vote_accounts().len(),
+            "preconditions": conditions.into_iter()
+                .map(|(name, value)| (name.to_owned(), json!(value)))
+                .collect::<serde_json::Map<_, _>>(),
+            "preconditions_satisfied": satisfied,
+            "entries": entries.iter().map(|entry| json!({
+                "vote": entry.vote.to_string(), "delegated_weight": entry.delegated_weight,
