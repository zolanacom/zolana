+#[test]
+fn ancestry_parallel_overlaps_three_walks_and_preserves_input_order() {
+    let started = AtomicUsize::new(0);
+    let threads = Mutex::new(std::collections::HashSet::new());
+    let expected_deadline = budget();
+    let result = run_parallel(
+        vec![0, 1, 2],
+        expected_deadline,
+        || false,
+        |index, deadline, abort| {
+            assert_eq!(deadline, expected_deadline);
+            threads.lock().unwrap().insert(thread::current().id());
+            rendezvous(&started, deadline, abort)?;
+            thread::sleep(Duration::from_millis((2 - index) as u64 * 5));
+            Ok(report(index))
+        },
+    )
+    .unwrap();
+    assert_eq!(threads.into_inner().unwrap().len(), 3);
+    assert_eq!(
+        result.iter().map(|r| r.report.entries).collect::<Vec<_>>(),
+        vec![10, 11, 12]
+    );
+    assert!(result.iter().all(|r| r.elapsed > Duration::ZERO));
+}
