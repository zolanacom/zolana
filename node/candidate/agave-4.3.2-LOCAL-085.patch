@@ -0,0 +1,90 @@
+//! Per-certificate egress admission for the explicitly enabled, pinned 202 view.
+//! Runtime owns anchor/eligibility validation. This consumer never constructs
+//! membership, changes quorum, mutates a Bank, or changes current/raw stake APIs.
+use {
+    crate::voting_service::BLSOp, solana_epoch_schedule::EpochSchedule, solana_pubkey::Pubkey,
+    solana_runtime::bank::Bank, std::collections::HashMap,
+};
+
+/// Actual linked Votor feature/policy information, also available when OFF.
+/// JSON text avoids adding a serde_json dependency to Votor. The runner parses
+/// the returned library value; it must not substitute its own feature flag.
+pub fn pilot_epoch202_build_info_v1() -> &'static str {
+    if cfg!(feature = "zolana-pilot-202-recovery") {
+        r#"{"format":"zolana085-epoch202-votor-build-v1","crate_feature_enabled":true,"target_epoch":202,"activation_slot":413696,"per_certificate_policy":"requested-epoch202-sidecar-only-v1","runtime_view_api":"Bank::pilot_epoch202_recovery_view"}"#
+    } else {
+        r#"{"format":"zolana085-epoch202-votor-build-v1","crate_feature_enabled":false,"target_epoch":202,"activation_slot":413696,"per_certificate_policy":"requested-epoch202-sidecar-only-v1","runtime_view_api":"Bank::pilot_epoch202_recovery_view"}"#
+    }
+}
+
+/// One root snapshot supplies both decisions for the whole operation. The
+/// optional 202 decision exists only when runtime supplied its validated view.
+pub(crate) struct CertificateEgressPolicy<'a> {
+    schedule: &'a EpochSchedule,
+    current_identity_staked: bool,
+    projected_202_identity_staked: Option<bool>,
+}
+
+impl<'a> CertificateEgressPolicy<'a> {
+    pub(crate) fn from_bank(root: &'a Bank, identity: &Pubkey) -> Self {
+        let current = root.current_epoch_staked_nodes();
+        let projected = if cfg!(feature = "zolana-pilot-202-recovery") {
+            root.pilot_epoch202_recovery_view()
+                .map(|view| view.stakes().staked_nodes())
+        } else {
+            None
+        };
+        Self::from_memberships(
+            root.epoch_schedule(),
+            identity,
+            &current,
+            projected.as_deref(),
+        )
+    }
+
+    fn from_memberships(
+        schedule: &'a EpochSchedule,
+        identity: &Pubkey,
+        current: &HashMap<Pubkey, u64>,
+        projected: Option<&HashMap<Pubkey, u64>>,
+    ) -> Self {
+        let positive =
+            |nodes: &HashMap<Pubkey, u64>| nodes.get(identity).is_some_and(|stake| *stake > 0);
+        Self {
+            schedule,
+            current_identity_staked: positive(current),
+            projected_202_identity_staked: projected.map(positive),
+        }
+    }
+
+    pub(crate) fn filter(&self, mut op: BLSOp) -> (BLSOp, usize) {
+        let certificates = match &mut op {
+            BLSOp::PushCertificates { certificates }
+            | BLSOp::RefreshCertificates { certificates } => certificates,
+            _ => unreachable!("expected a certificate BLSOp"),
+        };
+        let before = certificates.len();
+        certificates.retain(|cert| {
+            if self.schedule.get_epoch(cert.cert_type.slot()) == 202 {
+                self.projected_202_identity_staked
+                    .unwrap_or(self.current_identity_staked)
+            } else {
+                self.current_identity_staked
+            }
+        });
+        let skipped = before - certificates.len();
+        (op, skipped)
+    }
+
+    /// Consumer fixtures use real ordinary stake maps but cannot stand in for
+    /// runtime's separate exact-anchor validation. Not available in production.
+    #[cfg(test)]
+    pub(crate) fn from_test_memberships(
+        schedule: &'a EpochSchedule,
+        identity: &Pubkey,
+        current: &HashMap<Pubkey, u64>,
+        projected: Option<&HashMap<Pubkey, u64>>,
+    ) -> Self {
+        Self::from_memberships(schedule, identity, current, projected)
+    }
+}
