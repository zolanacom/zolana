+//! Synthetic public fixtures only. No live ledgers, accounts or operator keys.
+use {
+    super::*,
+    crate::bank_forks::BankForks,
+    crate::genesis_utils::{
+        ValidatorVoteKeypairs, create_genesis_config_with_alpenglow_vote_accounts,
+    },
+    solana_account::{AccountSharedData, ReadableAccount},
+    solana_epoch_schedule::EpochSchedule,
+    solana_inflation::Inflation,
+    solana_instruction::Instruction,
+    solana_keypair::Keypair,
+    solana_signer::Signer,
+    solana_system_interface::instruction::transfer,
+    solana_transaction::Transaction,
+    std::sync::{Arc, RwLock},
+};
+
+const VAT: u64 = 800_000_000;
+const GRANT: u64 = 20_000_000_000;
+const REMAINDER: u64 = 27_074_400;
+
+struct Fixture {
+    genesis: GenesisConfig,
+    mint: Keypair,
+    validators: Vec<ValidatorVoteKeypairs>,
+}
+impl Fixture {
+    fn new(network: [u8; 32]) -> Self {
+        let validators = (0..3)
+            .map(|_| ValidatorVoteKeypairs::new_rand())
+            .collect::<Vec<_>>();
+        let info = create_genesis_config_with_alpenglow_vote_accounts(
+            1_000_000_000_000_000,
+            &validators,
+            vec![10_000_000_000; 3],
+        );
+        let mut genesis = info.genesis_config;
+        genesis.epoch_schedule = EpochSchedule::custom(2048, 2048, false);
+        genesis.inflation = Inflation::new_disabled();
+        let state = native_payments::state::PoolState::new_slot_anchored(network, 1).unwrap();
+        let mut pool =
+            AccountSharedData::new(1, state.encode().len(), &native_payment_program::id());
+        pool.set_data_from_slice(&state.encode());
+        genesis
+            .accounts
+            .insert(native_payment_program::pool_address(), pool.into());
+        Self {
+            genesis,
+            mint: info.mint_keypair,
+            validators,
+        }
+    }
+    fn leader(&self) -> SlotLeader {
+        SlotLeader {
+            id: self.validators[0].node_keypair.pubkey(),
+            vote_address: self.validators[0].vote_keypair.pubkey(),
+        }
+    }
+    fn child(&self, forks: &RwLock<BankForks>, parent: Arc<Bank>, slot: Slot) -> Arc<Bank> {
+        Bank::new_from_parent_with_bank_forks(forks, parent, self.leader(), slot)
+    }
+    fn expire(&self) -> (Arc<Bank>, Arc<RwLock<BankForks>>) {
+        let (mut bank, forks) = Bank::new_with_bank_forks_for_tests(&self.genesis);
+        assert_eq!(bank.vat_to_burn_per_epoch(), DEFAULT_VAT_TO_BURN_PER_EPOCH);
+        assert!(!bank.pilot_empty_future_stakes_recovery_active());
+        // Use real epoch transitions and normal VAT burns, never mutate balances
+        // or manufacture the empty map. Only empty slot intervals are skipped.
+        for epoch in 1..=200 {
+            bank = self.child(&forks, bank, epoch * 2048);
+            assert_eq!(bank.vat_to_burn_per_epoch(), VAT);
+        }
+        bank = self.child(&forks, bank, 411_647);
+        for key in &self.validators {
+            assert_eq!(bank.get_balance(&key.vote_keypair.pubkey()), REMAINDER);
+        }
+        assert!(bank.epoch_stakes(201).unwrap().total_stake() > 0);
+        assert!(!bank.pilot_empty_future_stakes_recovery_active());
+        (bank, forks)
+    }
+    fn grant(&self, bank: &Bank) -> Transaction {
+        let instructions: Vec<Instruction> = self
+            .validators
+            .iter()
+            .map(|key| transfer(&self.mint.pubkey(), &key.vote_keypair.pubkey(), GRANT))
+            .collect();
+        Transaction::new_signed_with_payer(
+            &instructions,
+            Some(&self.mint.pubkey()),
+            &[&self.mint],
+            bank.last_blockhash(),
+        )
+    }
+}
