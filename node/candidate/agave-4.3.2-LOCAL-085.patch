+//! Explicit, default-OFF LOCAL085 upgrade. No historical201 retry or parent debit.
+#[cfg(feature = "zolana-pilot-202-recovery")]
+use super::pilot_epoch202_shared::*;
+use super::*;
+use serde_json::{json, Value};
+
+const ROOT_HASH: &str = "BYnRBCtGoKuEqWz36fwqYn6uBe1yY5ftp5oW9qs22Gdz";
+const PARENT_HASH: &str = "HXxWUSa9AoiyFJ7BEsVHNXLVNziD64zayM5592axQAsh";
+const PARENT_ID: &str = "FaEvei6cJcPzF83uK8MLLAQLLSXGQoe9m77FdpjCRTYu";
+const ROOT_INPUT: &str = "6e56d2954b6e1ea6afdcd14e9688fca011bae4c9b357cf8d904fe9669e7b038e";
+const PARENT_INPUT: &str = "f98785132ad63e75b9cdc21622992fc825d796ae9ef3c7f21fa45099cb87c2c9";
+const CONSENSUS: &str = "fe6f03c9cd7ed3d9774f71acd97f0f16b5dda937fcfcca483e66d6b1e0352e30";
+
+impl Bank {
+    /// Unique public linked-runtime proof; no config, ledger or key access.
+    pub fn pilot_epoch202_build_info_v1() -> Value {
+        json!({"format":"zolana085-epoch202-runtime-build-v1",
+            "compiled_new_feature":cfg!(feature="zolana-pilot-202-recovery"),
+            "compiled_old_retry_feature":cfg!(feature="zolana-pilot-vat-recovery"),
+            "historical201_policy":"existing-entry-preserved-v1",
+            "activation_first_slot":413696,"target_epoch":202,
+            "genesis_hash":"Ehh8b8thLqA1jqUsskkfrmgRRxPuFsUETb7N4pjebv2p","network":vec![67u8;32],
+            "root_anchor":{"slot":413694,"bank_hash":ROOT_HASH,"raw_input_sha256":ROOT_INPUT},
+            "signed_parent":{"slot":413695,"bank_hash":PARENT_HASH,"block_id":PARENT_ID,
+                "raw_input_sha256":PARENT_INPUT},"consensus_output_sha256":CONSENSUS})
+    }
+
+    /// Borrowed future202 consensus metadata only. OFF always returns None.
+    pub fn pilot_epoch202_recovery_view(&self) -> Option<&VersionedEpochStakes> {
+        #[cfg(not(feature = "zolana-pilot-202-recovery"))]
+        {
+            None
+        }
+        #[cfg(feature = "zolana-pilot-202-recovery")]
+        {
+            // Neither mutable accounts nor an incomplete frozen block identity
+            // may poison the once cell before its immutable inputs are known.
+            if !self.is_frozen() {
+                return None;
+            }
+            let input_pin = self.pilot_epoch202_anchor_identity()?;
+            frozen_view(self.is_frozen(), &self.pilot_epoch202_view, || {
+                self.pilot_epoch202_derive(input_pin)
+            })
+        }
+    }
+
+    #[cfg(feature = "zolana-pilot-202-recovery")]
+    pub(super) fn pilot_epoch202_anchor_identity(&self) -> Option<&'static str> {
+        if !self.is_frozen() || self.epoch() != 201 {
+            return None;
+        }
+        match self.slot() {
+            413694 if self.hash().to_string() == ROOT_HASH => Some(ROOT_INPUT),
+            413695
+                if self.hash().to_string() == PARENT_HASH
+                    && self
+                        .block_id()
+                        .is_some_and(|id| id.to_string() == PARENT_ID) =>
+            {
+                Some(PARENT_INPUT)
+            }
+            _ => None,
+        }
+    }
+
+    #[cfg(feature = "zolana-pilot-202-recovery")]
+    fn pilot_epoch202_derive(&self, input_pin: &str) -> Option<VersionedEpochStakes> {
+        // Raw fields only: invoking epoch_stakes/get_rank_map/whole diagnostic
+        // here would recursively ask for the view being initialized.
+        if !self.feature_set.snapshot().alpenglow
+            || !self.is_alpenglow()
+            || self.epoch_schedule.slots_per_epoch != 2048
+            || self.epoch_schedule.leader_schedule_slot_offset != 2048
+            || self.epoch_schedule.warmup
+            || !self
+                .epoch_stakes
+                .get(&201)
+                .is_some_and(|s| s.total_stake() > 0)
+            || !self
+                .epoch_stakes
+                .get(&202)
+                .is_some_and(|s| s.total_stake() == 0)
+            || self.epoch_stakes.contains_key(&203)
+        {
+            return None;
+        }
+        let pool = self.get_account(&native_payment_program::pool_address())?;
+        if pool.owner() != &native_payment_program::id()
+            || pool.data().get(..8) != Some(b"NPOOL004".as_slice())
+        {
+            return None;
+        }
+        let pool = native_payments::state::PoolState::decode(pool.data()).ok()?;
+        if pool.network != [67; 32] || !pool.uses_slot_anchors() {
+            return None;
+        }
+        let minimum = self.minimum_vote_account_balance_for_vat();
+        let vat = self.vat_to_burn_per_epoch();
+        let top = self.get_top_epoch_stakes();
+        if top.vote_accounts().len() != 3 {
+            return None;
+        }
+        let cached = self.stakes_cache.stakes();
+        let mut entries = Vec::with_capacity(3);
+        for vote in ORIGINAL_VOTES {
+            let actual = self.get_account(&vote)?;
+            let cache = cached.vote_accounts().get(&vote)?;
+            let stake = top.vote_accounts().get_delegated_stake(&vote);
+            if stake == 0 || cache.account() != &actual {
+                return None;
+            }
+            entries.push(EligibleInput {
+                vote,
+                delegated_weight: stake,
+                actual_lamports: actual.lamports(),
+                owner: *actual.owner(),
+                vote_data_sha256: solana_sha256_hasher::hash(actual.data()).to_bytes(),
+            });
+        }
+        drop(cached);
+        if eligible_digest(&entries, vat, minimum).as_deref() != Some(input_pin) {
+            return None;
+        }
+        let outputs =
+            prospective_consensus_outputs(top.vote_accounts(), &self.epoch_schedule, vat, minimum)?;
+        if consensus_digest(&outputs) != CONSENSUS {
+            return None;
+        }
+        Some(VersionedEpochStakes::new(
+            SerdeStakesToStakeFormat::from(top),
+            202,
+        ))
+    }
+
+    pub(super) fn pilot_epoch202_materialize_from_parent(&mut self, parent: &Bank) {
+        #[cfg(not(feature = "zolana-pilot-202-recovery"))]
+        {
+            let _ = parent;
+        }
+        #[cfg(feature = "zolana-pilot-202-recovery")]
+        {
+            if self.epoch() != 202 {
+                return;
+            }
+            if self
+                .epoch_stakes
+                .get(&202)
+                .is_some_and(|s| s.total_stake() > 0)
+            {
+                return;
+            }
+            assert!(
+                self.slot() >= 413696
+                    && parent.slot() == 413695
+                    && parent.pilot_epoch202_anchor_identity() == Some(PARENT_INPUT),
+                "LOCAL085202 requires exact immutable signed695 parent"
+            );
+            assert!(
+                self.epoch_stakes
+                    .get(&202)
+                    .is_some_and(|s| s.total_stake() == 0),
+                "LOCAL085202 requires original empty202 entry"
+            );
+            let projected = parent
+                .pilot_epoch202_recovery_view()
+                .expect("LOCAL085202 real membership/input/consensus pin refused");
+            let schedule = crate::leader_schedule_utils::leader_schedule_from_vote_accounts(
+                202,
+                &self.epoch_schedule,
+                projected.stakes().vote_accounts().as_ref(),
+            )
+            .expect("LOCAL085202 real leader schedule missing");
+            let (_, index) = self.epoch_schedule.get_epoch_and_slot_index(self.slot());
+            assert_eq!(
+                *self.leader(),
+                schedule[index],
+                "LOCAL085202 leader differs from real membership"
+            );
+            self.pilot_epoch202_install(projected.clone());
+        }
+    }
+
+    #[cfg(feature = "zolana-pilot-202-recovery")]
+    fn pilot_epoch202_install(&mut self, projected: VersionedEpochStakes) {
+        assert!(
+            !self.freeze_started(),
+            "LOCAL085202 cannot debit a frozen Bank"
+        );
+        if self
+            .epoch_stakes
+            .get(&202)
+            .is_some_and(|s| s.total_stake() > 0)
+        {
+            return;
+        }
+        assert!(self
+            .epoch_stakes
+            .get(&202)
+            .is_some_and(|s| s.total_stake() == 0));
+        assert!(projected.total_stake() > 0);
+        // Bank-local effects: never mutate a parent sidecar/VAT-consumed flag.
+        self.maybe_burn_vat_from_staked_accounts(&projected);
+        self.epoch_stakes.insert(202, projected);
+    }
+}
+
+#[cfg(feature = "zolana-pilot-202-recovery")]
+fn frozen_view(
+    frozen: bool,
+    cell: &OnceLock<Option<VersionedEpochStakes>>,
+    derive: impl FnOnce() -> Option<VersionedEpochStakes>,
+) -> Option<&VersionedEpochStakes> {
+    if !frozen {
+        return None;
+    }
+    cell.get_or_init(derive).as_ref()
+}
+
