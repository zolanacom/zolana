+//! Coordinator fault tests use disposable synthetic jobs. Real Blockstore paths
+//! additionally exercise the unchanged full metadata decoder below and in the
+//! original ancestry_tests module. No validator, key or network is involved.
+use {
+    super::*,
+    solana_ledger::blockstore_meta::SlotMeta,
+    std::{
+        cell::Cell,
+        rc::Rc,
+        sync::{Mutex, atomic::AtomicUsize},
+    },
+};
+
+fn budget() -> Instant {
+    Instant::now() + Duration::from_secs(2)
+}
+fn report(index: usize) -> AncestryReport {
+    AncestryReport {
+        start_slot: 100 + index as u64,
+        target_slot: 1,
+        entries: 10 + index as u64,
+    }
+}
+fn rendezvous(
+    started: &AtomicUsize,
+    deadline: Instant,
+    abort: &AtomicBool,
+) -> Result<(), AncestryError> {
+    started.fetch_add(1, Ordering::SeqCst);
+    while started.load(Ordering::SeqCst) != 3 {
+        check_budget(deadline, &mut || abort.load(Ordering::Acquire))?;
+        thread::sleep(Duration::from_millis(1));
+    }
+    Ok(())
+}
+struct Active<'a>(&'a AtomicUsize);
+impl Drop for Active<'_> {
+    fn drop(&mut self) {
+        self.0.fetch_sub(1, Ordering::SeqCst);
+    }
+}
+fn active(count: &AtomicUsize) -> Active<'_> {
+    count.fetch_add(1, Ordering::SeqCst);
+    Active(count)
+}
