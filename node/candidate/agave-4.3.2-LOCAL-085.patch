+
+/// Independent read-only paths share ONE deadline. The caller's cancellation
+/// callback stays on the caller thread; worker threads receive only an abort
+/// flag. Every worker is joined before returning, including on error or panic.
+/// No partial set of verified peers is ever returned as success.
+fn run_parallel<T: Send>(
+    jobs: Vec<T>,
+    deadline: Instant,
+    mut cancelled: impl FnMut() -> bool,
+    work: impl Fn(T, Instant, &AtomicBool) -> Result<AncestryReport, AncestryError> + Sync,
+) -> Result<Vec<TimedAncestryReport>, AncestryError> {
+    check_budget(deadline, &mut cancelled)?;
+    if !(1..=3).contains(&jobs.len()) {
+        return Err(AncestryError::Invalid {
+            slot: 0,
+            reason: "parallel ancestry requires one to three pinned peers".into(),
+        });
+    }
+    let abort = AtomicBool::new(false);
+    thread::scope(|scope| {
+        let (sender, receiver) = mpsc::channel();
+        let mut handles = Vec::with_capacity(jobs.len());
+        for (index, job) in jobs.into_iter().enumerate() {
+            let sender = sender.clone();
+            let work = &work;
+            let abort = &abort;
+            handles.push(scope.spawn(move || {
+                let began = Instant::now();
+                let result = catch_unwind(AssertUnwindSafe(|| work(job, deadline, abort)))
+                    .unwrap_or(Err(AncestryError::WorkerPanic { index }));
+                let _ = sender.send((index, began.elapsed(), result));
+            }));
+        }
+        drop(sender);
+        let mut reports: Vec<_> = (0..handles.len()).map(|_| None).collect();
+        let mut remaining = handles.len();
+        let mut failure = None;
+        while remaining > 0 {
+            if failure.is_none() {
+                if let Err(error) = check_budget(deadline, &mut cancelled) {
+                    failure = Some(error);
+                    abort.store(true, Ordering::Release);
+                }
+            }
+            // A blocking RocksDB read cannot be interrupted midway; workers
+            // recheck the same deadline/abort flag immediately after each full
+            // fallible metadata read. Join them rather than detach stale work.
+            match receiver.recv_timeout(Duration::from_millis(5)) {
+                Ok((index, elapsed, result)) => {
+                    remaining -= 1;
+                    match result {
+                        Ok(report) => {
+                            reports[index] = Some(TimedAncestryReport { report, elapsed })
+                        }
+                        Err(error) => {
+                            if failure.is_none() {
+                                failure = Some(error);
+                            }
+                            abort.store(true, Ordering::Release);
+                        }
+                    }
+                }
+                Err(mpsc::RecvTimeoutError::Timeout) => {}
+                Err(mpsc::RecvTimeoutError::Disconnected) => {
+                    if failure.is_none() {
+                        failure = Some(AncestryError::WorkerPanic {
+                            index: reports.len(),
+                        });
+                    }
+                    abort.store(true, Ordering::Release);
+                    break;
+                }
+            }
+        }
+        for (index, handle) in handles.into_iter().enumerate() {
+            if handle.join().is_err() && failure.is_none() {
+                failure = Some(AncestryError::WorkerPanic { index });
+                abort.store(true, Ordering::Release);
+            }
+        }
+        if let Some(error) = failure {
+            return Err(error);
+        }
+        check_budget(deadline, &mut cancelled)?;
+        reports
+            .into_iter()
+            .map(|report| {
+                report.ok_or(AncestryError::Invalid {
+                    slot: 0,
+                    reason: "joined worker did not produce a complete ancestry report".into(),
+                })
+            })
+            .collect()
+    })
+}
+
+pub(super) fn verify_paths(
+    tasks: Vec<PathTask>,
+    deadline: Instant,
+    cancelled: impl FnMut() -> bool,
+) -> Result<Vec<TimedAncestryReport>, AncestryError> {
+    run_parallel(tasks, deadline, cancelled, |task, deadline, abort| {
+        let began = Instant::now();
+        let mut entries = 0;
+        let mut last_slot = task.start_slot;
+        let result = verify_path_observed(
+            &task.blockstore,
+            task.start_slot,
+            task.target_slot,
+            deadline,
+            || abort.load(Ordering::Acquire),
+            |slot, count| {
+                last_slot = slot;
+                entries = count;
+            },
+        );
+        let count = entries;
+        eprintln!(
+            "{}",
+            serde_json::json!({"event": "parallel_original_ancestry_walk",
+            "identity": task.identity, "start_slot": task.start_slot, "target_slot": task.target_slot,
+            "entries": count, "parent_links": count.saturating_sub(1),
+            "last_validated_slot": last_slot,
+            "elapsed_ms": began.elapsed().as_secs_f64() * 1000.0,
+            "verified": result.is_ok(), "error": result.as_ref().err().map(ToString::to_string),
+            "full_fallible_metadata": true, "shared_deadline": true})
+        );
+        result
+    })
+}
