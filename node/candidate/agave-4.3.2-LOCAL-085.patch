@@ -0,0 +1,231 @@
+//! Pure bounded public input/output helpers; no Bank reads or mutations.
+use super::*;
+use serde_json::{json, Value};
+
+pub(super) const ELIGIBLE_DOMAIN: &[u8] = b"zolana085-epoch202-eligible-inputs-v1\0";
+pub(super) const ORIGINAL_VOTES: [Pubkey; 3] = [
+    solana_pubkey::pubkey!("7WHFCYkHZZ8L9FoKteoM8yRKJsFJSU3bMrVm1xCQWAYn"),
+    solana_pubkey::pubkey!("Fx4LYYr8xmnz8d7N2L4D5eJKsAyb8jAmNsBtkuPGxWFX"),
+    solana_pubkey::pubkey!("GEmo5tnbeEHXo7fqoWQSEzimS2Udb8dRR7y9xVu5evju"),
+];
+
+#[derive(Clone)]
+pub(super) struct EligibleInput {
+    pub(super) vote: Pubkey,
+    pub(super) delegated_weight: u64,
+    pub(super) actual_lamports: u64,
+    pub(super) owner: Pubkey,
+    pub(super) vote_data_sha256: [u8; 32],
+}
+
+pub(super) fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|byte| format!("{byte:02x}")).collect()
+}
+
+/// Canonical JSON of internally constructed, bounded PUBLIC diagnostic output.
+/// Object keys sort recursively; array order and integer representations remain
+/// exact. This is not a replacement for each anchor's full account-data pin.
+fn canonical_public_json(value: &Value, out: &mut Vec<u8>) {
+    match value {
+        Value::Object(fields) => {
+            out.push(b'{');
+            let mut keys = fields.keys().collect::<Vec<_>>();
+            keys.sort_unstable();
+            for (index, key) in keys.into_iter().enumerate() {
+                if index != 0 {
+                    out.push(b',');
+                }
+                out.extend(serde_json::to_vec(key).unwrap());
+                out.push(b':');
+                canonical_public_json(&fields[key], out);
+            }
+            out.push(b'}');
+        }
+        Value::Array(items) => {
+            out.push(b'[');
+            for (index, item) in items.iter().enumerate() {
+                if index != 0 {
+                    out.push(b',');
+                }
+                canonical_public_json(item, out);
+            }
+            out.push(b']');
+        }
+        _ => out.extend(serde_json::to_vec(value).unwrap()),
+    }
+}
+
+pub(super) fn consensus_digest(outputs: &Value) -> String {
+    let mut bytes = b"zolana085-epoch202-consensus-outputs-v1\0".to_vec();
+    canonical_public_json(outputs, &mut bytes);
+    hex(solana_sha256_hasher::hash(&bytes).as_ref())
+}
+
+pub(super) fn decoded_vote_state(vote: &Pubkey, account: &VoteAccount) -> Value {
+    let view = account.vote_state_view();
+    let timestamp = view.last_timestamp();
+    let nonrolling_pin =
+        solana_vote_interface::state::VoteStateV4::deserialize(account.account().data(), vote)
+            .ok()
+            .and_then(|mut state| {
+                state.votes.clear();
+                state.root_slot = None;
+                state.epoch_credits.clear();
+                state.last_timestamp = Default::default();
+                wincode::serialize(&solana_vote_interface::state::VoteStateVersions::new_v4(
+                    state,
+                ))
+                .ok()
+            })
+            .map(|bytes| hex(solana_sha256_hasher::hash(&bytes).as_ref()));
+    json!({
+        "node_pubkey": view.node_pubkey().to_string(),
+        "authorized_voter_202": view.get_authorized_voter(202).map(ToString::to_string),
+        "bls_pubkey_compressed_hex": view.bls_pubkey_compressed().map(|key| hex(&key)),
+        "inflation_commission_bps": view.inflation_rewards_commission(),
+        "legacy_commission_percent": view.commission(),
+        "block_revenue_commission_bps": view.block_revenue_commission(),
+        "inflation_rewards_collector": view.inflation_rewards_collector().map(ToString::to_string),
+        "block_revenue_collector": view.block_revenue_collector().map(ToString::to_string),
+        "pending_delegator_rewards": view.pending_delegator_rewards(),
+        "nonrolling_configuration_sha256":nonrolling_pin,
+        "normalization":"parsed V4; only votes/root_slot/epoch_credits/last_timestamp cleared; financial/configuration fields retained",
+        "root_slot": view.root_slot(), "last_voted_slot": view.last_voted_slot(),
+        "votes": view.votes_iter().map(|vote| json!({"slot":vote.slot(),
+            "confirmation_count":vote.confirmation_count()})).collect::<Vec<_>>(),
+        "credits": view.credits(),
+        "epoch_credits": view.epoch_credits_iter().map(|item| json!({
+            "epoch":item.epoch(),"credits":item.credits(),"previous_credits":item.prev_credits()
+        })).collect::<Vec<_>>(),
+        "last_timestamp": {"slot":timestamp.slot,"timestamp":timestamp.timestamp},
+    })
+}
+
+/// Full prospective leader/membership/quorum outputs derived by ordinary
+/// constructors, without changing Bank getters, epoch maps, or accounts.
+pub(super) fn prospective_consensus_outputs(
+    accounts: &solana_vote::vote_account::VoteAccounts,
+    schedule: &EpochSchedule,
+    vat: u64,
+    minimum: u64,
+) -> Option<Value> {
+    if accounts.len() != 3
+        || schedule.slots_per_epoch != 2048
+        || schedule.leader_schedule_slot_offset != 2048
+        || schedule.warmup
+    {
+        return None;
+    }
+    let mut ordered = accounts.as_ref().iter().collect::<Vec<_>>();
+    ordered.sort_unstable_by_key(|(vote, _)| vote.to_bytes());
+    let mut nodes = std::collections::HashSet::new();
+    let mut keys = std::collections::HashSet::new();
+    for (_, (stake, account)) in &ordered {
+        let view = account.vote_state_view();
+        let key = view.bls_pubkey_compressed()?;
+        if *stake == 0
+            || account.lamports() < minimum
+            || view.get_authorized_voter(202).is_none()
+            || !nodes.insert(*view.node_pubkey())
+            || !keys.insert(key)
+            || crate::epoch_stakes::bls_pubkey_compressed_bytes_to_bls_pubkey(key).is_none()
+        {
+            return None;
+        }
+    }
+    let projected = VersionedEpochStakes::new(
+        SerdeStakesToStakeFormat::from(Stakes::<StakeAccount<Delegation>>::new(
+            accounts.clone(),
+            201,
+        )),
+        202,
+    );
+    let rank_map = projected.bls_pubkey_to_rank_map();
+    if rank_map.len() != 3 || rank_map.total_stake().get() != projected.total_stake() {
+        return None;
+    }
+    let votes = ordered.iter().map(|(vote, (stake, account))| {
+        let view = account.vote_state_view();
+        json!({"vote":vote.to_string(),"node":view.node_pubkey().to_string(),
+            "delegated_weight":stake,"authorized_voter_202":view.get_authorized_voter(202).unwrap().to_string(),
+            "bls_pubkey_compressed_hex":hex(&view.bls_pubkey_compressed().unwrap())})
+    }).collect::<Vec<_>>();
+    let mut node_rows = projected
+        .node_id_to_vote_accounts()
+        .iter()
+        .collect::<Vec<_>>();
+    node_rows.sort_unstable_by_key(|(node, _)| node.to_bytes());
+    let node_rows = node_rows
+        .into_iter()
+        .map(|(node, value)| {
+            let mut votes = value.vote_accounts.clone();
+            votes.sort_unstable_by_key(|vote| vote.to_bytes());
+            json!({"node":node.to_string(),"total_stake":value.total_stake,
+            "vote_accounts":votes.iter().map(ToString::to_string).collect::<Vec<_>>()})
+        })
+        .collect::<Vec<_>>();
+    let staked_nodes = projected.stakes().staked_nodes();
+    let mut staked_nodes = staked_nodes.iter().collect::<Vec<_>>();
+    staked_nodes.sort_unstable_by_key(|(node, _)| node.to_bytes());
+    let mut authorized = projected
+        .epoch_authorized_voters()
+        .iter()
+        .collect::<Vec<_>>();
+    authorized.sort_unstable_by_key(|(vote, _)| vote.to_bytes());
+    let ranks = (0..rank_map.len()).map(|rank| {
+        let entry = rank_map.get_pubkey_stake_entry(rank).unwrap();
+        let account = accounts.get(&entry.vote_account_pubkey).unwrap();
+        json!({"rank":rank,"vote":entry.vote_account_pubkey.to_string(),
+            "node":entry.node_pubkey.to_string(),"stake":entry.stake.get(),
+            "bls_pubkey_compressed_hex":hex(&account.vote_state_view().bls_pubkey_compressed().unwrap())})
+    }).collect::<Vec<_>>();
+    let leaders = crate::leader_schedule_utils::leader_schedule_from_vote_accounts(
+        202,
+        schedule,
+        accounts.as_ref(),
+    )?;
+    if leaders.num_slots() != 2048 {
+        return None;
+    }
+    Some(json!({
+        "target_epoch":202,"slots_per_epoch":2048,"repeat_slots":4,"vat":vat,
+        "minimum_vote_balance":minimum,"total_stake":projected.total_stake(),
+        "votes":votes,"node_vote_accounts":node_rows,
+        "staked_nodes":staked_nodes.into_iter().map(|(node, stake)| json!({
+            "node":node.to_string(),"stake":stake})).collect::<Vec<_>>(),
+        "authorized_voters":authorized.into_iter().map(|(vote, voter)| json!({
+            "vote":vote.to_string(),"authorized_voter":voter.to_string()})).collect::<Vec<_>>(),
+        "bls_total_stake":rank_map.total_stake().get(),"bls_ranks":ranks,
+        "slot_leaders":leaders.get_slot_leaders().map(|leader| json!({
+            "id":leader.id.to_string(),"vote_address":leader.vote_address.to_string()})).collect::<Vec<_>>(),
+    }))
+}
+
+/// Exact public wire contract shared with the future activation implementation.
+/// The caller separately checks eligibility, BLS, original identities and cache
+/// fidelity. This function only encodes three distinct bounded public entries.
+pub(super) fn eligible_digest(entries: &[EligibleInput], vat: u64, minimum: u64) -> Option<String> {
+    if entries.len() != 3 {
+        return None;
+    }
+    let mut sorted = entries.to_vec();
+    sorted.sort_unstable_by_key(|entry| entry.vote.to_bytes());
+    if sorted.windows(2).any(|pair| pair[0].vote == pair[1].vote) {
+        return None;
+    }
+    let mut bytes = Vec::with_capacity(ELIGIBLE_DOMAIN.len() + 32 + 4 * 8 + 4 + 3 * 112);
+    bytes.extend_from_slice(ELIGIBLE_DOMAIN);
+    bytes.extend_from_slice(&[67; 32]);
+    for value in [201u64, 202u64, vat, minimum] {
+        bytes.extend_from_slice(&value.to_le_bytes());
+    }
+    bytes.extend_from_slice(&3u32.to_le_bytes());
+    for entry in sorted {
+        bytes.extend_from_slice(entry.vote.as_ref());
+        bytes.extend_from_slice(&entry.delegated_weight.to_le_bytes());
+        bytes.extend_from_slice(&entry.actual_lamports.to_le_bytes());
+        bytes.extend_from_slice(entry.owner.as_ref());
+        bytes.extend_from_slice(&entry.vote_data_sha256);
+    }
+    Some(hex(solana_sha256_hasher::hash(&bytes).as_ref()))
+}
