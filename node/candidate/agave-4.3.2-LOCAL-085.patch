+    #[test]
+    fn offline_probe_rejects_arbitrary_paths_or_runtime_options() {
+        let args = |values:&[&str]|values.iter().map(|value|value.to_string()).collect::<Vec<_>>();
+        for node in ["0","1","2"] { assert_eq!(requested(&args(&["--offline-202-probe",node])).unwrap(),node.parse::<usize>().ok()); }
+        for values in [vec!["--offline-202-probe"],vec!["--offline-202-probe","3"],
+            vec!["--offline-202-probe","00"],vec!["--offline-202-probe","/tmp/other"],
+            vec!["--offline-202-probe","0","--service"],vec!["--service","--offline-202-probe"]] {
+            assert!(requested(&args(&values)).is_err());
+        }
+        assert!(requested(&args(&["--service"])).unwrap().is_none());
+    }
+}
