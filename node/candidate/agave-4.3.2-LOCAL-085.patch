+    let root = ctx.ctx.sharable_banks.root();
+    let nodes = root.current_epoch_staked_nodes();
+    let identity = ctx.ctx.cluster_info.id();
+    assert!(nodes[&identity] > 0);
+    let raw_empty = std::collections::HashMap::new();
+    let policy = CertificateEgressPolicy::from_test_memberships(
+        &schedule,
+        &identity,
+        &raw_empty,
+        Some(&nodes),
+    );
+    let batch = pilot_epoch202_batch();
+    let expected = [batch[1].clone(), batch[3].clone()];
+    let mut stats = ConsensusPoolServiceStats::new();
+    ConsensusPoolService::send_certificates_with_policy(
+        &ctx.ctx,
+        BLSOp::PushCertificates {
+            certificates: batch,
+        },
+        &mut stats,
