+#[test]
+fn standard_purge_then_reopen_preserves_merged_metadata_ancestry_only() {
+    use solana_ledger::blockstore::PurgeType;
+
+    let directory = solana_ledger::get_tmp_ledger_path_auto_delete!();
+    let store = Blockstore::open(directory.path()).unwrap();
+    let all: Vec<_> = records()
+        .into_iter()
+        .chain([(12, meta(12, Some(9))), (15, meta(15, Some(12)))])
+        .collect();
+    let slots: Vec<_> = all.iter().map(|(slot, _)| *slot).collect();
+    for (slot, value) in &all {
+        store.put_meta(*slot, value).unwrap();
+        let hash = solana_sha256_hasher::hash(&slot.to_le_bytes());
+        store.insert_bank_hash(*slot, hash, true);
+        store
+            .insert_optimistic_slot(*slot, &hash, *slot as i64)
+            .unwrap();
+    }
+    // These are disposable DB rows, not consensus-generated certificates.
+    store.set_roots(slots.iter()).unwrap();
+    for (slot, value) in &all {
+        let hash = solana_sha256_hasher::hash(&slot.to_le_bytes());
+        assert_eq!(store.meta(*slot).unwrap().as_ref(), Some(value));
+        assert!(store.is_root(*slot));
+        assert_eq!(
+            store.get_optimistic_slot(*slot).unwrap(),
+            Some((hash, *slot as i64))
+        );
+        assert_eq!(store.get_bank_hash(*slot), Some(hash));
+    }
+    let before = verify_path(&store, 15, 3, budget(), || false).unwrap();
+    let prefix = prefix(); // Same in-memory object survives the DB close/reopen.
+    assert_eq!(
+        prefix.verify(&store, 15, budget(), || false).unwrap(),
+        before
+    );
+    let check = |db: &Blockstore| {
+        for slot in [3, 7] {
+            assert!(db.meta(slot).unwrap().is_none());
+            assert!(!db.is_root(slot));
+            assert!(db.get_optimistic_slot(slot).unwrap().is_none());
+            assert!(db.get_bank_hash(slot).is_none());
+        }
+        for (slot, value) in all.iter().filter(|(slot, _)| *slot > 7) {
+            let hash = solana_sha256_hasher::hash(&slot.to_le_bytes());
+            assert_eq!(db.meta(*slot).unwrap().as_ref(), Some(value));
+            assert!(db.is_root(*slot));
+            assert_eq!(
+                db.get_optimistic_slot(*slot).unwrap(),
+                Some((hash, *slot as i64))
+            );
+            assert_eq!(db.get_bank_hash(*slot), Some(hash));
+        }
+        assert_invalid(verify_path(db, 15, 3, budget(), || false), 7);
+        assert_eq!(prefix.verify(db, 15, budget(), || false).unwrap(), before);
+    };
+    // Exact upstream API with inclusive [0, 7], no chaining cleanup or custom
+    // CF deletion, no compaction-forcing or modification of protected head 9.
+    // This fixture has metadata/evidence rows only: no shreds or transaction
+    // special columns, so it does NOT establish payload/tx archive coverage.
+    store.purge_slots(0, 7, PurgeType::Exact).unwrap();
+    check(&store);
+    drop(store);
+    let reopened = Blockstore::open(directory.path()).unwrap();
+    check(&reopened);
+    // This checks process-local prefix reuse plus DB reopen only. It does NOT
+    // serialize/reload the prefix, restore a snapshot, or restart a validator.
+}
