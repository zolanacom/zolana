+#[test]
+fn callback_predicate_matches_live_error_and_invalid_parent_outcomes() {
+    let directory = solana_ledger::get_tmp_ledger_path_auto_delete!();
+    let store = Blockstore::open(directory.path()).unwrap();
+    store.put_meta(3, &meta(3, None)).unwrap();
+    for value in [
+        meta(9, None),
+        meta(9, Some(9)),
+        meta(9, Some(10)),
+        meta(9, Some(2)),
+    ] {
+        store.put_meta(9, &value).unwrap();
+        let live = verify_path(&store, 9, 3, budget(), || false).unwrap_err();
+        let callback =
+            verify_path_from(|s| store.meta(s), 9, 3, budget(), || false, |_, _| {}).unwrap_err();
+        assert_eq!(live.to_string(), callback.to_string());
+    }
+    store.put_meta_bytes(9, b"corrupt").unwrap();
+    let live = verify_path(&store, 9, 3, budget(), || false).unwrap_err();
+    let callback =
+        verify_path_from(|s| store.meta(s), 9, 3, budget(), || false, |_, _| {}).unwrap_err();
+    assert_eq!(live.to_string(), callback.to_string());
+}
