+//! Real SlotMeta/wincode plus disposable RocksDB fixtures; no consensus, keys,
+//! snapshots, durable archive authority or actual prune is exercised here.
+use {
+    super::*,
+    crate::ancestry::verify_path,
+    std::{cell::Cell, time::Duration},
+};
+
+fn budget() -> Instant {
+    Instant::now() + Duration::from_secs(5)
+}
+
+fn meta(slot: u64, parent_slot: Option<u64>) -> SlotMeta {
+    let mut value = SlotMeta {
+        slot,
+        parent_slot,
+        consumed: 4,
+        received: 4,
+        first_shred_timestamp: 123,
+        last_index: Some(3),
+        replay_fec_set_index: 2,
+        parent_block_id: solana_sha256_hasher::hash(&slot.to_le_bytes()),
+        ..SlotMeta::default()
+    };
+    value.next_slots.push(slot + 2);
+    value.completed_data_indexes.insert(3);
+    value
+}
+
+fn records() -> Vec<(u64, SlotMeta)> {
+    vec![
+        (9, meta(9, Some(7))),
+        (7, meta(7, Some(3))),
+        (3, meta(3, None)),
+    ]
+}
+
+fn prefix() -> ValidatedPrefix {
+    ValidatedPrefix::try_from_metadata(3, 9, 7, records(), budget(), || false).unwrap()
+}
+
+fn assert_invalid<T>(result: Result<T, AncestryError>, slot: u64) {
+    assert!(matches!(result, Err(AncestryError::Invalid { slot: s, .. }) if s == slot));
+}
+
+#[test]
+fn native_full_metadata_roundtrip_rejects_wrong_slot_truncation_and_trailing() {
+    let expected = meta(9, Some(7));
+    let raw = encode_full_meta(&expected).unwrap();
+    assert_eq!(decode_full_meta(9, &raw).unwrap(), expected);
+    assert_invalid(decode_full_meta(8, &raw), 8);
+    for length in [0, 7, raw.len() - 1] {
+        assert_invalid(decode_full_meta(9, &raw[..length]), 9);
+    }
+    let mut trailing = raw.clone();
+    trailing.push(0);
+    assert_invalid(decode_full_meta(9, &trailing), 9);
+    assert_invalid(decode_full_meta(9, &vec![0; MAX_META_BYTES + 1]), 9);
+}
+
+#[test]
+fn native_decoder_bounds_hostile_sequence_length_and_encoder_bounds_full_record() {
+    let mut empty = meta(9, Some(7));
+    empty.next_slots.clear();
+    let empty_raw = encode_full_meta(&empty).unwrap();
+    let mut one = empty.clone();
+    one.next_slots.push(11);
+    let one_raw = encode_full_meta(&one).unwrap();
+    // Locate the real wincode sequence length by the first difference between
+    // two otherwise identical native values; no hand-copied SlotMeta layout.
+    let length_offset = empty_raw
+        .iter()
+        .zip(&one_raw)
+        .position(|(a, b)| a != b)
+        .unwrap();
+    assert_eq!(
+        &empty_raw[length_offset..length_offset + 8],
+        &0u64.to_le_bytes()
+    );
+    assert_eq!(
+        &one_raw[length_offset..length_offset + 8],
+        &1u64.to_le_bytes()
+    );
+    for count in [u64::MAX, (MAX_META_BYTES as u64 / 8) + 1] {
+        let mut hostile = empty_raw.clone();
+        hostile[length_offset..length_offset + 8].copy_from_slice(&count.to_le_bytes());
+        assert_invalid(decode_full_meta(9, &hostile), 9);
+    }
+    let mut huge = empty;
+    huge.next_slots
+        .extend(std::iter::repeat_n(11, MAX_META_BYTES / 8));
+    assert_invalid(encode_full_meta(&huge), 9);
+}
+
+#[test]
+fn unchanged_live_reader_and_merged_prefix_give_identical_real_blockstore_reports() {
+    let full_dir = solana_ledger::get_tmp_ledger_path_auto_delete!();
+    let tail_dir = solana_ledger::get_tmp_ledger_path_auto_delete!();
+    let full = Blockstore::open(full_dir.path()).unwrap();
+    let tail = Blockstore::open(tail_dir.path()).unwrap();
+    for (slot, value) in records()
+        .into_iter()
+        .chain([(12, meta(12, Some(9))), (15, meta(15, Some(12)))])
+    {
+        full.put_meta(slot, &value).unwrap();
+        if slot > 7 {
+            tail.put_meta(slot, &value).unwrap();
+        }
+    }
+    let expected = verify_path(&full, 15, 3, budget(), || false).unwrap();
+    let prefix = prefix();
+    assert_eq!(
+        prefix.verify(&full, 15, budget(), || false).unwrap(),
+        expected
+    );
+    assert_eq!(
+        prefix.verify(&tail, 15, budget(), || false).unwrap(),
+        expected
+    );
+    assert_invalid(verify_path(&tail, 15, 3, budget(), || false), 7);
+    assert_eq!(full.meta(7).unwrap().unwrap(), meta(7, Some(3)));
+    assert!(tail.meta(7).unwrap().is_none());
+}
+
+#[test]
+fn full_overlap_conflicts_include_fields_beyond_parent_and_slot() {
+    let prefix = prefix();
+    let expected = meta(7, Some(3));
+    let mut conflicts = Vec::new();
+    let mut value = expected.clone();
+    value.consumed += 1;
+    conflicts.push(value);
+    let mut value = expected.clone();
+    value.next_slots.push(99);
+    conflicts.push(value);
+    let mut value = expected.clone();
+    value.completed_data_indexes.insert(2);
+    conflicts.push(value);
+    let mut value = expected.clone();
+    value.replay_fec_set_index += 1;
+    conflicts.push(value);
+    let mut value = expected.clone();
+    value.parent_block_id = Default::default();
+    conflicts.push(value);
+    for value in conflicts {
+        assert_eq!(value.parent_slot, expected.parent_slot);
+        assert!(
+            prefix
+                .read_from(7, |_| Ok::<_, String>(Some(value.clone())))
+                .is_err()
+        );
+    }
+    assert_eq!(
+        prefix
+            .read_from(7, |_| Ok::<_, String>(Some(expected.clone())))
+            .unwrap(),
+        Some(expected)
+    );
+}
+
+#[test]
+fn corrupt_live_full_metadata_is_fatal_instead_of_using_archived_replacement() {
+    let directory = solana_ledger::get_tmp_ledger_path_auto_delete!();
+    let store = Blockstore::open(directory.path()).unwrap();
+    store.put_meta(9, &meta(9, Some(7))).unwrap();
+    store.put_meta_bytes(7, b"corrupt").unwrap();
+    let before = store.meta(7).unwrap_err().to_string();
+    assert_invalid(prefix().verify(&store, 9, budget(), || false), 7);
+    assert_eq!(store.meta(7).unwrap_err().to_string(), before);
+    let error = prefix()
+        .read_from(7, |_| Err::<Option<SlotMeta>, _>("live read failed"))
+        .unwrap_err();
+    assert_eq!(error, "live read failed");
+}
+
+#[test]
+fn archive_can_fill_only_missing_records_in_approved_prefix_never_missing_tail() {
+    let prefix = prefix();
+    assert_eq!(
+        prefix.read_from(7, |_| Ok::<_, String>(None)).unwrap(),
+        Some(meta(7, Some(3)))
+    );
+    assert!(
+        prefix
+            .read_from(9, |_| Ok::<_, String>(None))
+            .unwrap()
+            .is_none()
+    );
+    assert!(
+        prefix
+            .read_from(2, |_| Ok::<_, String>(None))
+            .unwrap()
+            .is_none()
+    );
+    let directory = solana_ledger::get_tmp_ledger_path_auto_delete!();
+    let store = Blockstore::open(directory.path()).unwrap();
+    assert_invalid(prefix.verify(&store, 9, budget(), || false), 9);
+}
