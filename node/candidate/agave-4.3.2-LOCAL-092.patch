+#[test]
+fn prefix_total_encoded_bytes_are_bounded_before_path_acceptance() {
+    let mut values = Vec::new();
+    for slot in 1000..1600 {
+        let mut value = meta(slot, Some(slot - 1));
+        let base = wincode::serialized_size(&value).unwrap() as usize;
+        let extra = (MAX_META_BYTES - base - 16) / 8;
+        value.next_slots.extend(std::iter::repeat_n(11, extra));
+        assert!(wincode::serialized_size(&value).unwrap() <= MAX_META_BYTES as u64);
+        values.push((slot, value));
+    }
+    let error = match ValidatedPrefix::try_from_metadata(3, 2000, 999, values, budget(), || false) {
+        Err(error) => error,
+        Ok(_) => panic!("oversized prefix was accepted"),
+    };
+    assert!(
+        matches!(error, AncestryError::Invalid { ref reason, .. } if reason == "prefix exceeds total byte bound")
+    );
+}
