+#[test]
+fn callback_checks_deadline_and_cancel_before_and_after_full_read() {
+    let called = Cell::new(false);
+    let expired = Instant::now().checked_sub(Duration::from_secs(1)).unwrap();
+    let result = verify_path_from(
+        |_| {
+            called.set(true);
+            Ok::<_, String>(Some(meta(3, None)))
+        },
+        3,
+        3,
+        expired,
+        || false,
+        |_, _| {},
+    );
+    assert!(matches!(result, Err(AncestryError::Deadline)));
+    assert!(!called.get());
+    let result = verify_path_from(
+        |_| {
+            called.set(true);
+            Ok::<_, String>(Some(meta(3, None)))
+        },
+        3,
+        3,
+        budget(),
+        || true,
+        |_, _| {},
+    );
+    assert!(matches!(result, Err(AncestryError::Cancelled)));
+    assert!(!called.get());
+    let result = verify_path_from(
+        |_| {
+            std::thread::sleep(Duration::from_millis(40));
+            Ok::<_, String>(Some(meta(3, None)))
+        },
+        3,
+        3,
+        Instant::now() + Duration::from_millis(10),
+        || false,
+        |_, _| {},
+    );
+    assert!(matches!(result, Err(AncestryError::Deadline)));
+    let read = Cell::new(false);
+    let result = verify_path_from(
+        |_| {
+            read.set(true);
+            Ok::<_, String>(Some(meta(3, None)))
+        },
+        3,
+        3,
+        budget(),
+        || read.get(),
+        |_, _| {},
+    );
+    assert!(matches!(result, Err(AncestryError::Cancelled)));
+}
