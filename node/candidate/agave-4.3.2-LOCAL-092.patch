+#[test]
+fn prefix_rejects_bad_lookup_slot_missing_or_invalid_parent_and_extra_branch() {
+    let mut cases = Vec::new();
+    let mut values = records();
+    values[0].1.slot = 8;
+    cases.push(values);
+    let mut values = records();
+    values.remove(1);
+    cases.push(values);
+    for parent in [None, Some(9), Some(10), Some(2)] {
+        let mut values = records();
+        values[0].1.parent_slot = parent;
+        cases.push(values);
+    }
+    let mut values = records();
+    values.push((8, meta(8, Some(3))));
+    cases.push(values);
+    let mut values = records();
+    values.push((7, meta(7, Some(3))));
+    cases.push(values);
+    for values in cases {
+        assert!(matches!(
+            ValidatedPrefix::try_from_metadata(3, 9, 7, values, budget(), || false),
+            Err(AncestryError::Invalid { .. })
+        ));
+    }
+}
