+#[test]
+fn target_metadata_is_required_but_original_targets_own_parent_is_not_walked() {
+    let mut values = records();
+    values[2].1.parent_slot = Some(3);
+    let prefix = ValidatedPrefix::try_from_metadata(3, 9, 7, values, budget(), || false).unwrap();
+    assert_eq!(
+        prefix
+            .read_from(3, |_| Ok::<_, String>(None))
+            .unwrap()
+            .unwrap()
+            .parent_slot,
+        Some(3)
+    );
+    let mut values = records();
+    values.pop();
+    assert_invalid(
+        ValidatedPrefix::try_from_metadata(3, 9, 7, values, budget(), || false),
+        3,
+    );
+}
