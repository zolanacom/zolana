+//! Bounded in-memory FULL SlotMeta prefix, not durable archive authorization.
+//! No root/certificate evidence, domain binding, export publication, snapshot
+//! validation or resume integration is implemented by this native test slice.
+use {
+    super::{AncestryError, AncestryReport, check_budget, verify_path_from},
+    solana_ledger::{blockstore::Blockstore, blockstore_meta::SlotMeta},
+    std::{collections::BTreeMap, fmt, time::Instant},
+};
+
+// Deliberately small first native slice, not the larger durable-export caps.
+const MAX_RECORDS: usize = 4096;
+const MAX_META_BYTES: usize = 64 * 1024;
+const MAX_PREFIX_BYTES: u64 = 32 * 1024 * 1024;
+
+fn invalid(slot: u64, reason: impl Into<String>) -> AncestryError {
+    AncestryError::Invalid {
+        slot,
+        reason: reason.into(),
+    }
+}
+
+fn encode_full_meta(meta: &SlotMeta) -> Result<Vec<u8>, AncestryError> {
+    let size = wincode::serialized_size(meta)
+        .map_err(|e| invalid(meta.slot, format!("cannot size full metadata: {e}")))?;
+    if size == 0 || size > MAX_META_BYTES as u64 {
+        return Err(invalid(meta.slot, "full metadata exceeds record bound"));
+    }
+    wincode::serialize(meta)
+        .map_err(|e| invalid(meta.slot, format!("cannot encode full metadata: {e}")))
+}
+
+fn decode_full_meta(slot: u64, raw: &[u8]) -> Result<SlotMeta, AncestryError> {
+    if raw.is_empty() || raw.len() > MAX_META_BYTES {
+        return Err(invalid(slot, "full metadata exceeds record bound"));
+    }
+    let config =
+        wincode::config::Configuration::default().with_preallocation_size_limit::<MAX_META_BYTES>();
+    let meta: SlotMeta = wincode::config::deserialize_exact(raw, config)
+        .map_err(|e| invalid(slot, format!("cannot decode full metadata: {e}")))?;
+    // Exports must contain canonical FULL V3 records. Legacy DB encodings are
+    // normalized through Blockstore::meta before export, not accepted as an
+    // abbreviated/prefix archive representation.
+    if meta.slot != slot || encode_full_meta(&meta)? != raw {
+        return Err(invalid(
+            slot,
+            "full metadata slot or canonical bytes differ",
+        ));
+    }
+    Ok(meta)
+}
+
+/// Private owned records cannot be replaced after full native validation.
+/// "Validated" means metadata/path/size only, never finality or export trust.
+pub(super) struct ValidatedPrefix {
+    original_slot: u64,
+    prune_through: u64,
+    records: BTreeMap<u64, SlotMeta>,
+}
+
+impl ValidatedPrefix {
+    pub(super) fn try_from_metadata(
+        original_slot: u64,
+        head_slot: u64,
+        prune_through: u64,
+        records: Vec<(u64, SlotMeta)>,
+        deadline: Instant,
+        mut cancelled: impl FnMut() -> bool,
+    ) -> Result<Self, AncestryError> {
+        check_budget(deadline, &mut cancelled)?;
+        if !(original_slot <= prune_through && prune_through < head_slot)
+            || records.is_empty()
+            || records.len() > MAX_RECORDS
+        {
+            return Err(invalid(
+                original_slot,
+                "invalid bounded prefix range or count",
+            ));
+        }
+        let mut total = 0u64;
+        let mut owned = BTreeMap::new();
+        for (slot, meta) in records {
+            check_budget(deadline, &mut cancelled)?;
+            if slot < original_slot || slot > head_slot || meta.slot != slot {
+                return Err(invalid(slot, "prefix metadata slot or range differs"));
+            }
+            let raw = encode_full_meta(&meta)?;
+            total = total
+                .checked_add(raw.len() as u64)
+                .ok_or_else(|| invalid(slot, "prefix byte counter overflow"))?;
+            if total > MAX_PREFIX_BYTES {
+                return Err(invalid(slot, "prefix exceeds total byte bound"));
+            }
+            let decoded = decode_full_meta(slot, &raw)?;
+            if decoded != meta {
+                return Err(invalid(slot, "full metadata roundtrip differs"));
+            }
+            check_budget(deadline, &mut cancelled)?;
+            if owned.insert(slot, decoded).is_some() {
+                return Err(invalid(slot, "duplicate prefix metadata slot"));
+            }
+        }
+        let report = verify_path_from(
+            |slot| Ok::<_, String>(owned.get(&slot).cloned()),
+            head_slot,
+            original_slot,
+            deadline,
+            &mut cancelled,
+            |_, _| {},
+        )?;
+        if report.entries != owned.len() as u64 {
+            return Err(invalid(
+                head_slot,
+                "prefix contains records outside its ancestry path",
+            ));
+        }
+        Ok(Self {
+            original_slot,
+            prune_through,
+            records: owned,
+        })
+    }
+
+    fn read_from<E: fmt::Display>(
+        &self,
+        slot: u64,
+        mut read_live: impl FnMut(u64) -> Result<Option<SlotMeta>, E>,
+    ) -> Result<Option<SlotMeta>, String> {
+        // Live decoding/storage errors are NOT a missing/pruned record.
+        let live = read_live(slot).map_err(|e| e.to_string())?;
+        let old = self.records.get(&slot);
+        match (live, old) {
+            (Some(live), Some(old)) if &live != old => {
+                Err("live/archive full metadata conflicts".into())
+            }
+            (Some(live), _) => Ok(Some(live)),
+            (None, Some(old)) if slot <= self.prune_through => Ok(Some(old.clone())),
+            // Even a complete archived record cannot fill a missing live tail
+            // above the explicitly approved prune boundary.
+            (None, _) => Ok(None),
+        }
+    }
+
+    pub(super) fn verify(
+        &self,
+        blockstore: &Blockstore,
+        start_slot: u64,
+        deadline: Instant,
+        cancelled: impl FnMut() -> bool,
+    ) -> Result<AncestryReport, AncestryError> {
+        verify_path_from(
+            |slot| self.read_from(slot, |slot| blockstore.meta(slot)),
+            start_slot,
+            self.original_slot,
+            deadline,
+            cancelled,
+            |_, _| {},
+        )
+    }
+}
