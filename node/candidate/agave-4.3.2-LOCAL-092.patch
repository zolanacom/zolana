+#[test]
+fn prefix_range_count_and_preparation_budget_are_bounded() {
+    for (original, head, cutoff) in [(3, 9, 2), (3, 9, 9), (10, 9, 7)] {
+        assert!(
+            ValidatedPrefix::try_from_metadata(original, head, cutoff, records(), budget(), || {
+                false
+            })
+            .is_err()
+        );
+    }
+    assert!(ValidatedPrefix::try_from_metadata(3, 9, 7, vec![], budget(), || false).is_err());
+    let many = std::iter::repeat_with(|| (3, meta(3, None)))
+        .take(MAX_RECORDS + 1)
+        .collect();
+    assert!(ValidatedPrefix::try_from_metadata(3, 9, 7, many, budget(), || false).is_err());
+    assert!(matches!(
+        ValidatedPrefix::try_from_metadata(3, 9, 7, records(), budget(), || true),
+        Err(AncestryError::Cancelled)
+    ));
+    let expired = Instant::now().checked_sub(Duration::from_secs(1)).unwrap();
+    assert!(matches!(
+        ValidatedPrefix::try_from_metadata(3, 9, 7, records(), expired, || false),
+        Err(AncestryError::Deadline)
+    ));
+}
