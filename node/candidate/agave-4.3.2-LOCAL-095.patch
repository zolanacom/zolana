+fn kill_case(point: ancestry_archive::PublicationPoint, test_name: &str) {
+    use std::{
+        os::unix::process::ExitStatusExt,
+        process::{Child, Command, Stdio},
+        thread,
+    };
+    const CHILD: &str = "ZOLANA095_INDEXED_PUBLICATION";
+    const ROOT: &str = "ZOLANA095_INDEXED_ROOT";
+    let label = match point {
+        ancestry_archive::PublicationPoint::BeforeRename => "before",
+        ancestry_archive::PublicationPoint::AfterCommit => "after",
+    };
+    let expected = binding(9);
+    if let Some(value) = std::env::var_os(CHILD) {
+        assert_eq!(value.as_os_str(), std::ffi::OsStr::new(label));
+        let root = PathBuf::from(std::env::var_os(ROOT).unwrap());
+        let marker = root.join("publication-point");
+        ancestry_archive::PUBLICATION_HOOK.with(|hook| {
+            *hook.borrow_mut() = Some(Box::new(move |seen| {
+                if seen == point {
+                    let mut file = OpenOptions::new()
+                        .write(true)
+                        .create_new(true)
+                        .mode(0o600)
+                        .open(&marker)
+                        .unwrap();
+                    file.write_all(b"seen").unwrap();
+                    file.sync_all().unwrap();
+                    loop {
+                        thread::park();
+                    }
+                }
+            }))
+        });
+        publish(&root, "new", &expected);
+        panic!("indexed hook not reached");
+    }
+    struct ChildGuard(Child);
+    impl Drop for ChildGuard {
+        fn drop(&mut self) {
+            if self.0.try_wait().ok().flatten().is_none() {
+                let _ = self.0.kill();
+                let _ = self.0.wait();
+            }
+        }
+    }
+    let root = Fixture::new();
+    let old = ancestry_archive::publish(
+        &root.0,
+        "old",
+        owner(),
+        &expected,
+        (1..=9).map(|s| (s, meta(s))).collect(),
+        end(),
+        || false,
+    )
+    .unwrap();
+    let (_, manifest) = expected_bytes(&expected);
+    let independent_pin = digest(&manifest);
+    let child = Command::new(std::env::current_exe().unwrap())
+        .arg(test_name)
+        .arg("--exact")
+        .arg("--nocapture")
+        .arg("--test-threads=1")
+        .env(CHILD, label)
+        .env(ROOT, &root.0)
+        .stdin(Stdio::null())
+        .stdout(Stdio::null())
+        .stderr(Stdio::null())
+        .spawn()
+        .unwrap();
+    let mut child = ChildGuard(child);
+    let deadline = Instant::now() + Duration::from_secs(15);
+    while !root.0.join("publication-point").exists() {
+        assert!(child.0.try_wait().unwrap().is_none());
+        assert!(Instant::now() < deadline);
+        thread::sleep(Duration::from_millis(5));
+    }
+    child.0.kill().unwrap();
+    assert_eq!(child.0.wait().unwrap().signal(), Some(libc::SIGKILL));
+    ancestry_archive::load(
+        &root.0,
+        "old",
+        owner(),
+        old.manifest_sha256,
+        &expected,
+        end(),
+        || false,
+    )
+    .unwrap();
+    let loaded = ancestry_archive::load(
+        &root.0,
+        "new",
+        owner(),
+        independent_pin,
+        &expected,
+        end(),
+        || false,
+    );
+    match point {
+        ancestry_archive::PublicationPoint::BeforeRename => {
+            assert!(loaded.is_err());
+            assert!(!root.0.join("new").exists());
+        }
+        ancestry_archive::PublicationPoint::AfterCommit => {
+            let loaded = loaded.unwrap();
+            let db = Fixture::new();
+            let store = Blockstore::open(&db.0).unwrap();
+            store.put_meta(9, &meta(9)).unwrap();
+            assert_eq!(
+                loaded.verify(&store, 9, end(), || false).unwrap().entries,
+                9
+            );
+            loaded
+                .check_original_root(&store, 1, expected.original.certified_bank_hash)
+                .unwrap();
+        }
+    }
+}
+
+#[test]
+fn indexed_sigkill_before_rename_never_publishes_partial_generation() {
+    kill_case(
+        ancestry_archive::PublicationPoint::BeforeRename,
+        "ancestry_archive::indexed::tests::indexed_sigkill_before_rename_never_publishes_partial_generation",
+    );
+}
+#[test]
+fn indexed_sigkill_after_commit_reloads_complete_generation_with_independent_pin() {
+    kill_case(
+        ancestry_archive::PublicationPoint::AfterCommit,
+        "ancestry_archive::indexed::tests::indexed_sigkill_after_commit_reloads_complete_generation_with_independent_pin",
+    );
+}
