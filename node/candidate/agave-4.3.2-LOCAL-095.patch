+fn end() -> Instant {
+    Instant::now() + Duration::from_secs(180)
+}
+fn meta(slot: u64) -> SlotMeta {
+    let mut value = SlotMeta {
+        slot,
+        parent_slot: (slot > 1).then_some(slot - 1),
+        consumed: 3,
+        received: 3,
+        last_index: Some(2),
+        ..SlotMeta::default()
+    };
+    value.next_slots.push(slot + 1);
+    value.completed_data_indexes.insert(2);
+    value
+}
+fn evidence(slot: u64) -> RootEvidence {
+    RootEvidence {
+        slot,
+        is_root: true,
+        certified_bank_hash: digest(&slot.to_le_bytes()),
+        certified_timestamp: slot as i64,
+        replay_bank_hash: Some(digest(&slot.to_le_bytes())),
+    }
+}
+fn binding(head: u64) -> ArchiveBinding {
+    ArchiveBinding {
+        domain: Domain {
+            network: [7; 32],
+            genesis_hash: [11; 32],
+            identity: [1; 32],
+            voter: [2; 32],
+            resume_sha256: [3; 32],
+            ledger_relative_path: "peer-0/ledger".into(),
+        },
+        original: evidence(1),
+        head: evidence(head),
+        prune_through: head - 1,
+        snapshot_parent_slot: head + 1,
+        snapshot_slot: head + 2,
+        captured_current_root_slot: head + 3,
+        canonical_export_through: head + 3,
+    }
+}
+fn publish(root: &Path, name: &str, expected: &ArchiveBinding) -> PublishedArchive {
+    publish_from(
+        root,
+        name,
+        owner(),
+        expected,
+        |slot| Ok::<_, String>(Some(meta(slot))),
+        end(),
+        || false,
+    )
+    .unwrap()
+}
+fn load(
+    root: &Path,
+    name: &str,
+    pin: [u8; 32],
+    expected: &ArchiveBinding,
+) -> Result<IndexedPrefix, ArchiveError> {
+    let directory = open_child(&open_root(root, owner())?, name, owner(), true)?;
+    let raw = fs::read(root.join(name).join("manifest.json"))?;
+    ensure!(digest(&raw) == pin, "test independent manifest pin differs");
+    load_verified(&directory, owner(), &raw, expected, end(), &mut || false)
+}
+fn expected_bytes(expected: &ArchiveBinding) -> (Vec<u8>, Vec<u8>) {
+    let mut raw = MAGIC.to_vec();
+    let mut encoded_metadata_bytes = 0;
+    let mut decoded_metadata_bytes = 0;
+    let mut compressor = zstd::bulk::Compressor::new(1).unwrap();
+    for slot in (expected.original.slot..=expected.head.slot).rev() {
+        let body = encode_full_meta(&meta(slot)).unwrap();
+        let encoded = compressor.compress(&body).unwrap();
+        raw.extend_from_slice(&slot.to_le_bytes());
+        raw.extend_from_slice(&(encoded.len() as u32).to_le_bytes());
+        raw.extend_from_slice(&(body.len() as u32).to_le_bytes());
+        raw.extend_from_slice(&digest(&body));
+        raw.extend_from_slice(&encoded);
+        encoded_metadata_bytes += encoded.len() as u64;
+        decoded_metadata_bytes += body.len() as u64;
+    }
+    let manifest = serde_json::to_vec(&Manifest {
+        format: FORMAT.into(),
+        binding: expected.clone(),
+        record_count: (expected.head.slot - expected.original.slot + 1) as usize,
+        codec: CODEC.into(),
+        encoded_metadata_bytes,
+        decoded_metadata_bytes,
+        payload_bytes: raw.len() as u64,
+        payload_sha256: digest(&raw),
+    })
+    .unwrap();
+    (raw, manifest)
+}
