+fn v2_truncated_corrupt_and_even_repinned_discontinuous_frames_never_load() {
+    let body = encode_full_meta(&meta(9)).unwrap();
+    let encoded = zstd::bulk::compress(&body, 1).unwrap();
+    assert_eq!(decode_frame(&encoded, body.len()).unwrap(), body);
+    for bad in [
+        vec![],
+        vec![1, 2, 3],
+        encoded[..encoded.len() - 1].to_vec(),
+        {
+            let mut value = encoded.clone();
+            value.push(0);
+            value
+        },
+        {
+            let mut value = encoded.clone();
+            value.extend_from_slice(&encoded);
+            value
+        },
+    ] {
+        assert!(decode_frame(&bad, body.len()).is_err());
+    }
+    for declared in [0, 1, body.len() - 1, body.len() + 1, MAX_META_BYTES + 1] {
+        assert!(decode_frame(&encoded, declared).is_err());
+    }
+    let bomb = zstd::bulk::compress(&vec![0; MAX_META_BYTES + 1], 1).unwrap();
+    assert!(decode_frame(&bomb, MAX_META_BYTES).is_err());
+
+    let root = Fixture::new();
+    let expected = binding(9);
+    let published = publish(&root.0, "one", &expected);
+    let path = root.0.join("one/prefix.bin");
+    let original = fs::read(&path).unwrap();
+    for raw in [original[..original.len() - 1].to_vec(), {
+        let mut b = original.clone();
+        *b.last_mut().unwrap() ^= 1;
+        b
+    }] {
+        fs::write(&path, raw).unwrap();
+        assert!(load(&root.0, "one", published.manifest_sha256, &expected).is_err());
+    }
+    let (mut raw, mut manifest) = expected_bytes(&expected);
+    // Re-pin a frame with a duplicate/wrong first lookup slot. A manifest pin
+    // never excuses incomplete or substituted typed ancestry.
+    raw[8..16].copy_from_slice(&8u64.to_le_bytes());
+    let mut parsed: Manifest = serde_json::from_slice(&manifest).unwrap();
+    parsed.payload_sha256 = digest(&raw);
+    manifest = serde_json::to_vec(&parsed).unwrap();
+    fs::write(&path, &raw).unwrap();
+    fs::write(root.0.join("one/manifest.json"), &manifest).unwrap();
+    assert!(load(&root.0, "one", digest(&manifest), &expected).is_err());
+    // An over-bound frame length must refuse before allocating that body.
+    raw[8..16].copy_from_slice(&9u64.to_le_bytes());
+    raw[16..20].copy_from_slice(&(MAX_ENCODED_META_BYTES as u32 + 1).to_le_bytes());
+    parsed.payload_sha256 = digest(&raw);
