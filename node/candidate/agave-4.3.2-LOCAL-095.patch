diff --git a/zolana-fast-check/src/ancestry_archive_indexed.rs b/zolana-fast-check/src/ancestry_archive_indexed.rs
new file mode 100644
--- /dev/null
+++ b/zolana-fast-check/src/ancestry_archive_indexed.rs
@@ -0,0 +1,595 @@
+//! V2 full native ancestry: streaming immutable publication and bounded index.
+//! The index pins each verified frame digest; mutable file headers cannot
+//! re-authorize a post-load body rewrite. No complete SlotMeta collection lives
+//! in memory. Publication/trust/domain/root rules remain the parent module's.
+use {
+    super::{
+        ArchiveBinding, ArchiveError, MAX_MANIFEST, MAX_META_BYTES, PublishedArchive, budget,
+        c_name, capture_root_evidence, check_owner, checked_fd, decode_full_meta, digest,
+        encode_full_meta, open_child, open_root, valid_binding, valid_generation, write_new,
+    },
+    crate::ancestry::{AncestryError, AncestryReport},
+    anyhow::{Context, anyhow, bail, ensure},
+    serde::{Deserialize, Serialize},
+    solana_ledger::{blockstore::Blockstore, blockstore_meta::SlotMeta},
+    std::{
+        fmt,
+        fs::File,
+        io::{BufReader, BufWriter, Read, Write},
+        os::{
+            fd::AsRawFd,
+            unix::fs::{FileExt, MetadataExt},
+        },
+        path::Path,
+        time::Instant,
+    },
+};
+
+pub(super) const FORMAT: &str = "zolana095-native-ancestry-indexed-zstd-v2";
+const MAGIC: &[u8; 8] = b"ZANCZ002";
+const FRAME_BYTES: u64 = 48;
+const CODEC: &str = "zstd-one-frame-level-1";
+const MAX_ENCODED_META_BYTES: usize = MAX_META_BYTES + 1024;
+pub(crate) const MAX_DECODED_METADATA_BYTES: u64 = 8 * 1024 * 1024 * 1024;
+pub(crate) const MAX_RECORDS: usize = 1_048_576;
+pub(crate) const MAX_METADATA_BYTES: u64 = 512 * 1024 * 1024;
+pub(crate) const MAX_INDEX_BYTES: usize = MAX_RECORDS * 48;
+const MAX_PAYLOAD_BYTES: u64 = MAX_METADATA_BYTES + MAX_RECORDS as u64 * FRAME_BYTES + 8;
+
+#[derive(Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Manifest {
+    format: String,
+    binding: ArchiveBinding,
+    record_count: usize,
+    codec: String,
+    encoded_metadata_bytes: u64,
+    decoded_metadata_bytes: u64,
+    payload_bytes: u64,
+    payload_sha256: [u8; 32],
+}
+
+#[derive(Clone, Copy, Debug)]
+struct Entry {
+    slot: u64,
+    offset: u64,
+    // Bound to the independently pinned complete payload at load time.
+    // A digest obtained afresh from a mutable frame is not an authority.
+    digest: [u8; 32],
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct Identity {
+    device: u64,
+    inode: u64,
+    bytes: u64,
+    modified: (i64, i64),
+    changed: (i64, i64),
+    owner: u32,
+    mode: u32,
+    links: u64,
+}
+
+impl Identity {
+    fn capture(file: &File) -> Result<Self, ArchiveError> {
+        let m = file.metadata()?;
+        ensure!(
+            m.is_file() && m.nlink() == 1,
+            "indexed payload is not a single-link regular file"
+        );
+        Ok(Self {
+            device: m.dev(),
+            inode: m.ino(),
+            bytes: m.len(),
+            modified: (m.mtime(), m.mtime_nsec()),
+            changed: (m.ctime(), m.ctime_nsec()),
+            owner: m.uid(),
+            mode: m.mode(),
+            links: m.nlink(),
+        })
+    }
+}
+
+pub(super) struct IndexedPrefix {
+    file: File,
+    identity: Identity,
+    entries: Vec<Entry>,
+    original: u64,
+    prune_through: u64,
+}
+
+fn next_slot(meta: &SlotMeta, original: u64) -> Result<Option<u64>, ArchiveError> {
+    if meta.slot == original {
+        return Ok(None); // Original root's own parent is deliberately not walked.
+    }
+    let next = meta
+        .parent_slot
+        .context("indexed ancestry parent missing")?;
+    ensure!(
+        original <= next && next < meta.slot,
+        "indexed ancestry parent skips original root or is not decreasing"
+    );
+    Ok(Some(next))
+}
+
+fn create_payload(directory: &File, owner: u32) -> Result<File, ArchiveError> {
+    let file = checked_fd(
+        unsafe {
+            libc::openat(
+                directory.as_raw_fd(),
+                c"prefix.bin".as_ptr(),
+                libc::O_WRONLY | libc::O_CREAT | libc::O_EXCL | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+                0o600,
+            )
+        },
+        "create exclusive indexed ancestry payload",
+    )?;
+    check_owner(&file, owner, false)?;
+    Ok(file)
+}
+
+/// Actual Blockstore entrypoint. The caller still pins genesis/domain/resume,
+/// protected snapshots and the separate complete canonical transaction export.
+pub(crate) fn publish_indexed(
+    root: &Path,
+    generation: &str,
+    owner_uid: u32,
+    binding: &ArchiveBinding,
+    store: &Blockstore,
+    deadline: Instant,
+    mut cancelled: impl FnMut() -> bool,
+) -> Result<PublishedArchive, ArchiveError> {
+    for expected in [&binding.original, &binding.head] {
+        budget(deadline, &mut cancelled)?;
+        ensure!(
+            capture_root_evidence(store, expected.slot)?.certified_bank_hash
+                == expected.certified_bank_hash,
+            "indexed source root BANK evidence differs"
+        );
+    }
+    publish_from(
+        root,
+        generation,
+        owner_uid,
+        binding,
+        |slot| store.meta(slot),
+        deadline,
+        cancelled,
+    )
+}
+
+/// Generic FULL reader is private to this implementation and its fixtures.
+fn publish_from<E: fmt::Display>(
+    root: &Path,
+    generation: &str,
+    owner_uid: u32,
+    binding: &ArchiveBinding,
+    mut read: impl FnMut(u64) -> Result<Option<SlotMeta>, E>,
+    deadline: Instant,
+    mut cancelled: impl FnMut() -> bool,
+) -> Result<PublishedArchive, ArchiveError> {
+    budget(deadline, &mut cancelled)?;
+    valid_generation(generation)?;
+    valid_binding(binding)?;
+    let parent = open_root(root, owner_uid)?;
+    let pending = format!(".pending-{generation}");
+    let pending_c = c_name(pending.as_bytes())?;
+    if unsafe { libc::mkdirat(parent.as_raw_fd(), pending_c.as_ptr(), 0o700) } != 0 {
+        return Err(std::io::Error::last_os_error())
+            .context("create exclusive pending indexed generation");
+    }
+    parent.sync_all()?;
+    let directory = open_child(&parent, &pending, owner_uid, true)?;
+    let mut writer =
+        BufWriter::with_capacity(MAX_META_BYTES, create_payload(&directory, owner_uid)?);
+    let mut hasher = solana_sha256_hasher::Hasher::default();
+    writer.write_all(MAGIC)?;
+    hasher.hash(MAGIC);
+    let mut slot = binding.head.slot;
+    let mut count = 0usize;
+    let mut encoded_metadata_bytes = 0u64;
+    let mut decoded_metadata_bytes = 0u64;
+    let mut payload_bytes = MAGIC.len() as u64;
+    let mut compressor = zstd::bulk::Compressor::new(1)?;
+    loop {
+        budget(deadline, &mut cancelled)?;
+        ensure!(
+            count < MAX_RECORDS,
+            "indexed ancestry record bound exceeded"
+        );
+        let meta = read(slot)
+            .map_err(|e| anyhow!("cannot read full indexed ancestry at {slot}: {e}"))?
+            .context("full indexed ancestry metadata missing")?;
+        budget(deadline, &mut cancelled)?;
+        ensure!(
+            meta.slot == slot,
+            "indexed source metadata slot substitution"
+        );
+        let raw = encode_full_meta(&meta)?;
+        ensure!(
+            decode_full_meta(slot, &raw)? == meta,
+            "full indexed metadata roundtrip differs"
+        );
+        let next = next_slot(&meta, binding.original.slot)?;
+        let encoded = compressor.compress(&raw)?;
+        ensure!(
+            !encoded.is_empty() && encoded.len() <= MAX_ENCODED_META_BYTES,
+            "indexed compressed metadata record exceeds bound"
+        );
+        encoded_metadata_bytes = encoded_metadata_bytes
+            .checked_add(encoded.len() as u64)
+            .context("indexed stored metadata byte overflow")?;
+        decoded_metadata_bytes = decoded_metadata_bytes
+            .checked_add(raw.len() as u64)
+            .context("indexed decoded metadata byte overflow")?;
+        payload_bytes = payload_bytes
+            .checked_add(FRAME_BYTES + encoded.len() as u64)
+            .context("indexed payload byte overflow")?;
+        ensure!(
+            encoded_metadata_bytes <= MAX_METADATA_BYTES
+                && decoded_metadata_bytes <= MAX_DECODED_METADATA_BYTES
+                && payload_bytes <= MAX_PAYLOAD_BYTES,
+            "indexed ancestry payload bound exceeded"
+        );
+        let mut frame = [0u8; FRAME_BYTES as usize];
+        frame[..8].copy_from_slice(&slot.to_le_bytes());
+        frame[8..12].copy_from_slice(&(encoded.len() as u32).to_le_bytes());
+        frame[12..16].copy_from_slice(&(raw.len() as u32).to_le_bytes());
+        frame[16..].copy_from_slice(&digest(&raw));
+        writer.write_all(&frame)?;
+        writer.write_all(&encoded)?;
+        hasher.hash(&frame);
+        hasher.hash(&encoded);
+        count += 1;
+        budget(deadline, &mut cancelled)?;
+        match next {
+            Some(next) => slot = next,
+            None => break,
+        }
+    }
+    writer.flush()?;
+    writer.get_ref().sync_all()?;
+    ensure!(
+        writer.get_ref().metadata()?.len() == payload_bytes,
+        "indexed written payload size differs"
+    );
+    drop(writer);
+    let manifest = serde_json::to_vec(&Manifest {
+        format: FORMAT.into(),
+        binding: binding.clone(),
+        record_count: count,
+        codec: CODEC.into(),
+        encoded_metadata_bytes,
+        decoded_metadata_bytes,
+        payload_bytes,
+        payload_sha256: hasher.result().to_bytes(),
+    })?;
+    ensure!(
+        manifest.len() <= MAX_MANIFEST,
+        "indexed manifest exceeds bound"
+    );
+    budget(deadline, &mut cancelled)?;
+    write_new(&directory, "manifest.json", owner_uid, &manifest)?;
+    directory.sync_all()?;
+    budget(deadline, &mut cancelled)?;
+    #[cfg(test)]
+    super::publication_hook(super::PublicationPoint::BeforeRename);
+    let final_c = c_name(generation.as_bytes())?;
+    #[cfg(target_os = "linux")]
+    if unsafe {
+        libc::renameat2(
+            parent.as_raw_fd(),
+            pending_c.as_ptr(),
+            parent.as_raw_fd(),
+            final_c.as_ptr(),
+            libc::RENAME_NOREPLACE,
+        )
+    } != 0
+    {
+        return Err(std::io::Error::last_os_error())
+            .context("publish exclusive indexed generation");
+    }
+    #[cfg(not(target_os = "linux"))]
+    bail!("exclusive indexed ancestry publication requires Linux");
+    parent.sync_all()?;
+    #[cfg(test)]
+    super::publication_hook(super::PublicationPoint::AfterCommit);
+    budget(deadline, &mut cancelled)?;
+    Ok(PublishedArchive {
+        manifest_sha256: digest(&manifest),
+    })
+}
+
+pub(super) fn load_verified(
+    directory: &File,
+    owner_uid: u32,
+    raw_manifest: &[u8],
+    expected: &ArchiveBinding,
+    deadline: Instant,
+    cancelled: &mut impl FnMut() -> bool,
+) -> Result<IndexedPrefix, ArchiveError> {
+    let manifest: Manifest = serde_json::from_slice(raw_manifest)?;
+    ensure!(
+        manifest.format == FORMAT
+            && &manifest.binding == expected
+            && manifest.record_count > 0
+            && manifest.record_count <= MAX_RECORDS
+            && manifest.codec == CODEC
+            && manifest.encoded_metadata_bytes > 0
+            && manifest.encoded_metadata_bytes <= MAX_METADATA_BYTES
+            && manifest.decoded_metadata_bytes > 0
+            && manifest.decoded_metadata_bytes <= MAX_DECODED_METADATA_BYTES
+            && manifest.payload_bytes > 8
+            && manifest.payload_bytes <= MAX_PAYLOAD_BYTES
+            && std::mem::size_of::<Entry>() == 48,
+        "indexed manifest format/binding/bounds differ"
+    );
+    let index_bytes = manifest
+        .record_count
+        .checked_mul(std::mem::size_of::<Entry>())
+        .context("indexed memory byte overflow")?;
+    ensure!(
+        index_bytes <= MAX_INDEX_BYTES,
+        "indexed memory byte bound exceeded"
+    );
+    budget(deadline, cancelled)?;
+    let file = open_child(directory, "prefix.bin", owner_uid, false)?;
+    let identity = Identity::capture(&file)?;
+    ensure!(
+        identity.bytes == manifest.payload_bytes,
+        "indexed payload file size differs"
+    );
+    let mut reader = BufReader::with_capacity(MAX_META_BYTES, file);
+    let mut entries = Vec::new();
+    entries
+        .try_reserve_exact(manifest.record_count)
+        .context("cannot allocate bounded ancestry index")?;
+    let mut magic = [0u8; 8];
+    reader.read_exact(&mut magic)?;
+    ensure!(&magic == MAGIC, "indexed payload magic differs");
+    let mut hasher = solana_sha256_hasher::Hasher::default();
+    hasher.hash(&magic);
+    let mut offset = 8u64;
+    let mut encoded_metadata_bytes = 0u64;
+    let mut decoded_metadata_bytes = 0u64;
+    let mut expected_slot = Some(expected.head.slot);
+    for _ in 0..manifest.record_count {
+        budget(deadline, cancelled)?;
+        let mut frame = [0u8; FRAME_BYTES as usize];
+        reader.read_exact(&mut frame)?;
+        let slot = u64::from_le_bytes(frame[..8].try_into().unwrap());
+        let size = u32::from_le_bytes(frame[8..12].try_into().unwrap()) as usize;
+        let decoded_size = u32::from_le_bytes(frame[12..16].try_into().unwrap()) as usize;
+        let pin: [u8; 32] = frame[16..].try_into().unwrap();
+        ensure!(
+            Some(slot) == expected_slot
+                && size > 0
+                && size <= MAX_ENCODED_META_BYTES
+                && decoded_size > 0
+                && decoded_size <= MAX_META_BYTES,
+            "indexed frame slot/order/record bound differs"
+        );
+        let next_offset = offset
+            .checked_add(FRAME_BYTES + size as u64)
+            .context("indexed offset overflow")?;
+        encoded_metadata_bytes = encoded_metadata_bytes
+            .checked_add(size as u64)
+            .context("indexed stored metadata overflow")?;
+        decoded_metadata_bytes = decoded_metadata_bytes
+            .checked_add(decoded_size as u64)
+            .context("indexed decoded metadata overflow")?;
+        ensure!(
+            next_offset <= manifest.payload_bytes
+                && encoded_metadata_bytes <= MAX_METADATA_BYTES
+                && decoded_metadata_bytes <= MAX_DECODED_METADATA_BYTES,
+            "indexed frame/total payload bound exceeded"
+        );
+        let mut encoded = vec![0u8; size];
+        reader.read_exact(&mut encoded)?;
+        let raw = decode_frame(&encoded, decoded_size)?;
+        ensure!(digest(&raw) == pin, "indexed frame digest differs");
+        let meta = decode_full_meta(slot, &raw)?;
+        expected_slot = next_slot(&meta, expected.original.slot)?;
+        entries.push(Entry {
+            slot,
+            offset,
+            digest: pin,
+        });
+        offset = next_offset;
+        hasher.hash(&frame);
+        hasher.hash(&encoded);
+        budget(deadline, cancelled)?;
+    }
+    ensure!(
+        expected_slot.is_none()
+            && offset == manifest.payload_bytes
+            && encoded_metadata_bytes == manifest.encoded_metadata_bytes
+            && decoded_metadata_bytes == manifest.decoded_metadata_bytes
+            && hasher.result().to_bytes() == manifest.payload_sha256,
+        "indexed complete path/count/global digest differs"
+    );
+    let mut trailing = [0u8; 1];
+    ensure!(
+        reader.read(&mut trailing)? == 0,
+        "trailing indexed payload bytes"
+    );
+    let file = reader.into_inner();
+    ensure!(
+        Identity::capture(&file)? == identity,
+        "indexed payload changed during validation"
+    );
+    budget(deadline, cancelled)?;
+    Ok(IndexedPrefix {
+        file,
+        identity,
+        entries,
+        original: expected.original.slot,
+        prune_through: expected.prune_through,
+    })
+}
+
+/// One bounded zstd frame only: no concatenated/trailing/skippable payload
+/// can supply another body, and declared size never controls an unbounded allocation.
+fn decode_frame(encoded: &[u8], decoded_size: usize) -> Result<Vec<u8>, ArchiveError> {
+    ensure!(
+        !encoded.is_empty()
+            && encoded.len() <= MAX_ENCODED_META_BYTES
+            && decoded_size > 0
+            && decoded_size <= MAX_META_BYTES,
+        "indexed zstd encoded/decoded record bound differs"
+    );
+    let frame_size = zstd::zstd_safe::find_frame_compressed_size(encoded)
+        .map_err(|code| anyhow!("invalid indexed zstd frame: {code}"))?;
+    ensure!(
+        frame_size == encoded.len(),
+        "indexed zstd trailing or concatenated frame bytes"
+    );
+    let decoded = zstd::bulk::decompress(encoded, decoded_size)?;
+    ensure!(
+        decoded.len() == decoded_size,
+        "indexed zstd decoded size differs"
+    );
+    Ok(decoded)
+}
+
+impl IndexedPrefix {
+    fn read_entry(&self, position: usize) -> Result<SlotMeta, ArchiveError> {
+        ensure!(
+            Identity::capture(&self.file)? == self.identity,
+            "loaded indexed payload identity changed"
+        );
+        let entry = self
+            .entries
+            .get(position)
+            .context("indexed lookup out of range")?;
+        let mut frame = [0u8; FRAME_BYTES as usize];
+        self.file.read_exact_at(&mut frame, entry.offset)?;
+        let slot = u64::from_le_bytes(frame[..8].try_into().unwrap());
+        let size = u32::from_le_bytes(frame[8..12].try_into().unwrap()) as usize;
+        let decoded_size = u32::from_le_bytes(frame[12..16].try_into().unwrap()) as usize;
+        ensure!(
+            slot == entry.slot
+                && size > 0
+                && size <= MAX_ENCODED_META_BYTES
+                && decoded_size > 0
+                && decoded_size <= MAX_META_BYTES
+                && frame[16..] == entry.digest
+                && entry
+                    .offset
+                    .checked_add(FRAME_BYTES + size as u64)
+                    .is_some_and(|end| end <= self.identity.bytes),
+            "loaded indexed frame/header/digest pin differs"
+        );
+        let mut encoded = vec![0u8; size];
+        self.file
+            .read_exact_at(&mut encoded, entry.offset + FRAME_BYTES)?;
+        let raw = decode_frame(&encoded, decoded_size)?;
+        ensure!(
+            digest(&raw) == entry.digest,
+            "loaded indexed metadata digest differs"
+        );
+        let meta = decode_full_meta(slot, &raw)?;
+        ensure!(
+            Identity::capture(&self.file)? == self.identity,
+            "indexed payload changed during lookup"
+        );
+        Ok(meta)
+    }
+
+    fn find(&self, slot: u64) -> Option<usize> {
+        self.entries
+            .binary_search_by(|entry| entry.slot.cmp(&slot).reverse())
+            .ok()
+    }
+
+    fn lookup(
+        &self,
+        slot: u64,
+        cursor: Option<&mut usize>,
+    ) -> Result<Option<SlotMeta>, ArchiveError> {
+        let position = match cursor {
+            Some(cursor) => {
+                let position = if self
+                    .entries
+                    .get(*cursor)
+                    .is_some_and(|entry| entry.slot == slot)
+                {
+                    Some(*cursor)
+                } else {
+                    self.find(slot)
+                };
+                if let Some(position) = position {
+                    *cursor = position + 1;
+                }
+                position
+            }
+            None => self.find(slot),
+        };
+        position
+            .map(|position| self.read_entry(position))
+            .transpose()
+    }
+
+    fn merge(
+        &self,
+        slot: u64,
+        live: Option<SlotMeta>,
+        old: Option<SlotMeta>,
+    ) -> Result<Option<SlotMeta>, String> {
+        match (live, old) {
+            (Some(live), Some(old)) if live != old => {
+                Err("live/archive full metadata conflicts".into())
+            }
+            (Some(live), _) => Ok(Some(live)),
+            (None, Some(old)) if slot <= self.prune_through => Ok(Some(old)),
+            (None, _) => Ok(None),
+        }
+    }
+
+    fn read_from<E: fmt::Display>(
+        &self,
+        slot: u64,
+        mut read_live: impl FnMut(u64) -> Result<Option<SlotMeta>, E>,
+    ) -> Result<Option<SlotMeta>, String> {
+        // A live read/decode error is fatal before consulting the archive.
+        let live = read_live(slot).map_err(|e| e.to_string())?;
+        let old = self.lookup(slot, None).map_err(|e| e.to_string())?;
+        self.merge(slot, live, old)
+    }
+
+    pub(super) fn read_meta(
+        &self,
+        store: &Blockstore,
+        slot: u64,
+    ) -> Result<Option<SlotMeta>, String> {
+        self.read_from(slot, |slot| store.meta(slot))
+    }
+
+    pub(super) fn verify(
+        &self,
+        store: &Blockstore,
+        start: u64,
+        deadline: Instant,
+        cancelled: impl FnMut() -> bool,
+    ) -> Result<AncestryReport, AncestryError> {
+        let mut cursor = 0usize;
+        crate::ancestry::verify_path_from(
+            |slot| {
+                let live = store.meta(slot).map_err(|e| e.to_string())?;
+                let old = self
+                    .lookup(slot, Some(&mut cursor))
+                    .map_err(|e| e.to_string())?;
+                self.merge(slot, live, old)
+            },
+            start,
+            self.original,
+            deadline,
+            cancelled,
+            |_, _| {},
+        )
+    }
+}
