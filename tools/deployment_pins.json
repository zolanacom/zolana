 "format": "zolana-deployment-pins-v1",
 "reasons": {
  "acceptance-rig": "Source directories on the hosts of one acceptance run.",
  "accepted-source": "The accepted service source. Two startup wrappers and their tests bind its exact bytes, so it cannot be edited. native_network_service.py runs it for any description.",
  "explorer": "The explorer feed and puller are installed on their own and take their settings from their unit files; not in the description yet. The feed also names the vote program, which is the same on every network.",
  "installed-alone": "Installed without its sibling modules (a single sealed file or an exact file list), so the built-in values stay in the file. The tool reads its own fields of a description named by ZOLANA_DEPLOYMENT, and deployment_test.py holds the built-in values equal to the built-in description.",
  "local-macos-service": "The local macOS validator service and its acceptance tools. Its install root, account and label are not in the description yet.",
  "macos-pilot": "The macOS invite pilot installer and host plan. Not in the description yet.",
  "protocol-constant": "A program address or a curve constant. The same on every network.",
  "release-record": "Hashes of the profile, verifier and builder of one accepted wallet release.",
  "replacement-table": "The text of the accepted service source that this tool replaces with values from the description.",
  "source-pin": "Hashes of the upstream validator source and of the patches applied to it. They identify the build, not an installation."
 }
}
